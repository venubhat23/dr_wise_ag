<% content_for :title, "Incentive Calculator" %>
<% segment_colors = { 'Insurance' => 'primary', 'Investments' => 'success', 'Loans' => 'warning', 'Taxation' => 'info', 'Travel' => 'danger' } %>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h2 class="mb-1">Incentive Calculator</h2>
    <p class="text-muted mb-0">Incentive range (₹ Minimum – Upto) for every product. The mobile app shows these same values.</p>
  </div>
  <div class="d-flex gap-2">
    <% if @editing %>
      <%= link_to 'Cancel', admin_incentive_calculator_index_path, class: 'btn btn-outline-secondary' %>
      <button type="submit" form="incentive-form" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save Changes</button>
    <% else %>
      <%= button_to reset_admin_incentive_calculator_index_path, method: :post, class: 'btn btn-outline-secondary',
                    form: { data: { turbo_confirm: 'Reset every Minimum / Upto / Remark back to the default sheet values?' } } do %>
        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Default
      <% end %>
      <%= link_to admin_incentive_calculator_index_path(edit: 1), class: 'btn btn-primary' do %>
        <i class="bi bi-pencil-square me-1"></i>Edit
      <% end %>
    <% end %>
  </div>
</div>

<!-- Segment summary -->
<div class="row g-3 mb-4">
  <% @grouped.each do |segment, categories| %>
    <% seg_rows = categories.values.flatten %>
    <% color = segment_colors.fetch(segment, 'secondary') %>
    <div class="col-6 col-md-4 col-xl">
      <a href="#segment-<%= segment.parameterize %>" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-<%= color %>">
          <div class="card-body py-3">
            <div class="fw-semibold text-dark"><%= segment %></div>
            <div class="small text-muted"><%= pluralize(seg_rows.size, 'product') %></div>
            <div class="small text-<%= color %> fw-semibold mt-1">
              ₹<%= number_with_delimiter(seg_rows.map(&:minimum).min) %> – ₹<%= number_with_delimiter(seg_rows.map(&:upto).max) %>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% end %>
</div>

<%= form_with url: update_admin_incentive_calculator_index_path, method: :patch, id: 'incentive-form', local: true do %>
  <% @grouped.each do |segment, categories| %>
    <% color = segment_colors.fetch(segment, 'secondary') %>
    <div class="card border-0 shadow-sm mb-4" id="segment-<%= segment.parameterize %>">
      <div class="card-header bg-<%= color %> bg-opacity-10 border-0 py-3">
        <h5 class="mb-0 text-<%= color %>"><%= segment %></h5>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width:20%">Category</th>
              <th style="width:28%">Sub-category</th>
              <th class="text-end" style="width:14%">Minimum (₹)</th>
              <th class="text-end" style="width:14%">Upto (₹)</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody>
            <% categories.each do |category, rows| %>
              <% rows.each_with_index do |row, i| %>
                <tr>
                  <% if i.zero? %>
                    <td rowspan="<%= rows.size %>" class="fw-semibold border-end"><%= category %></td>
                  <% end %>
                  <td><%= row.sub_category %></td>
                  <% if @editing %>
                    <td>
                      <%= number_field_tag "rows[#{row.id}][minimum]", row.minimum, min: 0, step: 1, required: true,
                                           class: 'form-control form-control-sm text-end' %>
                    </td>
                    <td>
                      <%= number_field_tag "rows[#{row.id}][upto]", row.upto, min: 0, step: 1, required: true,
                                           class: 'form-control form-control-sm text-end' %>
                    </td>
                    <td>
                      <%= text_field_tag "rows[#{row.id}][remarks]", row.remarks, maxlength: 255,
                                         class: 'form-control form-control-sm', placeholder: 'Optional' %>
                    </td>
                  <% else %>
                    <td class="text-end"><%= number_with_delimiter(row.minimum) %></td>
                    <td class="text-end fw-semibold"><%= number_with_delimiter(row.upto) %></td>
                    <td class="text-muted small"><%= row.remarks.presence || '—' %></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if @editing %>
    <div class="d-flex justify-content-end gap-2 mb-4">
      <%= link_to 'Cancel', admin_incentive_calculator_index_path, class: 'btn btn-outline-secondary' %>
      <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save Changes</button>
    </div>
  <% end %>
<% end %>

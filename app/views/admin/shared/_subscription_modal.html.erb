<%# Shared "Mark subscription paid" modal for the ambassador / affiliate lists.
    Buttons carry data-sub-* attributes; the script below fills the form. %>
<div class="modal fade" id="subscriptionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form method="post" id="subscriptionForm" class="modal-content">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Mark Subscription Paid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2"><strong id="subscriptionName"></strong></p>
        <p class="small text-muted mb-3" id="subscriptionCurrent"></p>
        <div class="row g-3">
          <div class="col-6">
            <label class="form-label" for="subscriptionFrom">From date</label>
            <input type="date" class="form-control" name="from_date" id="subscriptionFrom" required>
          </div>
          <div class="col-6">
            <label class="form-label" for="subscriptionTo">To date</label>
            <input type="date" class="form-control" name="to_date" id="subscriptionTo" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="subscriptionAmount">Amount paid (₹)</label>
            <input type="number" step="0.01" min="0" class="form-control" name="amount" id="subscriptionAmount">
          </div>
        </div>
        <small class="text-muted d-block mt-3">
          Payment is marked as done and the subscription stays valid until the end of the To date.
        </small>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Mark as Paid</button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  function isoDate(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  // One year minus a day: 01 Apr 2025 -> 31 Mar 2026.
  function oneYearFrom(value) {
    if (!value) return '';
    const d = new Date(value + 'T00:00:00');
    d.setFullYear(d.getFullYear() + 1);
    d.setDate(d.getDate() - 1);
    return isoDate(d);
  }

  document.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-sub-url]');
    if (!btn) return;
    document.getElementById('subscriptionForm').action = btn.dataset.subUrl;
    document.getElementById('subscriptionName').textContent = btn.dataset.subName;
    document.getElementById('subscriptionCurrent').textContent = btn.dataset.subCurrent || 'No subscription recorded yet.';
    document.getElementById('subscriptionFrom').value = btn.dataset.subFrom;
    document.getElementById('subscriptionTo').value = oneYearFrom(btn.dataset.subFrom);
    document.getElementById('subscriptionAmount').value = btn.dataset.subAmount;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('subscriptionModal')).show();
  });

  document.addEventListener('change', function(e) {
    if (e.target.id === 'subscriptionFrom') {
      document.getElementById('subscriptionTo').value = oneYearFrom(e.target.value);
    }
  });
})();
</script>

    // Animation on load
    document.addEventListener('DOMContentLoaded', function() {
      const statValues = document.querySelectorAll('.stat-value');
      statValues.forEach((stat, index) => {
        setTimeout(() => {
          stat.style.transform = 'scale(1.1)';
          setTimeout(() => {
            stat.style.transform = 'scale(1)';
          }, 300);
        }, index * 100);
      });
    });
  </script>

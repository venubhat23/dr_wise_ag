                            <div class="d-flex align-items-center justify-content-center mb-2">
                              <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 30px; height: 30px; font-size: 0.75rem;">
                                A
                              </div>
                              <small class="ms-2 text-muted">Admin</small>
                            </div>

                            <div class="btn-group btn-group-sm w-100">
                              <% if doc_info[:type] == 'uploaded' %>
                                <% if doc_info[:doc].file.attached? %>
                                  <%= link_to rails_blob_path(doc_info[:doc].file, disposition: "inline"),
                                      class: "btn btn-outline-primary btn-sm",
                                      target: "_blank",

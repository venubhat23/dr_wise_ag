              <i class="bi bi-info-circle me-1"></i>
              Supports PDF, Images, Word files - RC, PUC, Insurance copy, etc.
            </div>
          </div>

          <!-- Additional Documents Preview -->
          <%= render 'shared/file_upload_preview',
                     field_id: 'additional_documents_upload',
                     preview_id: 'additional_documents_preview',
                     accept: 'application/pdf,image/jpeg,image/jpg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                     show_file_info: true,
                     max_file_size: '10MB' %>
        </div>
      </div>

      <!-- Existing Documents (Edit Mode) -->
      <% if @motor_insurance.persisted? %>
        <%
          total_documents = @motor_insurance.uploaded_documents.count +
                           (@motor_insurance.policy_documents.attached? ? @motor_insurance.policy_documents.count : 0) +
                           (@motor_insurance.documents.attached? ? @motor_insurance.documents.count : 0)

          total_size = 0
          total_size += @motor_insurance.uploaded_documents.sum { |doc| doc.file&.byte_size || 0 }
          total_size += @motor_insurance.policy_documents.sum(&:byte_size) if @motor_insurance.policy_documents.attached?
          total_size += @motor_insurance.documents.sum(&:byte_size) if @motor_insurance.documents.attached?

          document_types = []
          document_types += @motor_insurance.uploaded_documents.pluck(:document_type).compact.uniq
          document_types += ['Policy Document'] if @motor_insurance.policy_documents.attached?
          document_types += ['Additional Document'] if @motor_insurance.documents.attached?
          document_types = document_types.uniq

          recent_docs = @motor_insurance.uploaded_documents.where('created_at > ?', 7.days.ago).count
        %>

        <% if total_documents > 0 %>
          <div class="border-top pt-4 mt-4">
            <!-- Document Overview Statistics -->
            <div class="row mb-4">
              <div class="col-xl-3 col-md-6 mb-3">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-body">
                    <div class="d-flex justify-content-between">
                      <div>
                        <h6 class="text-muted mb-2">Total Documents</h6>
                        <h3 class="mb-0 text-primary"><%= total_documents %></h3>
                      </div>
                      <div class="bg-primary bg-opacity-10 rounded p-3">
                        <i class="bi bi-files text-primary fs-4"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-xl-3 col-md-6 mb-3">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-body">

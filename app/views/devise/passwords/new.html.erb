<% content_for :title, "Forgot Password - Drwise" %>
<div class="simple-login-wrapper">
  <div class="simple-login-container">
    <div class="simple-login-card">
      <% if alert.present? %>
        <div class="alert alert-danger mb-3">
          <i class="fas fa-exclamation-triangle me-2"></i><%= alert %>
        </div>
      <% end %>

      <div class="text-center mb-4">
        <div class="simple-logo">
          <img src="/logo.jpeg" alt="Dr WISE" class="login-logo-img" />
        </div>
        <h2 class="simple-title">Forgot Password</h2>
        <p class="text-muted mb-0">Enter your registered email and we'll send you a link to set a new password.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <% if resource.errors.any? %>
          <div class="alert alert-danger mb-3">
            <% resource.errors.full_messages.each do |message| %>
              <div><i class="fas fa-exclamation-triangle me-2"></i><%= message %></div>
            <% end %>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">
              <i class="fas fa-envelope"></i>
            </span>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control", placeholder: "email@example.com" %>
          </div>
        </div>

        <%= f.submit "Send Reset Link", class: "btn btn-primary w-100 py-3 fs-5 fw-semibold" %>
      <% end %>

      <div class="text-center mt-4 pt-3 border-top">
        <%= link_to new_session_path(resource_name), class: "text-decoration-none" do %>
          <i class="fas fa-arrow-left me-2"></i>Back to Sign In
        <% end %>
      </div>
    </div>
  </div>
</div>

<% photo_doc = @distributor.kyc_document("Profile Photo") %>

<h2 class="h6 fw-bold mb-1">Step 4 · Upload your photo</h2>
<p class="text-muted small">
  A recent, clear photo of your face in good light. This is used to verify your identity.
</p>

<%= form_with url: ambassador_kyc_photo_path, method: :patch, multipart: true, local: true, data: { turbo: false } do %>
  <div class="upload-box mb-3 <%= 'filled' if photo_doc %>" id="photo-upload-box">
    <div class="d-flex gap-2 mb-2">
      <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="btn-choose-photo">
        <i class="fas fa-folder-open me-1"></i> Choose from device
      </button>
      <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="btn-take-photo">
        <i class="fas fa-camera me-1"></i> Take a photo
      </button>
    </div>

    <%# "Choose from device" uses a plain file picker. "Take a photo" opens a
        live in-page camera (getUserMedia) so it also works on desktop/laptop
        webcams, not just mobile - the capture attribute alone only works on
        phones/tablets and desktop browsers just ignore it. Whichever one is
        used, the resulting file gets copied into the field below before submit. %>
    <input type="file" accept="image/*" id="photo-input-gallery" class="d-none">
    <%= file_field_tag :photo_file, accept: "image/*", id: "photo-input-final", class: "d-none" %>

    <div id="photo-preview-wrap" class="text-center <%= 'd-none' unless photo_doc&.document_url %>">
      <img id="photo-preview" src="<%= photo_doc&.document_url %>"
           style="max-height:160px;border-radius:12px;border:1px solid #e5e7eb;">
      <div class="text-muted small mt-1" id="photo-filename"><%= 'Current photo' if photo_doc %></div>
    </div>
    <div class="text-muted small text-center <%= 'd-none' if photo_doc&.document_url %>" id="photo-placeholder">
      No photo selected yet.
    </div>
  </div>

  <%# Live camera overlay for "Take a photo". Hidden until opened. %>
  <div id="camera-overlay" class="d-none"
       style="position:fixed;inset:0;background:rgba(17,24,39,.9);z-index:1050;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;">
    <video id="camera-video" autoplay playsinline
           style="max-width:100%;max-height:70vh;border-radius:12px;background:#000;"></video>
    <div class="text-danger small mt-2 d-none" id="camera-error" style="max-width:400px;text-align:center;"></div>
    <div class="d-flex gap-2 mt-3">
      <button type="button" class="btn btn-outline-light" id="camera-cancel">Cancel</button>
      <button type="button" class="btn btn-primary px-4" id="camera-capture">
        <i class="fas fa-camera me-1"></i> Capture
      </button>
    </div>
    <canvas id="camera-canvas" class="d-none"></canvas>
  </div>

  <div class="d-flex justify-content-between mt-4">
    <%= link_to "Back", ambassador_kyc_path(step: 3), class: "btn btn-outline-secondary" %>
    <%= submit_tag(photo_doc ? "Continue" : "Upload & continue", class: "btn btn-primary px-4",
          id: "photo-submit", disabled: photo_doc.nil?) %>
  </div>
<% end %>

<script>
  (function () {
    var galleryInput = document.getElementById("photo-input-gallery");
    var finalInput   = document.getElementById("photo-input-final");
    var previewWrap  = document.getElementById("photo-preview-wrap");
    var preview      = document.getElementById("photo-preview");
    var placeholder  = document.getElementById("photo-placeholder");
    var filename     = document.getElementById("photo-filename");
    var submitBtn    = document.getElementById("photo-submit");

    var overlay      = document.getElementById("camera-overlay");
    var video        = document.getElementById("camera-video");
    var canvas       = document.getElementById("camera-canvas");
    var cameraError  = document.getElementById("camera-error");
    var stream       = null;

    document.getElementById("btn-choose-photo").addEventListener("click", function () { galleryInput.click(); });
    document.getElementById("btn-take-photo").addEventListener("click", openCamera);
    document.getElementById("camera-cancel").addEventListener("click", closeCamera);
    document.getElementById("camera-capture").addEventListener("click", capturePhoto);

    function useFile(file) {
      if (!file) return;

      var dt = new DataTransfer();
      dt.items.add(file);
      finalInput.files = dt.files;

      var reader = new FileReader();
      reader.onload = function (e) { preview.src = e.target.result; };
      reader.readAsDataURL(file);

      previewWrap.classList.remove("d-none");
      placeholder.classList.add("d-none");
      filename.textContent = file.name;
      submitBtn.disabled = false;
      document.getElementById("photo-upload-box").classList.add("filled");
    }

    galleryInput.addEventListener("change", function () { useFile(this.files[0]); });

    function openCamera() {
      cameraError.classList.add("d-none");

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        // Very old browser / non-secure context - fall back to the plain file picker.
        galleryInput.click();
        return;
      }

      overlay.classList.remove("d-none");
      navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false })
        .then(function (s) {
          stream = s;
          video.srcObject = stream;
        })
        .catch(function (err) {
          cameraError.textContent = "Couldn't access the camera (" + err.message + "). " +
            "Check your browser's camera permission for this site, or use \"Choose from device\" instead.";
          cameraError.classList.remove("d-none");
        });
    }

    function closeCamera() {
      if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; }
      video.srcObject = null;
      overlay.classList.add("d-none");
    }

    function capturePhoto() {
      if (!video.videoWidth) return;

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);

      canvas.toBlob(function (blob) {
        if (!blob) return;
        useFile(new File([blob], "selfie-" + Date.now() + ".jpg", { type: "image/jpeg" }));
        closeCamera();
      }, "image/jpeg", 0.92);
    }
  })();
</script>

</style>

<div class="dashboard-container">
  <!-- Filters and Search - Moved to top with no padding -->
  <div class="card shadow-sm mb-4" style="margin-top: 0 !important;">
    <div class="card-body">
      <%= form_with url: dashboard_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end" do |form| %>
        <!-- Year Filter -->
        <div>
          <%= form.select :year,
                         options_for_select([
                           ['2024', '2024'],
                           ['2025', '2025'],
                           ['2026', '2026'],
                           ["#{Date.current.year} (Current)", Date.current.year.to_s],
                           ['2027', '2027'],
                           ['2028', '2028']
                         ], (@filter_year || Date.current.year).to_s),
                         {},
                         { class: "form-select", id: "year_filter" } %>
        </div>

        <!-- Month Filter -->
        <div>
          <%= form.select :month,
                         options_for_select([
                           ['All Year', ''],
                           ['January', '1'],
                           ['February', '2'],
                           ['March', '3'],
                           ['April', '4'],
                           ['May', '5'],
                           ['June', '6'],
                           ['July', '7'],
                           ['August', '8'],
                           ['September', '9'],
                           ['October', '10'],
                           ['November', '11'],
                           ['December', '12']
                         ], @filter_month.to_s),
                         {},
                         { class: "form-select", id: "month_filter" } %>
        </div>

        <!-- Custom Date Range -->
        <div class="d-flex gap-2">
          <%= form.date_field :start_date,
                             value: @filter_start_date&.strftime('%Y-%m-%d'),
                             class: "form-control",
                             id: "start_date_field",
                             placeholder: "Start Date",
                             min: "1900-01-01",
                             max: "2099-12-31" %>
          <%= form.date_field :end_date,
                             value: @filter_end_date&.strftime('%Y-%m-%d'),
                             class: "form-control",
                             id: "end_date_field",
                             placeholder: "End Date",
                             min: "1900-01-01",
                             max: "2099-12-31" %>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
          <%= form.submit "Apply Filter", class: "btn btn-primary" %>
          <button type="button" id="clear_filters_btn" class="btn btn-outline-secondary">Clear</button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Core KPI Cards -->
  <div class="row mb-4">
    <!-- Total Customers -->
    <div class="col-xl-3 col-md-6 mb-3">
      <%= link_to admin_customers_path, class: "text-decoration-none" do %>
        <div class="card h-100 border-0 shadow-sm card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <div>
                <h6 class="text-muted mb-2">Total Customers</h6>
                <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_customers) %></h3>
              </div>
              <div class="bg-primary bg-opacity-10 rounded p-3">
                <i class="bi bi-people text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Total Policies -->
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Active Policies</h6>
              <h3 class="mb-0 text-success"><%= number_with_delimiter(@total_policies) %></h3>
            </div>
            <div class="bg-success bg-opacity-10 rounded p-3">
              <i class="bi bi-file-earmark-text text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Premium -->
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Total Premium</h6>
              <h3 class="mb-0 text-warning"><%= indian_currency(@total_premium_collected || 0) %></h3>
            </div>
            <div class="bg-warning bg-opacity-10 rounded p-3">
              <i class="bi bi-currency-rupee text-warning fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Leads -->
    <div class="col-xl-3 col-md-6 mb-3">
      <%= link_to admin_leads_path, class: "text-decoration-none" do %>
        <div class="card h-100 border-0 shadow-sm card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <div>
                <h6 class="text-muted mb-2">Active Leads</h6>
                <h3 class="mb-0 text-info"><%= number_with_delimiter(@pending_leads) %></h3>
              </div>
              <div class="bg-info bg-opacity-10 rounded p-3">
                <i class="bi bi-funnel text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Actions Grid -->
  <div class="row mb-4">
    <!-- Renewal Alerts -->
    <div class="col-xl-3 col-lg-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title d-flex align-items-center mb-3">
            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
            Renewal Alerts
          </h5>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <a href="javascript:void(0)" onclick="showRenewalModal('expiring')" class="text-decoration-none text-muted">
              Expiring in 45 days
            </a>
            <span class="badge bg-warning text-dark" style="cursor: pointer;" onclick="showRenewalModal('expiring')">
              <%= renewal_counts[:expiring] %>
            </span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <a href="javascript:void(0)" onclick="showRenewalModal('expired')" class="text-decoration-none text-muted">
              Recently expired
            </a>
            <span class="badge bg-danger" style="cursor: pointer;" onclick="showRenewalModal('expired')">
              <%= renewal_counts[:expired] %>
            </span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <a href="javascript:void(0)" onclick="showRenewalModal('processed')" class="text-decoration-none text-muted">
              Processed this month
            </a>
            <span class="badge bg-success" style="cursor: pointer;" onclick="showRenewalModal('processed')">
              <%= renewal_counts[:processed] %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Policy Alerts -->
    <div class="col-xl-3 col-lg-6 mb-3">

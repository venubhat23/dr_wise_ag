<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Manage Broker</h2>
    <p class="text-muted mb-0">Manage and track all brokers and their codes</p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBrokerModal">
      <i class="bi bi-plus-lg me-1"></i>
      Add Broker
    </button>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Brokers</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@brokers.count) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-briefcase text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Brokers</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@brokers.active.count) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-check-circle text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Inactive Brokers</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@brokers.inactive.count) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-x-circle text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Broker Modal -->
<div class="modal fade" id="addBrokerModal" tabindex="-1" aria-labelledby="addBrokerModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="addBrokerModalLabel">
          <i class="bi bi-building me-2"></i>
          Add Broker
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with model: [:admin, @broker], local: true, class: "needs-validation", novalidate: true do |form| %>
        <div class="modal-body">
          <div class="mb-3">
            <%= form.label :name, "Broker Name*", class: "form-label fw-medium" %>
            <%= form.text_field :name, class: "form-control", placeholder: "Enter broker name", required: true %>
            <div class="invalid-feedback">
              Please provide a broker name.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= form.submit "Save Broker", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Broker List Card -->
<div class="card shadow-sm">
  <div class="card-header bg-light">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Broker Name List</h5>
      <div class="search-container" style="max-width: 300px;">
        <%= form_with url: admin_brokers_path, method: :get, local: true, class: "d-flex" do |form| %>
          <div class="input-group">
            <%= form.text_field :search, placeholder: "Search by broker name",
                               value: params[:search],
                               class: "form-control form-control-sm" %>
            <button class="btn btn-outline-secondary btn-sm" type="submit">
              <i class="bi bi-search"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <% if @brokers.present? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="px-4 py-3">BROKER NAME</th>
              <th class="px-4 py-3">STATUS</th>
              <th class="px-4 py-3 text-center">ACTION</th>
            </tr>
          </thead>
          <tbody>
            <% @brokers.each do |broker| %>
              <tr>
                <td class="px-4 py-3">
                  <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                      <i class="bi bi-briefcase text-primary"></i>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= broker.name %></h6>
                      <small class="text-muted">Added <%= broker.created_at.strftime("%b %d, %Y") %></small>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <% if broker.active? %>
                    <span class="badge bg-success-subtle text-success">
                      <i class="bi bi-check-circle me-1"></i>
                      Active
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning">
                      <i class="bi bi-x-circle me-1"></i>
                      Inactive
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center">
                  <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#editBrokerModal<%= broker.id %>">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <%= link_to admin_broker_path(broker),
                               method: :delete,
                               class: "btn btn-outline-danger btn-sm",
                               confirm: "Are you sure you want to delete #{broker.name}?" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>

              <!-- Edit Modal for this broker -->
              <div class="modal fade" id="editBrokerModal<%= broker.id %>" tabindex="-1" aria-labelledby="editBrokerModalLabel<%= broker.id %>" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                      <h5 class="modal-title" id="editBrokerModalLabel<%= broker.id %>">
                        <i class="bi bi-pencil me-2"></i>
                        Edit Broker
                      </h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <%= form_with model: [:admin, broker], local: true, class: "needs-validation", novalidate: true do |form| %>
                      <div class="modal-body">
                        <div class="mb-3">
                          <%= form.label :name, "Broker Name*", class: "form-label fw-medium" %>
                          <%= form.text_field :name, class: "form-control", placeholder: "Enter broker name", required: true %>
                          <div class="invalid-feedback">
                            Please provide a broker name.
                          </div>
                        </div>
                        <div class="mb-3">
                          <%= form.label :status, "Status", class: "form-label fw-medium" %>
                          <%= form.select :status,
                                         options_for_select([['Active', 'active'], ['Inactive', 'inactive']], broker.status),
                                         {},
                                         { class: "form-select" } %>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <%= form.submit "Update Broker", class: "btn btn-primary" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-briefcase display-1 text-muted"></i>
        </div>
        <h4 class="text-muted">No brokers found</h4>
        <p class="text-muted">
          <% if params[:search].present? %>
            No brokers match your search criteria.
          <% else %>
            Start by adding your first broker.
          <% end %>
        </p>
        <% if params[:search].present? %>
          <%= link_to "Clear search", admin_brokers_path, class: "btn btn-outline-primary" %>
        <% else %>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBrokerModal">
            <i class="bi bi-plus-lg me-1"></i>
            Add Your First Broker
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>
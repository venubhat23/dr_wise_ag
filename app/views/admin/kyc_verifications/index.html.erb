<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Affiliate KYC Verification</h2>
    <p class="text-muted mb-0">Review and approve affiliate KYC submissions</p>
  </div>
  <% if @pending_count > 0 %>
    <span class="badge bg-warning fs-6">
      <%= @pending_count %> awaiting review
    </span>
  <% end %>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-tabs mb-4">
  <% tabs = [
       ['just_registered', 'Just Registered'],
       ['submitted', 'Awaiting Review'],
       ['approved', 'Approved'],
       ['rejected', 'Rejected']
     ] %>
  <% tabs.each do |status, label| %>
    <li class="nav-item">
      <%= link_to admin_kyc_verifications_path(status: status),
                  class: "nav-link #{'active' if @kyc_status_filter == status}" do %>
        <%= label %>
        <% if status == 'just_registered' && @just_registered_count > 0 %>
          <span class="badge bg-secondary ms-1"><%= @just_registered_count %></span>
        <% elsif status == 'submitted' && @pending_count > 0 %>
          <span class="badge bg-warning text-dark ms-1"><%= @pending_count %></span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= render 'admin/shared/kyc_search', path: admin_kyc_verifications_path, status: @kyc_status_filter,
           noun: 'affiliates', q: @q, total: @sub_agents.size %>

<% bulk_enabled = @kyc_status_filter == 'submitted' %>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @sub_agents.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <% if bulk_enabled %>
                <th style="width: 40px;">
                  <input type="checkbox" class="form-check-input" id="kyc_select_all" title="Select all">
                </th>
              <% end %>
              <% unless @kyc_status_filter == 'just_registered' %>
                <th>Affiliate</th>
              <% end %>
              <th>Contact</th>
              <% unless @kyc_status_filter == 'just_registered' %>
                <th>Documents</th>
              <% end %>
              <th>Referred By</th>
              <th><%= @kyc_status_filter == 'just_registered' ? 'Registered' : 'Submitted' %></th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @sub_agents.each do |sub_agent| %>
              <tr>
                <% if bulk_enabled %>
                  <td>
                    <input type="checkbox" class="form-check-input kyc-row-check" name="ids[]"
                           value="<%= sub_agent.id %>" form="kyc_bulk_form"
                           data-unmapped="<%= sub_agent.ambassador_id.nil? ? '1' : '0' %>">
                  </td>
                <% end %>
                <% unless @kyc_status_filter == 'just_registered' %>
                  <td><%= sub_agent.display_name %></td>
                <% end %>
                <td>
                  <div><i class="bi bi-envelope text-muted me-1"></i><%= sub_agent.email %></div>
                  <div><i class="bi bi-telephone text-muted me-1"></i><%= sub_agent.mobile %></div>
                  <div class="small text-muted"><i class="bi bi-key me-1"></i><code><%= sub_agent.original_password.presence || "—" %></code></div>
                </td>
                <% unless @kyc_status_filter == 'just_registered' %>
                  <td>
                    <%# Latest upload per slot; docs are preloaded in the controller. %>
                    <% kyc_doc_slots = [
                         ['Aadhaar', ['Aadhaar Card'], 'bi-person-vcard'],
                         ['PAN', ['Pancard'], 'bi-credit-card-2-front'],
                         ['Photo', ['Profile Image'], 'bi-person-circle'],
                         ['Bank', ['Bank Statement', 'Bank Passbook'], 'bi-bank']
                       ] %>
                    <div class="d-flex flex-wrap gap-1">
                      <% kyc_doc_slots.each do |label, types, icon| %>
                        <% doc = sub_agent.sub_agent_documents.select { |d| types.include?(d.document_type) && d.has_file? }.max_by(&:created_at) %>
                        <% if doc %>
                          <%= link_to doc.document_url, target: '_blank', rel: 'noopener',
                                      class: "badge text-bg-success text-decoration-none",
                                      title: "View #{doc.document_type}" do %>
                            <i class="bi <%= icon %> me-1"></i><%= label %>
                          <% end %>
                        <% else %>
                          <span class="badge text-bg-light text-muted border" title="<%= label %> not uploaded">
                            <i class="bi <%= icon %> me-1"></i><%= label %>
                          </span>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                <% end %>
                <td>
                  <% if sub_agent.referred_by_code.present? %>
                    <span class="badge bg-info text-dark"><%= sub_agent.referred_by_code %></span>
                    <div class="small text-muted">
                      <%= sub_agent.referred_by_kind&.capitalize %> referral
                      <% if (ambassador = @ambassadors_by_id[sub_agent.ambassador_id]).present? %>
                        &middot; <%= link_to ambassador.display_name, admin_distributor_path(ambassador) %>
                      <% end %>
                    </div>
                  <% elsif (ambassador = @ambassadors_by_id[sub_agent.ambassador_id]).present? %>
                    <%= link_to ambassador.display_name, admin_distributor_path(ambassador) %>
                    <div class="small text-muted">Connected by admin</div>
                  <% else %>
                    <span class="text-muted">Direct signup</span>
                  <% end %>
                </td>
                <td>
                  <% ts = @kyc_status_filter == 'just_registered' ? sub_agent.created_at : sub_agent.kyc_submitted_at %>
                  <%= ts&.strftime('%d %b %Y, %I:%M %p') || '—' %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-2">
                    <%= link_to documents_admin_sub_agent_path(sub_agent), class: "btn btn-sm btn-outline-primary",
                                data: { bs_toggle: "tooltip" }, title: "View Documents" do %>
                      <i class="bi bi-file-earmark-text"></i>
                    <% end %>
                    <% if sub_agent.kyc_submitted? && sub_agent.ambassador_id.nil? %>
                      <%# Not mapped to any Ambassador: ask which one to connect before approving. %>
                      <button type="button" class="btn btn-sm btn-success js-approve-unmapped"
                              title="Approve" data-bs-toggle="tooltip"
                              data-url="<%= approve_kyc_admin_sub_agent_path(sub_agent) %>"
                              data-name="<%= sub_agent.display_name %>">
                        <i class="bi bi-check-lg"></i>
                      </button>
                    <% elsif sub_agent.kyc_submitted? %>
                      <%= button_to approve_kyc_admin_sub_agent_path(sub_agent),
                                    method: :patch, class: "btn btn-sm btn-success",
                                    data: { bs_toggle: "tooltip" }, title: "Approve",
                                    form: { data: { turbo_confirm: "Approve #{sub_agent.display_name}'s KYC and activate their account?" } } do %>
                        <i class="bi bi-check-lg"></i>
                      <% end %>
                    <% end %>
                    <% if sub_agent.kyc_submitted? %>
                      <button type="button" class="btn btn-sm btn-danger js-reject-kyc"
                              title="Reject" data-bs-toggle="tooltip"
                              data-url="<%= reject_kyc_admin_sub_agent_path(sub_agent) %>"
                              data-name="<%= sub_agent.display_name %>">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-patch-check fs-1 text-muted"></i>
        <h6 class="text-muted mt-3">
          <%= @q.present? ? "No affiliates match “#{@q}” in this status" : "No affiliates in this status" %>
        </h6>
      </div>
    <% end %>
  </div>
</div>

<% if bulk_enabled && @sub_agents.any? %>
  <%= render 'admin/shared/kyc_bulk_bar', url: bulk_action_admin_kyc_verifications_path,
             status: @kyc_status_filter, q: @q, noun: 'affiliate',
             default_reason: KycQueueTools::DEFAULT_REJECTION_REASON %>
<% end %>

<%= render 'admin/shared/kyc_ambassador_modal', options: @ambassador_options %>

<%# Reject one affiliate's KYC with a reason (shown to them). %>
<%= form_with url: "#", method: :patch, local: true, id: "kyc_reject_form" do %>
  <div class="modal fade" id="kyc_reject_one_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title"><i class="bi bi-x-octagon text-danger me-2"></i>Reject KYC - <span id="kyc_reject_one_name"></span></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label for="kyc_reject_one_reason" class="form-label">Reason <span class="text-muted small">(shown to the affiliate)</span></label>
          <%= text_area_tag :reason, KycQueueTools::DEFAULT_REJECTION_REASON, id: "kyc_reject_one_reason", class: "form-control", rows: 3, required: true %>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Reject KYC</button>
        </div>
      </div>
    </div>
  </div>
<% end %>
<script>
(function () {
  var form = document.getElementById('kyc_reject_form');
  var modalEl = document.getElementById('kyc_reject_one_modal');
  document.querySelectorAll('.js-reject-kyc').forEach(function (btn) {
    btn.addEventListener('click', function () {
      form.action = btn.dataset.url;
      document.getElementById('kyc_reject_one_name').textContent = btn.dataset.name || 'affiliate';
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    });
  });
})();
</script>

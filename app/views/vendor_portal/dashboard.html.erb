<h2 class="mb-4">Welcome, <%= @vendor_display_name %></h2>

<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Leads Received</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@leads_received) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-inbox text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Business Converted</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@leads_converted) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-check-circle text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">DrWise Commission Pending</h6>
            <h3 class="mb-0 text-warning"><%= indian_currency(@pending_amount) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-hourglass-split text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">DrWise Commission Paid</h6>
            <h3 class="mb-0 text-info"><%= indian_currency(@paid_amount) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-cash-coin text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">Recent Activity</h5>
  </div>
  <div class="card-body p-0">
    <% if @recent_activity.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Name</th>
              <th class="border-0">Product</th>
              <th class="border-0">Stage</th>
              <th class="border-0">Received</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_activity.each do |row| %>
              <tr>
                <td><%= row[:name] %></td>
                <td><%= row[:product] %></td>
                <td><span class="badge <%= row[:badge_class] %>"><%= row[:stage] %></span></td>
                <td><%= row[:date].strftime('%d %b %Y') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h5 class="mt-3 mb-0">No leads yet</h5>
        <p class="text-muted">Leads and services DrWise assigns to you will show up here.</p>
      </div>
    <% end %>
  </div>
</div>

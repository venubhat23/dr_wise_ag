  // Document deletion functionality
  document.querySelectorAll('.delete-document').forEach(button => {
    button.addEventListener('click', function() {
      const documentId = this.getAttribute('data-document-id');
      const documentName = this.getAttribute('data-document-name');
      const documentType = this.getAttribute('data-document-type');

      // Show confirmation dialog
      if (confirm(`Are you sure you want to delete "${documentName}"? This action cannot be undone.`)) {
        // Disable the button to prevent double-clicks
        this.disabled = true;
        this.innerHTML = '<i class="bi bi-hourglass-split"></i>';

        // Send delete request
        fetch(`/admin/motor_insurances/${window.location.pathname.split('/')[4]}/delete_document`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
          },
          body: JSON.stringify({
            document_id: documentId,
            document_type: documentType
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Remove the document row with animation
            const documentRow = this.closest('[data-document-id]');
            documentRow.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            documentRow.style.opacity = '0';
            documentRow.style.transform = 'translateX(-20px)';

            setTimeout(() => {
              documentRow.remove();

              // Check if there are no more documents and update display
              updateDocumentDisplay();
            }, 300);

            // Show success message
            showDocumentMessage('Document deleted successfully', 'success');
          } else {
            // Re-enable button on error
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-trash"></i>';
            showDocumentMessage('Failed to delete document: ' + (data.error || 'Unknown error'), 'danger');
          }
        })
        .catch(error => {
          console.error('Error deleting document:', error);
          // Re-enable button on error
          this.disabled = false;
          this.innerHTML = '<i class="bi bi-trash"></i>';
          showDocumentMessage('Failed to delete document. Please try again.', 'danger');
        });
      }
    });
  });

  function updateDocumentDisplay() {
    const policyDocsCard = document.querySelector('.card.border-success');
    const generalDocsCard = document.querySelector('.card.border-info');
    const existingDocsSection = document.querySelector('.row.mb-4');

    // Check if any documents remain
    const hasPolicyDocs = policyDocsCard && policyDocsCard.querySelectorAll('[data-document-id]').length > 0;
    const hasGeneralDocs = generalDocsCard && generalDocsCard.querySelectorAll('[data-document-id]').length > 0;

    if (!hasPolicyDocs && !hasGeneralDocs && existingDocsSection) {
      // Show "no documents" message
      existingDocsSection.innerHTML = `
        <div class="col-12">
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No documents have been uploaded for this policy yet.
          </div>
        </div>
      `;
    }
  }

  function showDocumentMessage(message, type) {
    // Create and show temporary message
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alertDiv.innerHTML = `
      <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;

    document.body.appendChild(alertDiv);

    // Auto dismiss after 3 seconds
    setTimeout(() => {
      if (alertDiv.parentNode) {
        alertDiv.remove();
      }
    }, 3000);
  }

  // Initialize form for edit mode
  <% if @motor_insurance.persisted? %>
    console.log('🔧 Initializing edit form...');

    // Store the existing values for later selection
    const existingAgencyCodeId = '<%= @motor_insurance.agency_code_id %>';
    const existingBrokerId = '<%= @motor_insurance.broker_id %>';
    const brokerCodeType = '<%= @motor_insurance.broker_code_type %>';

    console.log('Existing values:', {
      agencyCodeId: existingAgencyCodeId,
      brokerId: existingBrokerId,
      brokerCodeType: brokerCodeType
    });

    // Store policy holder value before triggering customer change
    const existingPolicyHolder = '<%= @selected_policy_holder || @motor_insurance.policy_holder %>';
    console.log('Existing policy holder:', existingPolicyHolder);

    // Trigger customer change to load affiliate options
    const customerSelect = document.getElementById('customer_select');
    if (customerSelect && customerSelect.value) {
      $(customerSelect).trigger('change');
      console.log('Triggered customer change for edit form');

      // Set timeout to restore policy holder after customer change completes
      // Use a retry mechanism to ensure the policy holder is set correctly
      let retryCount = 0;
      const maxRetries = 5;
      const retryInterval = setInterval(function() {
        retryCount++;
        const policyHolderSelect = document.getElementById('policy_holder_select');

        if (policyHolderSelect && existingPolicyHolder) {
          // Check if the options are loaded (more than just the loading option)
          const options = Array.from(policyHolderSelect.options);
          const isLoaded = options.length > 1 || (options.length === 1 && !options[0].text.includes('Loading'));

          if (isLoaded) {
            // Check if the policy holder option exists
            const optionExists = options.some(opt => opt.value === existingPolicyHolder);
            if (optionExists) {
              $(policyHolderSelect).val(existingPolicyHolder).trigger('change');
              console.log('✅ Restored policy holder:', existingPolicyHolder);
              clearInterval(retryInterval);
            } else if (retryCount >= maxRetries) {
              console.log('❌ Policy holder option not found after', maxRetries, 'retries:', existingPolicyHolder);
              console.log('Available options:', options.map(opt => opt.value));
              clearInterval(retryInterval);
            }
          } else if (retryCount >= maxRetries) {
            console.log('❌ Policy holder dropdown not loaded after', maxRetries, 'retries');
            clearInterval(retryInterval);
          }
        } else if (retryCount >= maxRetries) {
          console.log('❌ Policy holder select element not found');
          clearInterval(retryInterval);
        }
      }, 500); // Check every 500ms
    }

    // Listen for dropdown populated event to select existing values
    $('#motor_insurance_agency_code_id').on('dropdown:populated', function() {
      console.log('Agency dropdown populated, selecting existing value...');
      const agencySelect = this;

      // For direct mode, select the agency_code_id
      if (brokerCodeType === 'direct' && existingAgencyCodeId) {
        // Check if the option exists
        const optionExists = Array.from(agencySelect.options).some(opt => opt.value === existingAgencyCodeId);
        if (optionExists) {
          $(agencySelect).val(existingAgencyCodeId).trigger('change');
          console.log('✅ Selected existing agency code:', existingAgencyCodeId);
        } else {
          console.log('❌ Agency code option not found:', existingAgencyCodeId);
        }
      }
      // For broking mode, select the broker (which is stored as broker_X format)
      else if (brokerCodeType === 'broking' && existingBrokerId) {
        const brokerValue = 'broker_' + existingBrokerId;
        // Check if the option exists
        const optionExists = Array.from(agencySelect.options).some(opt => opt.value === brokerValue);
        if (optionExists) {
          $(agencySelect).val(brokerValue).trigger('change');
          console.log('✅ Selected existing broker:', brokerValue);
        } else {
          console.log('❌ Broker option not found:', brokerValue);
        }
      }
    });

    // Trigger broker code type change to load agency codes
    const brokerCodeSelect = document.getElementById('motor_insurance_broker_code_type');
    if (brokerCodeSelect && brokerCodeSelect.value) {
      setTimeout(function() {
        $(brokerCodeSelect).trigger('change');
        console.log('Triggered broker code type change for edit form');
        // The agency code will be selected automatically via the dropdown:populated event
      }, 500); // Small delay to allow customer change to complete first
    }
  <% end %>

  // Initialize date pickers with proper constraints
  function initializeDatePickers() {
    const dateFields = [
      'policy_booking_date',
      'policy_start_date',
      'policy_end_date',
      'autopay_start_date',
      'autopay_end_date'
    ];

    dateFields.forEach(fieldId => {
      const field = document.getElementById(fieldId) || document.querySelector(`[name*="${fieldId}"]`);
      if (field) {
        // Ensure proper min/max attributes are set
        field.setAttribute('min', '1900-01-01');
        field.setAttribute('max', '2099-12-31');

        // Fix any existing invalid values
        if (field.value && (field.value.includes('275760') || field.value.length > 10)) {
          field.value = new Date().toISOString().split('T')[0];
        }

        // Add event listener to prevent manual entry of invalid dates
        field.addEventListener('input', function() {
          const value = this.value;
          if (value && value.length > 10) {
            this.value = value.substring(0, 10);
          }
        });

        console.log(`✅ Initialized date picker for ${fieldId}`);
      }
    });
  }

  // Call date picker initialization
  initializeDatePickers();

  // Nominee Management Functions
  let nomineeIndex = <%= @motor_insurance.motor_insurance_nominees.length %>;

  // Auto-load nominees when customer is selected
  $('#customer_select').on('change', function() {
    const customerId = this.value;
    if (customerId) {
      loadCustomerNominees(customerId);
    } else {
      clearNominees();
    }
  });

  // Function to load customer nominees via AJAX
  function loadCustomerNominees(customerId) {
    $.ajax({
      url: '<%= load_customer_nominees_admin_motor_insurances_path %>',
      method: 'GET',
      data: { customer_id: customerId },
      success: function(data) {
        clearNominees();
        if (data && data.length > 0) {
          data.forEach(function(member) {
            addNomineeFromFamilyMember(member);
          });
          toggleNoNomineesMessage();
        }
      },
      error: function(xhr, status, error) {
        console.error('Error loading customer nominees:', error);
      }
    });
  }

  // Function to add nominee from family member data
  function addNomineeFromFamilyMember(member) {
    const nomineeHtml = `
      <div class="nominee-row border rounded p-3 mb-3" style="background-color: #f8f9fa;">
        <input type="hidden" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][id]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}_id">
        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label">Nominee Name <span class="text-danger">*</span></label>
            <input class="form-control" placeholder="Enter nominee name" required="required" type="text" value="${member.full_name}" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][nominee_name]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}_nominee_name">
          </div>
          <div class="col-md-3 mb-3">
            <label class="form-label">Relationship <span class="text-danger">*</span></label>
            <select class="form-control" required="required" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][relationship]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}_relationship">
              <option value="">Select Relationship</option>
              <option value="Spouse" ${member.relationship === 'Spouse' ? 'selected' : ''}>Spouse</option>
              <option value="Son" ${member.relationship === 'Son' ? 'selected' : ''}>Son</option>
              <option value="Daughter" ${member.relationship === 'Daughter' ? 'selected' : ''}>Daughter</option>
              <option value="Father" ${member.relationship === 'Father' ? 'selected' : ''}>Father</option>
              <option value="Mother" ${member.relationship === 'Mother' ? 'selected' : ''}>Mother</option>
              <option value="Brother" ${member.relationship === 'Brother' ? 'selected' : ''}>Brother</option>
              <option value="Sister" ${member.relationship === 'Sister' ? 'selected' : ''}>Sister</option>
              <option value="Other" ${member.relationship === 'Other' ? 'selected' : ''}>Other</option>
            </select>
          </div>
          <div class="col-md-2 mb-3">
            <label class="form-label">Age <span class="text-danger">*</span></label>
            <input class="form-control" placeholder="Age" required="required" min="0" max="120" type="number" value="${member.age || ''}" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][age]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}_age">
          </div>
          <div class="col-md-2 mb-3">
            <label class="form-label">Share (%)</label>
            <input class="form-control" placeholder="100" min="0" max="100" step="0.01" type="number" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][share_percentage]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}_share_percentage">
          </div>
          <div class="col-md-1 mb-3 d-flex align-items-end">
            <button type="button" class="btn btn-danger btn-sm" onclick="removeNominee(this)" title="Remove nominee">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
        <input value="false" class="destroy-flag" type="hidden" name="motor_insurance[motor_insurance_nominees_attributes][${nomineeIndex}][_destroy]" id="motor_insurance_motor_insurance_nominees_attributes_${nomineeIndex}__destroy">
      </div>
    `;

    $('#nominees-container').append(nomineeHtml);
    nomineeIndex++;
  }

  // Function to clear all nominees
  function clearNominees() {
    $('.nominee-row').remove();
    toggleNoNomineesMessage();
  }

  // Function to toggle no nominees message
  function toggleNoNomineesMessage() {
    const nomineeRows = document.querySelectorAll('.nominee-row');
    const noNomineesMsg = document.getElementById('no_nominees_message');
    if (nomineeRows.length === 0 || Array.from(nomineeRows).every(row => row.style.display === 'none')) {
      noNomineesMsg.style.display = 'block';
    } else {
      noNomineesMsg.style.display = 'none';
    }
  }

  // Initial call to set correct message state
  toggleNoNomineesMessage();
});

// Global nominee management functions (outside jQuery)
function addNewNominee() {
  const index = document.querySelectorAll('.nominee-row').length;

  const nomineeHtml = `
    <div class="nominee-row border rounded p-3 mb-3" style="background-color: #f8f9fa;">
      <input type="hidden" name="motor_insurance[motor_insurance_nominees_attributes][${index}][id]" id="motor_insurance_motor_insurance_nominees_attributes_${index}_id">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Nominee Name <span class="text-danger">*</span></label>
          <input class="form-control" placeholder="Enter nominee name" required="required" type="text" name="motor_insurance[motor_insurance_nominees_attributes][${index}][nominee_name]" id="motor_insurance_motor_insurance_nominees_attributes_${index}_nominee_name">
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Relationship <span class="text-danger">*</span></label>
          <select class="form-control" required="required" name="motor_insurance[motor_insurance_nominees_attributes][${index}][relationship]" id="motor_insurance_motor_insurance_nominees_attributes_${index}_relationship">
            <option value="">Select Relationship</option>
            <option value="Spouse">Spouse</option>
            <option value="Son">Son</option>
            <option value="Daughter">Daughter</option>
            <option value="Father">Father</option>
            <option value="Mother">Mother</option>
            <option value="Brother">Brother</option>
            <option value="Sister">Sister</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="col-md-2 mb-3">
          <label class="form-label">Age <span class="text-danger">*</span></label>
          <input class="form-control" placeholder="Age" required="required" min="0" max="120" type="number" name="motor_insurance[motor_insurance_nominees_attributes][${index}][age]" id="motor_insurance_motor_insurance_nominees_attributes_${index}_age">
        </div>
        <div class="col-md-2 mb-3">
          <label class="form-label">Share (%)</label>
          <input class="form-control" placeholder="100" min="0" max="100" step="0.01" type="number" name="motor_insurance[motor_insurance_nominees_attributes][${index}][share_percentage]" id="motor_insurance_motor_insurance_nominees_attributes_${index}_share_percentage">
        </div>
        <div class="col-md-1 mb-3 d-flex align-items-end">
          <button type="button" class="btn btn-danger btn-sm" onclick="removeNominee(this)" title="Remove nominee">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </div>
      <input value="false" class="destroy-flag" type="hidden" name="motor_insurance[motor_insurance_nominees_attributes][${index}][_destroy]" id="motor_insurance_motor_insurance_nominees_attributes_${index}__destroy">
    </div>
  `;

  document.getElementById('nominees-container').insertAdjacentHTML('beforeend', nomineeHtml);
  toggleNoNomineesMessage();
}

function removeNominee(button) {
  const nomineeRow = button.closest('.nominee-row');
  const destroyField = nomineeRow.querySelector('.destroy-flag');

  if (destroyField.value === 'false') {
    destroyField.value = 'true';
    nomineeRow.style.display = 'none';
  } else {
    nomineeRow.remove();
  }

  toggleNoNomineesMessage();
}

function toggleNoNomineesMessage() {
  const nomineeRows = document.querySelectorAll('.nominee-row');
  const noNomineesMsg = document.getElementById('no_nominees_message');

  const visibleRows = Array.from(nomineeRows).filter(row => row.style.display !== 'none');

  if (visibleRows.length === 0) {
    noNomineesMsg.style.display = 'block';
  } else {
    noNomineesMsg.style.display = 'none';
  }
}
</script>


<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Drwise Admin</title>
  <!-- Chart.js for interactive charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.js"></script>
  <!-- Additional Chart.js plugins -->
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  <!-- Chart.js plugin for funnel chart -->
  <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-funnel@4.2.5/dist/chartjs-chart-funnel.min.js"></script>

  <style>
    .dashboard-container {
      padding: 2rem;
      background: linear-gradient(135deg, #f8f9ff 0%, #e9ecef 100%);
      min-height: 100vh;
    }

    .dashboard-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      padding: 2.5rem;
      margin-bottom: 3rem;
      transition: all 0.4s ease;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .dashboard-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
    }

    .stat-card {
      background: white;
      border-radius: 15px;
      padding: 1.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: var(--card-gradient);
      border-radius: 20px 20px 0 0;
    }

    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: #1a202c;
      margin: 0.75rem 0;
      background: var(--text-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-label {
      color: #64748b;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      background: var(--icon-gradient);
      color: white;
      font-size: 1.5rem;
      box-shadow: 0 8px 20px var(--icon-shadow);
    }

    .chart-card {
      background: white;
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      margin-bottom: 3rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.4s ease;
    }

    .chart-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
    }

    .chart-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
    }

    .chart-title::before {
      content: '';
      width: 6px;
      height: 30px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      margin-right: 1rem;
      border-radius: 3px;
    }

    .recent-activity-item {
      display: flex;
      align-items: center;
      padding: 1.5rem;
      border-radius: 15px;
      background: #f8fafc;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
      border: 1px solid rgba(226, 232, 240, 0.5);
    }

    .recent-activity-item:hover {
      background: #e2e8f0;
      transform: translateX(8px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .activity-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 1.5rem;
      background: var(--activity-gradient);
      color: white;
      font-size: 1.2rem;
      box-shadow: 0 5px 15px var(--activity-shadow);
    }

    .welcome-banner {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      color: white;
      border-radius: 25px;
      padding: 4rem;
      margin-bottom: 4rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
    }

    .welcome-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 20"><defs><radialGradient id="a" cx="50%" cy="40%" r="50%"><stop offset="0%" stop-color="white" stop-opacity="0.15"/><stop offset="100%" stop-color="white" stop-opacity="0"/></radialGradient></defs><circle cx="15" cy="8" r="12" fill="url(%23a)"/><circle cx="85" cy="12" r="8" fill="url(%23a)"/><circle cx="60" cy="5" r="6" fill="url(%23a)"/></svg>');
      opacity: 0.4;
    }

    .welcome-content {
      position: relative;
      z-index: 1;
    }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }

    @media (max-width: 1400px) {
      .grid-4 { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 1200px) {
      .grid-4, .grid-3 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
      .dashboard-container { padding: 1rem; }
      .welcome-banner { padding: 2rem; }
    }

    .pulse {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.05); }
    }

    .floating {
      animation: floating 3s ease-in-out infinite;
    }

    @keyframes floating {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    /* Custom gradient variables */
    :root {
      --gradient-blue: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --gradient-green: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
      --gradient-red: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
      --gradient-yellow: linear-gradient(135deg, #ffc107 0%, #ff8f00 100%);
      --gradient-purple: linear-gradient(135deg, #8360c3 0%, #2ebf91 100%);
      --gradient-orange: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
      --gradient-cyan: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
      --gradient-pink: linear-gradient(135deg, #fc466b 0%, #3f5efb 100%);
    }

    .metric-card {
      background: white;
      border-radius: 15px;
      padding: 1.5rem;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .metric-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .chart-container {
      position: relative;
      height: 400px;
    }

    .chart-container.small {
      height: 300px;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 2rem;
      text-align: center;
    }

    .section-subtitle {
      color: #64748b;
      text-align: center;
      margin-bottom: 3rem;
    }
  </style>
</head>

<body>
  <div class="dashboard-container">
    <!-- Stats Cards -->
    <div class="grid-4">
      <!-- Total Customers -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-blue);
                  --icon-gradient: var(--gradient-blue);
                  --icon-shadow: rgba(102, 126, 234, 0.3);
                  --text-gradient: var(--gradient-blue);">
        <div class="stat-icon">
          <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-value pulse">1,247</div>
        <div class="stat-label">Total Customers</div>
      </div>

      <!-- Total Agents -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-green);
                  --icon-gradient: var(--gradient-green);
                  --icon-shadow: rgba(17, 153, 142, 0.3);
                  --text-gradient: var(--gradient-green);">
        <div class="stat-icon">
          <i class="bi bi-person-badge-fill"></i>
        </div>
        <div class="stat-value pulse">89</div>
        <div class="stat-label">Active Agents</div>
      </div>

      <!-- Total Policies -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-red);
                  --icon-gradient: var(--gradient-red);
                  --icon-shadow: rgba(255, 65, 108, 0.3);
                  --text-gradient: var(--gradient-red);">
        <div class="stat-icon">
          <i class="bi bi-file-earmark-text-fill"></i>
        </div>
        <div class="stat-value pulse">3,456</div>
        <div class="stat-label">Total Policies</div>
      </div>

      <!-- Total Premium Collected -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-yellow);
                  --icon-gradient: var(--gradient-yellow);
                  --icon-shadow: rgba(255, 193, 7, 0.3);
                  --text-gradient: var(--gradient-yellow);">
        <div class="stat-icon">
          <i class="bi bi-currency-rupee"></i>
        </div>
        <div class="stat-value pulse">₹24.7M</div>
        <div class="stat-label">Premium Collected</div>
      </div>

      <!-- Total Sum Insured -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-purple);
                  --icon-gradient: var(--gradient-purple);
                  --icon-shadow: rgba(131, 96, 195, 0.3);
                  --text-gradient: var(--gradient-purple);">
        <div class="stat-icon">
          <i class="bi bi-shield-check"></i>
        </div>
        <div class="stat-value pulse">₹567M</div>
        <div class="stat-label">Sum Insured</div>
      </div>

      <!-- Total Leads -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-orange);
                  --icon-gradient: var(--gradient-orange);
                  --icon-shadow: rgba(255, 154, 158, 0.3);
                  --text-gradient: var(--gradient-orange);">
        <div class="stat-icon">
          <i class="bi bi-funnel"></i>
        </div>
        <div class="stat-value pulse">856</div>
        <div class="stat-label">Total Leads</div>
      </div>

      <!-- Renewals Due -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-cyan);
                  --icon-gradient: var(--gradient-cyan);
                  --icon-shadow: rgba(0, 198, 255, 0.3);
                  --text-gradient: var(--gradient-cyan);">
        <div class="stat-icon">
          <i class="bi bi-clock-history"></i>
        </div>
        <div class="stat-value pulse">124</div>
        <div class="stat-label">Renewals Due</div>
      </div>

      <!-- Pending Payouts -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-pink);
                  --icon-gradient: var(--gradient-pink);
                  --icon-shadow: rgba(252, 70, 107, 0.3);
                  --text-gradient: var(--gradient-pink);">
        <div class="stat-icon">
          <i class="bi bi-cash-coin"></i>
        </div>
        <div class="stat-value pulse">₹2.3M</div>
        <div class="stat-label">Pending Payouts</div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="grid-2">
      <!-- Policy Type Distribution -->
      <div class="chart-card">
        <h3 class="chart-title">Policy Type Distribution</h3>
        <div class="chart-container small">
          <canvas id="policyDistributionChart"></canvas>
        </div>
      </div>

      <!-- Premium Collection Trend -->
      <div class="chart-card">
        <h3 class="chart-title">Premium Collection Trend (2024)</h3>
        <div class="chart-container small">
          <canvas id="premiumTrendChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Second Row of Charts -->
    <div class="grid-3">
      <!-- Lead Conversion Funnel -->
      <div class="chart-card">
        <h3 class="chart-title">Lead Conversion Funnel</h3>
        <div class="chart-container small">
          <canvas id="leadFunnelChart"></canvas>
        </div>
      </div>

      <!-- Renewal Status Overview -->
      <div class="chart-card">
        <h3 class="chart-title">Renewal Status Overview</h3>
        <div class="chart-container small">
          <canvas id="renewalStatusChart"></canvas>
        </div>
      </div>

      <!-- Referral Settlement Report -->
      <div class="chart-card">
        <h3 class="chart-title">Referral Settlement Status</h3>
        <div class="chart-container small">
          <canvas id="referralChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Third Row - Agent Performance and Commission -->
    <div class="grid-2">
      <!-- Agent Performance -->
      <div class="chart-card">
        <h3 class="chart-title">Top Agent Performance</h3>
        <div class="chart-container">
          <canvas id="agentPerformanceChart"></canvas>
        </div>
      </div>

      <!-- Commission Summary -->
      <div class="chart-card">
        <h3 class="chart-title">Commission Summary</h3>
        <div class="chart-container">
          <canvas id="commissionChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Customer Location Analysis -->
    <div class="chart-card">
      <h3 class="chart-title">Customer Geographic Distribution</h3>
      <div class="chart-container">
        <canvas id="locationChart"></canvas>
      </div>
    </div>

    <!-- Recent Activities -->
    <div class="chart-card">
      <h3 class="chart-title">Recent Activities</h3>
      <div style="max-height: 400px; overflow-y: auto;">
        <!-- Sample activities -->
        <div class="recent-activity-item">
          <div class="activity-icon"
               style="--activity-gradient: var(--gradient-blue);
                      --activity-shadow: rgba(102, 126, 234, 0.3);">
            <i class="bi bi-file-earmark-plus"></i>
          </div>
          <div>
            <div style="font-weight: 600; color: #1a202c;">New Health Policy Created</div>
            <div style="color: #718096; font-size: 0.95rem;">Rajesh Kumar - Family Health Insurance</div>
            <div style="color: #a0aec0; font-size: 0.85rem;">2 hours ago</div>
          </div>
        </div>

        <div class="recent-activity-item">
          <div class="activity-icon"
               style="--activity-gradient: var(--gradient-green);
                      --activity-shadow: rgba(17, 153, 142, 0.3);">
            <i class="bi bi-person-plus-fill"></i>
          </div>
          <div>
            <div style="font-weight: 600; color: #1a202c;">New Customer Registered</div>
            <div style="color: #718096; font-size: 0.95rem;">Priya Sharma - Delhi</div>
            <div style="color: #a0aec0; font-size: 0.85rem;">4 hours ago</div>
          </div>
        </div>

        <div class="recent-activity-item">
          <div class="activity-icon"
               style="--activity-gradient: var(--gradient-orange);
                      --activity-shadow: rgba(255, 154, 158, 0.3);">
            <i class="bi bi-funnel-fill"></i>
          </div>
          <div>
            <div style="font-weight: 600; color: #1a202c;">Lead Converted to Customer</div>
            <div style="color: #718096; font-size: 0.95rem;">Suresh Patel - Motor Insurance Interest</div>
            <div style="color: #a0aec0; font-size: 0.85rem;">6 hours ago</div>
          </div>
        </div>

        <div class="recent-activity-item">
          <div class="activity-icon"
               style="--activity-gradient: var(--gradient-yellow);
                      --activity-shadow: rgba(255, 193, 7, 0.3);">
            <i class="bi bi-cash-coin"></i>
          </div>
          <div>
            <div style="font-weight: 600; color: #1a202c;">Commission Paid</div>
            <div style="color: #718096; font-size: 0.95rem;">Agent: Amit Shah - ₹12,500</div>
            <div style="color: #a0aec0; font-size: 0.85rem;">1 day ago</div>
          </div>
        </div>

        <div class="recent-activity-item">
          <div class="activity-icon"
               style="--activity-gradient: var(--gradient-purple);
                      --activity-shadow: rgba(131, 96, 195, 0.3);">
            <i class="bi bi-arrow-repeat"></i>
          </div>
          <div>
            <div style="font-weight: 600; color: #1a202c;">Policy Renewed</div>
            <div style="color: #718096; font-size: 0.95rem;">Kavita Singh - Life Insurance</div>
            <div style="color: #a0aec0; font-size: 0.85rem;">1 day ago</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dashboard Banners -->
    <%= display_banners('dashboard') %>

    <!-- Quick Access Cards -->
    <div class="section-title" style="margin-top: 4rem;">Quick Access</div>
    <div class="grid-4">
      <!-- Renewal Policies -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-cyan);
                  --icon-gradient: var(--gradient-cyan);
                  --icon-shadow: rgba(0, 198, 255, 0.3);
                  --text-gradient: var(--gradient-cyan);
                  cursor: pointer;"
           onclick="document.getElementById('renewal-section').scrollIntoView();">
        <div class="stat-icon">
          <i class="bi bi-clock-history"></i>
        </div>
        <div class="stat-value pulse">124</div>
        <div class="stat-label">Renewal Due</div>
      </div>

      <!-- Expired Policies -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-red);
                  --icon-gradient: var(--gradient-red);
                  --icon-shadow: rgba(255, 65, 108, 0.3);
                  --text-gradient: var(--gradient-red);
                  cursor: pointer;"
           onclick="document.getElementById('expired-section').scrollIntoView();">
        <div class="stat-icon">
          <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="stat-value pulse">45</div>
        <div class="stat-label">Expired Policies</div>
      </div>

      <!-- Client Requests -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-orange);
                  --icon-gradient: var(--gradient-orange);
                  --icon-shadow: rgba(255, 154, 158, 0.3);
                  --text-gradient: var(--gradient-orange);
                  cursor: pointer;"
           onclick="document.getElementById('requests-section').scrollIntoView();">
        <div class="stat-icon">
          <i class="bi bi-chat-dots"></i>
        </div>
        <div class="stat-value pulse">32</div>
        <div class="stat-label">Client Requests</div>
      </div>

      <!-- Claims Processing -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-purple);
                  --icon-gradient: var(--gradient-purple);
                  --icon-shadow: rgba(131, 96, 195, 0.3);
                  --text-gradient: var(--gradient-purple);">
        <div class="stat-icon">
          <i class="bi bi-file-medical"></i>
        </div>
        <div class="stat-value pulse">18</div>
        <div class="stat-label">Claims Processing</div>
      </div>

      <!-- Document Verification -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-yellow);
                  --icon-gradient: var(--gradient-yellow);
                  --icon-shadow: rgba(255, 193, 7, 0.3);
                  --text-gradient: var(--gradient-yellow);">
        <div class="stat-icon">
          <i class="bi bi-file-check"></i>
        </div>
        <div class="stat-value pulse">67</div>
        <div class="stat-label">Docs Pending</div>
      </div>

      <!-- Agent Commissions -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-green);
                  --icon-gradient: var(--gradient-green);
                  --icon-shadow: rgba(17, 153, 142, 0.3);
                  --text-gradient: var(--gradient-green);">
        <div class="stat-icon">
          <i class="bi bi-wallet2"></i>
        </div>
        <div class="stat-value pulse">₹2.1M</div>
        <div class="stat-label">Commissions Due</div>
      </div>

      <!-- New Leads -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-pink);
                  --icon-gradient: var(--gradient-pink);
                  --icon-shadow: rgba(252, 70, 107, 0.3);
                  --text-gradient: var(--gradient-pink);">
        <div class="stat-icon">
          <i class="bi bi-star"></i>
        </div>
        <div class="stat-value pulse">156</div>
        <div class="stat-label">New Leads</div>
      </div>

      <!-- Customer Support -->
      <div class="stat-card"
           style="--card-gradient: var(--gradient-blue);
                  --icon-gradient: var(--gradient-blue);
                  --icon-shadow: rgba(102, 126, 234, 0.3);
                  --text-gradient: var(--gradient-blue);">
        <div class="stat-icon">
          <i class="bi bi-headset"></i>
        </div>
        <div class="stat-value pulse">89</div>
        <div class="stat-label">Support Tickets</div>
      </div>
    </div>

    <!-- Renewal Policies Section -->
    <div id="renewal-section" class="section-title" style="margin-top: 4rem;">Renewal Due Policies</div>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Policies Due for Renewal</h5>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary">
            <i class="bi bi-download me-1"></i>Export
          </button>
          <button class="btn btn-sm btn-primary">
            <i class="bi bi-envelope me-1"></i>Send Reminders
          </button>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th class="border-0">Customer</th>
                <th class="border-0">Policy</th>
                <th class="border-0">Type</th>
                <th class="border-0">Expiry Date</th>
                <th class="border-0">Premium</th>
                <th class="border-0">Status</th>
                <th class="border-0">Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1">Rajesh Kumar</h6>
                    <small class="text-muted">rajesh@email.com</small>
                  </div>
                </td>
                <td>
                  <div>
                    <div class="mb-1">HLT-2024-001</div>
                    <small class="text-muted">Family Health Plan</small>
                  </div>
                </td>
                <td>
                  <span class="badge bg-primary">Health Insurance</span>
                </td>
                <td>
                  <div>
                    <div class="text-warning fw-bold">15 Dec 2024</div>
                    <small class="text-muted">5 days left</small>
                  </div>
                </td>
                <td>
                  <div class="fw-bold">₹25,000</div>

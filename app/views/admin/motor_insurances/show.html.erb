<!-- Nominee Details Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#nomineeDetailsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-people"></i>
      </div>
      <h5 class="section-title">Nominee Details</h5>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="nomineeDetailsCollapse" class="collapse">
    <div class="section-body">
      <% if @motor_insurance.motor_insurance_nominees.any? %>
        <!-- Display nominees from motor_insurance_nominees association -->
        <% @motor_insurance.motor_insurance_nominees.each_with_index do |nominee, index| %>
          <div class="nominee-card <%= 'mb-4' if index < @motor_insurance.motor_insurance_nominees.count - 1 %>" style="border: 1px solid #e9ecef; border-radius: 8px; padding: 20px; background-color: #f8f9fa;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="mb-0" style="color: #495057; font-weight: 600;">
                <i class="bi bi-person-circle me-2"></i>Nominee <%= index + 1 %>
              </h6>
              <span class="badge bg-primary"><%= nominee.share_percentage || 0 %>% Share</span>
            </div>
            <div class="row g-3">
              <div class="col-md-4">
                <div class="info-field">
                  <label>NOMINEE NAME</label>
                  <div class="info-value"><%= nominee.nominee_name %></div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="info-field">
                  <label>RELATIONSHIP</label>
                  <div class="info-value"><%= nominee.relationship&.titleize || '-' %></div>
                </div>
              </div>
              <div class="col-md-2">
                <div class="info-field">
                  <label>AGE</label>
                  <div class="info-value"><%= nominee.age ? "#{nominee.age} years" : '-' %></div>
                </div>
              </div>
              <div class="col-md-2">
                <div class="info-field">
                  <label>SHARE %</label>
                  <div class="info-value"><%= nominee.share_percentage ? "#{nominee.share_percentage}%" : '-' %></div>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Summary section for multiple nominees -->
        <% if @motor_insurance.motor_insurance_nominees.count > 1 %>
          <div class="mt-4 p-3" style="background-color: #e7f3ff; border-radius: 6px; border-left: 4px solid #0d6efd;">
            <div class="row">
              <div class="col-md-6">
                <strong>Total Nominees: <%= @motor_insurance.motor_insurance_nominees.count %></strong>
              </div>
              <div class="col-md-6">
                <strong>Total Share: <%= @motor_insurance.motor_insurance_nominees.sum(:share_percentage) || 0 %>%</strong>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- No nominee data -->
        <div class="text-center py-4" style="color: #6c757d;">
          <i class="bi bi-person-x" style="font-size: 2rem; opacity: 0.5;"></i>
          <p class="mt-2 mb-0">No nominee details available</p>
        </div>
      <% end %>
    </div>
  </div>
</div>


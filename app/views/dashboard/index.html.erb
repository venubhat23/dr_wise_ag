<!-- Chart.js for interactive charts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.js"></script>
<!-- Additional Chart.js plugins -->
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>

<style>
  .dashboard-container {
    padding: 2rem;
    background: #f8fafc;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .card-hover {
    transition: all 0.2s ease-in-out;
    cursor: pointer;
  }

  .card-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }

  @media (max-width: 768px) {
    .dashboard-container {
      padding: 1rem;
    }
  }
</style>

<div class="dashboard-container">
  <!-- Core KPI Cards -->
  <div class="row mb-4">
    <!-- Total Customers -->
    <div class="col-xl-3 col-md-6 mb-3">
      <%= link_to admin_customers_path, class: "text-decoration-none" do %>
        <div class="card h-100 border-0 shadow-sm card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <div>
                <h6 class="text-muted mb-2">Total Customers</h6>
                <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_customers) %></h3>
                <small class="<%= (@customer_growth || 0) >= 0 ? 'text-success' : 'text-danger' %>">
                  <i class="bi bi-arrow-<%= (@customer_growth || 0) >= 0 ? 'up' : 'down' %>"></i>
                  <%= (@customer_growth || 0).abs %>% from last month
                </small>
              </div>
              <div class="bg-primary bg-opacity-10 rounded p-3">
                <i class="bi bi-people text-primary fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Total Policies -->
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Active Policies</h6>
              <h3 class="mb-0 text-success"><%= number_with_delimiter(@total_policies) %></h3>
              <small class="<%= (@policy_growth || 0) >= 0 ? 'text-success' : 'text-danger' %>">
                <i class="bi bi-arrow-<%= (@policy_growth || 0) >= 0 ? 'up' : 'down' %>"></i>
                <%= (@policy_growth || 0).abs %>% from last month
              </small>
            </div>
            <div class="bg-success bg-opacity-10 rounded p-3">
              <i class="bi bi-file-earmark-text text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Premium -->
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Total Premium</h6>
              <h3 class="mb-0 text-warning"><%= indian_currency(@total_premium_collected || 0) %></h3>
              <small class="<%= (@premium_growth || 0) >= 0 ? 'text-success' : 'text-danger' %>">
                <i class="bi bi-arrow-<%= (@premium_growth || 0) >= 0 ? 'up' : 'down' %>"></i>
                <%= (@premium_growth || 0).abs %>% from last month
              </small>
            </div>
            <div class="bg-warning bg-opacity-10 rounded p-3">
              <i class="bi bi-currency-rupee text-warning fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Leads -->
    <div class="col-xl-3 col-md-6 mb-3">
      <%= link_to admin_leads_path, class: "text-decoration-none" do %>
        <div class="card h-100 border-0 shadow-sm card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <div>
                <h6 class="text-muted mb-2">Active Leads</h6>
                <h3 class="mb-0 text-info"><%= number_with_delimiter(@pending_leads) %></h3>
                <small class="<%= (@lead_growth || 0) >= 0 ? 'text-success' : 'text-danger' %>">
                  <i class="bi bi-arrow-<%= (@lead_growth || 0) >= 0 ? 'up' : 'down' %>"></i>
                  <%= (@lead_growth || 0).abs %>% from last month
                </small>
              </div>
              <div class="bg-info bg-opacity-10 rounded p-3">
                <i class="bi bi-funnel text-info fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Actions Grid -->
  <div class="row mb-4">
    <!-- Renewal Alerts -->
    <div class="col-xl-3 col-lg-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title d-flex align-items-center mb-3">
            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
            Renewal Alerts
          </h5>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Expiring in 30 days</span>
            <span class="badge bg-warning text-dark"><%= @renewal_due_count %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Recently expired</span>
            <span class="badge bg-danger"><%= @expired_policies_count %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Processed this month</span>
            <span class="badge bg-success"><%= @renewal_status['Renewed'] %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Policy Alerts -->
    <div class="col-xl-3 col-lg-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title d-flex align-items-center mb-3">
            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
            Policy Alerts
          </h5>
          <%
            # Calculate renewal alerts
            expiring_soon = HealthInsurance.where(policy_end_date: Date.current..30.days.from_now).count rescue 0
            expired_policies = HealthInsurance.where(policy_end_date: Date.current.beginning_of_month..Date.current).count rescue 0
            pending_renewals = HealthInsurance.joins("LEFT JOIN health_insurances hi2 ON hi2.policy_type = 'Renewal' AND hi2.customer_id = health_insurances.customer_id")
                                             .where(policy_end_date: 30.days.ago..Date.current)
                                             .where("hi2.id IS NULL").count rescue 0
          %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Policies expiring soon</span>
            <span class="badge bg-warning text-dark"><%= expiring_soon %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Expired this month</span>
            <span class="badge bg-danger"><%= expired_policies %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Renewal opportunities</span>
            <span class="badge bg-success"><%= pending_renewals %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-xl-3 col-lg-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title d-flex align-items-center mb-3">
            <i class="bi bi-activity text-success me-2"></i>
            Recent Activity
          </h5>
          <div style="max-height: 200px; overflow-y: auto;">
            <% if @recent_policies&.any? %>
              <% @recent_policies.first(3).each do |policy| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <div>
                    <div class="fw-medium text-dark"><%= policy[:type] %></div>
                    <small class="text-muted"><%= policy[:customer] || "Customer" %></small>
                  </div>
                  <div class="text-end">
                    <div class="fw-medium text-success"><%= indian_currency(policy[:premium] || 0) %></div>
                    <small class="text-muted"><%= time_ago_in_words(policy[:date]) %> ago</small>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center text-muted">
                <small>No recent activity</small>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-xl-3 col-lg-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title d-flex align-items-center mb-3">
            <i class="bi bi-lightning-fill text-info me-2"></i>
            Quick Actions
          </h5>
          <div class="d-grid gap-2">
            <%= link_to new_admin_customer_path, class: "btn btn-outline-primary btn-sm d-flex align-items-center" do %>
              <i class="bi bi-person-plus me-2"></i>Add New Customer
            <% end %>
            <%= link_to new_admin_lead_path, class: "btn btn-outline-success btn-sm d-flex align-items-center" do %>
              <i class="bi bi-funnel me-2"></i>Create Lead
            <% end %>
            <%= link_to admin_analytics_path, class: "btn btn-outline-warning btn-sm d-flex align-items-center" do %>
              <i class="bi bi-bar-chart me-2"></i>View Analytics
            <% end %>
            <%= link_to admin_health_insurances_path, class: "btn btn-outline-info btn-sm d-flex align-items-center" do %>
              <i class="bi bi-file-earmark-plus me-2"></i>New Policy
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- System Status -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title d-flex align-items-center mb-3">
        <i class="bi bi-gear-fill text-secondary me-2"></i>
        System Status
      </h5>
      <div class="row">
        <div class="col-xl-3 col-md-6 mb-3">
          <div class="text-center p-3 bg-light rounded">
            <h4 class="mb-1 text-success"><%= @total_affiliates %></h4>
            <small class="text-muted">Active Affiliates</small>
          </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
          <div class="text-center p-3 bg-light rounded">
            <h4 class="mb-1 text-primary"><%= @conversion_rate %>%</h4>
            <small class="text-muted">Lead Conversion</small>
          </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
          <div class="text-center p-3 bg-light rounded">
            <h4 class="mb-1 text-warning"><%= indian_currency(@avg_policy_value || 0) %></h4>
            <small class="text-muted">Avg Policy Value</small>
          </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
          <div class="text-center p-3 bg-light rounded">
            <h4 class="mb-1 <%= @commissions_due > 0 ? 'text-danger' : 'text-success' %>">
              <%= indian_currency(@commissions_due || 0) %>
            </h4>
            <small class="text-muted">Commissions Due</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Display Banners if any -->
  <%= display_banners('dashboard') if defined?(display_banners) %>
</div>

<script>
// Add any minimal dashboard interactions here
document.addEventListener('DOMContentLoaded', function() {
  console.log('Dashboard loaded');

  // Auto-refresh dashboard data every 5 minutes
  setInterval(function() {
    // You could implement auto-refresh of KPI data here
    console.log('Dashboard auto-refresh check');
  }, 300000); // 5 minutes
});
</script>
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Withdrawal Requests</h2>
    <p class="text-muted mb-0">Review and process ambassador / affiliate wallet withdrawal requests</p>
  </div>
  <% if @tab_counts['pending'] > 0 %>
    <span class="badge bg-warning fs-6">
      <%= @tab_counts['pending'] %> awaiting review
    </span>
  <% end %>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-tabs mb-4">
  <% tabs = [
       ['pending',  'Pending'],
       ['approved', 'Approved'],
       ['rejected', 'Rejected']
     ] %>
  <% tabs.each do |status, label| %>
    <li class="nav-item">
      <%= link_to admin_withdrawal_requests_path(status: status),
                  class: "nav-link #{'active' if @tab == status}" do %>
        <%= label %>
        <% count = @tab_counts[status].to_i %>
        <% if count > 0 %>
          <span class="badge <%= status == 'pending' ? 'bg-warning text-dark' : 'bg-secondary' %> ms-1"><%= count %></span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @withdrawal_requests.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Requester</th>
              <th>Email</th>
              <th>Amount</th>
              <th>Reason</th>
              <th><%= @tab == 'pending' ? 'Requested on' : 'Reviewed on' %></th>
              <% if @tab == 'rejected' %>
                <th>Rejection reason</th>
              <% end %>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @withdrawal_requests.each do |wr| %>
              <tr>
                <td>
                  <%= wr.owner_label %>
                  <span class="badge bg-info-subtle text-info ms-1"><%= wr.owner_kind %></span>
                </td>
                <td><%= wr.owner.email %></td>
                <td class="fw-semibold">
                  <%= indian_currency(wr.amount) %>
                  <% owner_wallet = wr.owner.wallet %>
                  <% if owner_wallet && wr.pending? %>
                    <div class="small fw-normal">
                      <span class="text-success"><i class="bi bi-unlock"></i> Active <%= indian_currency(owner_wallet.balance) %></span><br>
                      <span class="text-warning"><i class="bi bi-lock"></i> Inactive <%= indian_currency(owner_wallet.inactive_balance) %></span>
                    </div>
                  <% end %>
                </td>
                <td><%= truncate(wr.reason, length: 60) %></td>
                <td>
                  <% ts = @tab == 'pending' ? wr.created_at : wr.reviewed_at %>
                  <%= ts&.strftime('%d %b %Y, %I:%M %p') || '—' %>
                </td>
                <% if @tab == 'rejected' %>
                  <td class="text-danger small"><%= wr.rejection_reason %></td>
                <% end %>
                <td class="text-end">
                  <% if wr.pending? %>
                    <div class="d-flex justify-content-end gap-2">
                      <%= button_to approve_admin_withdrawal_request_path(wr),
                                    method: :patch, class: "btn btn-sm btn-success",
                                    data: { bs_toggle: "tooltip" }, title: "Approve",
                                    form: { data: { turbo_confirm: "Approve #{wr.owner_label}'s withdrawal of #{indian_currency(wr.amount)}? This will deduct the amount from their wallet." } } do %>
                        <i class="bi bi-check-lg"></i>
                      <% end %>

                      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= wr.id %>" title="Reject">
                        <i class="bi bi-x-lg"></i>
                      </button>

                      <div class="modal fade" id="rejectModal<%= wr.id %>" tabindex="-1">
                        <div class="modal-dialog">
                          <div class="modal-content">
                            <%= form_with url: reject_admin_withdrawal_request_path(wr), method: :patch, local: true do |form| %>
                              <div class="modal-header">
                                <h5 class="modal-title">Reject Withdrawal Request</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                              </div>
                              <div class="modal-body">
                                <p>Reject <strong><%= wr.owner_label %></strong>'s withdrawal request of
                                  <strong><%= indian_currency(wr.amount) %></strong>?</p>
                                <label class="form-label">Reason (optional)</label>
                                <%= form.text_area :rejection_reason, class: "form-control", rows: 2, placeholder: "Rejected by admin" %>
                              </div>
                              <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <%= form.submit "Reject", class: "btn btn-danger" %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% elsif wr.approved? %>
                    <span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>Paid out</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-transparent border-0">
        <%= render 'shared/pagination', records: @withdrawal_requests %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-cash-coin fs-1 text-muted"></i>
        <h6 class="text-muted mt-3">No withdrawal requests in this status</h6>
      </div>
    <% end %>
  </div>
</div>

<%# Approve / reject failure, shown as a pop-up (set by
    Admin::WithdrawalRequestsController#review_failed). %>
<% if (review_error = flash[:review_error]) && (failed = WithdrawalRequest.find_by(id: review_error['id'])) %>
  <% approving = review_error['action'] == 'approve' %>
  <% wallet = failed.owner.wallet %>
  <% wallet_path = failed.owner_type == 'Distributor' ? admin_wallets_ambassador_wallet_path(failed.owner) : admin_wallets_affiliate_wallet_path(failed.owner) %>
  <% short_balance = approving && wallet && failed.amount > wallet.balance %>
  <div class="modal fade" id="reviewErrorModal" tabindex="-1" aria-labelledby="reviewErrorTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg wr-error-modal">
        <div class="modal-body text-center p-4">
          <div class="wr-error-icon mb-3"><i class="bi <%= short_balance ? 'bi-wallet2' : 'bi-exclamation-triangle' %>"></i></div>
          <h5 class="fw-bold mb-1" id="reviewErrorTitle"><%= approving ? "Couldn't approve this withdrawal" : "Couldn't reject this request" %></h5>
          <p class="text-muted small mb-3"><%= failed.owner_kind %>: <strong><%= failed.owner_label %></strong></p>

          <div class="wr-error-figures mb-3">
            <div>
              <span class="label">Requested</span>
              <span class="value"><%= indian_currency(failed.amount) %></span>
            </div>
            <% if wallet %>
              <div>
                <span class="label">Active wallet</span>
                <span class="value <%= 'text-danger' if short_balance %>"><%= indian_currency(wallet.balance) %></span>
              </div>
            <% end %>
          </div>

          <div class="alert <%= short_balance ? 'alert-warning' : 'alert-danger' %> small text-start mb-0">
            <i class="bi bi-info-circle me-1"></i><%= review_error['message'] %>
            <% if short_balance %>
              <div class="mt-1">Top up or correct their wallet first, or reject this request.</div>
            <% end %>
          </div>
        </div>
        <div class="modal-footer border-0 justify-content-center pt-0 pb-4 gap-2">
          <%= link_to wallet_path, class: "btn btn-outline-primary" do %>
            <i class="bi bi-wallet2 me-1"></i>Open wallet
          <% end %>
          <% if failed.pending? %>
            <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal" data-open-reject="#rejectModal<%= failed.id %>">
              <i class="bi bi-x-lg me-1"></i>Reject request
            </button>
          <% end %>
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .wr-error-modal { border-radius: 18px; }
    .wr-error-icon { width: 64px; height: 64px; margin: 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.7rem; color: #b45309; background: #fef3c7; }
    .wr-error-figures { display: flex; justify-content: center; gap: .75rem; }
    .wr-error-figures > div { flex: 1; max-width: 170px; background: #f8f9fc; border: 1px solid #eef0f6; border-radius: 12px; padding: .6rem .5rem; }
    .wr-error-figures .label { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: #6c757d; }
    .wr-error-figures .value { display: block; font-weight: 700; font-size: 1.1rem; }
  </style>

  <script>
    (function() {
      function show() {
        var el = document.getElementById('reviewErrorModal');
        if (!el || !window.bootstrap) return;
        bootstrap.Modal.getOrCreateInstance(el).show();
        var rejectBtn = el.querySelector('[data-open-reject]');
        if (rejectBtn) rejectBtn.addEventListener('click', function() {
          var target = document.querySelector(rejectBtn.dataset.openReject);
          if (target) el.addEventListener('hidden.bs.modal', function() { bootstrap.Modal.getOrCreateInstance(target).show(); }, { once: true });
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', show); else show();
    })();
  </script>
<% end %>

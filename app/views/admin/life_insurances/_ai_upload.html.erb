<%# AI Upload (beta) for the New Life Insurance form. Optional helper: the admin
    uploads a policy document, Claude extracts the details
    (Admin::LifeInsuranceAiExtractsController), the admin reviews them and only
    ticked fields are written into the form. Nothing is saved until the form
    itself is submitted. Opens automatically with ?ai_upload=1. %>
<div class="modal fade" id="aiUploadModal" tabindex="-1" aria-labelledby="aiUploadTitle" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content ai-modal">
      <div class="modal-header border-0 pb-0">
        <div>
          <h5 class="modal-title mb-0" id="aiUploadTitle">
            <span class="ai-sparkle"><i class="bi bi-stars"></i></span> AI Upload
            <span class="badge ai-beta ms-1">Beta</span>
          </h5>
          <small class="text-muted">Upload the policy document and we'll fill the form for you. You review everything before it's applied.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" data-ai-close></button>
      </div>

      <div class="modal-body">
        <!-- Step 1: choose file -->
        <div data-ai-step="pick">
          <label class="ai-drop" for="aiPolicyFile" data-ai-drop>
            <input type="file" id="aiPolicyFile" accept="application/pdf,image/jpeg,image/png,image/webp" hidden>
            <div class="ai-drop-icon"><i class="bi bi-cloud-arrow-up"></i></div>
            <div class="fw-semibold">Drop the policy document here or <span class="text-primary text-decoration-underline">browse</span></div>
            <div class="small text-muted">Policy schedule, proposal form or premium receipt · PDF, JPG, PNG · up to 20 MB</div>
          </label>
          <div class="ai-file d-none" data-ai-file>
            <i class="bi bi-file-earmark-text fs-4 text-primary"></i>
            <div class="flex-grow-1 text-truncate"><div class="fw-semibold text-truncate" data-ai-file-name></div><small class="text-muted" data-ai-file-size></small></div>
            <button type="button" class="btn btn-sm btn-link text-danger" data-ai-file-clear><i class="bi bi-x-lg"></i></button>
          </div>
          <div class="alert alert-danger small mt-3 mb-0 d-none" data-ai-error></div>
        </div>

        <!-- Step 2: working -->
        <div class="ai-working d-none" data-ai-step="working">
          <div class="ai-orb"><i class="bi bi-stars"></i></div>
          <h6 class="mt-3 mb-1">Reading your policy…</h6>
          <p class="small text-muted mb-3">This usually takes 15–40 seconds. You can keep this window open.</p>
          <ul class="ai-steps list-unstyled mb-0">
            <li data-ai-progress="0"><i class="bi bi-circle"></i> Uploading document</li>
            <li data-ai-progress="1"><i class="bi bi-circle"></i> Reading pages</li>
            <li data-ai-progress="2"><i class="bi bi-circle"></i> Extracting policy, premium &amp; nominee details</li>
            <li data-ai-progress="3"><i class="bi bi-circle"></i> Matching client and insurer</li>
          </ul>
        </div>

        <!-- Step 3: review -->
        <div class="d-none" data-ai-step="review">
          <div class="alert alert-success py-2 small d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <span data-ai-summary></span>
          </div>
          <div class="table-responsive ai-review-wrap">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light"><tr><th style="width:34px"><input type="checkbox" class="form-check-input" data-ai-check-all checked></th><th>Field</th><th>Found in document</th></tr></thead>
              <tbody data-ai-review></tbody>
            </table>
          </div>
          <p class="small text-muted mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>Untick anything you don't want. AI can make mistakes — filled fields are highlighted so you can check them before saving.</p>
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-ai-close>Cancel</button>
        <button type="button" class="btn ai-btn d-none" data-ai-extract disabled><i class="bi bi-stars me-1"></i>Extract details</button>
        <button type="button" class="btn btn-outline-primary d-none" data-ai-again><i class="bi bi-arrow-repeat me-1"></i>Try another file</button>
        <button type="button" class="btn ai-btn d-none" data-ai-apply><i class="bi bi-magic me-1"></i>Apply to form</button>
      </div>
    </div>
  </div>
</div>

<style>
  .ai-btn { background: linear-gradient(135deg, #6d28d9, #4f46e5); color: #fff; border: none; }
  .ai-btn:hover, .ai-btn:focus { color: #fff; filter: brightness(1.08); }
  .ai-btn:disabled { color: #fff; opacity: .55; }
  .ai-launch { box-shadow: 0 4px 14px rgba(109, 40, 217, .25); }
  .ai-beta { background: #ede9fe; color: #6d28d9; font-weight: 600; font-size: .65rem; vertical-align: middle; }
  .ai-sparkle { color: #7c3aed; }
  .ai-modal { border-radius: 18px; }
  .ai-drop { display: flex; flex-direction: column; align-items: center; gap: .35rem; padding: 2.2rem 1rem; border: 2px dashed #c4b5fd; border-radius: 14px; background: #faf8ff; cursor: pointer; text-align: center; transition: all .15s; width: 100%; }
  .ai-drop:hover, .ai-drop.drag { border-color: #7c3aed; background: #f3efff; }
  .ai-drop-icon { font-size: 2.2rem; color: #7c3aed; line-height: 1; }
  .ai-file { display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; border: 1px solid #e9e5ff; border-radius: 12px; background: #fff; margin-top: .75rem; }
  .ai-working { text-align: center; padding: 1.5rem .5rem; }
  .ai-orb { width: 72px; height: 72px; margin: 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: #fff; background: linear-gradient(135deg, #7c3aed, #4f46e5); animation: aiPulse 1.6s ease-in-out infinite; }
  @keyframes aiPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(124, 58, 237, .45); transform: scale(1); } 50% { box-shadow: 0 0 0 16px rgba(124, 58, 237, 0); transform: scale(1.05); } }
  .ai-steps { display: inline-block; text-align: left; }
  .ai-steps li { padding: .2rem 0; color: #9ca3af; font-size: .9rem; }
  .ai-steps li.active { color: #4f46e5; font-weight: 600; }
  .ai-steps li.done { color: #059669; }
  .ai-steps .spinner-border { width: .9rem; height: .9rem; border-width: .15em; }
  .ai-review-wrap { max-height: 46vh; overflow-y: auto; border: 1px solid #eef0f4; border-radius: 10px; }
  .ai-review-wrap td.text-muted { font-style: italic; }
  .ai-filled { background-color: #f5f3ff !important; border-color: #a78bfa !important; box-shadow: 0 0 0 .15rem rgba(167, 139, 250, .25) !important; }
  .select2-container.ai-filled .select2-selection { background-color: #f5f3ff !important; border-color: #a78bfa !important; }
</style>

<script>
(function() {
  // Registered once per tab (Turbo re-runs this script but keeps document).
  if (window.aiUploadInit) { window.aiUploadInit(); return; }

  var EXTRACT_URL = '<%= admin_life_insurance_ai_extract_path %>';
  var FIELDS = [
    ['customer', 'Client'], ['policy_number', 'Policy Number'], ['insurance_company_name', 'Insurance Company'],
    ['plan_name', 'Plan Name'], ['payment_mode', 'Payment Mode'], ['insured_name', 'Insured Name'],
    ['policy_booking_date', 'Booking Date'], ['policy_start_date', 'Start Date'], ['policy_end_date', 'End Date'],
    ['risk_start_date', 'Risk Start Date'], ['policy_term', 'Policy Term (years)'], ['premium_payment_term', 'Premium Paying Term (years)'],
    ['sum_insured', 'Sum Insured'], ['net_premium', 'Net Premium'], ['gst_percentage', 'First Year GST %'],
    ['total_premium', 'Total Premium (document)'], ['nominees', 'Nominees'],
    ['bank_name', 'Bank Name'], ['account_number', 'Account Number'], ['ifsc_code', 'IFSC Code'],
    ['account_holder_name', 'Account Holder'], ['notes', 'Notes']
  ];

  var state = { file: null, result: null, timers: [] };

  function $q(sel, root) { return (root || document).querySelector(sel); }
  function modalEl() { return document.getElementById('aiUploadModal'); }
  function esc(v) { return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function money(n) { return '₹' + Number(n).toLocaleString('en-IN', { maximumFractionDigits: 2 }); }

  function showStep(step) {
    modalEl().querySelectorAll('[data-ai-step]').forEach(function(el) { el.classList.toggle('d-none', el.dataset.aiStep !== step); });
    var m = modalEl();
    $q('[data-ai-extract]', m).classList.toggle('d-none', step !== 'pick');
    $q('[data-ai-again]', m).classList.toggle('d-none', step !== 'review');
    $q('[data-ai-apply]', m).classList.toggle('d-none', step !== 'review');
  }

  function showError(msg) {
    var box = $q('[data-ai-error]', modalEl());
    box.textContent = msg; box.classList.toggle('d-none', !msg);
  }

  function setFile(file) {
    var m = modalEl();
    showError('');
    if (file && !/^(application\/pdf|image\/(jpeg|png|webp))$/.test(file.type)) { showError('Please choose a PDF, JPG, PNG or WEBP file.'); file = null; }
    if (file && file.size > 20 * 1024 * 1024) { showError('The file is larger than 20 MB.'); file = null; }
    state.file = file;
    $q('[data-ai-drop]', m).classList.toggle('d-none', !!file);
    $q('[data-ai-file]', m).classList.toggle('d-none', !file);
    $q('[data-ai-extract]', m).disabled = !file;
    if (file) {
      $q('[data-ai-file-name]', m).textContent = file.name;
      $q('[data-ai-file-size]', m).textContent = (file.size / 1024 / 1024).toFixed(2) + ' MB';
    } else {
      $q('#aiPolicyFile').value = '';
    }
  }

  function reset() { state.result = null; setFile(null); showStep('pick'); }

  // Loader steps advance on a timer while the request runs; all tick off on success.
  function startProgress() {
    var items = modalEl().querySelectorAll('[data-ai-progress]');
    items.forEach(function(li) { setStepState(li, ''); });
    var delays = [0, 2500, 7000, 0];
    var i = 0;
    function advance() {
      if (i > 0) setStepState(items[i - 1], 'done');
      if (i < items.length - 1) { setStepState(items[i], 'active'); i++; state.timers.push(setTimeout(advance, delays[i] || 99999)); }
    }
    advance();
  }
  function finishProgress(ok) {
    state.timers.forEach(clearTimeout); state.timers = [];
    modalEl().querySelectorAll('[data-ai-progress]').forEach(function(li) { setStepState(li, ok ? 'done' : ''); });
  }
  function setStepState(li, st) {
    li.className = st;
    li.querySelector('i, .spinner-border').className = st === 'active' ? 'spinner-border text-primary' : (st === 'done' ? 'bi bi-check-circle-fill' : 'bi bi-circle');
  }

  function extract() {
    if (!state.file) return;
    showStep('working'); startProgress();
    var body = new FormData();
    body.append('document', state.file);
    var token = document.querySelector('meta[name="csrf-token"]');
    fetch(EXTRACT_URL, { method: 'POST', body: body, headers: { 'X-CSRF-Token': token ? token.content : '', 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(res) { return res.json().catch(function() { return { success: false, error: 'Unexpected server response (' + res.status + ').' }; }); })
      .then(function(data) {
        finishProgress(!!data.success);
        if (!data.success) { showStep('pick'); setFile(state.file); showError(data.error || 'Could not read the document.'); return; }
        state.result = data;
        setTimeout(function() { renderReview(data); showStep('review'); }, 350);
      })
      .catch(function() { finishProgress(false); showStep('pick'); setFile(state.file); showError('Network error. Please check your connection and try again.'); });
  }

  function displayValue(key, data) {
    var f = data.fields;
    switch (key) {
      case 'customer':
        if (data.customer) return { text: data.customer.name + ' (existing client #' + data.customer.id + ')' };
        return f.proposer_name ? { text: f.proposer_name + ' — not found in clients, select manually', disabled: true } : null;
      case 'insurance_company_name':
        if (data.insurance_company_name) return { text: data.insurance_company_name };
        return f.insurance_company_name ? { text: f.insurance_company_name + ' — not in the list, select manually', disabled: true } : null;
      case 'sum_insured': case 'net_premium': case 'total_premium':
        return f[key] != null ? { text: money(f[key]), disabled: key === 'total_premium', note: key === 'total_premium' ? 'calculated by the form' : null } : null;
      case 'gst_percentage': return f[key] != null ? { text: f[key] + '%' } : null;
      case 'nominees':
        return (f.nominees || []).length ? { text: f.nominees.map(function(n) { return n.name + (n.relationship ? ' (' + n.relationship + (n.age != null ? ', ' + n.age : '') + ')' : '') + (n.share_percentage != null ? ' · ' + n.share_percentage + '%' : ''); }).join('; ') } : null;
      default: return f[key] != null && f[key] !== '' ? { text: String(f[key]) } : null;
    }
  }

  function renderReview(data) {
    var rows = '', found = 0;
    FIELDS.forEach(function(pair) {
      var v = displayValue(pair[0], data);
      if (v && !v.disabled) found++;
      rows += '<tr>' +
        '<td><input type="checkbox" class="form-check-input" data-ai-field="' + pair[0] + '"' + (v && !v.disabled ? ' checked' : ' disabled') + '></td>' +
        '<td class="fw-semibold small">' + pair[1] + '</td>' +
        (v ? '<td class="small">' + esc(v.text) + (v.note ? ' <span class="text-muted">(' + v.note + ')</span>' : '') + '</td>' : '<td class="small text-muted">Not found</td>') +
        '</tr>';
    });
    $q('[data-ai-review]', modalEl()).innerHTML = rows;
    $q('[data-ai-summary]', modalEl()).textContent = 'Found ' + found + ' of ' + FIELDS.length + ' fields. Review and apply.';
    $q('[data-ai-check-all]', modalEl()).checked = true;
  }

  // ---- Filling the form -------------------------------------------------
  function mark(el) {
    if (!el) return;
    el.classList.add('ai-filled');
    var s2 = el.nextElementSibling;
    if (s2 && s2.classList.contains('select2')) s2.classList.add('ai-filled');
  }
  function fire(el, type) { el.dispatchEvent(new Event(type, { bubbles: true })); }
  function setInput(el, value) {
    if (!el || value == null || value === '') return false;
    el.value = value; fire(el, 'input'); fire(el, 'change'); mark(el); return true;
  }
  function byName(name) { return document.querySelector('#life-insurance-form [name="life_insurance[' + name + ']"]'); }
  // Selects (incl. Select2): set an existing option, then fire the same
  // events a user pick would so the form's own loaders run.
  function setSelect(el, value) {
    if (!el || value == null) return false;
    var opt = Array.prototype.find.call(el.options, function(o) { return o.value === String(value) || o.text.trim().toLowerCase() === String(value).toLowerCase(); });
    if (!opt) return false;
    el.value = opt.value;
    // jQuery passes errors from the form's own handlers up to us - keep the
    // chosen value and carry on.
    try {
      if (window.jQuery) {
        var $el = window.jQuery(el);
        $el.trigger('change');
        if ($el.hasClass('select2-hidden-accessible')) $el.trigger({ type: 'select2:select', params: { data: { id: opt.value, text: opt.text } } });
      } else { fire(el, 'change'); }
    } catch (e) { if (window.console) console.warn('[AI Upload] change handler failed for #' + el.id, e); }
    mark(el); return true;
  }
  function sumInsuredText(n) {
    n = Number(n);
    var fmt = function(x) { return String(Math.round(x * 100) / 100); };
    if (n >= 1e7) return fmt(n / 1e7) + (n / 1e7 === 1 ? ' crore' : ' crores');
    if (n >= 1e5) return fmt(n / 1e5) + (n / 1e5 === 1 ? ' lakh' : ' lakhs');
    return String(n);
  }
  function addNominees(list) {
    var existing = Array.prototype.map.call(document.querySelectorAll('.nominee-row input[name$="[nominee_name]"]'), function(i) { return i.value.trim().toLowerCase(); });
    list.forEach(function(n) {
      if (!n.name || existing.indexOf(n.name.trim().toLowerCase()) !== -1 || typeof window.addNewNominee !== 'function') return;
      try { window.addNewNominee(); } catch (e) { return; }
      var rows = document.querySelectorAll('.nominee-row');
      var row = rows[rows.length - 1];
      if (!row) return;
      setInput(row.querySelector('[name$="[nominee_name]"]'), n.name);
      setSelect(row.querySelector('[name$="[relationship]"]'), n.relationship);
      setInput(row.querySelector('[name$="[age]"]'), n.age);
      setInput(row.querySelector('[name$="[share_percentage]"]'), n.share_percentage);
    });
  }

  function apply() {
    var data = state.result, f = data.fields, filled = 0;
    var picked = {};
    modalEl().querySelectorAll('[data-ai-field]:checked').forEach(function(cb) { picked[cb.dataset.aiField] = true; });
    // Each field is filled on its own: an error inside one of the form's
    // existing change handlers must not stop the remaining fields.
    function did(fn) {
      try { if (fn()) filled++; } catch (e) { if (window.console) console.warn('[AI Upload] field fill failed', e); }
    }

    if (picked.customer && data.customer) did(function() { return setSelect(document.getElementById('customer_select'), data.customer.id); });
    if (picked.policy_number) did(function() { return setInput(byName('policy_number'), f.policy_number); });
    if (picked.insurance_company_name) did(function() { return setSelect(document.getElementById('life_insurance_insurance_company_name'), data.insurance_company_name); });
    if (picked.plan_name) did(function() { return setInput(byName('plan_name'), f.plan_name); });
    if (picked.payment_mode) did(function() { return setSelect(document.getElementById('payment_mode_select'), f.payment_mode); });
    if (picked.insured_name) did(function() { return setInput(byName('insured_name'), f.insured_name); });
    if (picked.policy_booking_date) did(function() { return setInput(byName('policy_booking_date'), f.policy_booking_date); });
    // Start date first: its change handler auto-calculates an end date, which
    // the document's own end date then replaces.
    if (picked.policy_start_date) did(function() { return setInput(document.getElementById('start_date'), f.policy_start_date); });
    if (picked.policy_end_date) did(function() { return setInput(document.getElementById('end_date'), f.policy_end_date); });
    if (picked.risk_start_date) did(function() { return setInput(byName('risk_start_date'), f.risk_start_date); });
    if (picked.policy_term) did(function() { return setInput(byName('policy_term'), f.policy_term); });
    if (picked.premium_payment_term) did(function() { return setInput(byName('premium_payment_term'), f.premium_payment_term); });
    if (picked.sum_insured && f.sum_insured != null) {
      did(function() { return setInput(document.getElementById('sum_insured_text_input'), sumInsuredText(f.sum_insured)); });
      var hidden = byName('sum_insured'); if (hidden) hidden.value = f.sum_insured;
    }
    if (picked.gst_percentage) did(function() { return setInput(document.getElementById('first_year_gst'), f.gst_percentage); });
    if (picked.net_premium) did(function() { return setInput(document.getElementById('net_premium'), f.net_premium); }); // recalculates total premium
    ['bank_name', 'account_number', 'ifsc_code', 'account_holder_name'].forEach(function(k) {
      if (picked[k]) did(function() { return setInput(byName(k), k === 'ifsc_code' && f[k] ? String(f[k]).toUpperCase() : f[k]); });
    });
    if (picked.notes && f.notes) {
      var note = byName('extra_note');
      if (note) did(function() { return setInput(note, note.value ? note.value + '\n' + f.notes : f.notes); });
    }
    // Picking the client loads their saved nominees (AJAX), so add the
    // document's nominees after that settles, skipping any already listed.
    if (picked.nominees && (f.nominees || []).length) {
      filled++;
      setTimeout(function() { addNominees(f.nominees); }, picked.customer && data.customer ? 1800 : 0);
    }

    var bs = window.bootstrap && window.bootstrap.Modal.getInstance(modalEl());
    if (bs) bs.hide();
    toast(filled + ' field' + (filled === 1 ? '' : 's') + ' filled from the document. Highlighted fields came from AI — please review before saving.');
    var first = document.querySelector('#life-insurance-form .ai-filled');
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function toast(msg) {
    var t = document.createElement('div');
    t.className = 'alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-3 shadow';
    t.style.zIndex = 2000; t.style.maxWidth = '420px';
    t.innerHTML = '<i class="bi bi-stars me-2"></i>' + esc(msg) + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
    document.body.appendChild(t);
    setTimeout(function() { if (t.parentNode) t.remove(); }, 7000);
  }

  function bind() {
    var m = modalEl();
    if (!m || m.dataset.aiBound) return;
    m.dataset.aiBound = '1';
    var input = $q('#aiPolicyFile', m), drop = $q('[data-ai-drop]', m);
    input.addEventListener('change', function() { setFile(this.files[0] || null); });
    ['dragenter', 'dragover'].forEach(function(t) { drop.addEventListener(t, function(e) { e.preventDefault(); drop.classList.add('drag'); }); });
    ['dragleave', 'drop'].forEach(function(t) { drop.addEventListener(t, function(e) { e.preventDefault(); drop.classList.remove('drag'); }); });
    drop.addEventListener('drop', function(e) { if (e.dataTransfer.files[0]) setFile(e.dataTransfer.files[0]); });
    $q('[data-ai-file-clear]', m).addEventListener('click', function() { setFile(null); });
    $q('[data-ai-extract]', m).addEventListener('click', extract);
    $q('[data-ai-again]', m).addEventListener('click', reset);
    $q('[data-ai-apply]', m).addEventListener('click', apply);
    $q('[data-ai-check-all]', m).addEventListener('change', function() {
      var on = this.checked;
      m.querySelectorAll('[data-ai-field]:not(:disabled)').forEach(function(cb) { cb.checked = on; });
    });
    m.addEventListener('show.bs.modal', function() { if (!state.result) reset(); });
    reset();
    if (/[?&]ai_upload=1/.test(location.search) && window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(m).show();
  }

  window.aiUploadInit = bind;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind); else bind();
})();
</script>

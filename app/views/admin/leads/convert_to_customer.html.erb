<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">
            <i class="bi bi-person-plus-fill me-2"></i>
            Convert Lead to Customer
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <!-- Lead Information -->
            <div class="col-md-6">
              <h6 class="text-muted mb-3">Lead Information</h6>
              <div class="bg-light p-3 rounded">
                <p><strong>Lead ID:</strong> <%= @lead.lead_id %></p>
                <p><strong>Name:</strong> <%= @lead.name %></p>
                <p><strong>Contact:</strong> <%= @lead.contact_number %></p>
                <% if @lead.email.present? %>
                  <p><strong>Email:</strong> <%= @lead.email %></p>
                <% end %>
                <p><strong>Type:</strong> <%= @lead.customer_type&.titleize || 'Individual' %></p>
                <p><strong>Stage:</strong> <%= @lead.current_stage&.humanize %></p>
              </div>
            </div>

            <!-- Customer Status -->
            <div class="col-md-6">
              <h6 class="text-muted mb-3">Customer Status</h6>
              <div class="bg-light p-3 rounded">
                <% if @lead.is_branch_out? %>
                  <div class="alert alert-success mb-3">
                    <i class="bi bi-diagram-3 me-2"></i>
                    <strong>Branch Out Lead</strong>
                  </div>
                  <p class="text-muted">
                    This is a branch out lead. You will be redirected to the customer creation form with all lead information pre-filled.
                    <% if @lead.parent_lead_id.present? %>
                      <br><small class="text-info">Parent Lead ID: <%= Lead.find_by(id: @lead.parent_lead_id)&.lead_id || @lead.parent_lead_id %></small>
                    <% end %>
                  </p>
                <% elsif @existing_customer %>
                  <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Existing Customer Found!</strong>
                  </div>
                  <p><strong>Customer ID:</strong> <%= @existing_customer.id %></p>
                  <p><strong>Name:</strong> <%= @existing_customer.display_name %></p>
                  <p><strong>Mobile:</strong> <%= @existing_customer.mobile %></p>
                  <% if @existing_customer.email.present? %>
                    <p><strong>Email:</strong> <%= @existing_customer.email %></p>
                  <% end %>
                  <p class="text-muted small">
                    This lead will be linked to the existing customer and updated with any new information.
                  </p>
                <% else %>
                  <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>New Customer</strong>
                  </div>
                  <p class="text-muted">
                    No existing customer found with this mobile number or email.
                    A new customer record will be created.
                  </p>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="d-flex justify-content-between">
                <%= link_to 'Cancel', admin_lead_path(@lead), class: 'btn btn-secondary' %>

                <%= form_with model: @lead, url: convert_to_customer_admin_lead_path(@lead),
                    method: :patch, local: true, class: 'd-inline' do |form| %>
                  <% if @lead.is_branch_out? %>
                    <button type="submit" class="btn btn-success">
                      <i class="bi bi-arrow-right-circle me-2"></i>
                      Go to Customer Creation Form
                    </button>
                  <% elsif @existing_customer %>
                    <button type="submit" class="btn btn-warning">
                      <i class="bi bi-person-check-fill me-2"></i>
                      Link to Existing Customer
                    </button>
                  <% else %>
                    <button type="submit" class="btn btn-success">
                      <i class="bi bi-person-plus-fill me-2"></i>
                      Create New Customer
                    </button>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Additional Information -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="alert alert-info">
                <h6 class="alert-heading">
                  <i class="bi bi-info-circle me-2"></i>
                  What happens next?
                </h6>
                <ul class="mb-0">
                  <% if @lead.is_branch_out? %>
                    <li>You'll be redirected to the customer creation form</li>
                    <li>All branch out lead information will be automatically filled in the form</li>
                    <li>You can review and edit the information before creating the customer</li>
                    <li>Once saved, the branch out lead will be marked as converted</li>
                  <% elsif @existing_customer %>
                    <li>The lead will be marked as converted</li>
                    <li>The existing customer record will be updated with any new information from the lead</li>
                    <li>You'll be redirected to the customer's profile page</li>
                  <% else %>
                    <li>A new customer record will be created using the lead information</li>
                    <li>The lead will be marked as converted</li>
                    <li>You'll be redirected to the new customer's profile page</li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% content_for :title, "Registration Fee - Dr WISE" %>

<style>
  html, body { overflow-y: auto !important; background: #eef0f8; font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  body {
    background-image:
      radial-gradient(circle at 12% 8%, rgba(124, 108, 240, .16), transparent 40%),
      radial-gradient(circle at 88% 92%, rgba(79, 70, 229, .14), transparent 40%);
    background-attachment: fixed;
    min-height: 100vh;
  }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .fade-up { animation: fadeUp .5s ease-out both; }
  .fade-up.d1 { animation-delay: .05s; } .fade-up.d2 { animation-delay: .12s; }
  .fade-up.d3 { animation-delay: .19s; } .fade-up.d4 { animation-delay: .26s; }
  .fade-up.d5 { animation-delay: .33s; }
  @media (prefers-reduced-motion: reduce) { .fade-up { animation: none; } }

  .kyc-wrap { max-width: 480px; margin: 0 auto; padding: 28px 16px 64px; }
  .kyc-topbar { display: flex; justify-content: space-between; align-items: center; padding: 0 4px 18px; }
  .kyc-logo { height: 36px; }

  /* ---- Step tracker ---- */
  .pay-tracker { display: flex; align-items: center; gap: 6px; margin-bottom: 20px; padding: 0 4px; }
  .pay-tracker .seg { flex: 1; height: 4px; border-radius: 3px; background: #22c55e; }
  .pay-tracker .seg.current { background: linear-gradient(90deg, #4f46e5, #7c6cf0); }
  .pay-tracker-label { display: flex; justify-content: space-between; font-size: 10.5px; color: #9aa3b2; font-weight: 600; letter-spacing: .2px; text-transform: uppercase; padding: 0 4px 16px; }
  .pay-tracker-label .on { color: #4f46e5; }

  .kyc-card {
    background: #fff; border-radius: 22px; overflow: hidden;
    box-shadow: 0 24px 60px -12px rgba(31, 41, 55, .22), 0 2px 8px rgba(31, 41, 55, .04);
    border: 1px solid rgba(255, 255, 255, .6);
  }

  /* ---- Hero ---- */
  .pay-hero {
    padding: 34px 26px 46px; text-align: center;
    background: linear-gradient(155deg, #4338ca, #6d5bf0 55%, #8b7cf5);
    color: #fff; position: relative; overflow: hidden;
  }
  .pay-hero::before, .pay-hero::after {
    content: ""; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .10);
  }
  .pay-hero::before { width: 200px; height: 200px; top: -90px; right: -60px; }
  .pay-hero::after { width: 130px; height: 130px; bottom: -70px; left: -40px; }
  .pay-hero-icon {
    width: 58px; height: 58px; border-radius: 16px; background: rgba(255, 255, 255, .16);
    backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 24px; position: relative; z-index: 1;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .12);
  }
  .kyc-submitted-badge {
    display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, .16);
    color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .3px; text-transform: uppercase;
    padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; position: relative; z-index: 1;
    border: 1px solid rgba(255, 255, 255, .25);
  }
  .kyc-submitted-badge i { color: #86efac; }
  .pay-hero-greeting { position: relative; z-index: 1; font-size: 12.5px; opacity: .82; margin-bottom: 2px; font-weight: 500; }
  .pay-hero h1 { position: relative; z-index: 1; font-size: 20px; font-weight: 700; margin-bottom: 8px; }
  .pay-hero p { position: relative; z-index: 1; font-size: 13px; opacity: .88; margin-bottom: 0; line-height: 1.55; max-width: 340px; margin-inline: auto; }

  /* ---- Amount "ticket" ---- */
  .pay-amount-box {
    margin: -28px 22px 0; background: #fff; border-radius: 16px;
    box-shadow: 0 14px 30px rgba(31, 41, 55, .14); border: 1px solid #eef0f6;
    padding: 20px 22px; position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
  }
  .pay-amount-box::before, .pay-amount-box::after {
    content: ""; position: absolute; top: 50%; transform: translateY(-50%);
    width: 20px; height: 20px; border-radius: 50%; background: #eef0f8;
  }
  .pay-amount-box::before { left: -10px; } .pay-amount-box::after { right: -10px; }
  .pay-amount-label { font-size: 12px; color: #6b7280; font-weight: 600; margin-bottom: 3px; }
  .pay-amount-sub { font-size: 11px; color: #9aa3b2; display: flex; align-items: center; gap: 4px; }
  .pay-amount { font-size: 32px; font-weight: 800; color: #111827; line-height: 1; letter-spacing: -.5px; }
  .pay-amount-currency { font-size: 16px; font-weight: 700; color: #6b7280; vertical-align: top; margin-right: 2px; }

  /* ---- Benefits ---- */
  .pay-benefits { list-style: none; padding: 0; margin: 26px 24px 0; display: grid; gap: 10px; }
  .pay-benefits li {
    display: flex; align-items: center; gap: 12px; font-size: 13px; color: #374151; font-weight: 500;
    padding: 11px 14px; border-radius: 12px; background: #f8f9fd; border: 1px solid #f0f1f8;
  }
  .pay-benefits .chk {
    flex: none; width: 30px; height: 30px; border-radius: 9px;
    background: linear-gradient(135deg, #eef2ff, #e0e7ff); color: #4f46e5;
    display: flex; align-items: center; justify-content: center; font-size: 13px;
  }

  .pay-actions { padding: 24px 24px 4px; }
  .btn-pay-now {
    width: 100%; background: linear-gradient(135deg, #4f46e5, #6d5bf0); border: none;
    color: #fff; font-weight: 700; font-size: 15.5px; padding: 15px; border-radius: 14px;
    box-shadow: 0 12px 26px rgba(79, 70, 229, .32); transition: transform .12s ease, box-shadow .12s ease;
    letter-spacing: .2px;
  }
  .btn-pay-now:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 16px 32px rgba(79, 70, 229, .40); color: #fff; }
  .btn-pay-now:active:not(:disabled) { transform: translateY(0); }
  .btn-pay-now:disabled { opacity: .75; }

  .pay-trust-row {
    display: flex; align-items: center; justify-content: center; gap: 18px;
    padding: 16px 24px 26px; flex-wrap: wrap; border-top: 1px dashed #eceefb; margin: 18px 24px 0;
  }
  .pay-trust-row span { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #9aa3b2; font-weight: 600; }
  .pay-trust-row i { color: #4f46e5; }

  .kyc-support-note { text-align: center; font-size: 12px; color: #9aa3b2; margin-top: 18px; }
  .kyc-support-note a { color: #4f46e5; font-weight: 600; text-decoration: none; }

  /* ---- Success confirmation (shown after Razorpay verify succeeds) ---- */
  .success-panel { animation: successPop .35s ease-out; padding: 40px 30px 34px; text-align: center; }
  @keyframes successPop { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }
  .success-check-wrap {
    width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 18px;
    background: radial-gradient(circle, #f0fdf4, #ecfdf5);
    display: flex; align-items: center; justify-content: center;
  }
  .success-check-svg { width: 62px; height: 62px; }
  .success-check-circle {
    stroke: #22c55e; stroke-width: 3; fill: none;
    stroke-dasharray: 151; stroke-dashoffset: 151;
    animation: successCircle .5s ease-out forwards;
  }
  .success-check-mark {
    stroke: #22c55e; stroke-width: 4; fill: none; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 36; stroke-dashoffset: 36;
    animation: successMark .35s .45s ease-out forwards;
  }
  @keyframes successCircle { to { stroke-dashoffset: 0; } }
  @keyframes successMark { to { stroke-dashoffset: 0; } }
  .success-amount { font-size: 26px; font-weight: 800; color: #16a34a; }
  @media (prefers-reduced-motion: reduce) {
    .success-panel { animation: none; }
    .success-check-circle, .success-check-mark { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 420px) {
    .pay-hero { padding: 30px 20px 42px; }
    .pay-amount-box { margin: -26px 16px 0; padding: 18px; }
    .pay-benefits, .pay-actions, .pay-trust-row { margin-left: 14px; margin-right: 14px; }
  }
</style>

<div class="kyc-wrap">
  <div class="kyc-topbar fade-up">
    <img src="/logo.jpeg" alt="Dr WISE" class="kyc-logo">
    <%= button_to "Sign out", destroy_user_session_path, method: :delete,
          class: "btn btn-link btn-sm p-0 small text-muted text-decoration-none" %>
  </div>

  <div class="pay-tracker-label fade-up d1">
    <span class="on"><i class="fas fa-check-circle me-1"></i>KYC details</span>
    <span class="on">Payment</span>
    <span>Under review</span>
  </div>
  <div class="pay-tracker fade-up d1">
    <div class="seg"></div>
    <div class="seg current"></div>
    <div class="seg" style="background:#e5e7f5;"></div>
  </div>

  <div class="kyc-card text-center fade-up d2">
    <div id="payBody">
      <div class="pay-hero">
        <div class="kyc-submitted-badge"><i class="fas fa-check-circle"></i> KYC submitted successfully</div>
        <div class="pay-hero-icon"><i class="fas fa-file-invoice-dollar"></i></div>
        <div class="pay-hero-greeting">Hi <%= @distributor.display_name %>,</div>
        <h1>One-time registration fee</h1>
        <p>Complete this payment to activate your ambassador account
          while our team reviews your documents.</p>
      </div>

      <div class="pay-amount-box fade-up d3">
        <div class="text-start">
          <div class="pay-amount-label">Ambassador registration</div>
          <div class="pay-amount-sub"><i class="fas fa-circle-check text-success"></i> Charged only once</div>
        </div>
        <div class="pay-amount" id="payAmountDisplay"><%= indian_currency(@amount) %></div>
      </div>

      <ul class="pay-benefits text-start fade-up d4">
        <li><span class="chk"><i class="fas fa-gauge-high"></i></span> Full access to your ambassador dashboard &amp; wallet</li>
        <li><span class="chk"><i class="fas fa-chart-line"></i></span> Track referrals, commissions &amp; payouts in real time</li>
        <li><span class="chk"><i class="fas fa-bolt"></i></span> Priority review of your submitted KYC documents</li>
      </ul>

      <div class="pay-actions fade-up d5">
        <div id="payErrorBox" class="alert alert-danger small mb-3 text-start" style="display:none;"></div>
        <button id="payNowBtn" type="button" class="btn btn-pay-now">
          <i class="fas fa-lock me-2"></i>Pay <%= indian_currency(@amount) %> Securely
        </button>
      </div>

      <div class="pay-trust-row fade-up d5">
        <span><i class="fas fa-shield-alt"></i> 256-bit encrypted</span>
        <span><i class="fas fa-bolt"></i> Powered by Razorpay</span>
        <span><i class="fas fa-wallet"></i> UPI &middot; Cards &middot; Netbanking</span>
      </div>
    </div>

    <div class="success-panel" id="successPanel" style="display:none;">
      <div class="success-check-wrap">
        <svg viewBox="0 0 52 52" class="success-check-svg">
          <circle class="success-check-circle" cx="26" cy="26" r="24" />
          <path class="success-check-mark" d="M14 27l7 7 16-16" />
        </svg>
      </div>
      <h1 class="h4 fw-bold mb-1">Payment successful!</h1>
      <p class="text-muted small mb-3">
        <span class="success-amount" id="successAmount"><%= indian_currency(@amount) %></span> received.
        Your KYC has been submitted for review.
      </p>
      <button id="continueBtn" type="button" class="btn btn-primary px-4">Continue</button>
    </div>
  </div>

  <p class="kyc-support-note fade-up d5">Having trouble paying? <a href="mailto:support@dr-wise.in">Contact support</a></p>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function () {
    var btn = document.getElementById("payNowBtn");
    var errorBox = document.getElementById("payErrorBox");
    var csrf = document.querySelector('meta[name="csrf-token"]').content;

    function showError(message) {
      errorBox.textContent = message;
      errorBox.style.display = "block";
    }

    btn.addEventListener("click", async function () {
      errorBox.style.display = "none";
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Please wait...';

      try {
        var orderRes = await fetch("<%= ambassador_kyc_payment_order_path %>", {
          method: "POST",
          headers: { "X-CSRF-Token": csrf }
        });
        var order = await orderRes.json();
        if (!orderRes.ok) throw new Error(order.error || "Could not start payment.");

        var rzp = new Razorpay({
          key: order.key,
          amount: order.amount,
          currency: order.currency,
          order_id: order.order_id,
          name: order.name,
          description: order.description,
          prefill: order.prefill,
          theme: { color: "#4f46e5" },
          handler: async function (response) {
            try {
              var verifyRes = await fetch("<%= ambassador_kyc_payment_verify_path %>", {
                method: "POST",
                headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
                body: JSON.stringify({
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature
                })
              });
              var result = await verifyRes.json();
              if (!verifyRes.ok) throw new Error(result.error || "Payment verification failed.");
              showSuccess(result.redirect_to);
            } catch (err) {
              showError(err.message);
              resetButton();
            }
          },
          modal: {
            ondismiss: function () { resetButton(); }
          }
        });
        rzp.on("payment.failed", function (response) {
          showError(response.error.description || "Payment failed. Please try again.");
          resetButton();
        });
        rzp.open();
      } catch (err) {
        showError(err.message);
        resetButton();
      }
    });

    function resetButton() {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-lock me-2"></i>Pay <%= indian_currency(@amount) %> Securely';
    }

    function showSuccess(redirectTo) {
      document.getElementById("payBody").style.display = "none";
      document.getElementById("successPanel").style.display = "block";

      var go = function () { window.location.href = redirectTo; };
      document.getElementById("continueBtn").addEventListener("click", go);
      setTimeout(go, 2500);
    }
  })();
</script>

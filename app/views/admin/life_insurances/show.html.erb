      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Agency Code (All Agents)*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.agency_code&.code %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Insurance Company Name*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.insurance_company_name %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Type*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_type %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Payment Mode*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.payment_mode %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Number*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_number %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Booking Date</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_booking_date&.strftime('%Y-%m-%d') %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Start Date*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_start_date&.strftime('%Y-%m-%d') %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy End Date*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_end_date&.strftime('%Y-%m-%d') %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Risk Start Date</label>
        <input type="text" class="form-control" value="<%= @life_insurance.risk_start_date&.strftime('%Y-%m-%d') if @life_insurance.risk_start_date %>" readonly>

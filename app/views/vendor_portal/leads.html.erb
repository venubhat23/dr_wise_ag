<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">My Leads</h2>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: vendor_leads_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end" do |form| %>
      <div>
        <%= form.select :stage,
              options_for_select([['All Stages', '']] + Lead.current_stages.keys.map { |s| [s.humanize, s] }, params[:stage]),
              {}, { class: "form-select" } %>
      </div>
      <div class="d-flex gap-2">
        <%= form.submit "Filter", class: "btn btn-primary" %>
        <%= link_to "Clear", vendor_leads_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @leads.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Name</th>
              <th class="border-0">Contact</th>
              <th class="border-0">Product</th>
              <th class="border-0">Lead Value</th>
              <th class="border-0">Stage</th>
              <th class="border-0">Move To</th>
            </tr>
          </thead>
          <tbody>
            <% @leads.each do |lead| %>
              <tr>
                <td><%= lead.name %></td>
                <td>
                  <div><%= lead.contact_number %></div>
                  <% if lead.email.present? %><small class="text-muted"><%= lead.email %></small><% end %>
                </td>
                <td><%= lead.product_category&.humanize %> / <%= lead.product_subcategory&.humanize %></td>
                <td><%= indian_currency(lead.referral_amount) %></td>
                <td><span class="badge <%= lead.stage_badge_class %>"><%= lead.stage_display_name %></span></td>
                <td>
                  <% if lead.next_stage_options.any? %>
                    <form action="<%= update_vendor_lead_stage_path(lead) %>" method="post" class="d-flex gap-1">
                      <input type="hidden" name="_method" value="patch">
                      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                      <select name="new_stage" class="form-select form-select-sm" style="width: auto;">
                        <% lead.next_stage_options.each do |stage| %>
                          <option value="<%= stage %>"><%= stage.humanize %></option>
                        <% end %>
                      </select>
                      <button type="submit" class="btn btn-sm btn-primary">Move</button>
                    </form>
                  <% else %>
                    <small class="text-muted">No further stages</small>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-transparent border-0">
        <%= render 'shared/pagination', records: @leads %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h5 class="mt-3 mb-0">No leads found</h5>
      </div>
    <% end %>
  </div>
</div>

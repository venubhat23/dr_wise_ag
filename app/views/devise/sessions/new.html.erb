
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body, html {
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: #f5f5f5;
}

/* Override any existing body styles */
body {
  margin: 0 !important;
  padding: 0 !important;
}

.auth-wrapper {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  position: relative;
}

.auth-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd"><g fill="%23ffffff" fill-opacity="0.05"><circle cx="7" cy="7" r="2"/><circle cx="27" cy="7" r="1"/><circle cx="47" cy="7" r="2"/><circle cx="7" cy="27" r="1"/><circle cx="27" cy="27" r="2"/><circle cx="47" cy="27" r="1"/><circle cx="7" cy="47" r="2"/><circle cx="27" cy="47" r="1"/><circle cx="47" cy="47" r="2"/></g></svg>');
  pointer-events: none;
}

.login-container {
  display: flex;
  max-width: 900px;
  width: 100%;
  min-height: 500px;
  background: white;
  border-radius: 24px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
  overflow: hidden;
  position: relative;
  z-index: 1;
}

/* Medium screens optimization */
@media (max-width: 1000px) and (min-width: 901px) {
  .login-container {
    max-width: 800px;
  }

  .illustration-section {
    padding: 35px;
  }

  .form-section {
    padding: 35px;
  }
}

.illustration-section {
  flex: 1;
  background: linear-gradient(135deg, #4285f4 0%, #34a853 100%);
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  min-height: 500px;
}

.illustration-section::before {
  content: '';
  position: absolute;
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  top: -20px;
  right: -20px;
}

.illustration-section::after {
  content: '';
  position: absolute;
  width: 80px;
  height: 80px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
  bottom: -10px;
  left: -10px;
}

.illustration-content {
  text-align: center;
  color: white;
  z-index: 2;
  max-width: 280px;
}

.insurance-icon {
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.insurance-icon::before {
  content: '🛡️';
  font-size: 48px;
}

.illustration-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 12px;
  line-height: 1.3;
}

.illustration-subtitle {
  font-size: 0.95rem;
  opacity: 0.9;
  line-height: 1.5;
}

.form-section {
  flex: 1;
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 500px;
}

.brand-header {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.brand-icon {
  width: 32px;
  height: 32px;
  background: #4285f4;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.brand-icon::before {
  content: '✓';
  color: white;
  font-weight: bold;
  font-size: 16px;
}

.brand-name {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0;
}

.welcome-section {
  margin: 24px 0 32px 0;
}

.welcome-text {
  font-size: 1.75rem;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
}

.welcome-text .wave-emoji {
  margin-left: 8px;
  font-size: 1.5rem;
}

.subtitle {
  color: #666;
  font-size: 0.95rem;
  line-height: 1.4;
}

.form-group {
  margin-bottom: 20px;
  position: relative;
}

.form-input {
  width: 100%;
  padding: 14px 16px 14px 44px;
  border: 2px solid #e8eaed;
  border-radius: 12px;
  font-size: 0.95rem;
  background: #fafbfc;
  transition: all 0.2s ease;
  outline: none;
  font-family: inherit;
}

.form-input:focus {
  border-color: #4285f4;
  background: white;
  box-shadow: 0 0 0 3px rgba(66, 133, 244, 0.1);
}

.form-input::placeholder {
  color: #9aa0a6;
}

.input-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 16px;
  color: #9aa0a6;
  pointer-events: none;
}

.form-input:focus + .input-icon {
  color: #4285f4;
}

.form-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.remember-me {
  display: flex;
  align-items: center;
}

.remember-me input[type="checkbox"] {
  width: 16px;
  height: 16px;
  margin-right: 8px;
  accent-color: #4285f4;
  border-radius: 3px;
}

.remember-me label {
  font-size: 0.875rem;
  color: #5f6368;
  cursor: pointer;
}

.forgot-password {
  color: #4285f4;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
}

.forgot-password:hover {
  text-decoration: underline;
}

.login-btn {
  width: 100%;
  padding: 14px;
  background: #4285f4;
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 20px;
  font-family: inherit;
}

.login-btn:hover {
  background: #3367d6;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
}

.login-btn:active {
  transform: translateY(0);
}

.signup-link {
  text-align: center;
  color: #5f6368;
  margin-bottom: 16px;
  font-size: 0.875rem;
}

.signup-link a {
  color: #4285f4;
  text-decoration: none;
  font-weight: 600;
}

.signup-link a:hover {
  text-decoration: underline;
}

.footer-links {
  text-align: center;
  padding-top: 16px;
  border-top: 1px solid #e8eaed;
}

.footer-links a {
  color: #5f6368;
  text-decoration: none;
  font-size: 0.8rem;
  margin: 0 12px;
}

.footer-links a:hover {
  color: #4285f4;
  text-decoration: underline;
}

.password-toggle {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #9aa0a6;
  cursor: pointer;
  font-size: 14px;
  padding: 4px;
  border-radius: 4px;
}

.password-toggle:hover {
  color: #4285f4;
  background: rgba(66, 133, 244, 0.05);
}


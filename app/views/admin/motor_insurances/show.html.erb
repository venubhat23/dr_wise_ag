      <div class="col-md-4 mb-3">
        <label class="form-label">Make</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.make %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Model</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.model %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Variant</label>

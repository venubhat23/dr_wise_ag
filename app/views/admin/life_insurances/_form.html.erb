      .then(data => {
        // Transform brokers data to broker_codes format
        if (data && data.brokers) {
          const transformedData = {
            success: true,
            broker_codes: data.brokers.map(broker => ({
              id: broker.id,
              broker_id: broker.id,
              broker_name: broker.name,
              broker_code: broker.code || broker.name,
              display_name: `${broker.name} (${broker.code || broker.name})`
            }))
          };
          return transformedData;
        }
        throw new Error('Invalid alternative endpoint response');

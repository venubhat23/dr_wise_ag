<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Agency Code Management</h2>
    <p class="text-muted mb-0">Manage agency codes by insurance type</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <div class="dropdown">
      <select class="form-select" id="clientIdSelect">
        <option>Client ID</option>
      </select>
    </div>
    <div class="position-relative">
      <input type="text" class="form-control" placeholder="Enter Client ID" style="width: 200px;">
    </div>
  </div>
</div>

<!-- Agency Code Management Section -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent border-0 d-flex align-items-center">
    <i class="bi bi-building me-2 text-primary fs-5"></i>
    <div>
      <h5 class="mb-0">Agency Code Management</h5>
      <small class="text-muted">Manage agency codes by insurance type</small>
    </div>
    <button class="btn btn-sm btn-outline-secondary ms-auto" type="button">
      <i class="bi bi-chevron-up"></i>
    </button>
  </div>

  <div class="card-body">
    <!-- Add New Agency Code Form -->
    <h6 class="mb-3">Add Agency Code</h6>

    <%= form_with model: [:admin, @agency_code], local: true, class: "row g-3 mb-4", data: { turbo: false } do |form| %>
      <div class="col-md-3">
        <label class="form-label">Type</label>
        <%= form.select :insurance_type,
            options_for_select(@insurance_types.map { |type| [type, type] }, @agency_code.insurance_type),
            { prompt: 'Select Type' },
            { class: "form-select", required: true } %>
        <% if @agency_code.errors[:insurance_type].any? %>
          <div class="text-danger small"><%= @agency_code.errors[:insurance_type].first %></div>
        <% end %>
      </div>

      <div class="col-md-3">
        <label class="form-label">Company Name</label>
        <%= form.select :company_name,
            options_for_select(@insurance_companies.map { |company| [company, company] }, @agency_code.company_name),
            { prompt: 'Select Company' },
            { class: "form-select", required: true } %>
        <% if @agency_code.errors[:company_name].any? %>
          <div class="text-danger small"><%= @agency_code.errors[:company_name].first %></div>
        <% end %>
      </div>

      <div class="col-md-3">
        <label class="form-label">Agent Name</label>
        <%= form.text_field :agent_name,
            class: "form-control",
            placeholder: "Enter agent name",
            required: true %>
        <% if @agency_code.errors[:agent_name].any? %>
          <div class="text-danger small"><%= @agency_code.errors[:agent_name].first %></div>
        <% end %>
      </div>

      <div class="col-md-3">
        <label class="form-label">Agency Code</label>
        <div class="d-flex gap-2">
          <%= form.text_field :code,
              class: "form-control",
              placeholder: "Enter agency code",
              required: true %>
          <%= form.submit "Save Agency Code", class: "btn btn-primary" %>
        </div>
        <% if @agency_code.errors[:code].any? %>
          <div class="text-danger small"><%= @agency_code.errors[:code].first %></div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Agency Code List Section -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
    <h6 class="mb-0">Agency Code List</h6>
    <div class="d-flex align-items-center gap-3">
      <!-- Search Bar -->
      <div class="position-relative">
        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
        <input type="text"
               id="searchInput"
               class="form-control ps-4"
               placeholder="Search by company or agent"
               value="<%= params[:search] %>"
               style="width: 250px;">
      </div>
    </div>
  </div>

  <div class="card-body">
    <!-- Statistics Row -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="d-flex align-items-center">
          <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-2">
            <i class="bi bi-collection text-primary"></i>
          </div>
          <div>
            <div class="fw-bold"><%= @total_codes %></div>
            <small class="text-muted">Total Codes</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-opacity-10 rounded-circle p-2 me-2">
            <i class="bi bi-heart-pulse text-success"></i>
          </div>
          <div>
            <div class="fw-bold"><%= @health_codes %></div>
            <small class="text-muted">Health</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-2">
            <i class="bi bi-car-front text-warning"></i>
          </div>
          <div>
            <div class="fw-bold"><%= @motor_codes %></div>
            <small class="text-muted">Motor</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="d-flex align-items-center">
          <div class="bg-info bg-opacity-10 rounded-circle p-2 me-2">
            <i class="bi bi-life-preserver text-info"></i>
          </div>
          <div>
            <div class="fw-bold"><%= @life_codes %></div>
            <small class="text-muted">Life</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Agency Codes Table -->
    <div id="agency-codes-table">
      <%= render 'agency_codes_table', agency_codes: @agency_codes %>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Agency Code</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div id="editModalBody">
        <!-- Edit form will be loaded here -->
      </div>
    </div>
  </div>
</div>

<style>
.table-responsive {
  border-radius: 8px;
  overflow: hidden;
}

.table th {
  background-color: #f8f9fa;
  border: none;
  font-weight: 600;
  color: #495057;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 1rem 0.75rem;
}

.table td {
  border: none;
  border-bottom: 1px solid #f1f3f4;
  padding: 1rem 0.75rem;
  vertical-align: middle;
}

.table tbody tr:hover {
  background-color: #f8f9fa;
}

.badge {
  font-weight: 500;
  font-size: 0.75rem;
  padding: 0.375rem 0.75rem;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.75rem;
}

.company-badge {
  background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
}

.type-badge-health { background-color: #d4edda; color: #155724; }
.type-badge-motor { background-color: #fff3cd; color: #856404; }
.type-badge-life { background-color: #cce7ff; color: #004085; }
.type-badge-general { background-color: #f8d7da; color: #721c24; }
.type-badge-other { background-color: #e2e3e5; color: #383d41; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('searchInput');

  // Debounced search
  let searchTimeout;
  searchInput?.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      performSearch();
    }, 500);
  });

  function performSearch() {
    const searchTerm = searchInput.value.trim();
    const url = new URL('<%= admin_agency_codes_search_path %>', window.location.origin);

    if (searchTerm) {
      url.searchParams.set('search', searchTerm);
    }

    fetch(url, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.text())
    .then(html => {
      document.getElementById('agency-codes-table').innerHTML = html;
    })
    .catch(error => {
      console.error('Search error:', error);
    });
  }

  // Handle edit modal
  document.addEventListener('click', function(e) {
    if (e.target.matches('.edit-agency-code') || e.target.closest('.edit-agency-code')) {
      e.preventDefault();
      const button = e.target.closest('.edit-agency-code');
      const url = button.href;

      fetch(url, {
        method: 'GET',
        headers: {
          'Accept': 'text/html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.text())
      .then(html => {
        document.getElementById('editModalBody').innerHTML = html;
        const modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();
      })
      .catch(error => {
        console.error('Edit modal error:', error);
      });
    }
  });

  // Handle delete confirmation
  document.addEventListener('click', function(e) {
    if (e.target.matches('.delete-agency-code') || e.target.closest('.delete-agency-code')) {
      if (!confirm('Are you sure you want to delete this agency code?')) {
        e.preventDefault();
      }
    }
  });
});
</script>
<% content_for :page_title, "Add General Insurance" %>
<% content_for :page_subtitle, "Easily create and manage general insurance details" %>

<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
  /* Enhanced Select2 styling */
  .select2-container--bootstrap-5 .select2-selection--single {
    height: 38px !important;
    padding: 6px 12px !important;
    border: 1px solid #ced4da !important;
    border-radius: 0.375rem !important;
  }

  .select2-container--bootstrap-5 .select2-selection--single:focus-within {
    border-color: #86b7fe !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
  }

  .select2-container--bootstrap-5 .select2-selection__rendered {
    color: #212529 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .select2-container--bootstrap-5 .select2-results__option {
    padding: 8px 12px !important;
  }

  .select2-container--bootstrap-5 .select2-results__option--highlighted {
    background-color: #0d6efd !important;
    color: white !important;
  }

  .select2-dropdown {
    border: 1px solid #ced4da !important;
    border-radius: 0.375rem !important;
  }

  .select2-results__options {
    max-height: 200px !important;
  }

  .select2-dropdown-large .select2-results__options {
    max-height: 300px !important;
  }

  .select2-dropdown-large {
    min-width: 300px !important;
  }

  .select2-dropdown-large .select2-results__option {
    padding: 10px 15px !important;
    border-bottom: 1px solid #f8f9fa;
  }

  .select2-search__field {
    padding: 8px 12px !important;
    border-radius: 0.375rem !important;
    border: 1px solid #ced4da !important;
  }
</style>

<!-- Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <%= link_to admin_other_insurances_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Back to List
    <% end %>
  </div>

  <div class="trust-seal">
    <i class="bi bi-shield-check seal-icon"></i>
    <span>Save Policy</span>
  </div>
</div>

<%= form_with model: [:admin, @other_insurance], local: true, class: "needs-validation", novalidate: true do |form| %>

  <!-- Client & Agent Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-person me-2 text-primary"></i>
        Client & Agent Details
      </h5>
    </div>
    <div class="card-body">
      <% if @other_insurance.errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Please correct the following errors:</strong>
          <ul class="mb-0 mt-2">
            <% @other_insurance.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :customer_id, "Client Name*", class: "form-label" %>
          <%= form.select :customer_id,
              options_for_select(@customers.map { |c| [c.display_name, c.id] }, @selected_customer&.id || @other_insurance.customer_id),
              { prompt: 'Search and select client...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:customer_id].any?}", required: true, id: "customer_select", data: { placeholder: "Type to search clients..." } } %>
          <% if @other_insurance.errors[:customer_id].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:customer_id].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :plan_name, "Plan Name", class: "form-label" %>
          <%= form.text_field :plan_name,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:plan_name].any?}",
              placeholder: "Enter plan name...",
              id: "plan_name_field" %>
          <% if @other_insurance.errors[:plan_name].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:plan_name].first %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Policy Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-file-text me-2 text-primary"></i>
        Policy Details
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- Insurance Company -->
        <div class="col-md-4 mb-3">
          <%= form.label :insurance_company_id, "Insurance Company*", class: "form-label" %>
          <%= form.select :insurance_company_id,
              options_for_select(@insurance_companies.map { |c| [c.name, c.id] }, @other_insurance.insurance_company_id),
              { prompt: 'Search and select company...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:insurance_company_id].any?}", required: true, id: "insurance_company_select", data: { placeholder: "Type to search companies..." } } %>
          <% if @other_insurance.errors[:insurance_company_id].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:insurance_company_id].first %></div>
          <% end %>
        </div>

        <!-- Policy Type -->
        <div class="col-md-4 mb-3">
          <%= form.label :policy_type, "Policy Type*", class: "form-label" %>
          <%= form.select :policy_type,
              options_for_select([
                ['New', 'New'],
                ['Renewal', 'Renewal'],
                ['Portability', 'Portability']
              ], @other_insurance.policy_type),
              { prompt: 'Select policy type...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_type].any?}", required: true, id: "policy_type_select", data: { placeholder: "Select policy type..." } } %>
          <% if @other_insurance.errors[:policy_type].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_type].first %></div>
          <% end %>
        </div>

        <!-- Policy Number -->
        <div class="col-md-4 mb-3">
          <%= form.label :policy_number, "Policy Number*", class: "form-label" %>
          <%= form.text_field :policy_number,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_number].any?}",
              placeholder: "Enter policy number...",
              required: true %>
          <% if @other_insurance.errors[:policy_number].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_number].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row">
        <!-- Policy Start Date -->
        <div class="col-md-4 mb-3">
          <%= form.label :policy_start_date, "Policy Start Date*", class: "form-label" %>
          <%= form.date_field :policy_start_date,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_start_date].any?}",
              required: true %>
          <% if @other_insurance.errors[:policy_start_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_start_date].first %></div>
          <% end %>
        </div>

        <!-- Policy End Date -->
        <div class="col-md-4 mb-3">
          <%= form.label :policy_end_date, "Policy End Date*", class: "form-label" %>
          <%= form.date_field :policy_end_date,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_end_date].any?}",
              required: true %>
          <% if @other_insurance.errors[:policy_end_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_end_date].first %></div>
          <% end %>
        </div>

      </div>

      <div class="row">
        <!-- Payment Mode -->
        <div class="col-md-4 mb-3">
          <%= form.label :payment_mode, "Payment Mode*", class: "form-label" %>
          <%= form.select :payment_mode,
              options_for_select([
                ['Monthly', 'Monthly'],
                ['Quarterly', 'Quarterly'],
                ['Half Yearly', 'Half Yearly'],
                ['Yearly', 'Yearly'],
                ['One Time', 'One Time']
              ], @other_insurance.payment_mode),
              { prompt: 'Select payment mode...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:payment_mode].any?}", required: true, id: "payment_mode_select", data: { placeholder: "Select payment mode..." } } %>
          <% if @other_insurance.errors[:payment_mode].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:payment_mode].first %></div>
          <% end %>
        </div>

        <!-- Status -->
        <div class="col-md-4 mb-3">
          <%= form.label :status, "Status*", class: "form-label" %>
          <%= form.select :status,
              options_for_select([
                ['Active', 'active'],
                ['Expired', 'expired'],
                ['Cancelled', 'cancelled'],
                ['Pending', 'pending']
              ], @other_insurance.status || 'active'),
              { prompt: 'Select status...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:status].any?}", required: true, id: "status_select", data: { placeholder: "Select status..." } } %>
          <% if @other_insurance.errors[:status].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:status].first %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Financial Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-currency-rupee me-2 text-primary"></i>
        Financial Details
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- Sum Insured -->
        <div class="col-md-4 mb-3">
          <%= form.label :sum_insured, "Sum Insured*", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">₹</span>
            <%= form.number_field :sum_insured,
                class: "form-control #{'is-invalid' if @other_insurance.errors[:sum_insured].any?}",
                placeholder: "0",
                step: 1,
                min: 0,
                required: true %>
            <% if @other_insurance.errors[:sum_insured].any? %>
              <div class="invalid-feedback"><%= @other_insurance.errors[:sum_insured].first %></div>
            <% end %>
          </div>
        </div>

        <!-- Net Premium -->
        <div class="col-md-4 mb-3">
          <%= form.label :net_premium, "Net Premium*", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">₹</span>
            <%= form.number_field :net_premium,
                class: "form-control #{'is-invalid' if @other_insurance.errors[:net_premium].any?}",
                placeholder: "0.00",
                step: 0.01,
                min: 0,
                required: true,
                id: "net_premium_field" %>
            <% if @other_insurance.errors[:net_premium].any? %>
              <div class="invalid-feedback"><%= @other_insurance.errors[:net_premium].first %></div>
            <% end %>
          </div>
        </div>

        <!-- GST Percentage -->
        <div class="col-md-4 mb-3">
          <%= form.label :gst_percentage, "GST %", class: "form-label" %>
          <div class="input-group">
            <%= form.number_field :gst_percentage,
                class: "form-control #{'is-invalid' if @other_insurance.errors[:gst_percentage].any?}",
                placeholder: "18.00",
                step: 0.01,
                min: 0,
                max: 100,
                value: @other_insurance.gst_percentage || 18.0,
                id: "gst_percentage_field" %>
            <span class="input-group-text">%</span>
            <% if @other_insurance.errors[:gst_percentage].any? %>
              <div class="invalid-feedback"><%= @other_insurance.errors[:gst_percentage].first %></div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="row">
        <!-- Total Premium -->
        <div class="col-md-4 mb-3">
          <%= form.label :total_premium, "Total Premium*", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">₹</span>
            <%= form.number_field :total_premium,
                class: "form-control #{'is-invalid' if @other_insurance.errors[:total_premium].any?}",
                placeholder: "0.00",
                step: 0.01,
                min: 0,
                required: true,
                id: "total_premium_field" %>
            <% if @other_insurance.errors[:total_premium].any? %>
              <div class="invalid-feedback"><%= @other_insurance.errors[:total_premium].first %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Submit Buttons -->
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-end gap-2">
        <%= link_to "Cancel", admin_other_insurances_path, class: "btn btn-outline-secondary" %>
        <%= form.submit "Save General Insurance Policy", class: "btn btn-primary", id: "submit_button" %>
      </div>
    </div>
  </div>

<% end %>

<!-- JavaScript for Enhanced Functionality -->
<script>
  $(document).ready(function() {
    // Initialize Select2 dropdowns
    if (typeof $ !== 'undefined' && typeof $.fn.select2 !== 'undefined') {
      $('#customer_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Search and select client...',
        allowClear: true,
        dropdownCssClass: 'select2-dropdown-large',
        language: {
          noResults: function() {
            return "No clients found";
          }
        }
      });


      $('#insurance_company_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Search and select company...',
        allowClear: false,
        dropdownCssClass: 'select2-dropdown-large',
        language: {
          noResults: function() {
            return "No companies found";
          }
        }
      });


      $('#policy_type_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Select policy type...',
        allowClear: false,
        dropdownCssClass: 'select2-dropdown-large',
        minimumResultsForSearch: Infinity
      });

      $('#payment_mode_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Select payment mode...',
        allowClear: false,
        dropdownCssClass: 'select2-dropdown-large',
        minimumResultsForSearch: Infinity
      });

      $('#status_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Select status...',
        allowClear: false,
        dropdownCssClass: 'select2-dropdown-large',
        minimumResultsForSearch: Infinity
      });
    }

    // Customer selection change handler can be added here if needed in the future

    // Auto-calculate total premium
    function calculateTotalPremium() {
      var netPremium = parseFloat($('#net_premium_field').val()) || 0;
      var gstPercentage = parseFloat($('#gst_percentage_field').val()) || 0;

      var gstAmount = (netPremium * gstPercentage) / 100;
      var totalPremium = netPremium + gstAmount;

      $('#total_premium_field').val(totalPremium.toFixed(2));
    }

    $('#net_premium_field, #gst_percentage_field').on('input', calculateTotalPremium);

    // Form validation
    $('form').on('submit', function(e) {
      var isValid = true;
      var requiredFields = ['customer_select', 'insurance_company_select', 'policy_type_select', 'policy_number', 'policy_start_date', 'policy_end_date', 'payment_mode_select', 'status_select', 'sum_insured', 'net_premium_field', 'total_premium_field'];

      requiredFields.forEach(function(fieldId) {
        var field = $('#' + fieldId);
        if (field.val() === '' || field.val() === null) {
          field.addClass('is-invalid');
          isValid = false;
        } else {
          field.removeClass('is-invalid');
        }
      });

      if (!isValid) {
        e.preventDefault();
        alert('Please fill in all required fields.');
      }
    });

    // Calculate total premium on page load if values exist
    calculateTotalPremium();
  });
</script>
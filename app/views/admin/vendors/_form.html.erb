<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<% existing_commissions = @vendor.vendor_products.index_by { |vp| "#{vp.product_category}::#{vp.product_subcategory}" } %>
<% selected_keys = existing_commissions.keys %>

<%= form_with model: [:admin, @vendor], local: true, data: { turbo: false } do |form| %>
  <% if @vendor.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading mb-2"><%= pluralize(@vendor.errors.count, "error") %> prevented this vendor from being saved:</h6>
      <ul class="mb-0">
        <% @vendor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 1. Vendor Details -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-transparent">
      <h5 class="mb-0"><i class="bi bi-shop me-2"></i>1. Vendor Details</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :name, class: "form-label" do %>
            Vendor Name <span class="text-danger">*</span>
          <% end %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="col-md-6">
          <%= form.label :company_name, "Company", class: "form-label" %>
          <%= form.text_field :company_name, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :phone_number, "Phone Number", class: "form-label" %>
          <%= form.text_field :phone_number, class: "form-control", placeholder: "9XXXXXXXXX" %>
        </div>

        <div class="col-md-6">
          <%= form.label :gst_number, "GST Number", class: "form-label" %>
          <%= form.text_field :gst_number, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :status, class: "form-label" %>
          <%= form.select :status,
                options_for_select([['Active', 'active'], ['Inactive', 'inactive']], @vendor.status),
                {}, { class: "form-select" } %>
        </div>

        <div class="col-12">
          <%= form.label :address, class: "form-label" %>
          <%= form.text_area :address, class: "form-control", rows: 2 %>
        </div>

        <div class="col-12">
          <%= form.label :notes, "Other Vendor Info / Notes", class: "form-label" %>
          <%= form.text_area :notes, class: "form-control", rows: 3, placeholder: "Any other information about this vendor" %>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Products & Commission -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-transparent">
      <h5 class="mb-0"><i class="bi bi-tags me-2"></i>2. Products & Commission</h5>
    </div>
    <div class="card-body">
      <div class="mb-3">
        <label for="vendor_product_selections" class="form-label">Products <span class="text-muted">(select all that apply)</span></label>
        <select multiple
                name="vendor[product_selections][]"
                id="vendor_product_selections"
                class="form-control"
                style="width: 100%;">
          <% Vendor::PRODUCT_TAXONOMY.each do |category, subcategories| %>
            <optgroup label="<%= category %>">
              <% subcategories.each do |subcategory| %>
                <% key = "#{category}::#{subcategory}" %>
                <option value="<%= key %>" <%= 'selected' if selected_keys.include?(key) %>><%= subcategory %></option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
      </div>

      <div id="product-commission-rows">
        <p id="no-products-selected-hint" class="text-muted mb-0">Select one or more products above to set a commission percentage for each.</p>

        <% Vendor::PRODUCT_TAXONOMY.each do |category, subcategories| %>
          <% subcategories.each do |subcategory| %>
            <% key = "#{category}::#{subcategory}" %>
            <div class="row align-items-center py-2 border-bottom product-commission-row" data-product-key="<%= key %>" style="display: none;">
              <div class="col-md-6">
                <span class="badge bg-light text-dark border me-1"><%= category %></span>
                <%= subcategory %>
              </div>
              <div class="col-md-6">
                <div class="input-group">
                  <input type="number"
                         name="vendor[product_commissions][<%= key %>]"
                         class="form-control"
                         min="0" max="100" step="0.01"
                         value="<%= existing_commissions[key]&.commission_percentage || 0 %>"
                         placeholder="Commission %">
                  <span class="input-group-text">%</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Cancel", admin_vendors_path, class: "btn btn-outline-secondary" %>
    <%= form.submit @vendor.persisted? ? "Update Vendor" : "Create Vendor", class: "btn btn-primary" %>
  </div>
<% end %>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  function updateVisibleCommissionRows(selectedKeys) {
    var anySelected = selectedKeys.length > 0;
    document.getElementById('no-products-selected-hint').style.display = anySelected ? 'none' : 'block';

    document.querySelectorAll('.product-commission-row').forEach(function (row) {
      var key = row.getAttribute('data-product-key');
      row.style.display = selectedKeys.indexOf(key) !== -1 ? 'flex' : 'none';
    });
  }

  if (typeof $ !== 'undefined' && $.fn.select2) {
    var $select = $('#vendor_product_selections');
    $select.select2({
      theme: 'bootstrap-5',
      placeholder: 'Select products...',
      closeOnSelect: false
    });

    $select.on('change', function () {
      updateVisibleCommissionRows($(this).val() || []);
    });

    // Initial state (edit form pre-selection)
    updateVisibleCommissionRows($select.val() || []);
  } else {
    // Fallback if CDN failed to load: plain multiselect still works, just show all selected rows
    var select = document.getElementById('vendor_product_selections');
    function currentSelection() {
      return Array.prototype.slice.call(select.selectedOptions).map(function (o) { return o.value; });
    }
    select.addEventListener('change', function () {
      updateVisibleCommissionRows(currentSelection());
    });
    updateVisibleCommissionRows(currentSelection());
  }
});
</script>

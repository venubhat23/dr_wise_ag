<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_leads_path, method: :get, local: true, class: "row g-3" do |form| %>
      <div class="col-md-3">
        <%= form.text_field :search, placeholder: "Search leads...", value: params[:search], class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= form.select :current_stage, options_for_select([
          ['All Stages', ''],
          ['Consultation', 'consultation'],
          ['One-on-One', 'one_on_one'],
          ['Converted', 'converted'],
          ['Policy Created', 'policy_created'],
          ['Referral Settled', 'referral_settled']
        ], params[:current_stage]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= form.select :product_interest, options_for_select([
          ['All Products', ''],
          ['Health Insurance', 'health'],
          ['Life Insurance', 'life'],
          ['Motor Insurance', 'motor'],
          ['Other Insurance', 'other']
        ], params[:product_interest]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= form.select :referred_by, options_for_select([
          ['All Sources', ''],
          ['Agent Referral', 'agent'],
          ['Online Campaign', 'online'],
          ['Walk-in', 'walkin'],
          ['Tele-calling', 'telecalling']
        ], params[:referred_by]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= form.submit "Filter", class: "btn btn-outline-primary w-100" %>
      </div>
      <div class="col-md-1">
        <%= link_to admin_leads_path, class: "btn btn-outline-secondary w-100", title: "Clear filters" do %>
          <i class="bi bi-x-lg"></i>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Leads Database</h5>
    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-secondary" onclick="selectAll()">
        <i class="bi bi-check-square me-1"></i>Select All
      </button>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" id="bulkActionsBtn" disabled>
          <i class="bi bi-gear me-1"></i>
          Bulk Actions (<span id="selectedCount">0</span>)
        </button>
        <ul class="dropdown-menu">
          <li class="dropdown-header">Stage Transitions</li>
          <li><a href="#" class="dropdown-item" onclick="bulkUpdateStage('consultation')">Move to Consultation</a></li>
          <li><a href="#" class="dropdown-item" onclick="bulkUpdateStage('one_on_one')">Move to One-on-One</a></li>
          <li><a href="#" class="dropdown-item" onclick="bulkUpdateStage('converted')">Move to Converted</a></li>
          <li><a href="#" class="dropdown-item" onclick="bulkUpdateStage('policy_created')">Move to Policy Created</a></li>
          <li><a href="#" class="dropdown-item" onclick="bulkUpdateStage('referral_settled')">Move to Referral Settled</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a href="#" class="dropdown-item" onclick="bulkAdvanceStage()">Advance All Selected</a></li>
          <li><hr class="dropdown-divider"></li>
          <li class="dropdown-header">Other Actions</li>
          <li><a href="#" class="dropdown-item" onclick="bulkExport()">Export Selected</a></li>
          <li><a href="#" class="dropdown-item text-danger" onclick="bulkDelete()">Delete Selected</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="bg-light">
          <tr>
            <th class="border-0 ps-3" width="50">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll()">
              </div>
            </th>
            <th class="border-0">Lead ID</th>
            <th class="border-0">Lead Name</th>
            <th class="border-0">Contact Information</th>
            <th class="border-0">Referred By</th>
            <th class="border-0">Product Interest</th>
            <th class="border-0">Current Stage</th>
            <th class="border-0">Created Date</th>
            <th class="border-0">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @leads.any? %>
            <% @leads.each do |lead| %>
              <tr class="lead-row" data-id="<%= lead.id %>">
                <td class="ps-3">
                  <div class="form-check">
                    <input class="form-check-input lead-checkbox" type="checkbox" value="<%= lead.id %>">
                  </div>
                </td>
                <td>
                  <span class="badge bg-primary"><%= lead.lead_id.presence || "LEAD-#{lead.id}" %></span>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= lead.name %></h6>
                    <small class="text-muted"><%= lead.email %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <div class="mb-1"><%= lead.contact_number %></div>
                    <small class="text-muted"><%= lead.full_address.presence || 'Address not provided' %></small>
                  </div>
                </td>
                <td>
                  <span class="badge <%= lead.source_badge_class %>">
                    <%= lead.referred_by.presence || lead.lead_source&.humanize || 'Unknown' %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= lead.product_badge_class %>">
                    <%= lead.product_interest&.humanize || 'Not specified' %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= lead.stage_badge_class %>">
                    <%= lead.current_stage&.humanize || 'Unknown' %>
                  </span>
                </td>
                <td>
                  <div>
                    <div><%= lead.created_date&.strftime('%b %d, %Y') || lead.created_at&.strftime('%b %d, %Y') %></div>
                    <small class="text-muted"><%= time_ago_in_words(lead.created_at) %> ago</small>
                  </div>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to admin_lead_path(lead), class: "btn btn-sm btn-outline-primary", title: "View Details" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <% if lead.can_convert_to_customer? %>
                      <%= form_with url: convert_to_customer_admin_lead_path(lead), method: :patch, local: true,
                          style: "display: inline;",
                          onsubmit: "return confirm('Are you sure you want to convert this lead to a customer?')" do |f| %>
                        <button type="submit" class="btn btn-sm btn-outline-success" title="Convert to Customer">
                          <i class="bi bi-person-plus"></i>
                        </button>
                      <% end %>
                    <% else %>
                      <button class="btn btn-sm btn-outline-secondary" disabled title="Cannot convert at this stage">
                        <i class="bi bi-person-plus"></i>
                      </button>
                    <% end %>

                    <% if lead.can_create_policy? %>
                      <%= form_with url: create_policy_admin_lead_path(lead), method: :patch, local: true,
                          style: "display: inline;" do |f| %>
                        <button type="submit" class="btn btn-sm btn-outline-info" title="Create Policy">
                          <i class="bi bi-file-earmark-plus"></i>
                        </button>
                      <% end %>
                    <% else %>
                      <button class="btn btn-sm btn-outline-secondary" disabled title="Cannot create policy at this stage">
                        <i class="bi bi-file-earmark-plus"></i>
                      </button>
                    <% end %>

                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <li><%= link_to "Edit Lead", edit_admin_lead_path(lead), class: "dropdown-item" %></li>

                        <% if lead.can_advance? %>
                          <li>
                            <%= form_with url: advance_stage_admin_lead_path(lead), method: :patch, local: true,
                                style: "margin: 0; padding: 0; display: contents;",
                                onsubmit: "return confirm('Advance lead to #{lead.next_stage.humanize} stage?')" do |f| %>
                              <button type="submit" class="dropdown-item text-success border-0 bg-transparent w-100 text-start"
                                      style="cursor: pointer; padding: 0.375rem 1rem;">
                                <i class="bi bi-arrow-right me-1"></i>Advance to <%= lead.next_stage.humanize %>
                              </button>
                            <% end %>
                          </li>
                        <% end %>

                        <% if lead.can_go_back? %>
                          <li>
                            <%= form_with url: go_back_stage_admin_lead_path(lead), method: :patch, local: true,
                                style: "margin: 0; padding: 0; display: contents;",
                                onsubmit: "return confirm('Move lead back to #{lead.previous_stage.humanize} stage?')" do |f| %>
                              <button type="submit" class="dropdown-item text-warning border-0 bg-transparent w-100 text-start"
                                      style="cursor: pointer; padding: 0.375rem 1rem;">
                                <i class="bi bi-arrow-left me-1"></i>Go Back to <%= lead.previous_stage.humanize %>
                              </button>
                            <% end %>
                          </li>
                        <% end %>

                        <% if lead.can_advance? || lead.can_go_back? %>
                          <li><hr class="dropdown-divider"></li>
                          <li class="dropdown-header">Quick Stage Change</li>
                          <% lead.available_stages_for_transition.each do |stage| %>
                            <% unless stage == lead.current_stage %>
                              <li>
                                <%= form_with url: update_stage_admin_lead_path(lead, stage: stage), method: :patch, local: true,
                                    style: "margin: 0; padding: 0; display: contents;",
                                    onsubmit: "return confirm('Move lead to #{stage.humanize} stage?')" do |f| %>
                                  <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start"
                                          style="cursor: pointer; padding: 0.375rem 1rem;">
                                    <span class="badge <%= case stage
                                      when 'consultation' then 'bg-info'
                                      when 'one_on_one' then 'bg-warning'
                                      when 'converted' then 'bg-success'
                                      when 'policy_created' then 'bg-primary'
                                      when 'referral_settled' then 'bg-dark'
                                      end %> me-2"></span><%= stage.humanize %>
                                  </button>
                                <% end %>
                              </li>
                            <% end %>
                          <% end %>
                        <% end %>

                        <% if lead.can_settle_referral? %>
                          <li>
                            <%= form_with url: transfer_referral_admin_lead_path(lead), method: :patch, local: true,
                                style: "margin: 0; padding: 0; display: contents;",
                                onsubmit: "return confirm('Transfer referral amount of #{number_to_currency(lead.referral_amount || 0)}?')" do |f| %>
                              <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start"
                                      style="cursor: pointer; padding: 0.375rem 1rem;">
                                Transfer Referral
                              </button>
                            <% end %>
                          </li>
                        <% end %>

                        <li><a href="#" class="dropdown-item" onclick="showLeadModal(<%= lead.id %>)">View Details</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <%= link_to admin_lead_path(lead), method: :delete,
                              class: "dropdown-item text-danger",
                              data: { confirm: "Are you sure you want to delete this lead?" } do %>
                            Delete Lead
                          <% end %>
                        </li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="text-center py-5">
                <div class="text-muted">
                  <i class="bi bi-funnel fs-1 mb-3 d-block"></i>
                  <h5>No leads found</h5>
                  <p>Start by creating your first lead or adjust your search filters.</p>
                  <%= link_to "Add New Lead", new_admin_lead_path, class: "btn btn-primary" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Lead Details Modal -->

                      const stageColor = stage === 'converted' ? '#11998e' :
                                        stage === 'lead_generated' ? '#667eea' :
                                        stage === 'follow_up' ? '#f093fb' :
                                        stage === 'consultation_scheduled' ? '#4facfe' :
                                        stage === 'not_interested' ? '#f5576c' :
                                        stage === 'lead_closed' ? '#ff6b6b' : '#6c757d';
                      const stageBg = stage === 'converted' ? 'bg-success' :
                                     stage === 'lead_generated' ? 'bg-primary' :
                                     stage === 'follow_up' ? 'bg-info' :
                                     stage === 'consultation_scheduled' ? 'bg-warning' :
                                     stage === 'not_interested' ? 'bg-danger' :
                                     stage === 'lead_closed' ? 'bg-dark' : 'bg-secondary';

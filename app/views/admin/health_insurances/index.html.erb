<!-- Custom styles for renewal button animation -->
<style>
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
    }
  }

  .pulse-animation {
    animation: pulse 1.5s infinite;
  }

  .btn-danger.pulse-animation:hover {
    animation: none;
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  /* Enhanced button styles */
  .btn-success:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  .btn-primary:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  .btn-warning:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  /* Enhanced renewal button styles */
  .btn-success.text-white.fw-bold {
    background-color: #198754 !important;
    border-color: #198754 !important;
    color: white !important;
    font-weight: bold !important;
  }

  .btn-warning.text-dark.fw-bold {
    background-color: #ffc107 !important;
    border-color: #ffc107 !important;
    color: #212529 !important;
    font-weight: bold !important;
  }

  .btn-danger {
    background-color: #dc3545 !important;
    border-color: #dc3545 !important;
    color: white !important;
    font-weight: bold !important;
  }

  /* Hover effects for renewal buttons */
  .btn-success.text-white.fw-bold:hover {
    background-color: #157347 !important;
    border-color: #146c43 !important;
    transform: scale(1.05);
  }

  .btn-warning.text-dark.fw-bold:hover {
    background-color: #ffcd39 !important;
    border-color: #ffc720 !important;
    transform: scale(1.05);
  }

  .btn-danger:hover {
    background-color: #bb2d3b !important;
    border-color: #b02a37 !important;
    transform: scale(1.05);
  }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Health Insurance Policies</h2>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_health_insurance_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Health Policy
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Health Policies</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter((@drwise_count || 0) + (@non_drwise_count || 0)) %></h3>
            <div class="d-flex gap-2 mt-2">
              <small class="text-success">
                <i class="bi bi-check-circle me-1"></i>DrWise: <%= @drwise_count %>
              </small>
              <small class="text-warning">
                <i class="bi bi-x-circle me-1"></i>Non-DrWise: <%= @non_drwise_count %>
              </small>
            </div>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-hospital text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Premium</h6>
            <h3 class="mb-0 text-success"><%= indian_currency((@drwise_premium || 0) + (@non_drwise_premium || 0)) %></h3>
            <div class="mt-2">
              <small class="text-muted d-block">DrWise: <%= indian_currency(@drwise_premium || 0) %></small>
              <small class="text-muted d-block">Non-DrWise: <%= indian_currency(@non_drwise_premium || 0) %></small>
            </div>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Coverage</h6>
            <h3 class="mb-0 text-info"><%= indian_currency((@drwise_coverage || 0) + (@non_drwise_coverage || 0)) %></h3>
            <div class="mt-2">
              <small class="text-muted d-block">DrWise: <%= indian_currency(@drwise_coverage || 0) %></small>
              <small class="text-muted d-block">Non-DrWise: <%= indian_currency(@non_drwise_coverage || 0) %></small>
            </div>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-shield-check text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Covered Members</h6>
            <%
              total_members = HealthInsuranceMember.joins(:health_insurance).count
              drwise_members = HealthInsuranceMember.joins(:health_insurance).where(
                health_insurances: { is_admin_added: true, is_customer_added: false, is_agent_added: false }
              ).count
              non_drwise_members = total_members - drwise_members
            %>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(total_members) %></h3>
            <div class="d-flex gap-2 mt-2">
              <small class="text-success">
                <i class="bi bi-check-circle me-1"></i>DrWise: <%= drwise_members %>
              </small>
              <small class="text-warning">
                <i class="bi bi-x-circle me-1"></i>Non-DrWise: <%= non_drwise_members %>
              </small>
            </div>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-people text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tabs for DrWise vs Non-DrWise -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <ul class="nav nav-tabs border-0" role="tablist">
      <li class="nav-item" role="presentation">
        <%= link_to admin_health_insurances_path(tab: 'drwise', search: params[:search], insurance_type: params[:insurance_type], payment_mode: params[:payment_mode]),
            class: "nav-link #{'active' if @current_tab == 'drwise'}",
            role: "tab" do %>
          <i class="bi bi-check-circle me-2"></i>
          DrWise Policies
          <span class="badge bg-success ms-2"><%= @drwise_count %></span>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to admin_health_insurances_path(tab: 'non_drwise', search: params[:search], insurance_type: params[:insurance_type], payment_mode: params[:payment_mode]),
            class: "nav-link #{'active' if @current_tab == 'non_drwise'}",
            role: "tab" do %>
          <i class="bi bi-x-circle me-2"></i>
          Non-DrWise Policies
          <span class="badge bg-warning ms-2"><%= @non_drwise_count %></span>
        <% end %>
      </li>
    </ul>
  </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_health_insurances_path, method: :get, local: true, class: "row g-3" do |form| %>
      <%= form.hidden_field :tab, value: @current_tab %>
      <div class="col-md-4">
        <%= form.text_field :search, placeholder: "Search policies...", value: params[:search], class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= form.select :insurance_type, options_for_select([
          ['All Types', ''],
          ['Individual', 'Individual'],
          ['Family', 'Family'],
          ['Group', 'Group']
        ], params[:insurance_type]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-3">
        <%= form.select :payment_mode, options_for_select([
          ['All Payment Modes', ''],
          ['Yearly', 'yearly'],
          ['Half Yearly', 'half_yearly'],
          ['Quarterly', 'quarterly'],
          ['Monthly', 'monthly']
        ], params[:payment_mode]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= form.submit "Filter", class: "btn btn-outline-primary w-100" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Health Insurance Policies List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">
      <% if @current_tab == 'drwise' %>
        <i class="bi bi-check-circle text-success me-2"></i>DrWise Health Insurance Policies
      <% else %>
        <i class="bi bi-x-circle text-warning me-2"></i>Non-DrWise Health Insurance Policies
      <% end %>
    </h5>
  </div>
  <div class="card-body p-0">
    <% if @health_insurances.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Policy</th>
              <th class="border-0">Customer</th>
              <th class="border-0">Company</th>
              <th class="border-0">Source & Type</th>
              <th class="border-0">Coverage</th>
              <th class="border-0">Premium</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @health_insurances.each do |policy| %>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.policy_number %></h6>
                    <small class="text-muted"><%= policy.policy_type&.humanize %></small>
                    <br>
                    <small class="<%= policy.has_any_documents? ? 'text-success' : 'text-danger' %>">
                      <i class="bi bi-file-earmark-<%= policy.has_any_documents? ? 'check' : 'x' %>"></i>
                      <%= "#{policy.total_documents_count} document#{'s' unless policy.total_documents_count == 1}" %>
                    </small>
                  </div>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.customer&.display_name %></h6>
                    <small class="text-muted"><%= policy.customer&.email %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.insurance_company_code || policy.insurance_company_name %></h6>
                  </div>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <!-- Source Badge -->
                    <div>
                      <% if policy.is_customer_added? %>
                        <span class="badge bg-info-subtle text-info">
                          <i class="bi bi-person-check me-1"></i>Customer
                        </span>
                      <% elsif policy.is_agent_added? %>
                        <span class="badge bg-success-subtle text-success">
                          <i class="bi bi-person-badge me-1"></i>Agent
                        </span>
                      <% elsif policy.is_admin_added? %>
                        <span class="badge bg-primary-subtle text-primary">
                          <i class="bi bi-shield-check me-1"></i>Admin
                        </span>
                      <% else %>
                        <span class="badge bg-secondary-subtle text-secondary">
                          <i class="bi bi-question-circle me-1"></i>Unknown
                        </span>
                      <% end %>
                    </div>
                    <!-- Type Badge -->
                    <div>
                      <span class="badge bg-light text-dark border">
                        <i class="bi bi-hospital me-1"></i><%= policy.insurance_type %>
                      </span>
                    </div>
                  </div>
                </td>
                <td>
                  <div>
                    <small class="text-muted d-block" style="font-size: 0.75rem;">Sum Insured</small>
                    <div class="fw-bold text-primary" style="font-size: 1rem;"><%= indian_currency(policy.sum_insured) %></div>
                  </div>
                </td>
                <td>
                  <div>
                    <small class="text-muted d-block" style="font-size: 0.75rem;"><%= policy.payment_mode&.humanize || 'Yearly' %></small>
                    <div class="fw-bold text-success" style="font-size: 1rem;"><%= indian_currency(policy.total_premium) %></div>
                  </div>
                </td>
                <td>
                  <% if policy.active? %>
                    <span class="badge bg-success">Active</span>
                  <% elsif policy.expired? %>
                    <span class="badge bg-danger">Expired</span>
                  <% elsif policy.expiring_soon? %>
                    <span class="badge bg-warning">Expiring Soon</span>
                  <% else %>
                    <span class="badge bg-info">Active</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <% if can_view?('health_insurances') %>
                      <%= link_to admin_health_insurance_path(policy), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    <% end %>
                    <% if can_edit?('health_insurances') %>
                      <%= link_to edit_admin_health_insurance_path(policy), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>

                    <!-- Renewal Status -->
                    <% if policy.has_been_renewed? %>
                      <!-- Show "Renewed" indicator for renewed policies -->
                      <span class="btn btn-sm btn-success disabled" title="This policy has been renewed">
                        <i class="bi bi-check-circle"></i>
                        <span class="d-none d-md-inline ms-1">Renewed</span>
                      </span>
                    <% elsif policy.can_be_renewed? %>
                      <!-- Show Renew button for eligible policies -->
                      <% days_to_expiry = (policy.policy_end_date - Date.current).to_i %>
                      <%
                        # Bright, high-contrast colors based on urgency for better visibility
                        if days_to_expiry <= 7
                          button_class = 'btn-danger'  # Red for urgent (7 days or less)
                        elsif days_to_expiry <= 30
                          button_class = 'btn-warning text-dark fw-bold'  # Yellow with dark bold text for medium urgency
                        else
                          button_class = 'btn-success text-white fw-bold'  # Green with white bold text for normal
                        end
                      %>
                      <% if can_edit?('health_insurances') %>
                        <%= link_to renew_admin_health_insurance_path(policy),
                            class: "btn btn-sm #{button_class}",
                            title: "Renew Policy (#{days_to_expiry} days to expiry)",
                            style: "min-width: 70px;" do %>
                          <i class="bi bi-arrow-clockwise"></i>
                          <span class="d-none d-md-inline ms-1">Renew</span>
                        <% end %>
                      <% end %>
                    <% elsif policy.is_renewal? %>
                      <!-- Show indicator for renewal policies -->
                      <span class="btn btn-sm btn-outline-secondary disabled" title="This is a renewal policy">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="d-none d-md-inline ms-1">Renewal</span>
                      </span>
                    <% end %>

                    <% if can_delete?('health_insurances') %>
                      <%= link_to admin_health_insurance_path(policy),
                          class: "btn btn-sm btn-outline-danger delete-policy-btn",
                          title: "Delete Policy & All Data",
                          method: :delete,
                          data: {
                            policy_number: policy.policy_number,
                            customer_name: policy.customer&.display_name,
                            company_name: policy.insurance_company_name,
                            premium_amount: number_to_currency(policy.total_premium, unit: '₹', precision: 0),
                            turbo_method: :delete,
                            turbo_confirm: false
                          },
                          onclick: "return confirmPolicyDeletion(this, event);" do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if respond_to?(:paginate) && @health_insurances.respond_to?(:current_page) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @health_insurances %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-hospital fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No health insurance policies found</h5>
        <p class="text-muted mb-3">
          <% if params[:search].present? || params[:insurance_type].present? || params[:payment_mode].present? %>
            Try adjusting your search criteria or
            <%= link_to "view all policies", admin_health_insurances_path, class: "text-decoration-none" %>.
          <% else %>
            Start by adding your first health insurance policy to the system.
          <% end %>
        </p>
        <% if can_create?('health_insurances') %>
          <%= link_to new_admin_health_insurance_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i>
            Add First Health Policy
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
function confirmPolicyDeletion(element, event) {
  // Prevent the default link behavior
  event.preventDefault();

  const policyNumber = element.dataset.policyNumber;
  const customerName = element.dataset.customerName;
  const companyName = element.dataset.companyName;
  const premiumAmount = element.dataset.premiumAmount;

  const confirmMessage = `⚠️ PERMANENT DELETION WARNING ⚠️

You are about to permanently delete:

📋 Policy: ${policyNumber}
👤 Customer: ${customerName}
🏢 Company: ${companyName}
💰 Premium: ${premiumAmount}

🗑️ This will also delete ALL associated data:
• Policy members and nominees
• Commission payouts and invoices
• Related lead records
• All uploaded documents

❌ THIS CANNOT BE UNDONE!

Are you absolutely sure you want to proceed?`;

  if (confirm(confirmMessage)) {
    // If user confirms, create and submit a form with DELETE method
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = element.href;
    form.style.display = 'none';

    // Add CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]');
    if (csrfToken) {
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrfToken.getAttribute('content');
      form.appendChild(csrfInput);
    }

    // Add method override for DELETE
    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'delete';
    form.appendChild(methodInput);

    document.body.appendChild(form);
    form.submit();
  }

  return false;
}
</script>
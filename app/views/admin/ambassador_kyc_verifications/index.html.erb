<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Ambassador KYC Verification</h2>
    <p class="text-muted mb-0">Review and approve self-registered ambassador accounts</p>
  </div>
  <% if @pending_count > 0 %>
    <span class="badge bg-warning fs-6">
      <%= @pending_count %> awaiting action
    </span>
  <% end %>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-tabs mb-4">
  <% tabs = [
       ['just_registered', 'Just Registered'],
       ['submitted',       'Awaiting Review'],
       ['approved',        'Approved'],
       ['rejected',        'Rejected']
     ] %>
  <% tabs.each do |status, label| %>
    <li class="nav-item">
      <%= link_to admin_ambassador_kyc_verifications_path(status: status),
                  class: "nav-link #{'active' if @tab == status}" do %>
        <%= label %>
        <% count = @tab_counts[status].to_i %>
        <% if count > 0 %>
          <% badge_class = status == 'submitted' ? 'bg-warning text-dark' : (status == 'just_registered' ? 'bg-info text-dark' : 'bg-secondary') %>
          <span class="badge <%= badge_class %> ms-1"><%= count %></span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @tab == 'just_registered' %>
  <div class="alert alert-info d-flex align-items-center py-2 small">
    <i class="bi bi-info-circle me-2"></i>
    These ambassadors have signed up but not yet submitted their KYC. You can approve / reject them directly.
  </div>
<% end %>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @distributors.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Ambassador</th>
              <th>Email</th>
              <th>Mobile</th>
              <th>Password</th>
              <th>Payment Paid</th>
              <th><%= @tab == 'just_registered' ? 'Registered on' : 'KYC submitted' %></th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @distributors.each do |distributor| %>
              <tr>
                <td><%= distributor.display_name.presence || content_tag(:span, "Name pending", class: "text-muted fst-italic") %></td>
                <td><%= distributor.email %></td>
                <td><%= distributor.formatted_mobile %></td>
                <td><code><%= distributor.original_password.presence || "—" %></code></td>
                <td>
                  <% if distributor.payment_paid? %>
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
                  <% elsif distributor.payment_required? %>
                    <span class="badge bg-warning-subtle text-warning"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary">—</span>
                  <% end %>
                </td>
                <td>
                  <% ts = @tab == 'just_registered' ? distributor.created_at : distributor.kyc_submitted_at %>
                  <%= ts&.strftime('%d %b %Y, %I:%M %p') || '—' %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-2">
                    <%= link_to admin_distributor_path(distributor), class: "btn btn-sm btn-outline-primary",
                                data: { bs_toggle: "tooltip" }, title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <% if distributor.kyc_pending? || distributor.kyc_submitted? %>
                      <%= button_to approve_admin_ambassador_kyc_verification_path(distributor),
                                    method: :patch, class: "btn btn-sm btn-success",
                                    data: { bs_toggle: "tooltip" }, title: "Approve",
                                    form: { data: { turbo_confirm: "Approve #{distributor.email}'s KYC and activate their account?" } } do %>
                        <i class="bi bi-check-lg"></i>
                      <% end %>
                      <%= button_to reject_admin_ambassador_kyc_verification_path(distributor,
                                      kyc_rejection_reason: "Rejected by admin"),
                                    method: :patch, class: "btn btn-sm btn-outline-danger",
                                    data: { bs_toggle: "tooltip" }, title: "Reject",
                                    form: { data: { turbo_confirm: "Reject #{distributor.email}'s KYC?" } } do %>
                        <i class="bi bi-x-lg"></i>
                      <% end %>
                    <% elsif distributor.kyc_rejected? %>
                      <span class="text-danger small"><%= distributor.kyc_rejection_reason.presence || "Rejected" %></span>
                    <% elsif distributor.kyc_approved? %>
                      <span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-patch-check fs-1 text-muted"></i>
        <h6 class="text-muted mt-3">No ambassadors in this status</h6>
      </div>
    <% end %>
  </div>
</div>

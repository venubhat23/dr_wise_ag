<script>
// Function to load real-time lead conversion rate
function loadRealTimeLeadConversion() {
  fetch('/admin/api/system_status/lead_conversion')
    .then(response => response.json())
    .then(data => {
      if (data.success && data.summary) {
        const conversionRateDisplay = document.getElementById('lead-conversion-rate');
        if (conversionRateDisplay) {
          conversionRateDisplay.textContent = data.summary.conversion_rate + '%';
        }
      }
    })
    .catch(error => {
      console.error('Error loading real-time lead conversion:', error);
    });
}

// Modal Functions for Dashboard Alerts
function showRenewalModal(type) {
  console.log('Opening renewal modal for type:', type);

  const modal = new bootstrap.Modal(document.getElementById('renewalModal'), {
    backdrop: false,
    keyboard: true,
    focus: true
  });

  const modalTitle = document.getElementById('renewalModalLabel');
  const tableBody = document.getElementById('renewalTableBody');

  // Update modal title based on type
  switch(type) {
    case 'expiring':
      modalTitle.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Policies Expiring in 30 Days';
      loadExpiringPolicies(tableBody);
      break;
    case 'expired':
      modalTitle.innerHTML = '<i class="bi bi-exclamation-circle me-2"></i>Recently Expired Policies';
      loadExpiredPolicies(tableBody);
      break;
    case 'processed':
      modalTitle.innerHTML = '<i class="bi bi-check-circle me-2"></i>Policies Processed This Month';
      loadProcessedPolicies(tableBody);
      break;
  }

  modal.show();
}

function showPolicyModal(type) {
  console.log('Opening policy modal for type:', type);

  const modal = new bootstrap.Modal(document.getElementById('policyModal'), {
    backdrop: false,
    keyboard: true,
    focus: true
  });

  const modalTitle = document.getElementById('policyModalLabel');
  const tableBody = document.getElementById('policyTableBody');

  // Update modal title based on type
  switch(type) {
    case 'expiring':
      modalTitle.innerHTML = '<i class="bi bi-clock-history me-2"></i>Policies Expiring Soon';
      loadPoliciesExpiringSoon(tableBody);
      break;
    case 'expired_month':
      modalTitle.innerHTML = '<i class="bi bi-calendar-x me-2"></i>Policies Expired This Month';
      loadPoliciesExpiredThisMonth(tableBody);
      break;
    case 'opportunities':
      modalTitle.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Renewal Opportunities';
      loadRenewalOpportunities(tableBody);
      break;
  }

  modal.show();
}

// Data loading functions
function loadExpiringPolicies(tableBody) {
  tableBody.innerHTML = '<tr><td colspan="7" class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></td></tr>';

  // Fetch data via AJAX
  fetch('/admin/api/policies/expiring?days=30')
    .then(response => response.json())
    .then(data => {
      renderPolicyTable(tableBody, data.policies || [], 'expiring');
      document.getElementById('renewalCount').textContent = data.policies ? data.policies.length : 0;
    })
    .catch(error => {
      console.error('Error loading expiring policies:', error);
      tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading data. Please try again.</td></tr>';
    });
}

function loadExpiredPolicies(tableBody) {

        const updateInsuranceCompany = () => {
          if (window.jQuery && jQuery(insuranceCompanySelect).hasClass('select2-hidden-accessible')) {
            console.log('📝 Updating via Select2 API...');
            // Clear existing options and add the company option
            jQuery(insuranceCompanySelect).empty();

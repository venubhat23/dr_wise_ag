<!-- Page Header with Customer Info -->
<div class="customer-header-card">
  <div class="d-flex justify-content-between align-items-start">
    <!-- Left Section with Avatar and Basic Info -->
    <div class="d-flex align-items-center gap-3">
      <!-- Avatar -->
      <div class="customer-avatar">
        <% if @customer.profile_image.attached? %>
          <%= image_tag rails_blob_path(@customer.profile_image, only_path: true),
              class: "avatar-img",
              alt: @customer.display_name %>
        <% else %>
          <div class="avatar-placeholder">
            <%= @customer.display_name.first.upcase %>
          </div>
        <% end %>
      </div>

      <!-- Customer Info -->
      <div>
        <h2 class="customer-name mb-2"><%= @customer.display_name %></h2>
        <div class="d-flex align-items-center gap-3 mb-2">
          <span class="badge customer-type-badge <%= @customer.customer_type == 'individual' ? 'individual' : 'corporate' %>">
            <%= @customer.customer_type == 'individual' ? 'Individual Client' : 'Corporate Client' %>
          </span>
          <span class="badge status-badge <%= @customer.status ? 'active' : 'inactive' %>">
            <%= @customer.status ? 'Active' : 'Inactive' %>
          </span>
        </div>
        <div class="text-muted small">
          <i class="bi bi-person me-1"></i>Agent:
          <% if @customer.respond_to?(:sub_agent_id) && @customer.sub_agent_id.present? %>
            <% sub_agent = SubAgent.find_by(id: @customer.sub_agent_id) %>
            <%= sub_agent&.full_name || 'Krama Consulting' %>
          <% elsif @customer.respond_to?(:sub_agent) && @customer.sub_agent.is_a?(String) %>
            <%= @customer.sub_agent %>
          <% else %>
            Krama Consulting
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Section with Password and Actions -->
    <div class="text-end">
      <div class="customer-credentials mb-3">
        <div class="credential-item">
          <span class="credential-label">Username:</span>
          <span class="credential-value fw-bold" id="customer-id-value">
            <%= @customer.mobile.present? ? @customer.mobile : '-' %>
          </span>
        </div>
        <div class="credential-item">
          <span class="credential-label">Password:</span>
          <span class="credential-value fw-bold" id="customer-password-value">
            <% user = User.find_by(email: @customer.email, user_type: 'customer') if @customer.email.present? %>
            <% if user&.original_password.present? %>
              <%= user.original_password %>
            <% elsif @customer.respond_to?(:original_password) && @customer.original_password.present? %>
              <%= @customer.original_password %>
            <% else %>
              -
            <% end %>
          </span>
        </div>
      </div>
      <div class="d-flex gap-2 justify-content-end">
        <button class="btn btn-outline-primary btn-sm" onclick="copyCredentials()">
          <i class="bi bi-clipboard me-1"></i>Copy
        </button>
        <a href="https://wa.me/<%= @customer.mobile&.gsub(/\D/, '') %>" class="btn btn-success btn-sm" target="_blank">
          <i class="bi bi-whatsapp"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Basic Information Section -->
<div class="info-section-card">
  <div class="section-header" data-bs-toggle="collapse" data-bs-target="#basicInfoCollapse" aria-expanded="true">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-person"></i>
      </div>
      <h5 class="section-title">Basic Information</h5>
      <span class="section-count">8 Fields</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="basicInfoCollapse" class="collapse show">
    <div class="section-body">
      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>FIRST NAME</label>
            <div class="info-value"><%= @customer.first_name || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>LAST NAME</label>
            <div class="info-value"><%= @customer.last_name || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>MOBILE NO.</label>
            <div class="info-value"><%= @customer.mobile || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>EMAIL</label>
            <div class="info-value"><%= @customer.email || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>GENDER</label>
            <div class="info-value"><%= @customer.gender&.humanize || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>BIRTH DATE</label>
            <div class="info-value"><%= @customer.birth_date&.strftime("%B %d, %Y") || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>BIRTH PLACE</label>
            <div class="info-value"><%= @customer.birth_place || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>MARITAL STATUS</label>
            <div class="info-value"><%= @customer.marital_status&.humanize || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="info-field">
            <label>AGE</label>
            <div class="info-value"><%= @customer.age ? "#{@customer.age} years" : '-' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Advance Details Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#advanceDetailsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-info-circle"></i>
      </div>
      <h5 class="section-title">Advance Details</h5>
      <span class="section-count">5 Fields</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="advanceDetailsCollapse" class="collapse">
    <div class="section-body">
      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="info-field">
            <label>OCCUPATION</label>
            <div class="info-value"><%= @customer.occupation || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="info-field">
            <label>EDUCATION</label>
            <div class="info-value"><%= @customer.education || '-' %></div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="info-field">
            <label>ANNUAL INCOME</label>
            <div class="info-value">
              <% if @customer.annual_income.present? %>
                <%= indian_currency(@customer.annual_income) %>
              <% else %>
                -
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Address Information Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#addressCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-geo-alt"></i>
      </div>
      <h5 class="section-title">Address Information</h5>
      <span class="section-count">4 Fields</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="addressCollapse" class="collapse">
    <div class="section-body">
      <div class="row g-4">
        <div class="col-12">
          <div class="info-field">
            <label>FULL ADDRESS</label>
            <div class="info-value"><%= @customer.address || '-' %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="info-field">
            <label>CITY</label>
            <div class="info-value"><%= @customer.city || '-' %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="info-field">
            <label>STATE</label>
            <div class="info-value"><%= @customer.state || '-' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Family Members Section -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent border-0">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <i class="bi bi-people me-2"></i>Family Members
      </h5>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-info"><%= @family_members&.count || 0 %></span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#familyMembersCollapse" aria-expanded="true" aria-controls="familyMembersCollapse" style="border: none; background: transparent;">
          <i class="bi bi-chevron-down" id="familyMembersChevron" style="transition: transform 0.3s ease;"></i>
        </button>
      </div>
    </div>
  </div>
  <div class="collapse show" id="familyMembersCollapse">
    <div class="card-body p-0">
    <% if @family_members&.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <tr>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-person-fill me-2"></i>Name
              </th>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-heart-fill me-2"></i>Relationship
              </th>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-calendar-fill me-2"></i>Birth Date
              </th>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-stopwatch-fill me-2"></i>Age
              </th>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-gender-ambiguous me-2"></i>Gender
              </th>
              <th class="border-0 text-white fw-bold py-3">
                <i class="bi bi-gear-fill me-2"></i>Actions
              </th>
            </tr>
          </thead>
            <tbody>
              <% @family_members.each do |family_member| %>
                <tr>
                  <td><%= family_member.name %></td>
                  <td><span class="badge bg-info"><%= family_member.relationship.humanize %></span></td>
                  <td><%= family_member.birth_date&.strftime("%B %d, %Y") %></td>
                  <td><%= family_member.age %> years</td>
                  <td><%= family_member.gender&.humanize %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <%= link_to edit_admin_customer_family_member_path(@customer, family_member), class: "btn btn-sm btn-outline-warning" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= link_to admin_customer_family_member_path(@customer, family_member), method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          data: { confirm: "Are you sure?", turbo_method: :delete } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center text-muted py-4">
          <i class="bi bi-people fs-3 d-block mb-2"></i>
          <p class="mb-3">No family members added yet</p>
          <%= link_to new_admin_customer_family_member_path(@customer), class: "btn btn-primary btn-sm" do %>
            <i class="bi bi-plus me-1"></i>Add Family Member
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>

<!-- Corporate Members Section (for corporate customers) -->
<% if @customer.customer_type == 'corporate' %>
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#corporateCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-building"></i>
      </div>
      <h5 class="section-title">Corporate Members</h5>
      <span class="section-count">0</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="corporateCollapse" class="collapse">
    <div class="section-body">
      <div class="text-center text-muted py-4">
        <i class="bi bi-building fs-3 d-block mb-2"></i>
        <p class="mb-0">No corporate members added yet</p>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Uploaded Documents Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#documentsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-folder"></i>
      </div>
      <h5 class="section-title">Document Library</h5>
      <span class="section-count"><%= @uploaded_documents&.count || 0 %> Files</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="documentsCollapse" class="collapse">
    <div class="section-body">

      <!-- Profile Image Section (if exists) -->
      <% if @customer.profile_image.attached? %>
        <div class="profile-image-section mb-4">
          <div class="d-flex align-items-center mb-3">
            <i class="bi bi-person-circle me-2 text-primary fs-5"></i>
            <h6 class="mb-0">Profile Image</h6>
          </div>
          <% image_data = @customer.safe_profile_image_display %>
          <% if image_data %>
            <div class="enhanced-profile-display">
              <div class="profile-image-card">
                <div class="profile-image-preview" onclick="openProfileModal()">
                  <%= image_tag image_data[:url],
                      class: "profile-img",
                      alt: @customer.display_name,
                      onerror: "this.src='/assets/placeholder-avatar.png'; this.onerror=null;",
                      loading: "lazy" %>
                  <div class="profile-overlay">
                    <i class="bi bi-eye preview-icon"></i>
                  </div>
                </div>
                <div class="profile-info">
                  <h6 class="profile-title">Profile Picture</h6>
                  <div class="profile-meta">
                    <div class="meta-item">
                      <i class="bi bi-file-image meta-icon"></i>
                      <span class="meta-text"><%= image_data[:filename] %></span>
                    </div>
                    <div class="meta-item">
                      <i class="bi bi-hdd meta-icon"></i>
                      <span class="meta-text"><%= number_to_human_size(image_data[:size]) %></span>
                    </div>
                  </div>
                  <div class="profile-actions">
                    <button type="button" class="action-btn preview-btn" title="Preview" onclick="openProfileModal()">
                      <i class="bi bi-eye"></i>
                    </button>
                    <a href="<%= image_data[:url] %>" class="action-btn download-btn" title="Download" download="<%= image_data[:filename] %>">
                      <i class="bi bi-download"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <div class="alert alert-warning d-flex align-items-center">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Profile image unavailable or corrupted
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Legacy Documents Section (if any) -->
      <% if @customer.documents.any? %>
        <div class="legacy-documents-section mb-4">
          <div class="d-flex align-items-center mb-3">
            <i class="bi bi-archive me-2 text-warning fs-5"></i>
            <h6 class="mb-0">Legacy Documents</h6>
            <span class="badge bg-warning ms-2">Old System</span>
          </div>
          <div class="legacy-documents-grid">
            <% @customer.documents.each do |document| %>
              <div class="legacy-document-card">
                <div class="legacy-document-preview">
                  <i class="bi bi-file-earmark file-icon"></i>
                </div>
                <div class="legacy-document-info">
                  <h6 class="document-name"><%= truncate(document.filename, length: 25) %></h6>
                  <div class="document-actions">
                    <%= link_to url_for(document.file), class: "btn btn-sm btn-outline-primary", target: "_blank" do %>
                      <i class="bi bi-download me-1"></i>Download
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @uploaded_documents&.any? %>
        <div class="documents-grid">
          <% @uploaded_documents.each_with_index do |document, index| %>
            <div class="enhanced-document-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
              <!-- Document Preview -->
              <div class="document-preview" onclick="openPreviewModal('<%= document.id %>')">
                <% file_extension = File.extname(document.file.filename.to_s).downcase %>
                <% if ['.jpg', '.jpeg', '.png', '.gif'].include?(file_extension) %>
                  <div class="image-preview">
                    <%= image_tag rails_blob_url(document.file), alt: document.title, class: "preview-image" %>
                    <div class="preview-overlay">
                      <i class="bi bi-eye preview-icon"></i>
                    </div>
                  </div>
                <% elsif file_extension == '.pdf' %>
                  <div class="file-type-preview pdf-preview">
                    <i class="bi bi-file-pdf file-type-icon"></i>
                    <span class="file-type-label">PDF</span>
                    <div class="preview-overlay">
                      <i class="bi bi-eye preview-icon"></i>
                    </div>
                  </div>
                <% elsif ['.doc', '.docx'].include?(file_extension) %>
                  <div class="file-type-preview doc-preview">
                    <i class="bi bi-file-word file-type-icon"></i>
                    <span class="file-type-label">DOC</span>
                    <div class="preview-overlay">
                      <i class="bi bi-download preview-icon"></i>
                    </div>
                  </div>
                <% elsif ['.xls', '.xlsx'].include?(file_extension) %>
                  <div class="file-type-preview excel-preview">
                    <i class="bi bi-file-excel file-type-icon"></i>
                    <span class="file-type-label">XLS</span>
                    <div class="preview-overlay">
                      <i class="bi bi-download preview-icon"></i>
                    </div>
                  </div>
                <% else %>
                  <div class="file-type-preview default-preview">
                    <i class="bi bi-file-earmark file-type-icon"></i>
                    <span class="file-type-label">FILE</span>
                    <div class="preview-overlay">
                      <i class="bi bi-download preview-icon"></i>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Document Info -->
              <div class="document-info">
                <div class="document-header">
                  <h6 class="document-title" title="<%= document.title %>"><%= truncate(document.title, length: 20) %></h6>
                  <div class="document-type-badge">
                    <%= document.human_document_type %>
                  </div>
                </div>

                <div class="document-meta">
                  <div class="meta-item">
                    <i class="bi bi-file-earmark meta-icon"></i>
                    <span class="meta-text"><%= truncate(document.file.filename.to_s, length: 15) %></span>
                  </div>
                  <div class="meta-item">
                    <i class="bi bi-hdd meta-icon"></i>
                    <span class="meta-text"><%= number_to_human_size(document.file.byte_size) %></span>
                  </div>
                  <div class="meta-item">
                    <i class="bi bi-calendar3 meta-icon"></i>
                    <span class="meta-text"><%= document.created_at.strftime("%b %d") %></span>
                  </div>
                </div>
              </div>

              <!-- Document Actions -->
              <div class="document-actions">
                <div class="action-buttons">
                  <% if document.downloadable? %>
                    <%= link_to rails_blob_url(document.file, disposition: "attachment"),
                        class: "action-btn download-btn",
                        title: "Download",
                        target: "_blank" do %>
                      <i class="bi bi-download"></i>
                    <% end %>
                  <% end %>

                  <button class="action-btn preview-btn" title="Preview" onclick="openPreviewModal('<%= document.id %>')">
                    <i class="bi bi-eye"></i>
                  </button>

                  <button class="action-btn share-btn" title="Share" onclick="shareDocument('<%= document.id %>')">
                    <i class="bi bi-share"></i>
                  </button>

                  <%= link_to admin_customer_document_path(@customer, document),
                      method: :delete,
                      class: "action-btn delete-btn",
                      title: "Delete",
                      data: { confirm: "Are you sure you want to delete this document?", turbo_method: :delete } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-documents-state">
          <div class="empty-state-icon">
            <i class="bi bi-folder2-open"></i>
          </div>
          <h6 class="empty-state-title">No Documents Available</h6>
          <p class="empty-state-subtitle">This client doesn't have any documents in their file.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Document Preview Modal -->
<div class="modal fade" id="documentPreviewModal" tabindex="-1" aria-labelledby="documentPreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="documentPreviewModalLabel">Document Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="preview-container" id="previewContainer">
          <!-- Preview content will be loaded here -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <a href="#" id="downloadPreviewBtn" class="btn btn-primary" target="_blank">
          <i class="bi bi-download me-1"></i>Download
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Profile Image Preview Modal -->
<div class="modal fade" id="profilePreviewModal" tabindex="-1" aria-labelledby="profilePreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="profilePreviewModalLabel">Profile Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <% if @customer.profile_image.attached? %>
          <% image_data = @customer.safe_profile_image_display %>
          <% if image_data %>
            <%= image_tag image_data[:url],
                class: "img-fluid rounded",
                alt: @customer.display_name,
                style: "max-height: 400px; width: auto;" %>
            <div class="mt-3">
              <h6 class="mb-2"><%= @customer.display_name %></h6>
              <p class="text-muted mb-0"><%= image_data[:filename] %></p>
              <small class="text-muted"><%= number_to_human_size(image_data[:size]) %></small>
            </div>
          <% else %>
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Profile image unavailable or corrupted
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <% if @customer.profile_image.attached? %>
          <% image_data = @customer.safe_profile_image_display %>
          <% if image_data %>
            <a href="<%= image_data[:url] %>" class="btn btn-primary" download="<%= image_data[:filename] %>" target="_blank">
              <i class="bi bi-download me-1"></i>Download
            </a>
          <% end %>
        <% end %>
      </div>

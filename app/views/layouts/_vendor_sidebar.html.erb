<div class="vendor-sidebar">
  <div class="brand">
    Dr WISE
    <small>Vendor Portal<% if @vendor %> · <%= @vendor.display_name %><% end %></small>
  </div>

  <nav>
    <%= link_to vendor_dashboard_path, class: "nav-link #{'active' if request.path == vendor_dashboard_path}" do %>
      <i class="bi bi-speedometer2"></i> Dashboard
    <% end %>
    <%= link_to vendor_leads_path, class: "nav-link #{'active' if request.path.start_with?(vendor_leads_path)}" do %>
      <i class="bi bi-people"></i> Leads
    <% end %>
    <%= link_to vendor_payouts_path, class: "nav-link #{'active' if request.path.start_with?(vendor_payouts_path)}" do %>
      <i class="bi bi-cash-stack"></i> Payout
    <% end %>
  </nav>

  <div class="signout">
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
          form: { data: { turbo: false } },
          class: "btn btn-outline-light btn-sm w-100" %>
  </div>
</div>

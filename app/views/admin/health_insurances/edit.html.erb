                    <% @health_insurance.policy_documents_records.each do |doc| %>
                      <div class="list-group-item">
                        <div class="d-flex align-items-center">
                          <div class="me-3">
                            <% if doc.r2_content_type&.start_with?('image/') %>
                              <div class="bg-info text-white rounded d-flex align-items-center justify-content-center"
                                   style="width: 40px; height: 40px;">
                                <i class="bi bi-image fs-5"></i>
                              </div>
                            <% elsif doc.r2_content_type == 'application/pdf' %>
                              <div class="bg-danger text-white rounded d-flex align-items-center justify-content-center"
                                   style="width: 40px; height: 40px;">
                                <i class="bi bi-file-earmark-pdf fs-5"></i>
                              </div>
                            <% else %>
                              <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
                                   style="width: 40px; height: 40px;">
                                <i class="bi bi-file-earmark fs-5"></i>
                              </div>
                            <% end %>
                          </div>
                          <div class="flex-grow-1">
                            <h6 class="mb-1"><%= doc.title %></h6>
                            <small class="text-muted">
                              <%= doc.document_type %> •
                              <%= (doc.r2_file_size / 1024.0 / 1024.0).round(2) %> MB •
                              <%= doc.r2_content_type %>
                            </small>
                            <% if doc.description.present? %>
                              <div class="small text-muted"><%= doc.description %></div>
                            <% end %>
                          </div>
                          <div class="ms-3">
                            <div class="btn-group" role="group">
                              <%= link_to doc.r2_url, class: "btn btn-outline-primary btn-sm",
                                  target: "_blank", title: "View Document" do %>

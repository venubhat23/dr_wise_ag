      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.token) {",
                  "        pm.environment.set('token', jsonData.data.token);",
                  "        pm.environment.set('user_id', jsonData.data.user_id);",
                  "        pm.environment.set('role', jsonData.data.role);",
                  "        if (jsonData.data.customer_id) {",
                  "            pm.environment.set('customer_id', jsonData.data.customer_id);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin@drwise.com\",\n    \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "auth", "login"]
            }

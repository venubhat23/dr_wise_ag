    fetch('/admin/broker_codes.json', {
      headers: brokersHeaders,
      credentials: 'same-origin'
    })
    .then(response => {
      console.log('Broker Codes API response status:', response.status);
      console.log('Response headers:', {
        'content-type': response.headers.get('content-type'),
        'x-request-id': response.headers.get('x-request-id')
      });

      if (response.status === 401 || response.status === 403) {
        console.error('❌ Authentication error. Response:', response);
        throw new Error('Authentication required - please refresh the page');
      }
      if (!response.ok) {
        console.error('❌ HTTP error. Response:', response);
        throw new Error(`HTTP error! status: ${response.status} - ${response.statusText}`);
      }

      return response.text().then(text => {
        console.log('Raw response text:', text.substring(0, 500) + '...');
        try {
          return JSON.parse(text);
        } catch (e) {
          console.error('❌ JSON parse error:', e);
          console.error('Response text that failed to parse:', text);
          throw new Error('Invalid JSON response from server');
        }
      });
    })
    .then(data => {
      console.log('Broker Codes API response data:', data);

      // Use the shared helper function to populate the dropdown
      populateBrokerCodesDropdown(data);
    })
    .catch(error => {
      console.error('🚨 Error fetching broker codes:', error);
      console.error('Error details:', {
        message: error.message,
        stack: error.stack
      });

      // Try alternative endpoint as fallback
      console.log('🔄 Trying alternative endpoint for broker codes...');
      tryAlternativeBrokerCodesEndpoint()
        .then(alternativeData => {
          if (alternativeData && alternativeData.success) {
            console.log('✅ Alternative endpoint worked!');
            populateBrokerCodesDropdown(alternativeData);
          } else {
            showBrokerCodesError();
          }
        })
        .catch(altError => {
          console.error('❌ Alternative endpoint also failed:', altError);
          showBrokerCodesError();
        });
    });
  }


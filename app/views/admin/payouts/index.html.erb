<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Commission Payouts</h2>
    <p class="text-muted mb-0">Manage commission payouts to agents, distributors, and investors</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_payout_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Payout
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Payouts</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@summary[:total_payouts] || 0) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-cash-coin text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Amount</h6>
            <h3 class="mb-0 text-success">₹<%= number_with_delimiter((@summary[:total_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Pending Amount</h6>
            <h3 class="mb-0 text-warning">₹<%= number_with_delimiter((@summary[:pending_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-clock text-warning fs-4"></i>
          </div>
        </div>
        <div class="mt-2">
          <small class="text-muted"><%= @summary[:pending_count] || 0 %> pending payouts</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Paid Amount</h6>
            <h3 class="mb-0 text-info">₹<%= number_with_delimiter((@summary[:paid_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-check-circle text-info fs-4"></i>
          </div>
        </div>
        <div class="mt-2">
          <small class="text-muted"><%= @summary[:paid_count] || 0 %> paid payouts</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_payouts_path, method: :get, local: true, class: "row g-3" do |f| %>
      <div class="col-md-3">
        <%= f.text_field :search, value: params[:search], placeholder: "Search payouts...", class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= f.select :policy_type, options_for_select([['All Types', ''], ['Health', 'health'], ['Life', 'life'], ['Motor', 'motor'], ['Other', 'other']], params[:policy_type]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.select :payout_to, options_for_select([['All Recipients', ''], ['Agent', 'agent'], ['Distributor', 'distributor'], ['Sub Agent', 'sub_agent'], ['Investor', 'investor']], params[:payout_to]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.select :status, options_for_select([['All Status', ''], ['Pending', 'pending'], ['Processing', 'processing'], ['Paid', 'paid'], ['Cancelled', 'cancelled']], params[:status]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.submit "Search", class: "btn btn-primary w-100" %>
      </div>
      <div class="col-md-1">
        <%= link_to admin_payouts_path, class: "btn btn-outline-secondary w-100" do %>
          <i class="bi bi-arrow-clockwise"></i>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Payouts Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom">
    <div class="d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Commission Payouts</h6>
      <div>
        <small class="text-muted"><%= @payouts.count %> payouts</small>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Policy Details</th>
            <th>Recipient</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @payouts.any? %>
            <% @payouts.each do |payout| %>
              <tr>
                <td>
                  <div>
                    <strong class="text-capitalize"><%= payout.policy_type %> Insurance</strong>
                    <span class="badge bg-light text-dark ms-1">#<%= payout.policy_id %></span>
                  </div>
                  <% if payout.notes.present? %>
                    <small class="text-muted d-block"><%= truncate(payout.notes, length: 50) %></small>
                  <% end %>
                </td>
                <td>
                  <span class="text-capitalize"><%= payout.payout_to.humanize %></span>
                </td>
                <td>
                  <strong class="text-success">₹<%= number_with_delimiter(payout.payout_amount.to_i) %></strong>
                </td>
                <td>
                  <% case payout.status %>
                  <% when 'paid' %>
                    <span class="badge bg-success">Paid</span>
                  <% when 'pending' %>
                    <span class="badge bg-warning">Pending</span>
                  <% when 'processing' %>
                    <span class="badge bg-info">Processing</span>
                  <% when 'cancelled' %>
                    <span class="badge bg-danger">Cancelled</span>
                  <% end %>
                </td>
                <td>
                  <%= payout.payout_date&.strftime('%d %b %Y') || '-' %>
                  <% if payout.payment_mode.present? %>
                    <br><small class="text-muted"><%= payout.payment_mode.humanize %></small>
                  <% end %>
                </td>
                <td>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      Actions
                    </button>
                    <ul class="dropdown-menu">
                      <li><%= link_to "View Details", admin_payout_path(payout), class: "dropdown-item" %></li>
                      <li><%= link_to "Edit", edit_admin_payout_path(payout), class: "dropdown-item" %></li>
                      <% if payout.status != 'paid' %>
                        <li><hr class="dropdown-divider"></li>
                        <% if payout.status == 'pending' %>
                          <li><%= link_to "Mark as Processing", mark_as_processing_admin_payout_path(payout), method: :patch, class: "dropdown-item text-info", data: { confirm: "Mark this payout as processing?" } %></li>
                        <% end %>
                        <% if payout.status.in?(['pending', 'processing']) %>
                          <li>
                            <%= link_to "Mark as Paid", mark_as_paid_admin_payout_path(payout),
                                method: :patch,
                                class: "dropdown-item text-success",
                                data: {
                                  confirm: "Are you sure you want to mark this payout as paid?\n\nAmount: ₹#{number_with_delimiter(payout.payout_amount.to_i)}\nRecipient: #{payout.payout_to.humanize}\n\nThis action cannot be undone."
                                } %>
                          </li>
                          <li>
                            <%= link_to "Cancel Payout", cancel_payout_admin_payout_path(payout),
                                method: :patch,
                                class: "dropdown-item text-danger",
                                data: {
                                  confirm: "Are you sure you want to cancel this payout?\n\nThis action cannot be undone."
                                } %>
                          </li>
                        <% end %>
                      <% end %>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-5">
                <div>
                  <i class="bi bi-cash-coin text-muted" style="font-size: 3rem;"></i>
                  <h5 class="text-muted mt-3">No payouts found</h5>
                  <p class="text-muted">Start by creating your first payout or adjust your search filters.</p>
                  <%= link_to new_admin_payout_path, class: "btn btn-primary" do %>
                    <i class="bi bi-plus-lg me-1"></i>
                    Add First Payout
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pagination -->
<% if @payouts.respond_to?(:current_page) %>
  <div class="d-flex justify-content-between align-items-center mt-4">
    <div>
      <span class="text-muted">
        Showing <%= (@payouts.current_page - 1) * @payouts.limit_value + 1 %> to
        <%= [(@payouts.current_page - 1) * @payouts.limit_value + @payouts.limit_value, @payouts.total_count].min %>
        of <%= @payouts.total_count %> payouts
      </span>
    </div>
    <%= paginate @payouts %>
  </div>
<% end %>
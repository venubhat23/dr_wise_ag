<!-- Uploaded Documents Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#documentsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-folder"></i>
      </div>
      <h5 class="section-title">Uploaded Documents</h5>
      <span class="section-count"><%= @uploaded_documents&.count || 0 %></span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="documentsCollapse" class="collapse">
    <div class="section-body">
      <% if @uploaded_documents&.any? %>
        <div class="row g-3">
          <% @uploaded_documents.each do |document| %>
            <div class="col-md-6">
              <div class="document-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <i class="bi bi-<%= document.file_icon %> me-2 text-primary fs-5"></i>
                    <strong><%= document.human_document_type %></strong>
                  </div>
                  <span class="badge bg-light text-dark"><%= document.human_file_type %></span>
                </div>
                <h6 class="mb-2"><%= document.title %></h6>
                <div class="small text-muted mb-3">
                  <div><i class="bi bi-file-earmark me-1"></i><%= document.file_name %></div>
                  <div><i class="bi bi-hdd me-1"></i><%= document.file_size_mb %> MB</div>
                  <div><i class="bi bi-calendar me-1"></i><%= document.created_at.strftime("%b %d, %Y") %></div>
                </div>
                <div class="d-flex gap-2">
                  <% if document.downloadable? %>
                    <%= link_to rails_blob_url(document.file, disposition: "attachment"), class: "btn btn-sm btn-outline-primary flex-grow-1", target: "_blank" do %>
                      <i class="bi bi-download me-1"></i>Download
                    <% end %>
                  <% end %>
                  <%= link_to admin_customer_document_path(@customer, document), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      data: { confirm: "Are you sure?", turbo_method: :delete } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-muted py-4">
          <i class="bi bi-folder2-open fs-3 d-block mb-2"></i>
          <p class="mb-3">No documents uploaded yet</p>
          <%= link_to new_admin_customer_document_path(@customer), class: "btn btn-primary btn-sm" do %>
            <i class="bi bi-plus me-1"></i>Add Document
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>


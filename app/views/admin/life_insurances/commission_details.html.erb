<% content_for :page_title, "Commission Details - #{@life_insurance.policy_number}" %>

<div class="row mb-4">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1 class="h3 mb-0 text-gray-800">Commission Details</h1>
        <p class="text-muted mt-1">Track commission breakdown and payments</p>
      </div>
      <div>
        <%= link_to admin_life_insurances_path, class: "btn btn-outline-primary" do %>
          Back to Life Insurances
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h6 class="m-0 font-weight-bold text-primary">Policy Commission Breakdown</h6>
  </div>
  <div class="card-body">
    <!-- Policy Summary -->
    <div class="policy-summary mb-4 p-3" style="background-color: #f8f9fa; border-radius: 8px;">
      <div class="row">
        <div class="col-md-8">
          <div class="fw-bold fs-5 text-primary mb-1"><%= @life_insurance.policy_number %></div>
          <div class="text-muted mb-1">Life</div>
          <div class="fw-bold mb-1"><%= @life_insurance.customer&.display_name %></div>
          <div class="text-muted mb-1"><%= @life_insurance.insurance_company_name %></div>
          <% if @life_insurance.lead_id.present? %>
            <div class="text-muted mb-2">Lead: <%= @life_insurance.lead_id %></div>
          <% end %>
          <div class="fw-bold text-success fs-5"><%= indian_currency(@life_insurance.sum_insured || 0) %></div>
          <div class="fw-bold text-primary fs-5"><%= indian_currency(@life_insurance.total_premium || 0) %></div>
        </div>
      </div>
    </div>

    <!-- Commission Breakdown -->
    <div class="commission-breakdown">
      <!-- Main Agent Commission -->
      <div class="commission-item d-flex justify-content-between align-items-center py-2 border-bottom">
        <div class="d-flex align-items-center">
          <span class="fw-bold">Main Agent: <%= indian_currency(@life_insurance.main_income_amount || 0) %></span>
          <span class="text-muted ms-2">(<%= (@life_insurance.main_income_percentage || 0).round(1) %>%)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <% if @life_insurance.main_agent_commission_received %>
            <span class="badge bg-success">Paid</span>
            <span class="text-muted small">
              <%= @life_insurance.main_agent_commission_paid_date&.strftime('%b %d') || 'Date not set' %>
            </span>
          <% else %>
            <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#markPaidModal">
              Mark as Paid
            </button>
            <span class="text-muted small">Paid: 0/1</span>
            <span class="text-muted small">Amount: <%= indian_currency(0) %></span>
          <% end %>
        </div>
      </div>

      <!-- Affiliate Commission -->
      <div class="commission-item d-flex justify-content-between align-items-center py-2 border-bottom">
        <span>Affiliate: <%= indian_currency(@life_insurance.sub_agent_commission_amount || 0) %> (<%= (@life_insurance.sub_agent_commission_percentage || 0).round(1) %>%)</span>
      </div>

      <!-- Ambassador Commission -->
      <div class="commission-item d-flex justify-content-between align-items-center py-2 border-bottom">
        <span>Ambassador: <%= indian_currency(@life_insurance.ambassador_commission_amount || 0) %> (<%= (@life_insurance.ambassador_commission_percentage || 0).round(1) %>%)</span>
      </div>

      <!-- Investor Commission -->
      <div class="commission-item d-flex justify-content-between align-items-center py-2 border-bottom">
        <span>Investor: <%= indian_currency(@life_insurance.investor_commission_amount || 0) %> (<%= (@life_insurance.investor_commission_percentage || 0).round(1) %>%)</span>
      </div>

      <!-- Company Expense -->
      <div class="commission-item d-flex justify-content-between align-items-center py-2">
        <span>Company: <%= indian_currency((@life_insurance.total_premium || 0) * (@life_insurance.company_expenses_percentage || 0) / 100) %> (<%= (@life_insurance.company_expenses_percentage || 0).round(1) %>%)</span>
      </div>
    </div>
  </div>
</div>

<!-- Mark as Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Mark Main Agent Commission as Paid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: mark_main_agent_commission_received_admin_commission_tracking_path(@life_insurance.id, policy_type: 'life'), method: :patch, local: false, id: 'mark_paid_form' do |form| %>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Transaction ID <span class="text-danger">*</span></label>
            <%= form.text_field :transaction_id, class: "form-control", required: true, placeholder: "Enter transaction ID" %>
          </div>
          <div class="mb-3">
            <label class="form-label">Payment Date</label>
            <%= form.date_field :paid_date, class: "form-control", value: Date.current %>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <%= form.text_area :notes, class: "form-control", rows: 3, placeholder: "Optional payment notes" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= form.submit "Mark as Paid", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle Mark as Paid form submission
    const markPaidForm = document.getElementById('mark_paid_form');
    if (markPaidForm) {
        markPaidForm.addEventListener('ajax:success', function(event) {
            const response = event.detail[0];
            if (response.success) {
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('markPaidModal'));
                modal.hide();

                // Show success message and reload page
                alert('Commission marked as paid successfully!');
                window.location.reload();
            } else {
                alert('Error: ' + (response.message || 'Failed to mark commission as paid'));
            }
        });

        markPaidForm.addEventListener('ajax:error', function(event) {
            alert('Error: Failed to mark commission as paid. Please try again.');
        });
    }
});
</script>
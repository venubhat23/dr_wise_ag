<% content_for :page_title, "Life Insurance Policy Details" %>
<% content_for :page_subtitle, "Policy ##{@life_insurance.policy_number}" %>

<!-- Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <%= link_to admin_life_insurances_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Back to List
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= link_to edit_admin_life_insurance_path(@life_insurance), class: "btn btn-primary" do %>
      <i class="bi bi-pencil me-2"></i>
      Edit Policy
    <% end %>
  </div>
</div>

<!-- Client & Agent Details Section -->
<div class="info-section-card">
  <div class="section-header" data-bs-toggle="collapse" data-bs-target="#clientAgentCollapse" aria-expanded="true">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-person"></i>
      </div>
      <h5 class="section-title">Client & Agent Details</h5>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="clientAgentCollapse" class="collapse show">
    <div class="section-body">
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Client Name*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.customer&.display_name %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Holder*</label>
        <input type="text" class="form-control" value="<%= @life_insurance.policy_holder %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Affiliate</label>
        <input type="text" class="form-control" value="<%= @life_insurance.sub_agent&.display_name || 'Self' %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Insured Name</label>
        <input type="text" class="form-control" value="<%= @life_insurance.insured_name %>" readonly>
      </div>
    </div>
    </div>
  </div>
</div>


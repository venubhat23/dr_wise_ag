          <h5 class="mb-3">Premium Distribution Analysis</h5>
          <div class="row">
            ${data.distribution.map(item => `
              <div class="col-md-6 col-lg-4 mb-3">
                <div class="card">
                  <div class="card-body">
                    <h6 class="card-title text-muted">${item.range}</h6>

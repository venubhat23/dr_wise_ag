<script>
  // Chart.js Global Configuration
  Chart.defaults.font.family = "'Poppins', sans-serif";
  Chart.defaults.font.size = 12;
  Chart.defaults.color = '#64748b';

  // REAL-TIME DATA FROM RUBY BACKEND - All graphs use live database data
  console.log('✅ REAL-TIME DATA VERIFICATION:');

  // Policy Type Distribution - Live data from @policy_type_distribution
  const policyDistributionRaw = <%= @policy_type_distribution.to_json.html_safe %>;
  console.log('📊 Policy Distribution (Live):', <%= @policy_type_distribution.to_json.html_safe %>);

  // Extract counts from the nested structure for the chart
  const policyDistributionData = {};
  Object.keys(policyDistributionRaw).forEach(key => {
    if (policyDistributionRaw[key] && typeof policyDistributionRaw[key] === 'object') {
      policyDistributionData[key] = policyDistributionRaw[key].count || 0;
    } else {
      policyDistributionData[key] = policyDistributionRaw[key] || 0;
    }
  });

  console.log('📈 Policy Chart Data (Real-time):', policyDistributionData);

  // Premium Collection Trend - Live data from @premium_collection_trend
  const premiumTrendData = <%= @premium_collection_trend.transform_values(&:to_f).to_json.html_safe %>;
  console.log('💰 Premium Trend (Real-time):', premiumTrendData);

  // Lead Conversion Funnel - Live data from @lead_conversion_funnel
  const leadFunnelData = <%= @lead_conversion_funnel.to_json.html_safe %>;
  console.log('🔄 Lead Funnel (Real-time):', leadFunnelData);

  // Renewal Status - Live data from @renewal_status
  const renewalStatusData = <%= @renewal_status.to_json.html_safe %>;
  console.log('🔄 Renewal Status (Real-time):', renewalStatusData);

  // Referral Status - Live data from @referral_status
  const referralData = <%= @referral_status.to_json.html_safe %>;
  console.log('👥 Referral Data (Real-time):', referralData);

  // Agent Performance - Live data from @agent_performance
  const agentPerformanceData = <%= @agent_performance.transform_values(&:to_f).to_json.html_safe %>;
  console.log('🏆 Agent Performance (Real-time):', agentPerformanceData);

  // Commission Summary - Live data from @commission_summary
  const commissionData = {
    main_agent: <%= @commission_summary['main_agent'].transform_values(&:to_f).to_json.html_safe %>,
    sub_agent: <%= @commission_summary['sub_agent'].transform_values(&:to_f).to_json.html_safe %>,
    tds: <%= @commission_summary['tds'].transform_values(&:to_f).to_json.html_safe %>
  };
  console.log('💼 Commission Data (Real-time):', commissionData);

  // Customer Location Distribution - Live data from @customer_location
  const locationData = <%= @customer_location.to_json.html_safe %>;
  console.log('🌍 Location Data (Real-time):', locationData);

  console.log('✅ ALL GRAPHS CONFIRMED USING REAL-TIME DATABASE DATA!');

  // Add empty data warning overlays
  function addNoDataMessage(chartId, message) {
    const canvas = document.getElementById(chartId);
    const container = canvas.parentNode;
    if (container.querySelector('.no-data-message')) return; // Already exists

    const noDataDiv = document.createElement('div');
    noDataDiv.className = 'no-data-message';
    noDataDiv.style.cssText = `
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      color: #a0aec0;
      font-size: 14px;
      font-weight: 500;
      z-index: 10;
      background: rgba(255,255,255,0.9);
      padding: 10px;
      border-radius: 8px;
    `;
    noDataDiv.innerHTML = `<i class="bi bi-info-circle me-2"></i>${message}`;
    container.style.position = 'relative';
    container.appendChild(noDataDiv);
  }

  // 1. Policy Type Distribution (Enhanced Doughnut Chart)
  const policyCtx = document.getElementById('policyDistributionChart').getContext('2d');
  const policyLabels = Object.keys(policyDistributionData);
  const policyValues = Object.values(policyDistributionData);
  const totalPolicies = policyValues.reduce((a, b) => a + b, 0);

  console.log('Creating policy chart with labels:', policyLabels, 'values:', policyValues); // Debug

  new Chart(policyCtx, {
    type: 'doughnut',
    data: {
      labels: policyLabels,
      datasets: [{
        data: policyValues,
        backgroundColor: [
          '#3b82f6',
          '#10b981',
          '#ef4444',
          '#f59e0b',
          '#8b5cf6'
        ],
        borderWidth: 0,
        hoverOffset: 8,
        cutout: '70%'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 25,
            usePointStyle: true,
            pointStyle: 'circle',
            font: {
              size: 13,
              weight: '600'
            },
            generateLabels: function(chart) {
              const data = chart.data;
              return data.labels.map((label, index) => {
                const value = data.datasets[0].data[index];
                const percentage = totalPolicies > 0 ? ((value / totalPolicies) * 100).toFixed(1) : 0;
                return {
                  text: `${label}: ${value} (${percentage}%)`,
                  fillStyle: data.datasets[0].backgroundColor[index],
                  strokeStyle: data.datasets[0].backgroundColor[index],
                  lineWidth: 0,
                  pointStyle: 'circle',
                  index: index
                };
              });
            }
          }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed;
              const percentage = totalPolicies > 0 ? ((value / totalPolicies) * 100).toFixed(1) : 0;
              return `${label}: ${value} policies (${percentage}%)`;
            }
          },
          backgroundColor: 'rgba(0, 0, 0, 0.8)',
          titleColor: 'white',
          bodyColor: 'white',
          borderColor: 'rgba(102, 126, 234, 0.3)',
          borderWidth: 1,
          cornerRadius: 8
        }
      },
      animation: {
        animateRotate: true,
        animateScale: true,
        duration: 2000,
        easing: 'easeOutQuart'
      }
    },
    plugins: [{
      // Custom plugin to show center text
      beforeDraw: function(chart) {
        const ctx = chart.ctx;
        ctx.save();

        // Draw center text
        ctx.font = 'bold 24px Poppins';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        const centerX = chart.chartArea.left + (chart.chartArea.right - chart.chartArea.left) / 2;
        const centerY = chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2;

        ctx.fillStyle = '#1a202c';
        ctx.fillText(totalPolicies, centerX, centerY - 8);

        ctx.font = '14px Poppins';
        ctx.fillStyle = '#64748b';
        ctx.fillText('Total Policies', centerX, centerY + 15);

        ctx.restore();
      }
    }]
  });

  // 2. Premium Collection Trend (Line Chart)
  const premiumCtx = document.getElementById('premiumTrendChart').getContext('2d');
  new Chart(premiumCtx, {
    type: 'line',
    data: {
      labels: Object.keys(premiumTrendData),
      datasets: [{
        label: 'Premium Collection (₹)',
        data: Object.values(premiumTrendData),
        borderColor: '#3b82f6',
        backgroundColor: 'rgba(59, 130, 246, 0.1)',
        borderWidth: 3,
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#3b82f6',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: { grid: { display: false } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000000) return '₹' + (value/1000000).toFixed(1) + 'M';
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        }
      }
    }
  });

  // 3. Lead Conversion Funnel (Bar Chart)
  const leadCtx = document.getElementById('leadFunnelChart').getContext('2d');
  const leadDataValues = Object.values(leadFunnelData);
  const hasLeadData = leadDataValues.some(val => val > 0);

  new Chart(leadCtx, {
    type: 'bar',
    data: {
      labels: Object.keys(leadFunnelData),
      datasets: [{
        label: 'Leads',
        data: hasLeadData ? leadDataValues : [1, 1, 1, 1, 1], // Show sample data if no real data
        backgroundColor: [
          '#3b82f6',
          '#10b981',
          '#f59e0b',
          '#ef4444',
          '#8b5cf6'
        ],
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          enabled: hasLeadData
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, grid: { color: 'rgba(0, 0, 0, 0.05)' } }
      }
    }
  });

  // 4. Renewal Status Overview (Doughnut Chart)
  const renewalCtx = document.getElementById('renewalStatusChart').getContext('2d');
  new Chart(renewalCtx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(renewalStatusData),
      datasets: [{
        data: Object.values(renewalStatusData),
        backgroundColor: [
          '#10b981',
          '#f59e0b',
          '#ef4444'
        ],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 15, usePointStyle: true }
        }
      }
    }
  });

  // 5. Referral Settlement Status (Pie Chart)
  const referralCtx = document.getElementById('referralChart').getContext('2d');
  new Chart(referralCtx, {
    type: 'pie',
    data: {
      labels: Object.keys(referralData),
      datasets: [{
        data: Object.values(referralData),
        backgroundColor: [
          '#10b981',
          '#f59e0b',
          '#3b82f6'
        ],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 15, usePointStyle: true }
        }
      }
    }
  });

  // 6. Agent Performance (Horizontal Bar Chart)
  const agentCtx = document.getElementById('agentPerformanceChart').getContext('2d');
  const agentLabels = Object.keys(agentPerformanceData);
  const agentValues = Object.values(agentPerformanceData);
  const hasAgentData = agentLabels.length > 0 && agentValues.some(val => val > 0);

  new Chart(agentCtx, {
    type: 'bar',
    data: {
      labels: hasAgentData ? agentLabels : ['Agent 1', 'Agent 2', 'Agent 3'],
      datasets: [{
        label: 'Premium Amount (₹)',
        data: hasAgentData ? agentValues : [100000, 80000, 60000],
        backgroundColor: 'rgba(102, 126, 234, 0.8)',
        borderColor: 'rgba(102, 126, 234, 1)',
        borderWidth: 2,
        borderRadius: 6
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { enabled: hasAgentData }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000000) return '₹' + (value/1000000).toFixed(1) + 'M';
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        },
        y: { grid: { display: false } }
      }
    }
  });

  // 7. Commission Summary (Stacked Bar Chart)
  const commissionCtx = document.getElementById('commissionChart').getContext('2d');
  const months = Object.keys(commissionData.main_agent || {});
  const hasCommissionData = months.length > 0 && months.some(m =>
    (commissionData.main_agent[m] || 0) + (commissionData.sub_agent[m] || 0) + (commissionData.tds[m] || 0) > 0
  );

  new Chart(commissionCtx, {
    type: 'bar',
    data: {
      labels: hasCommissionData ? months : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
      datasets: [
        {
          label: 'Main Agent Commission',
          data: hasCommissionData ? months.map(m => commissionData.main_agent[m] || 0) : [5000, 7000, 6000, 8000, 9000, 12000],
          backgroundColor: 'rgba(102, 126, 234, 0.8)',
        },
        {
          label: 'Affiliate Commission',
          data: hasCommissionData ? months.map(m => commissionData.sub_agent[m] || 0) : [2000, 3000, 2500, 4000, 3500, 5000],
          backgroundColor: 'rgba(17, 153, 142, 0.8)',
        },
        {
          label: 'TDS Deducted',
          data: hasCommissionData ? months.map(m => commissionData.tds[m] || 0) : [700, 1000, 850, 1200, 1250, 1700],
          backgroundColor: 'rgba(255, 65, 108, 0.8)',
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { stacked: true, grid: { display: false } },
        y: {
          stacked: true,
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        }
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 20, usePointStyle: true }
        },
        tooltip: { enabled: hasCommissionData }
      }
    }
  });

  // 8. Customer Location Distribution (Bar Chart)
  const locationCtx = document.getElementById('locationChart').getContext('2d');
  new Chart(locationCtx, {
    type: 'bar',
    data: {
      labels: Object.keys(locationData),
      datasets: [{
        label: 'Number of Customers',
        data: Object.values(locationData),
        backgroundColor: [
          'rgba(102, 126, 234, 0.8)',
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(255, 65, 108, 0.8)',
          'rgba(131, 96, 195, 0.8)',
          'rgba(255, 154, 158, 0.8)',
          'rgba(0, 198, 255, 0.8)',
          'rgba(252, 70, 107, 0.8)'
        ],
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' }
        }
      }
    }
  });

  // Add no-data messages for empty charts after all charts are created
  if (!hasLeadData) {
    addNoDataMessage('leadFunnelChart', 'No lead data available');
  }
  if (!hasAgentData) {
    addNoDataMessage('agentPerformanceChart', 'No agent performance data');
  }
  if (!hasCommissionData) {
    addNoDataMessage('commissionChart', 'No commission data available');
  }

  // Real-time updates functionality
  let updateInterval;
  let isUpdating = false;

  // Add loading indicators to cards
  function addLoadingIndicator(cardElement) {
    if (cardElement.querySelector('.loading-indicator')) return;

    const indicator = document.createElement('div');
    indicator.className = 'loading-indicator';
    indicator.innerHTML = '<i class="bi bi-arrow-clockwise"></i>';
    indicator.style.cssText = `
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.9);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: #667eea;
      animation: spin 1s linear infinite;
      z-index: 100;
    `;
    cardElement.style.position = 'relative';
    cardElement.appendChild(indicator);
  }

  function removeLoadingIndicator(cardElement) {
    const indicator = cardElement.querySelector('.loading-indicator');
    if (indicator) indicator.remove();
  }

  // Format currency for display
  function formatCurrency(amount) {
    if (amount > 1000000) {
      return '₹' + (amount / 1000000).toFixed(1) + 'M';
    } else if (amount > 1000) {
      return '₹' + (amount / 1000).toFixed(1) + 'K';
    } else {
      return '₹' + amount.toLocaleString();
    }
  }

  // Update dashboard stats
  function updateDashboardStats() {
    if (isUpdating) return;
    isUpdating = true;

    // Get all stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => addLoadingIndicator(card));

    fetch('/dashboard/stats', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      // Update Client Requests card (4th quick access card)
      const clientRequestsCard = document.querySelector('[onclick*="client_requests"] .stat-value');
      if (clientRequestsCard) {
        clientRequestsCard.textContent = data.client_requests_count.toLocaleString();
      }

      // Update Commissions Due card (3rd quick access card)
      const commissionsCard = document.querySelector('[onclick*="payouts"] .stat-value');
      if (commissionsCard) {
        commissionsCard.textContent = formatCurrency(data.commissions_due);
      }

      // Update Support Tickets card (4th quick access card)
      const supportCard = document.querySelector('[onclick*="helpdesk"] .stat-value');
      if (supportCard) {
        supportCard.textContent = data.support_tickets.toLocaleString();
      }

      // Update other main stat cards
      const totalCustomersCard = document.querySelector('.stat-card:first-child .stat-value');
      if (totalCustomersCard) {
        totalCustomersCard.textContent = data.total_customers.toLocaleString();
      }

      // Add last updated time indicator
      updateLastUpdatedTime(data.last_updated);

      // Add brief flash effect to updated cards
      statCards.forEach(card => {
        card.style.transition = 'all 0.3s ease';
        card.style.transform = 'scale(1.02)';
        setTimeout(() => {
          card.style.transform = 'scale(1)';
        }, 200);
      });

      console.log('Dashboard updated at:', data.last_updated);
    })
    .catch(error => {
      console.error('Error updating dashboard:', error);
      showUpdateError();
    })
    .finally(() => {
      isUpdating = false;
      statCards.forEach(card => removeLoadingIndicator(card));
    });
  }

  // Add last updated time display
  function addLastUpdatedDisplay() {
    const container = document.querySelector('.dashboard-container');
    const updateDisplay = document.createElement('div');
    updateDisplay.id = 'lastUpdated';
    updateDisplay.style.cssText = `
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: rgba(255,255,255,0.95);
      padding: 8px 15px;
      border-radius: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      font-size: 12px;
      color: #64748b;
      border: 1px solid rgba(102, 126, 234, 0.1);
      z-index: 1000;
    `;
    updateDisplay.innerHTML = '<i class="bi bi-clock me-1"></i>Last updated: Just now';
    container.appendChild(updateDisplay);
  }

  function updateLastUpdatedTime(time) {
    const display = document.getElementById('lastUpdated');
    if (display) {
      display.innerHTML = `<i class="bi bi-clock me-1"></i>Last updated: ${time}`;
      display.style.background = 'rgba(102, 126, 234, 0.1)';
      setTimeout(() => {
        display.style.background = 'rgba(255,255,255,0.95)';
      }, 1000);
    }
  }

  function showUpdateError() {
    const display = document.getElementById('lastUpdated');
    if (display) {
      display.innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>Update failed';
      display.style.background = 'rgba(255, 193, 7, 0.1)';
    }
  }

  // Add control panel for real-time updates
  function addUpdateControls() {
    const container = document.querySelector('.dashboard-container');
    const controls = document.createElement('div');
    controls.style.cssText = `
      position: fixed;
      bottom: 70px;
      right: 20px;
      background: rgba(255,255,255,0.95);
      padding: 10px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      border: 1px solid rgba(102, 126, 234, 0.1);
      z-index: 1000;
    `;

    controls.innerHTML = `
      <div style="display: flex; gap: 10px; align-items: center;">
        <button id="toggleUpdates" class="btn btn-sm btn-primary">
          <i class="bi bi-pause-fill"></i> Auto-refresh: ON
        </button>
        <button id="manualUpdate" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
    `;

    container.appendChild(controls);

    // Add event listeners
    document.getElementById('toggleUpdates').addEventListener('click', toggleAutoUpdates);
    document.getElementById('manualUpdate').addEventListener('click', updateDashboardStats);
  }

  function toggleAutoUpdates() {
    const button = document.getElementById('toggleUpdates');

    if (updateInterval) {
      clearInterval(updateInterval);
      updateInterval = null;
      button.innerHTML = '<i class="bi bi-play-fill"></i> Auto-refresh: OFF';
      button.className = 'btn btn-sm btn-outline-primary';
    } else {
      startAutoUpdates();
      button.innerHTML = '<i class="bi bi-pause-fill"></i> Auto-refresh: ON';
      button.className = 'btn btn-sm btn-primary';
    }
  }

  function startAutoUpdates() {
    updateInterval = setInterval(updateDashboardStats, 30000); // Update every 30 seconds
  }

  // Add spinning animation for loading
  const style = document.createElement('style');
  style.textContent = `
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  `;
  document.head.appendChild(style);

  // Initialize real-time updates
  addLastUpdatedDisplay();
  addUpdateControls();
  startAutoUpdates();

  // Update immediately on page load
  setTimeout(updateDashboardStats, 2000);

  // Floating Action Button functionality
  function toggleFabMenu() {
    const fabMain = document.querySelector('.fab-main');
    const fabMenu = document.getElementById('fabMenu');

    fabMain.classList.toggle('active');
    fabMenu.classList.toggle('active');
  }

  // Close FAB menu when clicking outside
  document.addEventListener('click', function(event) {
    const fabContainer = document.querySelector('.fab-container');
    const fabMenu = document.getElementById('fabMenu');
    const fabMain = document.querySelector('.fab-main');

    if (!fabContainer.contains(event.target) && fabMenu.classList.contains('active')) {
      fabMain.classList.remove('active');
      fabMenu.classList.remove('active');
    }
  });

  // Add tooltips to FAB items
  document.querySelectorAll('.fab-item').forEach(item => {
    item.addEventListener('mouseenter', function() {
      const title = this.getAttribute('title');
      if (title) {
        const tooltip = document.createElement('div');
        tooltip.className = 'fab-tooltip';
        tooltip.textContent = title;
        tooltip.style.cssText = `
          position: absolute;
          right: 60px;
          top: 50%;
          transform: translateY(-50%);
          background: #1a202c;
          color: white;
          padding: 6px 12px;
          border-radius: 6px;
          font-size: 12px;
          font-weight: 500;
          white-space: nowrap;
          z-index: 1001;
          opacity: 0;
          transition: opacity 0.2s ease;
        `;
        this.appendChild(tooltip);
        setTimeout(() => tooltip.style.opacity = '1', 10);
      }
    });

    item.addEventListener('mouseleave', function() {
      const tooltip = this.querySelector('.fab-tooltip');
      if (tooltip) {
        tooltip.remove();
      }
    });
  });

  // Enhanced card animations on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animation = 'slideInUp 0.6s ease-out';
      }
    });
  }, observerOptions);

  // Observe all cards for scroll animations
  document.querySelectorAll('.stat-card, .chart-card').forEach(card => {
    cardObserver.observe(card);
  });

  // Add slide-in animation
  const slideInStyle = document.createElement('style');
  slideInStyle.textContent = `
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  `;
  document.head.appendChild(slideInStyle);

  // Live time update in header
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('en-IN', {
      hour12: false,
      hour: '2-digit',
      minute: '2-digit'
    });
    const timeElement = document.getElementById('liveTime');
    if (timeElement) {
      timeElement.textContent = timeString;
    }
  }

  // Update time immediately and then every second
  updateTime();
  setInterval(updateTime, 1000);
</script>
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Sub Agents</h2>
    <p class="text-muted mb-0">Manage your sub agent network and view agent details</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_sub_agent_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Create Sub Agent
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Sub Agents</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_sub_agents) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-people text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Sub Agents</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@active_sub_agents) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-person-check text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Inactive Sub Agents</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@inactive_sub_agents) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-person-x text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_sub_agents_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end" do |form| %>
      <!-- Search -->
      <div class="flex-grow-1 min-width-250">
        <%= form.text_field :search, placeholder: "Search by name, mobile, or email...",
                           value: params[:search],
                           class: "form-control" %>
      </div>

      <!-- Status Filter -->
      <div>
        <%= form.select :status,
                       options_for_select([
                         ['All Statuses', ''],
                         ['Active', 'active'],
                         ['Inactive', 'inactive']
                       ], params[:status]),
                       {},
                       { class: "form-select" } %>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-2">
        <%= form.submit "Search", class: "btn btn-primary" %>
        <%= link_to "Clear", admin_sub_agents_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Sub Agents Table -->
<div class="card shadow-sm">
  <div class="card-body">
    <% if @sub_agents.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Mobile</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @sub_agents.each do |sub_agent| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
                      <i class="bi bi-person text-primary"></i>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= sub_agent.display_name %></h6>
                      <small class="text-muted"><%= sub_agent.full_name %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-telephone me-1"></i>
                    <%= sub_agent.formatted_mobile %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-envelope me-1"></i>
                    <%= sub_agent.formatted_email %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-info">Role <%= sub_agent.role_id %></span>
                </td>
                <td>
                  <% if sub_agent.active? %>
                    <span class="badge bg-success">Active</span>
                  <% else %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(sub_agent.created_at) %> ago
                  </small>
                </td>
                <td>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu">
                      <li><%= link_to "View", admin_sub_agent_path(sub_agent), class: "dropdown-item" %></li>
                      <li><%= link_to "Edit", edit_admin_sub_agent_path(sub_agent), class: "dropdown-item" %></li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= link_to toggle_status_admin_sub_agent_path(sub_agent),
                                   method: :patch,
                                   class: "dropdown-item",
                                   data: { confirm: "Are you sure you want to change the status?" } do %>
                          <% if sub_agent.active? %>
                            <i class="bi bi-pause-circle text-warning me-2"></i>Deactivate
                          <% else %>
                            <i class="bi bi-play-circle text-success me-2"></i>Activate
                          <% end %>
                        <% end %>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= link_to "Delete", admin_sub_agent_path(sub_agent),
                                   method: :delete,
                                   class: "dropdown-item text-danger",
                                   data: { confirm: "Are you sure you want to delete this sub agent? This action cannot be undone." } do %>
                          <i class="bi bi-trash text-danger me-2"></i>Delete
                        <% end %>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="text-muted">
          Showing <%= @sub_agents.offset_value + 1 %> to <%= [@sub_agents.offset_value + @sub_agents.limit_value, @sub_agents.total_count].min %> of <%= @sub_agents.total_count %> entries
        </div>
        <div>
          <%= paginate @sub_agents, theme: 'twitter-bootstrap-5' %>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-people display-1 text-muted"></i>
        </div>
        <h5 class="mb-3">No Sub Agents Found</h5>
        <p class="text-muted mb-4">
          <% if params[:search].present? || params[:status].present? %>
            No sub agents match your current filters. Try adjusting your search criteria.
          <% else %>
            Start building your sub agent network by adding your first sub agent.
          <% end %>
        </p>
        <% unless params[:search].present? || params[:status].present? %>
          <%= link_to new_admin_sub_agent_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i>
            Create First Sub Agent
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
.min-width-250 {
  min-width: 250px;
}

.avatar-sm {
  width: 38px;
  height: 38px;
}
</style>
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="d-flex align-items-center">
    <h2 class="page-title mb-0">
      <span class="title-text">Investor</span>
      <span class="title-highlight">Management</span>
    </h2>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_investor_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Create Investor
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Investors</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_investors) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-people text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Recent Investors</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@total_investors) %></h3>
            <small class="text-muted">Last 30 days</small>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-person-plus text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Credentials</h6>
            <h3 class="mb-0 text-info"><%= number_with_delimiter(@total_investors) %></h3>
            <small class="text-muted">Login accounts</small>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-key text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_investors_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end", id: "search_form" do |form| %>
      <!-- Search -->
      <div class="flex-grow-1 min-width-250">
        <%= form.text_field :search, placeholder: "Search by name, mobile, or email... (min 4 characters)",
                           value: params[:search],
                           class: "form-control",
                           id: "search_input",
                           data: { min_length: 4 } %>
      </div>


      <!-- Actions -->
      <div class="d-flex gap-2">
        <%= link_to "Clear", admin_investors_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Investors Table -->
<div class="card shadow-sm">
  <div class="card-body">
    <% if @investors.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Mobile</th>
              <th>Email</th>
              <th>Login Credentials</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @investors.each do |investor| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
                      <i class="bi bi-person text-primary"></i>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= investor.display_name %></h6>
                      <small class="text-muted"><%= investor.full_name %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-telephone me-1"></i>
                    <%= investor.formatted_mobile %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-envelope me-1"></i>
                    <%= investor.formatted_email %>
                  </span>
                </td>
                <td>
                  <div>
                    <div><strong>Login:</strong> Email or Mobile</div>
                    <div><strong>Password:</strong> <%= investor.original_password || 'N/A' %></div>
                  </div>
                </td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(investor.created_at) %> ago
                  </small>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to admin_investor_path(investor), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_investor_path(investor), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to admin_investor_path(investor),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        title: "Delete",
                        data: {
                          confirm: "⚠️ PERMANENT DELETE WARNING ⚠️\n\nThis will PERMANENTLY delete:\n• Investor: #{investor.display_name}\n• All investor documents\n• Remove investor reference from insurance policies\n• Clean up related commission payouts\n\nThis action CANNOT be undone!\n\nAre you absolutely sure you want to proceed?",
                          turbo_method: :delete
                        } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="card-footer bg-transparent border-0">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
          <small class="text-muted mb-2 mb-md-0">
            <% if defined?(@total_filtered_count) && @total_filtered_count.present? %>
              Showing <%= @investors.current_page == 1 ? 1 : ((@investors.current_page - 1) * @investors.limit_value + 1) %>
              to <%= [@investors.current_page * @investors.limit_value, @total_filtered_count].min %>
              of <%= number_with_delimiter(@total_filtered_count) %> investors
            <% elsif @investors.respond_to?(:total_count) %>
              Showing <%= @investors.current_page == 1 ? 1 : ((@investors.current_page - 1) * @investors.limit_value + 1) %>
              to <%= [@investors.current_page * @investors.limit_value, @investors.total_count].min %>
              of <%= number_with_delimiter(@investors.total_count) %> investors
            <% else %>
              Showing <%= @investors.count %> investors
            <% end %>
          </small>

          <% if @investors.respond_to?(:total_pages) && @investors.total_pages > 1 %>
            <div class="pagination-wrapper">
              <%= paginate @investors %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-people display-1 text-muted"></i>
        </div>
        <h5 class="mb-3">No Investors Found</h5>
        <p class="text-muted mb-4">
          <% if params[:search].present? || params[:status].present? %>
            No investors match your current filters. Try adjusting your search criteria.
          <% else %>
            Start building your investor network by adding your first investor.
          <% end %>
        </p>
        <% unless params[:search].present? || params[:status].present? %>
          <%= link_to new_admin_investor_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i>
            Create First Investor
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
/* Attractive Page Title Styling */
.page-title {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.5px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  position: relative;
  padding-left: 0;
}

.title-text {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 800;
  position: relative;
}

.title-highlight {
  color: #2d3748;
  font-weight: 600;
  position: relative;
}

.title-highlight::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 2px;
  animation: slideIn 0.5s ease-out;
}

@keyframes slideIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 100%;
    opacity: 1;
  }
}

/* Hover effect for the title */
.page-title:hover .title-text {
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.2);
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .page-title {
    font-size: 1.5rem;
  }
}

/* Existing styles */
.min-width-250 {
  min-width: 250px;
}

.avatar-sm {
  width: 38px;
  height: 38px;
}

/* Enhanced button styling for actions */
.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.775rem;
  border-radius: 0.2rem;
}

.btn-outline-primary:hover {
  transform: scale(1.05);
  transition: transform 0.2s;
}

.btn-outline-warning:hover {
  transform: scale(1.05);
  transition: transform 0.2s;
}

.btn-outline-danger:hover {
  transform: scale(1.05);
  transition: transform 0.2s;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('search_input');
  const searchForm = document.getElementById('search_form');
  let searchTimeout;

  // Auto-search on typing after 4 characters
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const searchValue = this.value;

    searchTimeout = setTimeout(() => {
      if (searchValue.length >= 4 || searchValue.length === 0) {
        searchForm.submit();
      }
    }, 500); // 500ms delay after typing stops
  });
});
</script>

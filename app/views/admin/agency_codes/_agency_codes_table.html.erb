<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr>
        <th>TYPE</th>
        <th>COMPANY NAME</th>
        <th>AGENT NAME</th>
        <th>AGENCY CODE</th>
        <th>ACTION</th>
      </tr>
    </thead>
    <tbody>
      <% if agency_codes.any? %>
        <% agency_codes.each do |agency_code| %>
          <tr>
            <td>
              <% case agency_code.insurance_type.downcase %>
              <% when 'health' %>
                <span class="badge type-badge-health">Health</span>
              <% when 'motor' %>
                <span class="badge type-badge-motor">Motor</span>
              <% when 'life' %>
                <span class="badge type-badge-life">Life</span>
              <% when 'general' %>
                <span class="badge type-badge-general">General</span>
              <% else %>
                <span class="badge type-badge-other"><%= agency_code.insurance_type %></span>
              <% end %>
            </td>
            <td>
              <div class="d-flex align-items-center">
                <span class="company-badge me-2">
                  <%= agency_code.company_name.split(' ').first %>
                </span>
                <span class="text-dark fw-medium"><%= agency_code.company_name %></span>
              </div>
            </td>
            <td>
              <span class="fw-medium text-dark"><%= agency_code.agent_name %></span>
            </td>
            <td>
              <code class="bg-light text-dark px-2 py-1 rounded"><%= agency_code.code %></code>
            </td>
            <td>
              <div class="d-flex gap-1">
                <%= link_to edit_admin_agency_code_path(agency_code),
                    class: "btn btn-sm btn-outline-primary edit-agency-code",
                    data: { bs_toggle: "tooltip", title: "Edit" } do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <%= link_to admin_agency_code_path(agency_code),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger delete-agency-code",
                    data: {
                      confirm: "Are you sure you want to delete this agency code?",
                      bs_toggle: "tooltip",
                      title: "Delete"
                    } do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="text-center py-4">
            <div class="d-flex flex-column align-items-center text-muted">
              <i class="bi bi-inbox display-4 mb-2"></i>
              <p class="mb-0">No agency codes found</p>
              <% if params[:search].present? %>
                <small>Try adjusting your search criteria</small>
              <% else %>
                <small>Add your first agency code using the form above</small>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if agency_codes.any? %>
  <div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted">
      Showing <%= agency_codes.count %> of <%= AgencyCode.count %> entries
    </small>

    <!-- Pagination would go here if needed -->
    <div class="d-flex gap-1">
      <button class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
      <button class="btn btn-sm btn-primary">1</button>
      <button class="btn btn-sm btn-outline-secondary" disabled>Next</button>
    </div>
  </div>
<% end %>
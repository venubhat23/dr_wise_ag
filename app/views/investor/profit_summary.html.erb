<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">Profit Summary Dashboard</h2>
      <p class="text-muted mb-0">Detailed profit breakdown for <%= @investor.full_name %></p>
    </div>
    <div>
      <%= link_to investor_dashboard_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>
        Back to Dashboard
      <% end %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Total Profit</h6>
              <h3 class="mb-0 text-success">₹<%= number_with_delimiter((@total_profit_stats[:total_profit]).round(0)) %></h3>
            </div>
            <div class="bg-success bg-opacity-10 rounded p-3">
              <i class="bi bi-currency-rupee text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Total Policies</h6>
              <h3 class="mb-0 text-primary"><%= @total_profit_stats[:total_policies] %></h3>
            </div>
            <div class="bg-primary bg-opacity-10 rounded p-3">
              <i class="bi bi-file-text text-primary fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Avg Profit/Policy</h6>
              <h3 class="mb-0 text-info">₹<%= number_with_delimiter(@total_profit_stats[:average_profit_per_policy].round(0)) %></h3>
            </div>
            <div class="bg-info bg-opacity-10 rounded p-3">
              <i class="bi bi-graph-up text-info fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="text-muted mb-2">Profit Margin</h6>
              <h3 class="mb-0 text-warning"><%= @total_profit_stats[:profit_margin] %>%</h3>
            </div>
            <div class="bg-warning bg-opacity-10 rounded p-3">
              <i class="bi bi-percent text-warning fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Profit by Policy Type -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0">
        <i class="bi bi-pie-chart-fill text-primary me-2"></i>
        Profit by Policy Type
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <% ['health', 'life', 'motor', 'other'].each do |policy_type| %>
          <% data = @profit_breakdown[policy_type.to_sym] %>
          <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-left-<%= policy_type == 'health' ? 'success' : policy_type == 'life' ? 'warning' : policy_type == 'motor' ? 'info' : 'secondary' %> h-100">
              <div class="card-body">
                <h6 class="text-uppercase text-muted mb-3">
                  <%= policy_type.capitalize %> Insurance
                </h6>
                <div class="mb-2">
                  <span class="text-muted small">Policies:</span>
                  <strong class="float-end"><%= data[:policies_count] %></strong>
                </div>
                <div class="mb-2">
                  <span class="text-muted small">Premium:</span>
                  <strong class="float-end">₹<%= number_with_delimiter((data[:total_premium]).round(0)) %></strong>
                </div>
                <div class="mb-2">
                  <span class="text-muted small">Commission:</span>
                  <strong class="float-end">₹<%= number_with_delimiter((data[:investor_commission]).round(0)) %></strong>
                </div>
                <div class="mb-2">
                  <span class="text-muted small">Expenses:</span>
                  <strong class="float-end">₹<%= number_with_delimiter((data[:company_expenses]).round(0)) %></strong>
                </div>
                <hr class="my-2">
                <div class="mb-0">
                  <span class="text-muted small">Net Profit:</span>
                  <strong class="float-end <%= data[:profit] >= 0 ? 'text-success' : 'text-danger' %>">
                    ₹<%= number_with_delimiter((data[:profit]).round(0)) %>
                  </strong>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                  <div class="progress-bar bg-<%= data[:profit] >= 0 ? 'success' : 'danger' %>"
                       role="progressbar"
                       style="width: <%= [data[:profit_margin].abs, 100].min %>%"
                       aria-valuenow="<%= data[:profit_margin] %>"
                       aria-valuemin="0"
                       aria-valuemax="100">
                  </div>
                </div>
                <small class="text-muted">Margin: <%= data[:profit_margin] %>%</small>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Monthly Trends Chart -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0">
        <i class="bi bi-graph-up text-primary me-2"></i>
        Monthly Profit Trends (Last 12 Months)
      </h5>
    </div>
    <div class="card-body">
      <canvas id="monthlyProfitChart" height="100"></canvas>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label small text-muted">Policy Type</label>
          <select class="form-select" id="policyTypeFilter">
            <option value="">All Types</option>
            <option value="Health">Health</option>
            <option value="Life">Life</option>
            <option value="Motor">Motor</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted">Sort By</label>
          <select class="form-select" id="sortFilter">
            <option value="profit_desc">Highest Profit</option>
            <option value="profit_asc">Lowest Profit</option>
            <option value="premium_desc">Highest Premium</option>
            <option value="date_desc">Latest Policies</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted">Profit Status</label>
          <select class="form-select" id="profitFilter">
            <option value="">All Policies</option>
            <option value="profitable">Profitable Only</option>
            <option value="unprofitable">Loss Making</option>
          </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <button class="btn btn-outline-secondary w-100" onclick="resetFilters()">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Reset Filters
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Policy Details Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0">
        <i class="bi bi-list-ul text-primary me-2"></i>
        Individual Policy Profits
      </h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Policy Details</th>
              <th class="border-0 text-end">Premium</th>
              <th class="border-0 text-end">Commission</th>
              <th class="border-0 text-end">Expenses</th>
              <th class="border-0 text-end">Net Profit</th>
              <th class="border-0 text-center">Margin</th>
            </tr>
          </thead>
          <tbody id="policiesList">
            <% @policy_profits.each do |policy| %>
              <tr class="policy-item"
                  data-type="<%= policy[:policy_type] %>"
                  data-profit="<%= policy[:profit] %>"
                  data-premium="<%= policy[:premium] %>"
                  data-date="<%= policy[:policy_date] %>">
                <td>
                  <div>
                    <h6 class="mb-1">
                      <%= policy[:policy_number] %>
                      <span class="badge bg-<%= policy[:policy_type].downcase == 'health' ? 'success' :
                                               policy[:policy_type].downcase == 'life' ? 'warning' :
                                               policy[:policy_type].downcase == 'motor' ? 'info' : 'secondary' %> ms-2">
                        <%= policy[:policy_type] %>
                      </span>
                    </h6>
                    <small class="text-muted">
                      <%= policy[:customer_name] %> • <%= policy[:policy_date].strftime("%d %b %Y") %>
                    </small>
                  </div>
                </td>
                <td class="text-end align-middle">
                  <strong>₹<%= number_with_delimiter(policy[:premium].round(0)) %></strong>
                </td>
                <td class="text-end align-middle">
                  ₹<%= number_with_delimiter(policy[:investor_commission].round(0)) %>
                </td>
                <td class="text-end align-middle">
                  ₹<%= number_with_delimiter(policy[:company_expenses].round(0)) %>
                </td>
                <td class="text-end align-middle">
                  <strong class="<%= policy[:profit] >= 0 ? 'text-success' : 'text-danger' %>">
                    ₹<%= number_with_delimiter(policy[:profit].round(0)) %>
                  </strong>
                </td>
                <td class="text-center align-middle">
                  <span class="badge bg-<%= policy[:profit_margin] >= 0 ? 'success' : 'danger' %>">
                    <%= policy[:profit_margin] %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Custom CSS for border-left style -->
<style>
  .card.border-left-success {
    border-left: 4px solid #28a745 !important;
  }
  .card.border-left-warning {
    border-left: 4px solid #ffc107 !important;
  }
  .card.border-left-info {
    border-left: 4px solid #17a2b8 !important;
  }
  .card.border-left-secondary {
    border-left: 4px solid #6c757d !important;
  }
  .table-responsive {
    max-height: 600px;
    overflow-y: auto;
  }
</style>

<!-- Chart.js Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Monthly Profit Trends Chart
  const profitCtx = document.getElementById('monthlyProfitChart').getContext('2d');
  const monthlyTrends = <%= @monthly_profit_trends.to_json.html_safe %>;

  new Chart(profitCtx, {
    type: 'bar',
    data: {
      labels: Object.values(monthlyTrends).map(d => d.month.split(' ')[0].substr(0,3)),
      datasets: [{
        label: 'Monthly Profit (₹)',
        data: Object.values(monthlyTrends).map(d => d.profit),
        backgroundColor: 'rgba(40, 167, 69, 0.8)',
        borderColor: 'rgba(40, 167, 69, 1)',
        borderWidth: 2,
        borderRadius: 4
      }, {
        label: 'Premium (₹)',
        data: Object.values(monthlyTrends).map(d => d.premium),
        type: 'line',
        borderColor: 'rgba(0, 123, 255, 0.8)',
        backgroundColor: 'transparent',
        borderWidth: 2,
        fill: false,
        tension: 0.3
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          position: 'top'
        }
      },
      scales: {
        x: {
          grid: {
            display: false
          }
        },
        y: {
          ticks: {
            callback: function(value) {
              return '₹ ' + (value/1000).toFixed(0) + 'K';
            }
          },
          grid: {
            borderDash: [2, 2]
          }
        }
      }
    }
  });

  // Filter functionality
  document.getElementById('policyTypeFilter').addEventListener('change', filterPolicies);
  document.getElementById('sortFilter').addEventListener('change', filterPolicies);
  document.getElementById('profitFilter').addEventListener('change', filterPolicies);

  function filterPolicies() {
    const typeFilter = document.getElementById('policyTypeFilter').value;
    const sortFilter = document.getElementById('sortFilter').value;
    const profitFilter = document.getElementById('profitFilter').value;

    const tbody = document.getElementById('policiesList');
    const policies = Array.from(tbody.querySelectorAll('tr.policy-item'));

    // Filter policies
    policies.forEach(policy => {
      let show = true;

      if (typeFilter && !policy.dataset.type.includes(typeFilter)) {
        show = false;
      }

      if (profitFilter === 'profitable' && parseFloat(policy.dataset.profit) <= 0) {
        show = false;
      }

      if (profitFilter === 'unprofitable' && parseFloat(policy.dataset.profit) > 0) {
        show = false;
      }

      policy.style.display = show ? '' : 'none';
    });

    // Sort policies
    const visiblePolicies = policies.filter(p => p.style.display !== 'none');

    visiblePolicies.sort((a, b) => {
      switch (sortFilter) {
        case 'profit_desc':
          return parseFloat(b.dataset.profit) - parseFloat(a.dataset.profit);
        case 'profit_asc':
          return parseFloat(a.dataset.profit) - parseFloat(b.dataset.profit);
        case 'premium_desc':
          return parseFloat(b.dataset.premium) - parseFloat(a.dataset.premium);
        case 'date_desc':
          return new Date(b.dataset.date) - new Date(a.dataset.date);
        default:
          return 0;
      }
    });

    // Re-append sorted policies
    visiblePolicies.forEach(policy => tbody.appendChild(policy));
  }

  function resetFilters() {
    document.getElementById('policyTypeFilter').value = '';
    document.getElementById('sortFilter').value = 'profit_desc';
    document.getElementById('profitFilter').value = '';
    filterPolicies();
  }
</script>
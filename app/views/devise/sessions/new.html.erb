
<style>
.auth-wrapper {
  min-height: 100vh;
  background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #f5576c, #4facfe, #00f2fe, #a8edea, #fed6e3);
  background-size: 600% 600%;
  animation: gradientBG 20s ease infinite;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.auth-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url('data:image/svg+xml,<svg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd"><g fill="%23ffffff" fill-opacity="0.05"><circle cx="7" cy="7" r="2"/><circle cx="27" cy="7" r="1"/><circle cx="47" cy="7" r="2"/><circle cx="7" cy="27" r="1"/><circle cx="27" cy="27" r="2"/><circle cx="47" cy="27" r="1"/><circle cx="7" cy="47" r="2"/><circle cx="27" cy="47" r="1"/><circle cx="47" cy="47" r="2"/></g></svg>');
  animation: float 20s ease-in-out infinite;
  z-index: 1;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(180deg); }
}

.login-container {
  position: relative;
  z-index: 10;
  animation: slideInUp 0.8s ease-out;
  width: 100%;
  max-width: 450px;
  margin: auto;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.login-card {
  backdrop-filter: blur(30px) saturate(180%);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow:
    0 25px 50px rgba(0, 0, 0, 0.15),
    0 1px 1px rgba(255, 255, 255, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    inset 0 -1px 0 rgba(255, 255, 255, 0.2);
  animation: cardFloat 6s ease-in-out infinite;
  border-radius: 25px;
  position: relative;
  overflow: hidden;
}

.login-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, transparent, rgba(255, 255, 255, 0.1), transparent, rgba(255, 255, 255, 0.05), transparent);
  animation: rotate 10s linear infinite;
  z-index: 0;
}

.login-card .card-body {
  position: relative;
  z-index: 1;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes cardFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.floating-elements {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 2;
  pointer-events: none;
}

.floating-element {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  animation: floatingElements 20s linear infinite;
}

.floating-element:nth-child(1) {
  width: 80px;
  height: 80px;
  left: 10%;
  animation-delay: 0s;
}

.floating-element:nth-child(2) {
  width: 120px;
  height: 120px;
  left: 20%;
  animation-delay: 2s;
}

.floating-element:nth-child(3) {
  width: 60px;
  height: 60px;
  left: 70%;
  animation-delay: 4s;
}

.floating-element:nth-child(4) {
  width: 100px;
  height: 100px;
  left: 80%;
  animation-delay: 6s;
}

@keyframes floatingElements {
  0% {
    transform: translateY(100vh) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(-100px) rotate(720deg);
    opacity: 0;
  }
}

.contact-info {
  margin-top: 30px;
  text-align: center;
  z-index: 10;
  position: relative;
}

.contact-info .contact-row {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-bottom: 15px;
}

.contact-info .contact-item {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
}

.contact-info .contact-separator {
  color: rgba(255, 255, 255, 0.5);
  margin: 0 10px;
}

@media (max-width: 768px) {
  .contact-info .contact-row {
    flex-direction: column;
    gap: 10px;
  }

  .contact-info .contact-separator {
    display: none;
  }
}

/* Modern Input Styles */
.modern-input-wrapper {
  position: relative;
  margin-bottom: 1rem;
}

.modern-input-group {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border-radius: 16px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.modern-input-group:focus-within {
  border-color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.15);
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
  transform: translateY(-2px);
}

.modern-input-icon {
  padding: 0 1rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 1.1rem;
  z-index: 2;
  transition: color 0.3s ease;
}

.modern-input-group:focus-within .modern-input-icon {
  color: rgba(255, 255, 255, 0.9);
}

.modern-input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 1rem 0.5rem;
  color: rgba(255, 255, 255, 0.95);
  font-size: 1rem;
  font-weight: 400;
  z-index: 2;
  transition: all 0.3s ease;
}

.modern-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
}

.modern-input:focus {
  outline: none;
  color: white;
}

.modern-toggle-btn {
  background: transparent;
  border: none;
  padding: 0.5rem 1rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 2;
}

.modern-toggle-btn:hover {
  color: rgba(255, 255, 255, 0.9);
  transform: scale(1.1);
}

.modern-input-border {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3px;
  background: linear-gradient(90deg, #00f2fe, #4facfe);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  transform: translateX(-50%);
  z-index: 3;
}

.modern-input-group:focus-within .modern-input-border {
  width: 100%;
}

/* Enhanced Login Button */
.btn-login {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 16px;
  padding: 1rem 2rem;
  font-weight: 600;
  font-size: 1rem;
  color: white;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
}

.btn-login::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s ease;
}

.btn-login:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px rgba(102, 126, 234, 0.4);
  background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
}

.btn-login:hover::before {
  left: 100%;
}

.btn-login:active {
  transform: translateY(-1px);
}
</style>

<!-- Floating background elements -->
<div class="floating-elements">
  <div class="floating-element"></div>
  <div class="floating-element"></div>
  <div class="floating-element"></div>
  <div class="floating-element"></div>
</div>

<div class="login-container">
  <div class="login-card">
    <div class="card-body p-5">
      <!-- Logo and Title -->
      <div class="text-center mb-4">
        <div class="d-flex justify-content-center align-items-center mb-3">
          <i class="bi bi-shield-check text-primary me-2" style="font-size: 2.5rem;"></i>
          <h2 class="text-primary mb-0 fw-bold">InsureBook</h2>
        </div>
        <p class="text-muted mb-0">Technology Pvt Ltd</p>
        <h4 class="text-dark mt-3 mb-1">Login</h4>
        <p class="text-muted">Access your admin dashboard</p>
      </div>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "needs-validation", novalidate: true }) do |f| %>
            <!-- Email Field -->
            <div class="mb-4">
              <div class="modern-input-wrapper">
                <div class="modern-input-group">
                  <span class="modern-input-icon">
                    <i class="bi bi-envelope"></i>
                  </span>
                  <%= f.email_field :email, autofocus: true, autocomplete: "email",
                      class: "modern-input",
                      placeholder: "Enter your email address",
                      required: true %>
                  <div class="modern-input-border"></div>
                </div>
                <div class="invalid-feedback">
                  Please provide a valid email address.
                </div>
              </div>
            </div>

            <!-- Password Field -->
            <div class="mb-4">
              <div class="modern-input-wrapper">
                <div class="modern-input-group">
                  <span class="modern-input-icon">
                    <i class="bi bi-lock"></i>
                  </span>
                  <%= f.password_field :password, autocomplete: "current-password",
                      class: "modern-input",
                      placeholder: "Enter your password",
                      required: true %>
                  <button class="modern-toggle-btn" type="button" id="togglePassword">
                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                  </button>
                  <div class="modern-input-border"></div>
                </div>
                <div class="invalid-feedback">
                  Password is required.
                </div>
              </div>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="d-flex justify-content-between align-items-center mb-4">
              <% if devise_mapping.rememberable? %>
                <div class="form-check">
                  <%= f.check_box :remember_me, class: "form-check-input" %>
                  <%= f.label :remember_me, "Remember me", class: "form-check-label text-muted" %>
                </div>
              <% end %>

              <%= link_to "Forgot Password?", new_password_path(resource_name),
                  class: "text-primary text-decoration-none" %>
            </div>

            <!-- Login Button -->
            <div class="d-grid mb-4">
              <%= f.submit "Sign In", class: "btn btn-login btn-lg w-100" %>
            </div>
          <% end %>

          <!-- Registration Link -->
          <% if devise_mapping.registerable? %>
            <div class="text-center">
              <p class="text-muted mb-0">Don't have an account?</p>
              <%= link_to "Create New Account", new_registration_path(resource_name),
                  class: "text-primary fw-bold text-decoration-none" %>
            </div>
          <% end %>

          <!-- Footer Links -->
          <div class="text-center mt-4 pt-3 border-top">
            <small class="text-muted">
              <%= link_to "#", class: "text-muted text-decoration-none me-3" do %>
                <i class="bi bi-question-circle me-1"></i>
                Help & Support
              <% end %>
              <%= link_to "mailto:info@insurebook.in", class: "text-muted text-decoration-none" do %>
                <i class="bi bi-envelope me-1"></i>
                info@insurebook.in
              <% end %>
            </small>
      </div>
    </div>
  </div>

  <!-- Contact Information -->
  <div class="contact-info">
    <div class="contact-row">
      <div class="contact-item">
        <i class="bi bi-telephone me-2"></i>
        <span>+91 75678-44567</span>
      </div>
      <span class="contact-separator">•</span>
      <div class="contact-item">
        <i class="bi bi-envelope me-2"></i>
        <span>info@insurebook.in</span>
      </div>
    </div>
    <div>
      <small style="color: rgba(255, 255, 255, 0.7);">
        <%= link_to "#", class: "text-decoration-none", style: "color: rgba(255, 255, 255, 0.7);" do %>
          Back To Home
        <% end %>
      </small>
    </div>
  </div>
</div>

<script>
  // Form validation
  (function() {
    'use strict';
    window.addEventListener('load', function() {
      var forms = document.getElementsByClassName('needs-validation');
      var validation = Array.prototype.filter.call(forms, function(form) {
        form.addEventListener('submit', function(event) {
          if (form.checkValidity() === false) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    }, false);
  })();

  // Password toggle
  document.getElementById('togglePassword').addEventListener('click', function() {
    const passwordField = this.previousElementSibling;
    const passwordIcon = document.getElementById('togglePasswordIcon');

    if (passwordField.type === 'password') {
      passwordField.type = 'text';
      passwordIcon.classList.remove('bi-eye');
      passwordIcon.classList.add('bi-eye-slash');
    } else {
      passwordField.type = 'password';
      passwordIcon.classList.remove('bi-eye-slash');
      passwordIcon.classList.add('bi-eye');
    }
  });
</script>

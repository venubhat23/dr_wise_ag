  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#commissionDetailsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-percent"></i>
      </div>
      <h5 class="section-title">Commission Details</h5>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="commissionDetailsCollapse" class="collapse">
    <div class="section-body">
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Main Agent Commission %</label>
        <input type="text" class="form-control" value="<%= @life_insurance.main_agent_commission_percentage %> %" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Commission Amount</label>
        <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.commission_amount) %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">TDS %</label>
        <input type="text" class="form-control" value="<%= @life_insurance.tds_percentage %> %" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">TDS Amount</label>
        <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.tds_amount) %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">After TDS Value</label>
        <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.after_tds_value) %>" readonly>
      </div>
    </div>

    <!-- Sub Agent Commission -->
    <% if @life_insurance.sub_agent_commission_percentage.present? && @life_insurance.sub_agent_commission_percentage > 0 %>
      <hr class="my-4">
      <h6 class="mb-3">Sub Agent Commission</h6>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Sub Agent Commission %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.sub_agent_commission_percentage %> %" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Sub Agent Commission Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.sub_agent_commission_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Sub Agent TDS %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.sub_agent_tds_percentage %> %" readonly>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Sub Agent TDS Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.sub_agent_tds_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Sub Agent After TDS Value</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.sub_agent_after_tds_value) %>" readonly>
        </div>
      </div>
    <% end %>

    <!-- Ambassador Commission -->
    <% if @life_insurance.ambassador_commission_percentage.present? && @life_insurance.ambassador_commission_percentage > 0 %>
      <hr class="my-4">
      <h6 class="mb-3">Ambassador Commission</h6>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Ambassador Commission %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.ambassador_commission_percentage %> %" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Ambassador Commission Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.ambassador_commission_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Ambassador TDS %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.ambassador_tds_percentage %> %" readonly>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Ambassador TDS Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.ambassador_tds_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Ambassador After TDS Value</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.ambassador_after_tds_value) %>" readonly>
        </div>
      </div>
    <% end %>

    <!-- Investor Commission -->
    <% if @life_insurance.investor_commission_percentage.present? && @life_insurance.investor_commission_percentage > 0 %>
      <hr class="my-4">
      <h6 class="mb-3">Investor Commission</h6>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Investor Commission %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.investor_commission_percentage %> %" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Investor Commission Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.investor_commission_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Investor TDS %</label>
          <input type="text" class="form-control" value="<%= @life_insurance.investor_tds_percentage %> %" readonly>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Investor TDS Amount</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.investor_tds_amount) %>" readonly>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Investor After TDS Value</label>
          <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.investor_after_tds_value) %>" readonly>
        </div>
      </div>
    <% end %>

    <!-- Company Expenses & Profit -->
    <hr class="my-4">
    <h6 class="mb-3">Company Expenses & Profit</h6>
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Company Expenses %</label>
        <input type="text" class="form-control" value="<%= @life_insurance.company_expenses_percentage %> %" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Profit %</label>
        <input type="text" class="form-control" value="<%= @life_insurance.profit_percentage %> %" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Profit Amount</label>
        <input type="text" class="form-control" value="<%= indian_currency(@life_insurance.profit_amount) %>" readonly>
      </div>
    </div>
  </div>
</div>


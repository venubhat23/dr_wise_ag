}

.customer-type-card {
  cursor: pointer;
  transition: all 0.3s ease;
}

.customer-type-label {
  width: 100%;
  border: 2px solid #e9ecef;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  background: white;
  display: block;
  margin: 0;
}

.customer-type-label:hover {

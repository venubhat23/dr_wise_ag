  // Document Management System
  let documentIndex = 0;
  document.getElementById('add-document-btn')?.addEventListener('click', function() {
    const container = document.getElementById('documents-container');
    const documentRow = document.createElement('div');
    documentRow.className = 'row mb-3 document-row';
    documentRow.innerHTML = `
      <div class="col-md-3">
        <input type="text" name="other_insurance[documents][${documentIndex}][title]"
               class="form-control" placeholder="Document Title">
      </div>
      <div class="col-md-3">
        <select name="other_insurance[documents][${documentIndex}][type]" class="form-control">
          <option value="">Select Type</option>
          <option value="Policy Document">Policy Document</option>
          <option value="ID Proof">ID Proof</option>
          <option value="Address Proof">Address Proof</option>
          <option value="Medical Report">Medical Report</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="col-md-4">
        <input type="file" name="other_insurance[documents][${documentIndex}][file]"
               class="form-control" accept="application/pdf,image/*">
      </div>
      <div class="col-md-2">
        <button type="button" class="btn btn-danger btn-sm remove-document-btn">
          <i class="bi bi-trash"></i> Remove
        </button>
      </div>
    `;
    container.appendChild(documentRow);
    documentIndex++;

    // Add remove functionality
    documentRow.querySelector('.remove-document-btn').addEventListener('click', function() {
      documentRow.remove();
    });
  });
});
</script>
  function initializeMotorBrokerFlow() {
    console.log('🔧 Setting up Motor Broker Flow...');

    const brokerCodeSelect = document.getElementById('motor_insurance_broker_code_type');
    const agencyCodeSelect = document.getElementById('motor_insurance_agency_code_id');
    const insuranceCompanySelect = document.getElementById('motor_insurance_insurance_company_name');

    console.log('🔍 Motor Broker Elements Check:');
    console.log('- Broker Code:', brokerCodeSelect ? '✅' : '❌');
    console.log('- Agency Code:', agencyCodeSelect ? '✅' : '❌');
    console.log('- Insurance Company:', insuranceCompanySelect ? '✅' : '❌');

    if (!brokerCodeSelect) {
      console.error('❌ Motor broker code select not found!');
      return;
    }

    // Clear any existing event listeners and add new one
    $(brokerCodeSelect).off('change.motorBroker');

    // Enable Insurance Company dropdown on click
    $(brokerCodeSelect).off('click.motorBrokerEnable');
    $(brokerCodeSelect).on('click.motorBrokerEnable', function() {
      if (insuranceCompanySelect && insuranceCompanySelect.disabled) {
        insuranceCompanySelect.disabled = false;
        console.log('✅ Motor Insurance Company Name dropdown enabled');

        // Also enable it for Select2 if initialized
        if (window.jQuery && $('#motor_insurance_insurance_company_name').hasClass('select2-hidden-accessible')) {
          $('#motor_insurance_insurance_company_name').prop('disabled', false);
        }
      }
    });

    $(brokerCodeSelect).on('change.motorBroker', function() {
      const brokerType = this.value;
      console.log('🔥 MOTOR BROKER CODE CHANGED! Value:', brokerType);

      // Enable Insurance Company dropdown when any option is selected
      if (insuranceCompanySelect && insuranceCompanySelect.disabled) {
        insuranceCompanySelect.disabled = false;
        console.log('✅ Motor Insurance Company Name dropdown enabled on selection');

        // Also enable it for Select2 if initialized
        if (window.jQuery && $('#motor_insurance_insurance_company_name').hasClass('select2-hidden-accessible')) {
          $('#motor_insurance_insurance_company_name').prop('disabled', false);
        }
      }

      if (!brokerType) {
        console.log('⚠️ No broker type selected, skipping API call');
        return;
      }

      // Clear and show loading state for dependent dropdowns
      if (agencyCodeSelect) {
        $(agencyCodeSelect).select2('destroy');
        agencyCodeSelect.innerHTML = '<option value="">Loading...</option>';
        $(agencyCodeSelect).select2({
          theme: 'bootstrap-5',
          placeholder: 'Loading...',
          allowClear: true,
          width: '100%'
        });
      }

      if (insuranceCompanySelect) {
        $(insuranceCompanySelect).select2('destroy');
        insuranceCompanySelect.innerHTML = '<option value="">Loading...</option>';
        $(insuranceCompanySelect).select2({
          theme: 'bootstrap-5',
          placeholder: 'Loading...',
          allowClear: true,
          width: '100%'
        });
      }

      // Update label
      const labelSpan = document.getElementById('agency_code_label_text');
      if (labelSpan) {
        labelSpan.textContent = brokerType === 'direct' ? ' (Agents)*' : ' (Brokers)*';
      }

      // Call appropriate API
      if (brokerType === 'direct') {
        callMotorDirectAPI();
      } else if (brokerType === 'broking') {
        callMotorBrokingAPI();
      }
    });

    console.log('✅ Motor broker code change listener attached');
  }

  function callMotorDirectAPI() {
    console.log('🌐 Calling Motor Direct API...');

    fetch('/admin/insurance/motor/agency_codes_for_broker_type?broker_type=direct', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      console.log('📡 Motor Direct API Response Status:', response.status);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Motor Direct API Data:', data);

      if (data.success && data.data) {
        populateMotorAgencyDropdown(data.data, 'Select Agent...');

        // Clear company dropdown and show placeholder
        const companySelect = document.getElementById('motor_insurance_insurance_company_name');
        if (companySelect) {
          $(companySelect).select2('destroy');
          companySelect.innerHTML = '<option value="">Select Agent First...</option>';
          $(companySelect).select2({
            theme: 'bootstrap-5',
            placeholder: 'Select Agent First...',
            allowClear: true,
            width: '100%'
          });
        }
      } else {
        console.error('❌ Motor Direct API returned no data');
      }
    })
    .catch(error => {
      console.error('❌ Motor Direct API Error:', error);
    });
  }


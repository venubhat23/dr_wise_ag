<%= form_with model: [:admin, @other_insurance], local: true, class: "needs-validation", novalidate: true do |form| %>

  <!-- Client & Agent Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-person me-2 text-primary"></i>
        Client & Agent Details
      </h5>
    </div>
    <div class="card-body">
      <% if @other_insurance.errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Please correct the following errors:</strong>
          <ul class="mb-0 mt-2">
            <% @other_insurance.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :customer_id, "Client Name*", class: "form-label" %>
          <%= form.select :customer_id,
              options_for_select(@customers.map { |c| [c.display_name, c.id] }, @other_insurance.customer_id),
              { prompt: 'Search and select client...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:customer_id].any?}",
                required: true,
                id: "customer_select",
                data: { placeholder: "Type to search clients..." } } %>
          <% if @other_insurance.errors[:customer_id].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:customer_id].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :policy_holder, "Policy Holder", class: "form-label" %>
          <%
            policy_holder_options = [['Self', 'Self']]
            selected_policy_holder = @other_insurance.policy_holder || 'Self'

            # Add family members to options if available
            if @customer_family_members&.any?
              @customer_family_members.each do |member|
                if member.name.present? && member.name.strip.length > 0
                  display_name = "#{member.name} (#{member.relationship.humanize})"
                  # Use member name as value, not ID
                  policy_holder_options << [display_name, member.name]

                  # If policy_holder was incorrectly saved as member ID, convert to name
                  if @other_insurance.policy_holder == member.id.to_s
                    selected_policy_holder = member.name
                  end
                end
              end
            end

            # Add current policy holder if not in options
            if selected_policy_holder.present? &&
               selected_policy_holder != 'Self' &&
               !policy_holder_options.any? { |opt| opt[1] == selected_policy_holder }
              policy_holder_options << ["#{selected_policy_holder} (Custom)", selected_policy_holder]
            end
          %>
          <%= form.select :policy_holder,
              options_for_select(policy_holder_options, selected_policy_holder),
              {},
              { class: "form-control",
                id: "policy_holder_select",
                data: { placeholder: "Type to search policy holders..." } } %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :sub_agent_id, "Affiliate", class: "form-label" %>
          <%= form.select :sub_agent_id,
              options_for_select([['Self', '']] + @sub_agents.map { |a| [a.display_name, a.id] }, @other_insurance.sub_agent_id),
              { prompt: 'Search and select affiliate...' },
              { class: "form-control",
                id: "affiliate_select",
                data: { placeholder: "Type to search affiliates..." } } %>
        </div>
      </div>

    </div>
  </div>

  <!-- Policy Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-file-text me-2 text-primary"></i>
        Policy Details
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- 1st: Broker Code dropdown with Direct/Broking options -->
        <div class="col-md-4 mb-3">
          <%= form.label :broker_code_type, "Broker Code", class: "form-label" %>
          <%= form.select :broker_code_type,
              options_for_select([
                ['Direct', 'direct'],
                ['Broking', 'broking']
              ], @other_insurance.broker_code_type),
              { prompt: 'Select Broker Code' },
              { class: "form-control", id: "other_insurance_broker_code_type" } %>
        </div>

        <!-- 2nd: Agency Code (shows Agents when Direct selected, Brokers when Broking selected) -->
        <div class="col-md-4 mb-3">
          <%= form.label :agency_code_id, "Agency Code", class: "form-label" %>
          <span class="dynamic-label" id="agency_code_label_text"></span>
          <%
            # Build options based on broker_code_type for edit mode
            agency_options = []
            selected_value = nil

            if @other_insurance.persisted?
              if @other_insurance.broker_code_type == 'direct' && @other_insurance.agency_code_id.present?
                # For direct mode, load the specific agency code
                agency_code = AgencyCode.find_by(id: @other_insurance.agency_code_id)
                if agency_code
                  agency_options << ["#{agency_code.agent_name} - #{agency_code.code}", agency_code.id]
                  selected_value = agency_code.id
                end
              elsif @other_insurance.broker_code_type == 'broking' && @other_insurance.broker_id.present?
                # For broking mode, load the specific broker
                broker = Broker.find_by(id: @other_insurance.broker_id)
                if broker
                  agency_options << [broker.name, "broker_#{broker.id}"]
                  selected_value = "broker_#{broker.id}"
                end
              end
            end

            # If no specific options loaded (new record), use default agency codes
            if agency_options.empty?
              agency_options = @agency_codes.map { |a| ["#{a.agent_name} - #{a.code}", a.id] }
            end
          %>
          <%= form.select :agency_code_id,
              options_for_select(agency_options, selected_value),
              { prompt: 'Search and select agency code...' },
              { class: "form-control", id: "other_insurance_agency_code_id", data: { placeholder: "Type to search agency codes..." } } %>
        </div>

        <!-- Hidden field for broker_id when needed -->
        <%= form.hidden_field :broker_id, id: "broker_id_hidden" %>

        <!-- 3rd: Insurance Company Name (Dynamic based on Agent/Broker selection) -->
        <div class="col-md-4 mb-3">
          <%= form.label :insurance_company_name, "Insurance Company Name*", class: "form-label" %>
          <%= form.select :insurance_company_name,
              options_for_select(@insurance_companies&.map { |c| [c, c] } || [], @other_insurance.insurance_company_name),
              { prompt: 'Search and select company...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:insurance_company_name].any?}", required: true, id: "other_insurance_insurance_company_name", data: { placeholder: "Type to search companies..." }, disabled: @other_insurance.new_record? } %>
          <% if @other_insurance.errors[:insurance_company_name].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:insurance_company_name].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row">

        <div class="col-md-4 mb-3">
          <%= form.label :insurance_type, "Insurance Type*", class: "form-label" %>
          <%= form.select :insurance_type,
              options_for_select([
                ['Travel Insurance', 'Travel Insurance'],
                ['Property Insurance', 'Property Insurance'],
                ['Cyber Insurance', 'Cyber Insurance'],
                ['Professional Indemnity', 'Professional Indemnity'],
                ['Directors & Officers', 'Directors & Officers'],
                ['Marine Insurance', 'Marine Insurance'],
                ['Credit Insurance', 'Credit Insurance'],
                ['Other', 'Other']
              ], @other_insurance.insurance_type),
              { prompt: 'Select Insurance Type' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:insurance_type].any?}",
                required: true } %>
          <% if @other_insurance.errors[:insurance_type].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:insurance_type].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :policy_type, "Policy Type*", class: "form-label" %>
          <%= form.select :policy_type,
              options_for_select([
                ['New', 'New'],
                ['Renewal', 'Renewal'],
                ['Portability', 'Portability']
              ], @other_insurance.policy_type),
              { prompt: 'Select Policy Type' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_type].any?}",
                required: true } %>
          <% if @other_insurance.errors[:policy_type].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_type].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :policy_number, "Policy Number*", class: "form-label" %>
          <%= form.text_field :policy_number,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_number].any?}",
              placeholder: "Enter policy number",
              required: true %>
          <% if @other_insurance.errors[:policy_number].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_number].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :plan_name, "Plan Name", class: "form-label" %>
          <%= form.text_field :plan_name,
              class: "form-control",
              placeholder: "Enter plan name" %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :policy_term, "Policy Term (Years)", class: "form-label" %>
          <%= form.text_field :policy_term,
              class: "form-control",
              placeholder: "e.g., 1, 2, 3" %>
          <div class="form-text">Enter policy term in years (e.g., 1, 2, 3)</div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :policy_booking_date, "Policy Booking Date", class: "form-label" %>
          <%= form.date_field :policy_booking_date,
              class: "form-control",
              min: "1900-01-01",
              max: "2099-12-31" %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :policy_start_date, "Policy Start Date*", class: "form-label" %>
          <%= form.date_field :policy_start_date,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_start_date].any?}",
              required: true,
              id: "start_date",
              min: "1900-01-01",
              max: "2099-12-31" %>
          <% if @other_insurance.errors[:policy_start_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_start_date].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :policy_end_date, "Policy End Date*", class: "form-label" %>
          <%= form.date_field :policy_end_date,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_end_date].any?}",
              required: true,
              id: "end_date",
              min: "1900-01-01",
              max: "2099-12-31" %>
          <% if @other_insurance.errors[:policy_end_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_end_date].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :payment_mode, "Payment Mode*", class: "form-label" %>
          <%= form.select :payment_mode,
              options_for_select([
                ['Yearly', 'Yearly'],
                ['Half Yearly', 'Half Yearly'],
                ['Quarterly', 'Quarterly'],
                ['Monthly', 'Monthly']
              ], @other_insurance.payment_mode),
              { prompt: 'Select Payment Mode' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:payment_mode].any?}",
                required: true,
                id: "payment_mode_select" } %>
          <% if @other_insurance.errors[:payment_mode].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:payment_mode].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :sum_insured, "Sum Insured*", class: "form-label" %>
          <%= form.text_field :sum_insured,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:sum_insured].any?}",
              placeholder: "e.g., 90 lakhs, 5 crores, 1.5 crore",
              required: true %>
          <div class="form-text">Enter amount like: 90 lakhs, 5 crores, 1.5 crore, etc.</div>
          <% if @other_insurance.errors[:sum_insured].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:sum_insured].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :status, "Policy Status", class: "form-label" %>
          <%= form.select :status,
              options_for_select([
                ['Active', 'active'],
                ['Expired', 'expired'],
                ['Pending', 'pending'],
                ['Cancelled', 'cancelled']
              ], @other_insurance.status || 'active'),
              {},
              { class: "form-control" } %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :claim_process, "Claim Process", class: "form-label" %>
          <%= form.select :claim_process,
              options_for_select([
                ['Cashless', 'Cashless'],
                ['Reimbursement', 'Reimbursement'],
                ['Both', 'Both']
              ], @other_insurance.claim_process),
              { prompt: 'Select Claim Process' },
              { class: "form-control" } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Premium Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-currency-rupee me-2 text-primary"></i>
        Premium Details
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :net_premium, "Net Premium*", class: "form-label" %>
          <%= form.number_field :net_premium,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:net_premium].any?}",
              placeholder: "Enter net premium",
              step: 0.01,
              required: true,
              id: "net_premium" %>
          <% if @other_insurance.errors[:net_premium].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:net_premium].first %></div>
          <% end %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :gst_percentage, "GST %", class: "form-label" %>
          <%= form.number_field :gst_percentage,
              class: "form-control",
              step: 0.01,
              id: "gst_percentage",
              value: @other_insurance.gst_percentage || 18.0 %>
        </div>

        <div class="col-md-4 mb-3">
          <%= form.label :total_premium, "Total Premium*", class: "form-label" %>
          <%= form.number_field :total_premium,
              class: "form-control #{'is-invalid' if @other_insurance.errors[:total_premium].any?}",
              step: 0.01,
              required: true,
              id: "total_premium",
              readonly: true %>
          <% if @other_insurance.errors[:total_premium].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:total_premium].first %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Commission Detail Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-percent me-2 text-primary"></i>
        Commission Detail
      </h5>
    </div>
    <div class="card-body">
      <h6>Main Agent Commission</h6>
      <div class="row">
        <div class="col-md-2 mb-3">
          <label class="form-label">1st year (%)</label>
          <%= form.number_field :main_agent_commission_percentage,
              class: "form-control",
              value: @other_insurance.main_agent_commission_percentage || 10.0,
              step: 0.01, id: "commission_percentage" %>
        </div>
        <div class="col-md-5 mb-3">
          <%= form.label :commission_amount, "Commission Amount", class: "form-label" %>
          <%= form.number_field :commission_amount,
              class: "form-control",
              value: @other_insurance.commission_amount || 0,
              step: 0.01, readonly: true, id: "commission_amount" %>
        </div>
        <div class="col-md-5 mb-3">
          <%= form.label :tds_percentage, "TDS %", class: "form-label" %>
          <%= form.number_field :tds_percentage,
              class: "form-control",
              value: @other_insurance.tds_percentage || 0,
              step: 0.01, id: "tds_percentage" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :tds_amount, "TDS Amount", class: "form-label" %>
          <%= form.number_field :tds_amount,
              class: "form-control",
              value: @other_insurance.tds_amount || 0,
              step: 0.01, readonly: true, id: "tds_amount" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :after_tds_value, "After TDS Value", class: "form-label" %>
          <%= form.number_field :after_tds_value,
              class: "form-control",
              value: @other_insurance.after_tds_value || 0,
              step: 0.01, readonly: true, id: "after_tds_value" %>
        </div>
      </div>

      <!-- Main Agent Commission Transaction Details -->
      <div class="row">
        <div class="col-md-4 mb-3">
          <%= form.label :main_agent_commission_received, "Commission Received", class: "form-label" %>
          <%= form.select :main_agent_commission_received,
              options_for_select([
                ['No', false],
                ['Yes', true]
              ], @other_insurance.main_agent_commission_received),
              {},
              { class: "form-control", id: "main_agent_commission_received" } %>
        </div>
        <div class="col-md-4 mb-3">
          <%= form.label :main_agent_commission_paid_date, "Commission Paid Date", class: "form-label" %>
          <%= form.date_field :main_agent_commission_paid_date,
              class: "form-control",
              min: "1900-01-01",
              max: "2099-12-31" %>
        </div>
        <div class="col-md-4 mb-3">
          <%= form.label :main_agent_commission_transaction_id, "Transaction ID", class: "form-label" %>
          <%= form.text_field :main_agent_commission_transaction_id,
              class: "form-control",
              placeholder: "Enter transaction ID" %>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12 mb-3">
          <%= form.label :main_agent_commission_notes, "Commission Notes", class: "form-label" %>
          <%= form.text_area :main_agent_commission_notes,
              class: "form-control",
              rows: 2,
              placeholder: "Enter any notes about commission..." %>
        </div>
      </div>

      <!-- Affiliate Commission -->
      <hr class="my-4">
      <h6>Affiliate Commission</h6>
      <div class="row">
        <div class="col-md-2 mb-3">
          <label class="form-label">1st year (%)</label>
          <%= form.number_field :sub_agent_commission_percentage,
              class: "form-control sub-agent-commission-percentage",
              value: @other_insurance.sub_agent_commission_percentage || 2.0,
              step: 0.01 %>
        </div>
        <div class="col-md-5 mb-3">
          <label class="form-label">Commission Amount</label>
          <%= form.number_field :sub_agent_commission_amount,
              class: "form-control sub-agent-commission-amount",
              value: @other_insurance.sub_agent_commission_amount || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-5 mb-3">
          <label class="form-label">TDS %</label>
          <%= form.number_field :sub_agent_tds_percentage,
              class: "form-control sub-agent-tds-percentage",
              value: @other_insurance.sub_agent_tds_percentage || 0,
              step: 0.01 %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">TDS Amount</label>
          <%= form.number_field :sub_agent_tds_amount,
              class: "form-control sub-agent-tds-amount",
              value: @other_insurance.sub_agent_tds_amount || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">After TDS Value</label>
          <%= form.number_field :sub_agent_after_tds_value,
              class: "form-control sub-agent-after-tds-value",
              value: @other_insurance.sub_agent_after_tds_value || 0,
              step: 0.01, readonly: true %>
        </div>
      </div>

      <!-- Investor Commission -->
      <hr class="my-4">
      <h6>Investor Commission</h6>
      <div class="row">
        <div class="col-md-2 mb-3">
          <label class="form-label">1st year (%)</label>
          <%= form.number_field :investor_commission_percentage,
              class: "form-control investor-commission-percentage",
              value: @other_insurance.investor_commission_percentage || 2.0,
              step: 0.01 %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Amount</label>
          <%= form.number_field :investor_commission_amount,
              class: "form-control investor-commission-amount",
              value: @other_insurance.investor_commission_amount || 0,
              step: 0.01, readonly: true %>
        </div>
      </div>
      <%= form.hidden_field :investor_tds_percentage, value: 0, class: "investor-tds-percentage" %>

      <!-- Ambassador Commission -->
      <hr class="my-4">
      <h6>Ambassador Commission</h6>
      <div class="row">
        <div class="col-md-2 mb-3">
          <label class="form-label">1st year (%)</label>
          <%= form.number_field :ambassador_commission_percentage,
              class: "form-control ambassador-commission-percentage",
              value: @other_insurance.ambassador_commission_percentage || 2.0,
              step: 0.01 %>
        </div>
        <div class="col-md-5 mb-3">
          <label class="form-label">Commission Amount</label>
          <%= form.number_field :ambassador_commission_amount,
              class: "form-control ambassador-commission-amount",
              value: @other_insurance.ambassador_commission_amount || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-5 mb-3">
          <label class="form-label">TDS %</label>
          <%= form.number_field :ambassador_tds_percentage,
              class: "form-control ambassador-tds-percentage",
              value: @other_insurance.ambassador_tds_percentage || 0,
              step: 0.01 %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">TDS Amount</label>
          <%= form.number_field :ambassador_tds_amount,
              class: "form-control ambassador-tds-amount",
              value: @other_insurance.ambassador_tds_amount || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">After TDS Value</label>
          <%= form.number_field :ambassador_after_tds_value,
              class: "form-control ambassador-after-tds-value",
              value: @other_insurance.ambassador_after_tds_value || 0,
              step: 0.01, readonly: true %>
        </div>
      </div>

      <!-- Company Expenses & Profit Calculation -->
      <hr class="my-4">
      <h6>Company Expenses & Profit Calculation</h6>
      <div class="row">
        <div class="col-md-3 mb-3">
          <label class="form-label">Company Expenses (%)</label>
          <%= form.number_field :company_expenses_percentage,
              class: "form-control company-expenses-percentage",
              value: @other_insurance.company_expenses_percentage || 2.0,
              step: 0.01, min: 0, max: 100 %>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Total Distribution (%)</label>
          <%= form.number_field :total_distribution_percentage,
              class: "form-control total-distribution-percentage",
              value: @other_insurance.total_distribution_percentage || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Profit (%)</label>
          <%= form.number_field :profit_percentage,
              class: "form-control profit-percentage",
              value: @other_insurance.profit_percentage || 0,
              step: 0.01, readonly: true %>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Profit Amount (₹)</label>
          <%= form.number_field :profit_amount,
              class: "form-control profit-amount",
              value: @other_insurance.profit_amount || 0,
              step: 0.01, readonly: true %>
        </div>
      </div>

      <div class="alert alert-info mt-3">
        <h6 class="mb-2">Commission Calculation Summary:</h6>
        <ul class="mb-0">
          <li><strong>Main Agent Commission:</strong> <span id="main-income-display">0%</span> of Net Premium</li>
          <li><strong>Total Distribution:</strong> <span id="distribution-display">6.0%</span> (Affiliate + Investor + Ambassador)</li>
          <li><strong>Company Expenses:</strong> <span id="expenses-display">2.0%</span> of Net Premium</li>
          <li><strong>Profit:</strong> Main Agent Commission - Total Distribution - Company Expenses</li>
        </ul>
      </div>
    </div>
  </div>


  <!-- Autopay Installment Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-calendar-check me-2 text-primary"></i>
        Autopay Installment
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :installment_autopay_start_date, "Installment Autopay Start Date", class: "form-label" %>
          <%= form.date_field :installment_autopay_start_date,
              class: "form-control",
              value: @other_insurance.installment_autopay_start_date || Date.current,
              min: "1900-01-01",
              max: "2099-12-31" %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :installment_autopay_end_date, "Installment Autopay End Date", class: "form-label" %>
          <%= form.date_field :installment_autopay_end_date,
              class: "form-control",
              min: "1900-01-01",
              max: "2099-12-31" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="card">
    <div class="card-body">
      <div class="d-flex justify-content-between">
        <%= link_to admin_other_insurances_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-x-lg me-1"></i>Cancel
        <% end %>
        <% if @other_insurance.persisted? %>
          <%= form.submit "Update General Insurance", class: "btn btn-primary btn-lg" %>
        <% else %>
          <%= form.submit "Create General Insurance", class: "btn btn-primary btn-lg" %>
        <% end %>
      </div>
    </div>
  </div>

<% end %>

<!-- jQuery (required for Select2) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Select2 for searchable dropdowns
  $('#customer_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Type to search clients...',
    allowClear: false,
    width: '100%'
  });

  $('#affiliate_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Type to search affiliates...',
    allowClear: true,
    width: '100%'
  });

  $('#policy_holder_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select policy holder...',
    allowClear: false,
    width: '100%'
  });

  $('#other_insurance_agency_code_id').select2({
    theme: 'bootstrap-5',
    placeholder: 'Type to search agency codes...',
    allowClear: true,
    width: '100%'
  });

  $('#insurance_company_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Type to search companies...',
    allowClear: false,
    width: '100%'
  });

  // Handle customer selection change to update policy holder options
  $('#customer_select').on('select2:select', function(e) {
    const customerId = $(this).val();

    if (customerId) {
      // Fetch customer family members and update policy holder options
      fetch('/admin/customers/' + customerId + '/family_members')
        .then(response => response.json())
        .then(data => {
          const policyHolderSelect = $('#policy_holder_select');

          // Destroy existing Select2 instance
          if (policyHolderSelect.data('select2')) {
            policyHolderSelect.select2('destroy');
          }

          // Clear and rebuild options
          policyHolderSelect.empty();
          policyHolderSelect.append('<option value="Self">Self</option>');

          if (data.family_members && data.family_members.length > 0) {
            data.family_members.forEach(member => {
              if (member.name && member.name.trim().length > 0) {
                // Use member NAME as value, NOT the ID
                policyHolderSelect.append(`<option value="${member.name}">${member.name} (${member.relationship})</option>`);
              }
            });
          }

          // Reinitialize Select2 with new options
          policyHolderSelect.select2({
            theme: 'bootstrap-5',
            placeholder: 'Select policy holder...',
            allowClear: false,
            width: '100%'
          });

          // Set value to Self
          policyHolderSelect.val('Self').trigger('change');
        })
        .catch(error => {
          console.error('Error fetching family members:', error);
        });

      // Clear and refresh affiliate dropdown when customer changes
      $('#affiliate_select').val(null).trigger('change');
      console.log('Customer selected, filtering affiliates for customer ID:', customerId);
    }
  });

  // Handle customer clearing
  $('#customer_select').on('select2:clear', function(e) {
    console.log('Customer cleared');
    // Reset policy holder options to default
    const policyHolderSelect = $('#policy_holder_select');

    // Destroy existing Select2 instance
    if (policyHolderSelect.data('select2')) {
      policyHolderSelect.select2('destroy');
    }

    // Clear and rebuild with default options
    policyHolderSelect.empty();
    policyHolderSelect.append('<option value="Self">Self</option>');

    // Reinitialize Select2
    policyHolderSelect.select2({
      theme: 'bootstrap-5',
      placeholder: 'Select policy holder...',
      allowClear: false,
      width: '100%'
    });

    // Set to Self and refresh Select2
    policyHolderSelect.val('Self').trigger('change');

    // Clear affiliate dropdown when customer is cleared
    $('#affiliate_select').val(null).trigger('change');
    console.log('Customer cleared, showing all affiliates');
  });

  // Check if customer is already selected on page load (for edit forms)
  const initialCustomerId = $('#customer_select').val();
  if (initialCustomerId) {
    // Trigger the customer selection to load family members
    $('#customer_select').trigger('select2:select');
  }

  // Broker code type handling - Dynamic Agency/Broker Loading
  const brokerCodeType = document.getElementById('other_insurance_broker_code_type');
  const brokerContainer = document.getElementById('broker_id_container');
  const agencyCodeSelect = document.getElementById('other_insurance_agency_code_id');
  const companyNameSelect = document.getElementById('other_insurance_insurance_company_name');
  const brokerIdHidden = document.getElementById('broker_id_hidden');
  const labelText = document.getElementById('agency_code_label_text');

  if (brokerCodeType) {
    brokerCodeType.addEventListener('change', function() {
      const brokerType = this.value;

      if (brokerType) {
        // Update label based on selection
        if (labelText) {
          labelText.textContent = brokerType === 'direct' ? ' (Select Agent)' : ' (Select Broker)';
        }

        // Clear existing options
        $('#other_insurance_agency_code_id').empty();
        $('#other_insurance_agency_code_id').append('<option value="">Loading...</option>');

        // Fetch agency codes or brokers based on type
        fetch(`/admin/insurance/other/agency_codes_for_broker_type?broker_type=${brokerType}`)
          .then(response => response.json())
          .then(data => {
            if (data.success && data.data) {
              // Clear and rebuild options
              $('#other_insurance_agency_code_id').empty();
              $('#other_insurance_agency_code_id').append('<option value="">Search and select...</option>');

              data.data.forEach(item => {
                let optionText = item.text;
                if (item.code) {
                  optionText += ` - ${item.code}`;
                }
                $('#other_insurance_agency_code_id').append(
                  `<option value="${item.id}" data-company="${item.company_name || ''}" data-broker-name="${item.broker_name || ''}">${optionText}</option>`
                );
              });

              // Reinitialize Select2
              $('#other_insurance_agency_code_id').select2('destroy');
              $('#other_insurance_agency_code_id').select2({
                theme: 'bootstrap-5',
                placeholder: brokerType === 'direct' ? 'Type to search agents...' : 'Type to search brokers...',
                allowClear: true,
                width: '100%'
              });

              // Enable company name dropdown
              $('#other_insurance_insurance_company_name').prop('disabled', false);
            }
          })
          .catch(error => {
            console.error('Error loading agency codes:', error);
            $('#other_insurance_agency_code_id').empty();
            $('#other_insurance_agency_code_id').append('<option value="">Error loading data</option>');
          });
      }
    });

    // Handle agency/broker selection
    $('#other_insurance_agency_code_id').on('change', function() {
      const selectedOption = $(this).find('option:selected');
      const selectedValue = $(this).val();
      const brokerType = brokerCodeType.value;

      if (selectedValue) {
        if (brokerType === 'broking' && selectedValue.startsWith('broker_')) {
          // Extract broker ID and set it in hidden field
          const brokerId = selectedValue.replace('broker_', '');
          if (brokerIdHidden) brokerIdHidden.value = brokerId;
        } else if (brokerType === 'direct') {
          // Clear broker ID for direct mode
          if (brokerIdHidden) brokerIdHidden.value = '';

          // Auto-populate company name if available
          const companyName = selectedOption.data('company');
          if (companyName && companyNameSelect) {
            // Check if company exists in select options
            const existingOption = Array.from(companyNameSelect.options).find(opt => opt.value === companyName);
            if (!existingOption) {
              // Add the company as an option
              $(companyNameSelect).append(`<option value="${companyName}">${companyName}</option>`);
            }
            $(companyNameSelect).val(companyName).trigger('change');
          }
        }

        // Load insurance companies based on selection
        loadInsuranceCompanies(brokerType, selectedValue);
      }
    });

    // Function to load insurance companies
    function loadInsuranceCompanies(brokerType, agencyOrBrokerId) {
      $('#other_insurance_insurance_company_name').empty();
      $('#other_insurance_insurance_company_name').append('<option value="">Loading companies...</option>');

      // Fetch insurance companies
      fetch(`/admin/insurance/other/insurance_companies_for_type?insurance_type=General%20Insurance`)
        .then(response => response.json())
        .then(data => {
          if (data.success && data.data) {
            $('#other_insurance_insurance_company_name').empty();
            $('#other_insurance_insurance_company_name').append('<option value="">Search and select company...</option>');

            data.data.forEach(company => {
              $('#other_insurance_insurance_company_name').append(
                `<option value="${company.id}">${company.text}</option>`
              );
            });

            // Reinitialize Select2
            $('#other_insurance_insurance_company_name').select2('destroy');
            $('#other_insurance_insurance_company_name').select2({
              theme: 'bootstrap-5',
              placeholder: 'Type to search companies...',
              allowClear: false,
              width: '100%'
            });
          }
        })
        .catch(error => {
          console.error('Error loading companies:', error);
        });
    }

    // Trigger initial load if broker type is selected
    if (brokerCodeType.value) {
      brokerCodeType.dispatchEvent(new Event('change'));
    }
  }

  // Auto-calculation functions
  function calculateTotalPremium() {
    const netPremium = parseFloat(document.getElementById('net_premium').value) || 0;
    const gstPercentage = parseFloat(document.getElementById('gst_percentage').value) || 0;

    const gstAmount = netPremium * (gstPercentage / 100);
    const totalPremium = netPremium + gstAmount;

    document.getElementById('total_premium').value = totalPremium.toFixed(2);

    // Trigger commission calculations
    calculateCommissions();
  }

  // Commission calculations
  function calculateCommissions() {
    const netPremium = parseFloat(document.getElementById('net_premium').value) || 0;

    // Main Agent Commission
    const mainCommissionPercentage = parseFloat(document.getElementById('commission_percentage').value) || 0;
    const mainCommissionAmount = (netPremium * mainCommissionPercentage / 100);
    const mainTdsPercentage = parseFloat(document.getElementById('tds_percentage').value) || 0;
    const mainTdsAmount = (mainCommissionAmount * mainTdsPercentage / 100);
    const mainAfterTds = mainCommissionAmount - mainTdsAmount;

    document.getElementById('commission_amount').value = mainCommissionAmount.toFixed(2);
    document.getElementById('tds_amount').value = mainTdsAmount.toFixed(2);
    document.getElementById('after_tds_value').value = mainAfterTds.toFixed(2);

    // Affiliate Commission
    const subAgentPercentage = parseFloat(document.querySelector('.sub-agent-commission-percentage').value) || 0;
    const subAgentAmount = (netPremium * subAgentPercentage / 100);
    const subAgentTdsPercentage = parseFloat(document.querySelector('.sub-agent-tds-percentage').value) || 0;
    const subAgentTdsAmount = (subAgentAmount * subAgentTdsPercentage / 100);
    const subAgentAfterTds = subAgentAmount - subAgentTdsAmount;

    document.querySelector('.sub-agent-commission-amount').value = subAgentAmount.toFixed(2);
    document.querySelector('.sub-agent-tds-amount').value = subAgentTdsAmount.toFixed(2);
    document.querySelector('.sub-agent-after-tds-value').value = subAgentAfterTds.toFixed(2);

    // Investor Commission
    const investorPercentage = parseFloat(document.querySelector('.investor-commission-percentage').value) || 0;
    const investorAmount = (netPremium * investorPercentage / 100);
    document.querySelector('.investor-commission-amount').value = investorAmount.toFixed(2);

    // Ambassador Commission
    const ambassadorPercentage = parseFloat(document.querySelector('.ambassador-commission-percentage').value) || 0;
    const ambassadorAmount = (netPremium * ambassadorPercentage / 100);
    const ambassadorTdsPercentage = parseFloat(document.querySelector('.ambassador-tds-percentage').value) || 0;
    const ambassadorTdsAmount = (ambassadorAmount * ambassadorTdsPercentage / 100);
    const ambassadorAfterTds = ambassadorAmount - ambassadorTdsAmount;

    document.querySelector('.ambassador-commission-amount').value = ambassadorAmount.toFixed(2);
    document.querySelector('.ambassador-tds-amount').value = ambassadorTdsAmount.toFixed(2);
    document.querySelector('.ambassador-after-tds-value').value = ambassadorAfterTds.toFixed(2);

    // Total Distribution & Profit
    const totalDistribution = subAgentPercentage + investorPercentage + ambassadorPercentage;
    const companyExpenses = parseFloat(document.querySelector('.company-expenses-percentage').value) || 0;
    const profitPercentage = mainCommissionPercentage - totalDistribution - companyExpenses;
    const profitAmount = (netPremium * profitPercentage / 100);

    document.querySelector('.total-distribution-percentage').value = totalDistribution.toFixed(2);
    document.querySelector('.profit-percentage').value = profitPercentage.toFixed(2);
    document.querySelector('.profit-amount').value = profitAmount.toFixed(2);

    // Update display
    document.getElementById('main-income-display').textContent = mainCommissionPercentage.toFixed(1) + '%';
    document.getElementById('distribution-display').textContent = totalDistribution.toFixed(1) + '%';
    document.getElementById('expenses-display').textContent = companyExpenses.toFixed(1) + '%';
  }

  // Event listeners for real-time updates
  document.getElementById('net_premium')?.addEventListener('input', calculateTotalPremium);
  document.getElementById('gst_percentage')?.addEventListener('input', calculateTotalPremium);

  // Commission field listeners
  document.getElementById('commission_percentage')?.addEventListener('input', calculateCommissions);
  document.getElementById('tds_percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.sub-agent-commission-percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.sub-agent-tds-percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.investor-commission-percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.ambassador-commission-percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.ambassador-tds-percentage')?.addEventListener('input', calculateCommissions);
  document.querySelector('.company-expenses-percentage')?.addEventListener('input', calculateCommissions);

  // Calculate policy end date based on start date and payment mode
  function calculatePolicyEndDate() {
    const startDateField = document.getElementById('start_date');
    const endDateField = document.getElementById('end_date');
    const paymentModeField = document.getElementById('payment_mode_select');

    if (!startDateField || !endDateField || !paymentModeField) {
      return;
    }

    const startDate = new Date(startDateField.value);
    const paymentMode = paymentModeField.value;

    if (!startDateField.value || !paymentMode) {
      return;
    }

    let endDate = new Date(startDate);

    switch(paymentMode) {
      case 'Yearly':
        endDate.setFullYear(endDate.getFullYear() + 1);
        endDate.setDate(endDate.getDate() - 1);
        break;
      case 'Half Yearly':
        endDate.setMonth(endDate.getMonth() + 6);
        endDate.setDate(endDate.getDate() - 1);
        break;
      case 'Quarterly':
        endDate.setMonth(endDate.getMonth() + 3);
        endDate.setDate(endDate.getDate() - 1);
        break;
      case 'Monthly':
        endDate.setMonth(endDate.getMonth() + 1);
        endDate.setDate(endDate.getDate() - 1);
        break;
      default:
        endDate.setFullYear(endDate.getFullYear() + 1);
        endDate.setDate(endDate.getDate() - 1);
    }

    endDateField.value = endDate.toISOString().split('T')[0];
  }

  // Event listeners for date calculations
  document.getElementById('start_date')?.addEventListener('change', calculatePolicyEndDate);
  document.getElementById('payment_mode_select')?.addEventListener('change', calculatePolicyEndDate);

  // Initialize calculations on page load
  if (document.getElementById('net_premium')?.value) {
    calculateTotalPremium();
  }

  // Convert sum insured text to number before form submission
  const form = document.querySelector('form.needs-validation');
  const sumInsuredField = document.querySelector('[name="other_insurance[sum_insured]"]');

  if (form && sumInsuredField) {
    form.addEventListener('submit', function(e) {
      const value = sumInsuredField.value.toLowerCase().trim();
      let numericValue = 0;

      if (value) {
        // Extract number and unit from text like "90 lakhs" or "5 crores"
        const match = value.match(/([\d.]+)\s*(lakh|lac|crore|cr|thousand|k|million|m)?/i);
        if (match) {
          const number = parseFloat(match[1]);
          const unit = match[2] ? match[2].toLowerCase() : '';

          switch(unit) {
            case 'lakh':
            case 'lac':
            case 'lakhs':
              numericValue = number * 100000;
              break;
            case 'crore':
            case 'crores':
            case 'cr':
              numericValue = number * 10000000;
              break;
            case 'thousand':
            case 'k':
              numericValue = number * 1000;
              break;
            case 'million':
            case 'm':
              numericValue = number * 1000000;
              break;
            default:
              numericValue = number;
          }
        } else {
          // If no unit specified, try to parse as plain number
          numericValue = parseFloat(value.replace(/[^\d.]/g, '')) || 0;
        }

        // Update the field with numeric value
        sumInsuredField.value = numericValue;
      }
    });
  }


  // Initialize date pickers with proper constraints
  function initializeDatePickers() {
    const dateFields = [
      'policy_booking_date',
      'start_date',
      'end_date',
      'main_agent_commission_paid_date',
      'installment_autopay_start_date',
      'installment_autopay_end_date'
    ];

    dateFields.forEach(fieldId => {
      const field = document.getElementById(fieldId) || document.querySelector(`[name*="${fieldId}"]`);
      if (field) {
        // Ensure proper min/max attributes are set
        field.setAttribute('min', '1900-01-01');
        field.setAttribute('max', '2099-12-31');

        // Fix any existing invalid values
        if (field.value && (field.value.includes('275760') || field.value.length > 10)) {
          field.value = new Date().toISOString().split('T')[0];
        }

        // Add event listener to prevent manual entry of invalid dates
        field.addEventListener('input', function() {
          const value = this.value;
          if (value && value.length > 10) {
            this.value = value.substring(0, 10);
          }
        });

        console.log(`✅ Initialized date picker for ${fieldId}`);
      }
    });
  }

  // Call date picker initialization
  initializeDatePickers();
});
</script>


            return true;
          } else if (insuranceCompanySelect) {
            console.log('📝 Updating via DOM API...');
            // Fallback for non-Select2 dropdowns
            insuranceCompanySelect.innerHTML = '<option value="">Select Company</option>';
            const option = new Option(data.company_name, data.company_name);
            insuranceCompanySelect.add(option);
            insuranceCompanySelect.value = data.company_name;
            console.log('✅ Company auto-selected via DOM:', data.company_name);
            return true;
          }
          return false;
        };

        // Try to update immediately
        if (!updateInsuranceCompany()) {
          // If failed, wait a bit for Select2 to initialize and retry
          console.log('⏱️ Select2 not ready, retrying in 500ms...');
          setTimeout(() => {
            if (!updateInsuranceCompany()) {
              console.log('⚠️ Failed to update company dropdown after retry');
            }
          }, 500);
        }
      } else {
        console.error('No company found for agency code:', agencyCodeId);
        if (window.jQuery && jQuery(insuranceCompanySelect).hasClass('select2-hidden-accessible')) {
          jQuery(insuranceCompanySelect).empty().append('<option value="">No company found</option>');
          jQuery(insuranceCompanySelect).trigger('change');
        } else {
          insuranceCompanySelect.innerHTML = '<option value="">No company found</option>';
        }
      }
    })
    .catch(error => {
      console.error('🚨 Error loading company:', error);
      if (window.jQuery && jQuery(insuranceCompanySelect).hasClass('select2-hidden-accessible')) {
        jQuery(insuranceCompanySelect).empty().append('<option value="">Error loading company</option>');
        jQuery(insuranceCompanySelect).trigger('change');
      } else {
        insuranceCompanySelect.innerHTML = '<option value="">Error loading company</option>';
      }

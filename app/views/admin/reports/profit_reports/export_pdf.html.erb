<%# Profit Reports PDF Export Template %>
<div class="pdf-container">
  <div class="pdf-header">
    <h2>Profit Report</h2>
    <p>Generated on: <%= Date.current.strftime('%d/%m/%Y') %></p>
    <p>Period: <%= params[:start_date] %> to <%= params[:end_date] %></p>
    <hr>
  </div>

  <!-- Summary Section -->
  <div class="summary-section">
    <h4>Summary</h4>
    <div class="summary-grid">
      <div class="summary-item">
        <strong>Total Policies:</strong> <%= number_with_delimiter(@policy_data.size) %>
      </div>
      <div class="summary-item">
        <strong>Total Profit:</strong> ₹<%= number_with_delimiter(@policy_data.sum { |p| p[:profit_amount] || 0 }) %>
      </div>
      <div class="summary-item">
        <strong>Total Premium:</strong> ₹<%= number_with_delimiter(@policy_data.sum { |p| p[:premium_amount] || 0 }) %>
      </div>
      <div class="summary-item">
        <strong>Average Profit %:</strong>
        <%= number_with_precision(
              @policy_data.empty? ? 0 : (@policy_data.sum { |p| p[:profit_percentage] || 0 } / @policy_data.size),
              precision: 2
            ) %>%
      </div>
    </div>
    <hr>
  </div>

  <!-- Data Table -->
  <div class="table-section">
    <table class="pdf-table">
      <thead>
        <tr>
          <th>Policy No.</th>
          <th>Type</th>
          <th>Customer</th>
          <th>Insurance Company</th>
          <th>Premium</th>
          <th>Net Premium</th>
          <th>Profit Amount</th>
          <th>Profit %</th>
          <th>Expenses</th>
          <th>Sub Agent</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @policy_data.each do |policy| %>
          <tr>
            <td><%= policy[:policy_number] %></td>
            <td><%= policy[:policy_type] %></td>
            <td><%= policy[:customer_name] %></td>
            <td><%= policy[:insurance_company] %></td>
            <td class="amount">₹<%= number_with_delimiter(policy[:premium_amount]) %></td>
            <td class="amount">₹<%= number_with_delimiter(policy[:net_premium]) %></td>
            <td class="amount profit">₹<%= number_with_delimiter(policy[:profit_amount]) %></td>
            <td class="percentage"><%= number_with_precision(policy[:profit_percentage], precision: 2) %>%</td>
            <td class="amount">₹<%= number_with_delimiter(policy[:company_expenses]) %></td>
            <td><%= policy[:sub_agent_name] %></td>
            <td><%= policy[:created_at]&.strftime('%d/%m/%Y') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="pdf-footer">
    <p>Report generated by InsureBook Admin System</p>
  </div>
</div>

<style>
  .pdf-container {
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 1.3;
  }

  .pdf-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .pdf-header h2 {
    margin: 0 0 10px 0;
    font-size: 18px;
    color: #333;
  }

  .pdf-header p {
    margin: 2px 0;
    font-size: 12px;
    color: #666;
  }

  .summary-section {
    margin-bottom: 20px;
  }

  .summary-section h4 {
    margin: 0 0 10px 0;
    font-size: 14px;
    color: #333;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 15px;
  }

  .summary-item {
    padding: 8px;
    background-color: #f8f9fa;
    border-radius: 4px;
  }

  .pdf-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
  }

  .pdf-table th,
  .pdf-table td {
    padding: 6px 4px;
    border: 1px solid #ddd;
    text-align: left;
    vertical-align: top;
  }

  .pdf-table th {
    background-color: #f8f9fa;
    font-weight: bold;
    font-size: 9px;
  }

  .pdf-table td.amount {
    text-align: right;
    font-family: monospace;
  }

  .pdf-table td.profit {
    color: #28a745;
    font-weight: bold;
  }

  .pdf-table td.percentage {
    text-align: center;
  }

  .pdf-footer {
    text-align: center;
    margin-top: 30px;
    font-size: 10px;
    color: #666;
  }

  hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 10px 0;
  }

  @media print {
    .pdf-container {
      margin: 0;
      padding: 0;
    }
  }
</style>
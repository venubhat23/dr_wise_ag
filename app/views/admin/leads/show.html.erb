<!-- Lead Details Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-2">
      <h2 class="mb-0">Lead Details</h2>
      <span class="badge bg-primary fs-6">LEAD-001</span>
    </div>
    <p class="text-muted mb-0">Complete lead information and management actions</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to admin_leads_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Leads
    <% end %>
    <div class="dropdown">
      <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-gear me-1"></i>
        Actions
      </button>
      <ul class="dropdown-menu">
        <li><a href="#" class="dropdown-item">Edit Lead</a></li>
        <li><a href="#" class="dropdown-item">Add Notes</a></li>
        <li><a href="#" class="dropdown-item">Send Email</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a href="#" class="dropdown-item text-danger">Delete Lead</a></li>
      </ul>
    </div>
  </div>
</div>

<!-- Lead Status Timeline -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <h5 class="card-title mb-4">
      <i class="bi bi-diagram-3 me-2 text-primary"></i>
      Lead Progress Timeline
    </h5>
    <div class="row">
      <div class="col-md-12">
        <div class="timeline-container">
          <div class="timeline-item completed">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>Lead Generated</h6>
              <p class="text-muted mb-1">Initial lead entry into the system</p>
              <small class="text-success">Completed on Dec 08, 2024</small>
            </div>
          </div>
          <div class="timeline-item completed">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>Consultation Scheduled</h6>
              <p class="text-muted mb-1">First contact and consultation setup</p>
              <small class="text-success">Completed on Dec 08, 2024</small>
            </div>
          </div>
          <div class="timeline-item active">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>One-on-One Discussion</h6>
              <p class="text-muted mb-1">Detailed discussion about insurance needs</p>
              <small class="text-warning">In Progress</small>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>Convert to Customer</h6>
              <p class="text-muted mb-1">Lead converted to customer record</p>
              <small class="text-muted">Pending</small>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>Policy Created</h6>
              <p class="text-muted mb-1">Insurance policy generated</p>
              <small class="text-muted">Pending</small>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h6>Referral Settled</h6>
              <p class="text-muted mb-1">Commission and referrals processed</p>
              <small class="text-muted">Pending</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


        <input type="text" class="form-control" value="<%= @motor_insurance.broker_code_type&.humanize || 'N/A' %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Agency Code</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.agency_code_id || 'N/A' %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Insurance Company Name*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.insurance_company_name %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Insurance Type*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.insurance_type %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Class of Vehicle*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.class_of_vehicle %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Type*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.policy_type %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Number*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.policy_number %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Booking Date</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.policy_booking_date&.strftime('%B %d, %Y') %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Lead ID</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.lead_id %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Payment Mode*</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.payment_mode %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy Start Date</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.policy_start_date&.strftime('%B %d, %Y') %>" readonly>
      </div>

      <div class="col-md-4 mb-3">
        <label class="form-label">Policy End Date</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.policy_end_date&.strftime('%B %d, %Y') %>" readonly>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Installment Autopay Start Date</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.installment_autopay_start_date&.strftime('%B %d, %Y') if @motor_insurance.installment_autopay_start_date %>" readonly>
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Installment Autopay End Date</label>
        <input type="text" class="form-control" value="<%= @motor_insurance.installment_autopay_end_date&.strftime('%B %d, %Y') if @motor_insurance.installment_autopay_end_date %>" readonly>
      </div>
    </div>
    </div>
  </div>
</div>

<!-- Vehicle Details Section -->

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Motor Insurance Policies</h2>
    <p class="text-muted mb-0">Manage motor insurance policies and track coverage details</p>
  </div>
  <div class="d-flex gap-2">
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-download me-1"></i>
        Export
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to "Export as CSV", admin_motor_insurances_path(format: :csv), class: "dropdown-item" %></li>
      </ul>
    </div>
    <%= link_to new_admin_motor_insurance_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Motor Policy
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Motor Policies</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@motor_insurances.count) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-car-front text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Policies</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@motor_insurances.where(status: true).count) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-shield-check text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Premium</h6>
            <h3 class="mb-0 text-info">₹<%= number_with_delimiter(@motor_insurances.sum(:total_premium)) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Sum Insured</h6>
            <h3 class="mb-0 text-warning">₹<%= number_with_delimiter(@motor_insurances.sum(:sum_insured)) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-shield text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Motor Insurance Policies List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">Motor Insurance Policies</h5>
  </div>
  <div class="card-body p-0">
    <% if @motor_insurances.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Policy Number</th>
              <th class="border-0">Customer</th>
              <th class="border-0">Insurance Company</th>
              <th class="border-0">Premium</th>
              <th class="border-0">Sum Insured</th>
              <th class="border-0">Validity</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @motor_insurances.each do |policy| %>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.policy_number %></h6>
                    <small class="text-muted"><%= policy.policy_type.humanize if policy.policy_type %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.customer&.display_name %></h6>
                    <small class="text-muted"><%= policy.customer&.mobile %></small>
                  </div>
                </td>
                <td>
                  <%= policy.insurance_company&.name %>
                </td>
                <td>
                  <div>
                    <div class="fw-bold">₹<%= number_with_delimiter(policy.total_premium) %></div>
                    <small class="text-muted"><%= policy.premium_frequency.humanize if policy.premium_frequency %></small>
                  </div>
                </td>
                <td>
                  <span class="fw-bold">₹<%= number_with_delimiter(policy.sum_insured) %></span>
                </td>
                <td>
                  <div>
                    <div><%= policy.start_date&.strftime("%d %b %Y") %></div>
                    <small class="text-muted">to <%= policy.end_date&.strftime("%d %b %Y") %></small>
                  </div>
                </td>
                <td>
                  <span class="badge bg-<%= policy.status? ? 'success' : 'secondary' %>">
                    <%= policy.status? ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to admin_motor_insurance_path(policy), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_motor_insurance_path(policy), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to admin_motor_insurance_path(policy), method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        title: "Delete",
                        data: {
                          confirm: "Are you sure you want to delete this motor insurance policy?",
                          turbo_method: :delete
                        } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if respond_to?(:paginate) && @motor_insurances.respond_to?(:current_page) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @motor_insurances, theme: 'twitter-bootstrap-4' %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-car-front fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No motor insurance policies found</h5>
        <p class="text-muted mb-3">
          Start by adding your first motor insurance policy to the system.
        </p>
        <%= link_to new_admin_motor_insurance_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i>
          Add First Motor Policy
        <% end %>
      </div>
    <% end %>
  </div>
</div>
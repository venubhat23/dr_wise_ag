function showSystemStatusModal(type) {
  console.log('Opening system status modal for:', type);
  _csvModalType = type;
  _csvModalData = null;
  const btn = document.getElementById('downloadCsvBtn');
  if (btn) btn.style.display = 'none';

  // Hide scrollbars on body
  document.body.style.overflow = 'hidden';

  const modalElement = document.getElementById('systemStatusModal');

  // Clear any existing modal instances
  let existingModal = bootstrap.Modal.getInstance(modalElement);
  if (existingModal) {
    existingModal.dispose();
  }

  const modal = new bootstrap.Modal(modalElement, {
    backdrop: 'static',
    keyboard: true,
    focus: true
  });

  const modalTitle = document.getElementById('systemStatusModalLabel');
  const content = document.getElementById('systemStatusContent');
  const loading = document.getElementById('systemStatusLoading');

  // Show loading
  if (content) content.style.display = 'none';
  if (loading) loading.style.display = 'block';

  // Ensure modal is properly displayed
  modalElement.style.display = 'flex';
  modalElement.style.zIndex = '9999';

  // Update modal title and load data based on type
  switch(type) {
    case 'active_affiliates':
      modalTitle.innerHTML = '<i class="bi bi-people me-2"></i>Active Affiliates Details';
      loadActiveAffiliatesData(content, loading);
      break;
    case 'lead_conversion':
      modalTitle.innerHTML = '<i class="bi bi-graph-up-arrow me-2"></i>Lead Conversion Analysis';
      loadLeadConversionData(content, loading);
      break;
    case 'avg_policy_value':
      modalTitle.innerHTML = '<i class="bi bi-cash-stack me-2"></i>Average Policy Value Breakdown';
      loadAvgPolicyValueData(content, loading);
      break;
    case 'commissions_due':
      modalTitle.innerHTML = '<i class="bi bi-wallet2 me-2"></i>Commissions Due - Detailed Calculation';
      loadCommissionsDueData(content, loading);
      break;
    case 'total_revenue':
      modalTitle.innerHTML = '<i class="bi bi-graph-up-arrow me-2"></i>Total Revenue Breakdown';
      loadTotalRevenueData(content, loading);
      break;
    case 'profit':
      modalTitle.innerHTML = '<i class="bi bi-graph-up-arrow me-2 text-success"></i>Net Profit — Policy Commission Breakdown';
      loadProfitSummaryData(content, loading);
      break;
  }

  // Add event listener to restore body overflow when modal is closed
  modalElement.addEventListener('hidden.bs.modal', function () {
    document.body.style.overflow = 'auto';
    document.body.classList.remove('modal-open');
  });

  modal.show();
}


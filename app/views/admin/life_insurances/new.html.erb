<% content_for :page_title, "Add Life Insurance" %>
<% content_for :page_subtitle, "Easily create and manage life insurance details" %>

<!-- Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <%= link_to admin_life_insurances_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Back to List
    <% end %>
  </div>

  <div class="d-flex align-items-center gap-3">
    <button type="button" class="btn ai-btn ai-launch" data-bs-toggle="modal" data-bs-target="#aiUploadModal" title="Upload a policy document and let AI fill the form (beta)">
      <i class="bi bi-stars me-1"></i>AI Upload <span class="badge ai-beta ms-1">Beta</span>
    </button>
    <div class="trust-seal">
      <i class="bi bi-shield-check seal-icon"></i>
      <span>Save Policy</span>
    </div>
  </div>
</div>

<%= render 'form' %>

<%# AI Upload (beta) - optional document reader that pre-fills the form above %>
<%= render 'ai_upload' %>

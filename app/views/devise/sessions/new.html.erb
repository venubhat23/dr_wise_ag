/* Alert styling for flash messages */
.alert {
  padding: 8px 12px;
  margin-bottom: 12px;
  border-radius: 8px;
  font-size: 0.8rem;
  position: relative;
  z-index: 10;
  max-width: 100%;
  box-sizing: border-box;
}

.alert-danger {
  background: #fef2f2;
  color: #dc2626;
  border: 1px solid #fecaca;
}

.alert-notice {
  background: #f0f9ff;
  color: #1d4ed8;
  border: 1px solid #bfdbfe;
}

/* Ensure login container has proper z-index but doesn't interfere */
.login-container {
  position: relative;
  z-index: 1;
}

/* Fix any overlay issues */
.auth-wrapper {
  position: relative;
  z-index: 1;
}

/* Handle any external modals or notifications */
body {
  position: relative !important;
}

/* Override any external notification positioning */
.notification, .toast, .modal-backdrop {
  z-index: 9999 !important;
}

/* Responsive alert sizing */
@media (max-width: 600px) {
  .alert {
    padding: 6px 10px;
    font-size: 0.75rem;
    margin-bottom: 8px;
  }
}
</style>

<div class="auth-wrapper">
  <div class="login-container">
    <!-- Left Side - Illustration -->
    <div class="illustration-section">
      <div class="illustration-content">
        <div class="insurance-icon"></div>
        <h3 class="illustration-title">Secure Insurance Management</h3>
        <p class="illustration-subtitle">
          Manage your policies seamlessly with our comprehensive insurance management platform.
        </p>
      </div>
    </div>

    <!-- Right Side - Login Form -->
    <div class="form-section">
      <!-- Display Flash Messages -->
      <% if notice %>
        <div class="alert alert-notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <!-- Brand Header -->
      <div class="brand-header">
        <div class="brand-icon"></div>
        <h1 class="brand-name">InsureBook</h1>
      </div>

      <!-- Welcome Section -->
      <div class="welcome-section">
        <h2 class="welcome-text">
          Welcome Back
          <span class="wave-emoji">👋</span>
        </h2>
        <p class="subtitle">Manage your policies seamlessly</p>
      </div>

      <!-- Login Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <!-- Email Field -->
        <div class="form-group">
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "form-input",
              placeholder: "Email Address",
              required: true %>
          <span class="input-icon">📧</span>
        </div>

        <!-- Password Field -->
        <div class="form-group">
          <%= f.password_field :password, autocomplete: "current-password",
              class: "form-input",
              placeholder: "Password",
              id: "passwordField",
              required: true %>
          <span class="input-icon">🔒</span>
          <button type="button" class="password-toggle" id="togglePassword">
            <span id="toggleIcon">👁️</span>
          </button>
        </div>

        <!-- Remember Me & Forgot Password -->
        <div class="form-options">
          <% if devise_mapping.rememberable? %>
            <div class="remember-me">
              <%= f.check_box :remember_me %>
              <%= f.label :remember_me, "Remember Me" %>
            </div>
          <% end %>

          <%= link_to "Forgot Password?", new_password_path(resource_name),
              class: "forgot-password" %>
        </div>

        <!-- Login Button -->
        <%= f.submit "Login", class: "login-btn" %>
      <% end %>

      <!-- Registration Link -->
      <% if devise_mapping.registerable? %>
        <div class="signup-link">
          Don't have an account? <%= link_to "Sign Up", new_registration_path(resource_name) %>
        </div>
      <% end %>

      <!-- Footer Links -->
      <div class="footer-links">
        <a href="#" title="Help & Support">Help & Support</a>
        <a href="mailto:info@insurebook.in" title="Contact Us">Contact Us</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Password toggle functionality
  document.addEventListener('DOMContentLoaded', function() {
    const togglePassword = document.getElementById('togglePassword');
    const passwordField = document.getElementById('passwordField');
    const toggleIcon = document.getElementById('toggleIcon');

    if (togglePassword && passwordField && toggleIcon) {
      togglePassword.addEventListener('click', function() {
        if (passwordField.type === 'password') {
          passwordField.type = 'text';
          toggleIcon.textContent = '🙈';
        } else {
          passwordField.type = 'password';
          toggleIcon.textContent = '👁️';
        }
      });
    }

    // Form validation and smooth interactions
    const formInputs = document.querySelectorAll('.form-input');
    formInputs.forEach(input => {
      input.addEventListener('focus', function() {
        this.parentElement.style.transform = 'translateY(-2px)';
      });

      input.addEventListener('blur', function() {
        this.parentElement.style.transform = 'translateY(0)';
      });
    });

    // Login button interaction
    const loginBtn = document.querySelector('.login-btn');
    if (loginBtn) {
      loginBtn.addEventListener('click', function() {
        this.style.transform = 'scale(0.98)';
        setTimeout(() => {
          this.style.transform = 'scale(1)';
        }, 150);
      });
    }
  });
</script>

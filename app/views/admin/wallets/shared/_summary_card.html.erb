<%# locals: owner, wallet, locked_holds, inactive_balance, transactions, transaction_count, full_wallet_path %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center">
      <i class="bi bi-wallet2 me-2 text-success"></i>
      <h5 class="mb-0">Wallet Balance</h5>
    </div>
    <%# btn-outline-success/-primary get a near-white "glass" restyle app-wide (see application.scss)
        that's invisible on a plain white card header — btn-outline-secondary isn't touched by it. %>
    <%= link_to full_wallet_path, class: "btn btn-sm btn-outline-secondary" do %>
      <i class="bi bi-gear me-1"></i>Manage Wallet
    <% end %>
  </div>
  <div class="card-body">
    <!-- Active / Inactive / Total -->
    <div class="row text-center mb-3">
      <div class="col-md-4">
        <div class="border rounded p-3" style="background: rgba(25,135,84,0.08);">
          <h4 class="text-success mb-1"><%= indian_currency(wallet.active_balance) %></h4>
          <small class="text-muted">Active Wallet<span class="d-block">(withdrawable)</span></small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="border rounded p-3" style="background: rgba(255,193,7,0.1);">
          <h4 class="text-warning mb-1" style="color:#a9790a !important;"><%= indian_currency(inactive_balance) %></h4>
          <small class="text-muted">Inactive Wallet<span class="d-block">(locked)</span></small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="border rounded p-3 bg-light">
          <h4 class="text-secondary mb-1"><%= indian_currency(wallet.total_balance) %></h4>
          <small class="text-muted">Total Balance<span class="d-block">(active + inactive)</span></small>
        </div>
      </div>
    </div>

    <!-- How the inactive wallet built up -->
    <% if locked_holds.any? %>
      <h6 class="mb-2"><i class="bi bi-lock text-warning me-1"></i>Locked amounts &mdash; how the inactive wallet built up</h6>
      <div class="table-responsive mb-4">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="border-0">Added on</th>
              <th class="border-0">For</th>
              <th class="border-0 text-end">Amount</th>
              <th class="border-0">Unlocks</th>
            </tr>
          </thead>
          <tbody>
            <% locked_holds.each do |hold| %>
              <tr>
                <td><%= hold.created_at.strftime('%d %b %Y, %I:%M %p') %></td>
                <td><%= hold.description %></td>
                <td class="text-end fw-semibold" style="color:#a9790a;">+<%= indian_currency(hold.amount) %></td>
                <td class="text-muted small"><%= hold.unlock_condition %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="table-light">
            <tr>
              <td colspan="2" class="fw-bold">Total locked</td>
              <td class="text-end fw-bold" style="color:#a9790a;"><%= indian_currency(inactive_balance) %></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>

    <!-- End-to-end active-wallet history -->
    <h6 class="mb-2"><i class="bi bi-clock-history text-primary me-1"></i>Recent wallet transactions</h6>
    <% if transactions.any? %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="border-0">Date &amp; Time</th>
              <th class="border-0">Activity</th>
              <th class="border-0 text-end">Amount</th>
              <th class="border-0 text-end">Balance After</th>
              <th class="border-0">Note</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.each do |txn| %>
              <tr>
                <td><%= txn.created_at.strftime('%d %b %Y, %I:%M %p') %></td>
                <td>
                  <% if txn.credit? %>
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-circle me-1"></i>Credit</span>
                  <% else %>
                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-circle me-1"></i>Debit</span>
                  <% end %>
                </td>
                <td class="text-end fw-semibold <%= txn.credit? ? 'text-success' : 'text-danger' %>">
                  <%= txn.credit? ? '+' : '−' %><%= indian_currency(txn.amount) %>
                </td>
                <td class="text-end"><%= indian_currency(txn.balance_after) %></td>
                <td class="text-muted small"><%= txn.description.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if transaction_count > transactions.size %>
        <div class="text-center mt-2">
          <%= link_to "View all #{transaction_count} transactions →", full_wallet_path, class: "small" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-3">
        <i class="bi bi-clock-history fs-2 d-block mb-2"></i>
        <small>
          No active-wallet transactions yet<%= locked_holds.any? ? " — the locked amount above hasn't unlocked" : "" %>.
        </small>
      </div>
    <% end %>
  </div>
</div>

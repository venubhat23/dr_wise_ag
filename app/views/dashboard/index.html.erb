    .then(data => {
      renderHealthPolicyTable(tableBody, data.policies || [], 'opportunity');
      document.getElementById('policyCount').textContent = data.policies ? data.policies.length : 0;
    })
    .catch(error => {
      console.error('Error loading policies:', error);
      tableBody.innerHTML = '<tr><td colspan="8" class="text-center text-danger">Error loading data. Please try again.</td></tr>';
    });
}

// Render functions
function renderPolicyTable(tableBody, policies, type) {
  if (policies.length === 0) {
    tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No policies found</td></tr>';
    return;
  }

  let html = '';
  policies.forEach(policy => {
    const daysLeft = policy.days_left || 0;
    let statusBadge = '';

    if (type === 'expired') {
      statusBadge = '<span class="badge status-badge-expired">Expired</span>';
    } else if (type === 'processed') {
      statusBadge = '<span class="badge status-badge-active">Renewed</span>';
    } else if (daysLeft <= 7) {
      statusBadge = '<span class="badge status-badge-expired">Urgent</span>';
    } else if (daysLeft <= 30) {
      statusBadge = '<span class="badge status-badge-warning">Expiring Soon</span>';
    } else {
      statusBadge = '<span class="badge status-badge-active">Active</span>';
    }

    html += `
      <tr>
        <td><span class="text-monospace">${policy.policy_number || 'N/A'}</span></td>
        <td>
          <div>
            <strong>${policy.customer_name || 'Unknown'}</strong>
            ${policy.customer_email ? '<br><small class="text-muted">' + policy.customer_email + '</small>' : ''}
          </div>
        </td>
        <td><span class="badge bg-info text-white">${policy.insurance_type || 'General'}</span></td>
        <td class="fw-bold">₹${(policy.premium || 0).toLocaleString()}</td>
        <td>${policy.end_date || 'N/A'}</td>
        <td>${statusBadge}</td>
        <td>
          ${type !== 'processed' ?
            `<a href="/admin/${policy.type_slug}/renew/${policy.id}" class="btn btn-sm btn-success">
              <i class="bi bi-arrow-repeat me-1"></i>Renew
            </a>` :
            '<span class="text-success"><i class="bi bi-check-circle"></i> Completed</span>'
          }
        </td>
      </tr>
    `;
  });

  tableBody.innerHTML = html;
}

function renderHealthPolicyTable(tableBody, policies, type) {
  if (policies.length === 0) {
    tableBody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No policies found</td></tr>';
    return;
  }

  let html = '';
  policies.forEach(policy => {
    const daysLeft = policy.days_left || 0;
    let daysLeftBadge = '';

    if (daysLeft < 0) {
      daysLeftBadge = `<span class="badge bg-danger">Expired ${Math.abs(daysLeft)} days ago</span>`;
    } else if (daysLeft === 0) {
      daysLeftBadge = '<span class="badge bg-danger">Expires Today</span>';
    } else if (daysLeft <= 7) {
      daysLeftBadge = `<span class="badge bg-warning text-dark">${daysLeft} days</span>`;
    } else {
      daysLeftBadge = `<span class="badge bg-success">${daysLeft} days</span>`;
    }

    html += `
      <tr>
        <td><span class="text-monospace">${policy.policy_number || 'N/A'}</span></td>
        <td>
          <div>
            <strong>${policy.customer_name || 'Unknown'}</strong>
            ${policy.customer_email ? '<br><small class="text-muted">' + policy.customer_email + '</small>' : ''}
          </div>
        </td>
        <td><span class="badge bg-primary">Health</span></td>
        <td class="fw-bold">₹${(policy.sum_insured || 0).toLocaleString()}</td>
        <td>₹${(policy.premium || 0).toLocaleString()}</td>
        <td>${policy.end_date || 'N/A'}</td>
        <td>${daysLeftBadge}</td>
        <td>
          <a href="/admin/health_insurances/${policy.id}" class="btn btn-sm btn-outline-primary me-1">
            <i class="bi bi-eye"></i>
          </a>
          ${daysLeft >= 0 && daysLeft <= 60 ?
            `<a href="/admin/health_insurances/${policy.id}/renew" class="btn btn-sm btn-success">
              <i class="bi bi-arrow-repeat"></i> Renew
            </a>` : ''
          }
        </td>
      </tr>
    `;
  });

  tableBody.innerHTML = html;
}

// System Status Modal Functions
function showSystemStatusModal(type) {
  console.log('Opening system status modal for:', type);

  // Hide scrollbars on body
  document.body.style.overflow = 'hidden';

  const modalElement = document.getElementById('systemStatusModal');

  // Clear any existing modal instances
  let existingModal = bootstrap.Modal.getInstance(modalElement);
  if (existingModal) {
    existingModal.dispose();
  }

  const modal = new bootstrap.Modal(modalElement, {
    backdrop: 'static',
    keyboard: true,
    focus: true
  });

  const modalTitle = document.getElementById('systemStatusModalLabel');
  const content = document.getElementById('systemStatusContent');
  const loading = document.getElementById('systemStatusLoading');

  // Show loading
  if (content) content.style.display = 'none';
  if (loading) loading.style.display = 'block';

  // Ensure modal is properly displayed
  modalElement.style.display = 'flex';
  modalElement.style.zIndex = '9999';

  // Update modal title and load data based on type
  switch(type) {
    case 'active_affiliates':
      modalTitle.innerHTML = '<i class="bi bi-people me-2"></i>Active Affiliates Details';
      loadActiveAffiliatesData(content, loading);
      break;
    case 'lead_conversion':
      modalTitle.innerHTML = '<i class="bi bi-graph-up-arrow me-2"></i>Lead Conversion Analysis';
      loadLeadConversionData(content, loading);
      break;
    case 'avg_policy_value':
      modalTitle.innerHTML = '<i class="bi bi-cash-stack me-2"></i>Average Policy Value Breakdown';
      loadAvgPolicyValueData(content, loading);
      break;
    case 'commissions_due':
      modalTitle.innerHTML = '<i class="bi bi-wallet2 me-2"></i>Commissions Due - Detailed Calculation';
      loadCommissionsDueData(content, loading);
      break;
    case 'total_revenue':
      modalTitle.innerHTML = '<i class="bi bi-graph-up-arrow me-2"></i>Total Revenue Breakdown';
      loadTotalRevenueData(content, loading);
      break;
  }

  // Add event listener to restore body overflow when modal is closed
  modalElement.addEventListener('hidden.bs.modal', function () {
    document.body.style.overflow = 'auto';
    document.body.classList.remove('modal-open');
  });

  modal.show();
}


                  <thead style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <tr>
                      <th style="color: white; font-weight: bold; border: none;">Stage</th>
                      <th style="color: white; font-weight: bold; border: none;">Count</th>
                      <th style="color: white; font-weight: bold; border: none;">Percentage</th>
                    </tr>

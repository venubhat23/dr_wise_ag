<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Customers</h2>
    <p class="text-muted mb-0">Manage your customer database and view customer details</p>
  </div>
  <div class="d-flex gap-2">
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-download me-1"></i>
        Export
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to "Export as CSV", export_admin_customers_path(format: :csv, search: params[:search], customer_type: params[:customer_type], status: params[:status]), class: "dropdown-item" %></li>
        <!-- <li><%= link_to "Export as Excel", export_admin_customers_path(format: :xlsx, search: params[:search], customer_type: params[:customer_type], status: params[:status]), class: "dropdown-item" %></li> -->
      </ul>
    </div>
    <%= link_to new_admin_customer_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Customer
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Customers</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_customers) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-people text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Customers</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@active_customers) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-person-check text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Individual Customers</h6>
            <h3 class="mb-0 text-info"><%= number_with_delimiter(@individual_customers) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-person text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Corporate Customers</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@corporate_customers) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-building text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_customers_path, method: :get, local: true, class: "row g-3", id: "customer-search-form" do |form| %>
      <div class="col-md-4">
        <div class="position-relative">
          <%= form.text_field :search,
              placeholder: "Type 4+ characters to search customers...",
              value: params[:search],
              class: "form-control",
              id: "customer-search-input",
              autocomplete: "off" %>
          <div id="search-spinner" class="position-absolute top-50 end-0 translate-middle-y me-3" style="display: none;">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
              <span class="visually-hidden">Searching...</span>
            </div>
          </div>
        </div>
        <small class="text-muted">Start typing to search by name, email, mobile, or PAN</small>
      </div>
      <div class="col-md-3">
        <%= form.select :customer_type, options_for_select([
          ['All Types', ''],
          ['Individual', 'individual'],
          ['Corporate', 'corporate']
        ], params[:customer_type]), {}, { class: "form-select", id: "customer-type-filter" } %>
      </div>
      <div class="col-md-3">
        <%= form.select :status, options_for_select([
          ['All Status', ''],
          ['Active', 'active'],
          ['Inactive', 'inactive']
        ], params[:status]), {}, { class: "form-select", id: "customer-status-filter" } %>
      </div>
      <div class="col-md-2">
        <button type="button" id="clear-search" class="btn btn-outline-secondary w-100">
          <i class="bi bi-x-circle me-1"></i>Clear
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('customer-search-input');
  const searchForm = document.getElementById('customer-search-form');
  const customerTypeFilter = document.getElementById('customer-type-filter');
  const statusFilter = document.getElementById('customer-status-filter');
  const clearButton = document.getElementById('clear-search');
  const searchSpinner = document.getElementById('search-spinner');
  const customersTable = document.querySelector('.card-body .table-responsive');

  let searchTimeout;
  let currentRequest;

  // Auto-search function
  function performSearch() {
    const searchTerm = searchInput.value.trim();
    const customerType = customerTypeFilter.value;
    const status = statusFilter.value;

    // Don't search if less than 4 characters (unless it's empty to show all)
    if (searchTerm.length > 0 && searchTerm.length < 4) {
      return;
    }

    // Cancel previous request if exists
    if (currentRequest) {
      currentRequest.abort();
    }

    // Show loading spinner
    searchSpinner.style.display = 'block';

    // Create new request
    currentRequest = new AbortController();

    // Build URL with parameters
    const params = new URLSearchParams();
    if (searchTerm) params.append('search', searchTerm);
    if (customerType) params.append('customer_type', customerType);
    if (status) params.append('status', status);
    params.append('page', '1'); // Reset to first page on search

    const url = '/admin/customers?' + params.toString();

    fetch(url, {
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      signal: currentRequest.signal
    })
    .then(response => response.text())
    .then(html => {
      // Parse the response and update the table
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newTable = doc.querySelector('.table-responsive');
      const newStats = doc.querySelectorAll('.card h3');

      if (newTable && customersTable) {
        // Update table content
        customersTable.innerHTML = newTable.innerHTML;

        // Update statistics cards
        const currentStats = document.querySelectorAll('.card h3');
        newStats.forEach((stat, index) => {
          if (currentStats[index]) {
            currentStats[index].textContent = stat.textContent;
          }
        });
      }

      // Update URL without page reload
      window.history.replaceState({}, '', url);

      // Hide loading spinner
      searchSpinner.style.display = 'none';
    })
    .catch(error => {
      if (error.name !== 'AbortError') {
        console.error('Search error:', error);
      }
      searchSpinner.style.display = 'none';
    });
  }

  // Search input event listener
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);

    // Debounce search by 500ms
    searchTimeout = setTimeout(() => {
      performSearch();
    }, 500);
  });

  // Filter change listeners
  customerTypeFilter.addEventListener('change', performSearch);
  statusFilter.addEventListener('change', performSearch);

  // Clear search functionality
  clearButton.addEventListener('click', function() {
    searchInput.value = '';
    customerTypeFilter.value = '';
    statusFilter.value = '';
    performSearch();
  });

  // Prevent form submission on Enter
  searchForm.addEventListener('submit', function(e) {
    e.preventDefault();
    performSearch();
  });
});
</script>

<!-- Customers List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">Customer List</h5>
  </div>
  <div class="card-body p-0">
    <% if @customers.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Customer</th>
              <th class="border-0">Type</th>
              <th class="border-0">Contact</th>
              <th class="border-0">Location</th>
              <th class="border-0">Policies</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @customers.each do |customer| %>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1"><%= customer.display_name %></h6>
                    <small class="text-muted"><%= customer.email %></small>
                  </div>
                </td>
                <td>
                  <span class="badge bg-<%= customer.customer_type == 'individual' ? 'primary' : 'success' %>">
                    <%= customer.customer_type.humanize %>
                  </span>
                </td>
                <td>
                  <div>
                    <div class="mb-1"><%= customer.mobile %></div>
                    <% if customer.pan_number.present? %>
                      <small class="text-muted">PAN: <%= customer.pan_number %></small>
                    <% end %>
                  </div>
                </td>
                <td>
                  <div>
                    <div><%= customer.city %></div>
                    <small class="text-muted"><%= customer.state %></small>
                  </div>
                </td>
                <td>
                  <span class="badge bg-info"><%= customer.respond_to?(:policies_count) ? (customer.policies_count || 0) : customer.policies.count %> policies</span>
                </td>
                <td>
                  <span class="badge bg-<%= customer.status? ? 'success' : 'secondary' %>">
                    <%= customer.status? ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to admin_customer_path(customer), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_customer_path(customer), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to toggle_status_admin_customer_path(customer),
                        method: :patch,
                        class: "btn btn-sm btn-outline-#{customer.status? ? 'secondary' : 'success'}",
                        title: customer.status? ? 'Deactivate' : 'Activate',
                        data: {
                          confirm: "Are you sure you want to #{customer.status? ? 'deactivate' : 'activate'} this customer?",
                          turbo_method: :patch
                        } do %>
                      <i class="bi bi-#{customer.status? ? 'pause-circle' : 'play-circle'}"></i>
                    <% end %>
                    <%= button_to admin_customer_path(customer),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        title: "Delete",
                        data: {
                          confirm: "Are you sure you want to delete this customer?"
                        },
                        form: { style: "display: inline;" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if @customers.respond_to?(:total_pages) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @customers %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No customers found</h5>
        <p class="text-muted mb-3">
          <% if params[:search].present? || params[:customer_type].present? || params[:status].present? %>
            Try adjusting your search criteria or
            <%= link_to "view all customers", admin_customers_path, class: "text-decoration-none" %>.
          <% else %>
            Start by adding your first customer to the system.
          <% end %>
        </p>
        <%= link_to new_admin_customer_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i>
          Add First Customer
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<% content_for :title, "Referred Business" %>

<div class="row mb-4">
  <div class="col-12">
    <h1 class="h3 mb-0 text-gray-800">Referred Business</h1>
    <p class="text-muted mt-1">Affiliates you referred and how many policies each has done.</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">Affiliates Referred</h6>
        <h3 class="mb-0 text-primary"><%= number_with_delimiter(@distributor_stats[:total_affiliates]) %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">Total Policies</h6>
        <h3 class="mb-0 text-success"><%= number_with_delimiter(@distributor_stats[:total_policies]) %></h3>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @referred_affiliates.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Affiliate</th>
              <th>Mobile</th>
              <th>Joined</th>
              <th class="text-center">Health</th>
              <th class="text-center">Life</th>
              <th class="text-center">Motor</th>
              <th class="text-center">Other</th>
              <th class="text-center">Total Policies</th>
            </tr>
          </thead>
          <tbody>
            <% @referred_affiliates.each do |affiliate| %>
              <% stats = @affiliate_stats[affiliate.id] %>
              <%# Self-registered affiliates have no name until KYC is filled in. %>
              <% label = affiliate.display_name.presence || affiliate.email.presence || affiliate.mobile.presence || "—" %>
              <tr>
                <td>
                  <%= label %>
                  <% if affiliate.referred_by_code.present? %>
                    <span class="badge bg-info-subtle text-info ms-1">via referral code</span>
                  <% end %>
                </td>
                <td><%= affiliate.mobile.presence || "—" %></td>
                <td><%= affiliate.created_at.strftime('%d %b %Y') %></td>
                <td class="text-center"><%= stats[:health_policies] %></td>
                <td class="text-center"><%= stats[:life_policies] %></td>
                <td class="text-center"><%= stats[:motor_policies] %></td>
                <td class="text-center"><%= stats[:other_policies] %></td>
                <td class="text-center fw-bold"><%= stats[:total_policies] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted"></i>
        <h5 class="mt-3">No referred affiliates yet</h5>
        <p class="text-muted mb-0">Affiliates who join with your referral code will appear here.</p>
      </div>
    <% end %>
  </div>
</div>

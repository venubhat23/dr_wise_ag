<!-- Success/Error Messages -->
<% if flash[:success] %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle me-2"></i>
    <%= flash[:success] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<% if flash[:notice] %>
  <div class="alert alert-info alert-dismissible fade show" role="alert">
    <i class="bi bi-info-circle me-2"></i>
    <%= flash[:notice] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <%= flash[:alert] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Expired Insurance Policies</h2>
    <p class="text-muted mb-0">View all expired insurance policies from the last year</p>
  </div>
  <div>
    <%= link_to generate_admin_reports_expired_insurance_reports_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Generate Report
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Expired Policies</h6>
            <h3 class="mb-0 text-danger"><%= number_with_delimiter(@total_expired || 0) %></h3>
          </div>
          <div class="bg-danger bg-opacity-10 rounded p-3">
            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Premium Lost</h6>
            <h3 class="mb-0 text-warning">₹<%= number_to_currency((@total_premium_lost || 0).round(2), unit: '', precision: 2, delimiter: ',') %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Sum Insured Lost</h6>
            <h3 class="mb-0 text-info">₹<%= number_to_currency((@total_sum_insured_lost || 0).round(2), unit: '', precision: 2, delimiter: ',') %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-shield-x text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Date Range</h6>
            <p class="mb-0 text-muted small">
              <%= 1.year.ago.strftime('%d %b %Y') %><br>
              to <%= Date.current.strftime('%d %b %Y') %>
            </p>
          </div>
          <div class="bg-secondary bg-opacity-10 rounded p-3">
            <i class="bi bi-calendar-range text-secondary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Expired Policies List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">Expired Insurance Policies</h5>
  </div>
  <div class="card-body p-0">
    <% if @expired_data && @expired_data.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Policy Number</th>
              <th class="border-0">Type</th>
              <th class="border-0">Customer</th>
              <th class="border-0">Insurance Company</th>
              <th class="border-0">End Date</th>
              <th class="border-0">Days Expired</th>
              <th class="border-0">Premium Amount</th>
              <th class="border-0">Sum Insured</th>
              <th class="border-0">Sub Agent</th>
            </tr>
          </thead>
          <tbody>
            <% @expired_data.each do |policy| %>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1">
                      <i class="bi bi-file-earmark-text text-primary me-1"></i>
                      <%= policy[:policy_number] %>
                    </h6>
                    <% if policy[:lead_id].present? %>
                      <small class="text-muted">
                        Lead: <%= policy[:lead_id] %>
                      </small>
                    <% end %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= case policy[:policy_type]
                                         when 'Health' then 'bg-success'
                                         when 'Motor' then 'bg-primary'
                                         when 'Life' then 'bg-info'
                                         when 'Other' then 'bg-secondary'
                                         else 'bg-light text-dark'
                                         end %>">
                    <%= policy[:policy_type] %>
                  </span>
                </td>
                <td>
                  <div>
                    <strong><%= policy[:customer_name] %></strong>
                    <br>
                    <small class="text-muted"><%= policy[:policy_holder] %></small>
                  </div>
                </td>
                <td>
                  <small><%= policy[:insurance_company] %></small>
                </td>
                <td>
                  <div>
                    <strong class="text-danger">
                      <%= policy[:end_date]&.strftime('%d %b %Y') %>
                    </strong>
                    <br>
                    <small class="text-muted">
                      Started: <%= policy[:start_date]&.strftime('%d %b %Y') %>
                    </small>
                  </div>
                </td>
                <td>
                  <span class="badge <%= policy[:days_expired] > 90 ? 'bg-danger' : 'bg-warning text-dark' %>">
                    <%= pluralize(policy[:days_expired], 'day') %>
                  </span>
                </td>
                <td>
                  <strong class="text-success">
                    ₹<%= number_to_currency((policy[:premium_amount] || 0).round(2), unit: '', precision: 2, delimiter: ',') %>
                  </strong>
                  <br>
                  <small class="text-muted"><%= policy[:payment_mode] %></small>
                </td>
                <td>
                  <strong class="text-info">
                    ₹<%= number_to_currency((policy[:sum_insured] || 0).round(2), unit: '', precision: 2, delimiter: ',') %>
                  </strong>
                </td>
                <td>
                  <small class="text-muted">
                    <%= policy[:sub_agent_name] %>
                  </small>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if @expired_data.respond_to?(:total_pages) && @expired_data.total_pages > 1 %>
        <div class="card-footer bg-transparent border-0">
          <div class="d-flex justify-content-between align-items-center flex-wrap">
            <small class="text-muted mb-2 mb-md-0">
              Showing <%= @expired_data.current_page == 1 ? 1 : ((@expired_data.current_page - 1) * @expired_data.limit_value + 1) %>
              to <%= [@expired_data.current_page * @expired_data.limit_value, @expired_data.total_count].min %>
              of <%= number_with_delimiter(@expired_data.total_count) %> policies
            </small>
            <div class="pagination-wrapper">
              <%= paginate @expired_data %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-shield-check fs-1 text-success d-block mb-3"></i>
        <h5 class="text-success">No Expired Policies Found!</h5>
        <p class="text-muted mb-3">
          Great news! There are no expired insurance policies in the selected date range.
        </p>
      </div>
    <% end %>
  </div>
</div>

<style>
.min-width-250 { min-width: 250px; }
</style>
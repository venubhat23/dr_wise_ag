            'rgba(255, 193, 7, 0.8)',
            'rgba(255, 65, 108, 0.8)',
            'rgba(131, 96, 195, 0.8)',
            'rgba(255, 154, 158, 0.8)',
            'rgba(0, 198, 255, 0.8)',
            'rgba(252, 70, 107, 0.8)'

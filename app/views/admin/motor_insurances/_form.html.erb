                    <% all_documents.each do |doc_info| %>
                      <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm document-card">
                          <div class="card-body p-3 text-center">
                            <div class="mb-3">
                              <%
                                icon_class = case doc_info[:type]
                                when 'uploaded'
                                  doc_info[:doc].file_extension&.downcase == '.pdf' ? 'bi-file-earmark-pdf text-danger' : 'bi-file-earmark-image text-info'
                                when 'policy'
                                  doc_info[:doc].content_type&.include?('pdf') ? 'bi-file-earmark-pdf text-danger' : 'bi-file-earmark-image text-info'
                                when 'additional'
                                  doc_info[:doc].content_type&.include?('pdf') ? 'bi-file-earmark-pdf text-danger' : 'bi-file-earmark-image text-info'
                                else
                                  'bi-file-earmark text-secondary'
                                end

                                bg_class = case doc_info[:type]
                                when 'uploaded'
                                  doc_info[:doc].file_extension&.downcase == '.pdf' ? 'bg-danger' : 'bg-info'
                                when 'policy'
                                  doc_info[:doc].content_type&.include?('pdf') ? 'bg-danger' : 'bg-info'
                                when 'additional'
                                  doc_info[:doc].content_type&.include?('pdf') ? 'bg-danger' : 'bg-info'
                                else
                                  'bg-secondary'
                                end
                              %>
                              <div class="<%= bg_class %> bg-opacity-10 rounded d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi <%= icon_class %> fs-4"></i>
                              </div>
                            </div>

                            <h6 class="card-title small mb-2">
                              <% if doc_info[:type] == 'uploaded' %>
                                <%= truncate(doc_info[:doc].title, length: 20) %>
                              <% else %>
                                <%= truncate(doc_info[:doc].filename.to_s, length: 20) %>
                              <% end %>
                            </h6>

                            <p class="small text-muted mb-2">
                              <% if doc_info[:type] == 'uploaded' %>
                                <%= doc_info[:doc].file_extension&.upcase&.delete('.') || 'FILE' %>
                              <% else %>
                                <%= File.extname(doc_info[:doc].filename.to_s).upcase.delete('.') %>
                              <% end %>
                            </p>

                            <p class="small text-muted mb-3">
                              <% if doc_info[:type] == 'uploaded' %>
                                <%= number_to_human_size(doc_info[:doc].file_size || 0) %>
                              <% else %>
                                <%= number_to_human_size(doc_info[:doc].byte_size) %>
                              <% end %>
                            </p>

                            <div class="mb-2">
                              <span class="badge bg-light text-dark"><%= doc_info[:label] %></span>
                            </div>


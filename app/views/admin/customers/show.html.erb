<!-- User Account Information Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#userAccountCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-person-circle"></i>
      </div>
      <h5 class="section-title">User Account Information</h5>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="userAccountCollapse" class="collapse">
    <div class="section-body">
      <% if @customer.email.present? %>
        <% user = User.find_by(email: @customer.email, user_type: 'customer') %>
        <% if user %>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="info-field">
                <label>ACCOUNT STATUS</label>
                <div class="info-value">
                  <span class="badge bg-success">
                    <i class="bi bi-person-check me-1"></i>Active
                  </span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="info-field">
                <label>LOGIN EMAIL</label>
                <div class="info-value"><%= user.email %></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="info-field">
                <label>LOGIN MOBILE</label>
                <div class="info-value"><%= user.mobile || '-' %></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="info-field">
                <label>LOGIN PASSWORD</label>
                <div class="info-value">
                  <% if user.original_password.present? %>
                    <span class="text-success fw-bold"><%= user.original_password %></span>
                    <button class="btn btn-sm btn-outline-secondary ms-2"
                            onclick="copyToClipboard('<%= user.original_password %>')"
                            title="Copy password">
                      <i class="bi bi-clipboard"></i>
                    </button>
                  <% else %>
                    <span class="text-muted">Password encrypted</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="alert alert-warning">
            <i class="bi bi-person-x me-2"></i>User account not created yet
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>No email address provided - User account cannot be created
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Associated Leads Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#leadsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-funnel"></i>
      </div>
      <h5 class="section-title">Associated Leads</h5>
      <span class="section-count"><%= @associated_leads&.count || 0 %> Total</span>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="leadsCollapse" class="collapse">
    <div class="section-body">
      <% if @associated_leads&.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Lead ID</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>Email</th>
                <th>Product</th>
                <th>Stage</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% @associated_leads.each do |lead| %>
                <tr>
                  <td><code class="bg-light px-2 py-1 rounded text-primary"><%= lead.lead_id %></code></td>
                  <td><strong><%= lead.name %></strong></td>
                  <td>
                    <% if lead.contact_number.present? %>
                      <i class="bi bi-phone me-1 text-muted"></i><%= lead.contact_number %>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <% if lead.email.present? %>
                      <i class="bi bi-envelope me-1 text-muted"></i><%= lead.email %>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <%= lead.product_category %>
                    <% if lead.product_subcategory.present? %>
                      <br><small class="text-muted"><%= lead.product_subcategory %></small>
                    <% end %>
                  </td>
                  <td>
                    <%
                      stage_colors = {
                        'new' => 'secondary', 'contacted' => 'info', 'qualified' => 'warning',
                        'proposal_sent' => 'primary', 'negotiation' => 'warning', 'converted' => 'success',
                        'lost' => 'danger', 'policy_created' => 'success'
                      }
                      stage_color = stage_colors[lead.current_stage] || 'secondary'
                    %>
                    <span class="badge bg-<%= stage_color %>"><%= lead.current_stage&.humanize || 'Unknown' %></span>
                  </td>
                  <td><%= lead.created_at.strftime("%d %b %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center text-muted py-4">
          <i class="bi bi-funnel fs-3 d-block mb-3"></i>
          <h6>No Leads Found</h6>
          <p class="mb-3">This client doesn't have any associated leads.</p>
          <%= link_to new_admin_lead_path(customer_id: @customer.id), class: "btn btn-primary btn-sm" do %>
            <i class="bi bi-plus me-1"></i>Create New Lead
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>


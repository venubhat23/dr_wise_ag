<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Edit Broker</h2>
    <p class="text-muted mb-0">Update the broker information</p>
  </div>
  <div>
    <%= link_to admin_brokers_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Brokers
    <% end %>
  </div>
</div>

<!-- Error Display -->
<% if @broker.errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <div class="d-flex align-items-center">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <div>
        <h6 class="mb-1"><%= pluralize(@broker.errors.count, "error") %> prohibited this broker from being saved:</h6>
        <ul class="mb-0">
          <% @broker.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<%= form_with model: [:admin, @broker], local: true, class: "needs-validation", novalidate: true, data: { turbo: false } do |form| %>

  <!-- Broker Information -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 d-flex align-items-center">
      <i class="bi bi-briefcase-fill me-2 text-primary"></i>
      <h5 class="mb-0">Broker Information</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-8">
          <div class="mb-4">
            <%= form.label :name, class: "form-label" do %>
              <i class="bi bi-building me-2 text-primary"></i>
              Broker Name <span class="text-danger">*</span>
            <% end %>
            <%= form.text_field :name,
                class: "form-control form-control-lg",
                placeholder: "Enter broker or brokerage firm name",
                required: true %>
            <small class="form-text text-muted">
              <i class="bi bi-info-circle me-1"></i>
              Enter the full name of the brokerage firm or individual broker
            </small>
            <div class="invalid-feedback">
              Please provide a valid broker name.
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="mb-4">
            <%= form.label :insurance_company_id, class: "form-label" do %>
              <i class="bi bi-building me-2 text-primary"></i>
              Insurance Company
            <% end %>
            <%= form.select :insurance_company_id,
                options_from_collection_for_select(@insurance_companies, :id, :name, @broker.insurance_company_id),
                { prompt: 'Select Insurance Company (Optional)' },
                { class: "form-select form-select-lg" } %>
            <small class="form-text text-muted">
              Choose the insurance company this broker represents
            </small>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4">
          <div class="mb-4">
            <%= form.label :status, class: "form-label" do %>
              <i class="bi bi-toggle-on me-2 text-success"></i>
              Status <span class="text-danger">*</span>
            <% end %>
            <%= form.select :status,
                options_for_select([
                  ['Active', 'active'],
                  ['Inactive', 'inactive']
                ], @broker.status),
                {},
                { class: "form-select form-select-lg", required: true } %>
            <small class="form-text text-muted">
              Set the status for this broker
            </small>
          </div>
        </div>
      </div>

      <!-- Information Alert -->
      <div class="alert alert-info" role="alert">
        <div class="d-flex">
          <i class="bi bi-lightbulb-fill me-2 text-info"></i>
          <div>
            <strong>Note:</strong> Changes to this broker will affect all associated policies and customer assignments.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            All fields marked with <span class="text-danger">*</span> are required
          </small>
        </div>
        <div class="d-flex gap-2">
          <%= link_to admin_brokers_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-x-lg me-1"></i>
            Cancel
          <% end %>
          <%= form.submit "Update Broker", class: "btn btn-primary px-4" %>
        </div>
      </div>
    </div>
  </div>

<% end %>

<style>
.form-control-lg, .form-select-lg {
  border-radius: 12px;
  border: 2px solid #e9ecef;
  padding: 12px 16px;
  font-size: 16px;
}

.form-control-lg:focus, .form-select-lg:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
}

.card {
  border-radius: 16px;
}

.card-header {
  border-radius: 16px 16px 0 0 !important;
}

.btn {
  border-radius: 10px;
  font-weight: 500;
}

.alert {
  border-radius: 12px;
  border: none;
}

.form-label {
  font-weight: 600;
  color: #495057;
  margin-bottom: 8px;
}

.form-text {
  font-size: 13px;
}

.invalid-feedback {
  font-size: 13px;
  margin-top: 4px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Bootstrap form validation
  const forms = document.querySelectorAll('.needs-validation');

  Array.from(forms).forEach(function(form) {
    form.addEventListener('submit', function(event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    });
  });

  // Focus on first input
  const firstInput = document.querySelector('input[type="text"]');
  if (firstInput) {
    firstInput.focus();
  }
});
</script>
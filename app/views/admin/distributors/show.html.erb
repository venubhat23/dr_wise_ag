<!-- Profile Hero -->
<div class="ambassador-hero mb-4">
  <div class="hero-decor hero-decor-1"></div>
  <div class="hero-decor hero-decor-2"></div>
  <div class="hero-content">
    <div class="d-flex align-items-center gap-3">
      <div class="hero-avatar">
        <% if @distributor.has_r2_profile_image? %>
          <%= image_tag @distributor.r2_profile_image_url, alt: @distributor.display_name %>
        <% elsif @distributor.profile_image.attached? %>
          <%= image_tag @distributor.profile_image_url, alt: @distributor.display_name %>
        <% else %>
          <span><%= @distributor.display_name.to_s.first(1).upcase.presence || "A" %></span>
        <% end %>
      </div>
      <div>
        <h2 class="hero-name mb-1"><%= @distributor.display_name %></h2>
        <div class="d-flex align-items-center flex-wrap gap-2">
          <span class="hero-pill <%= @distributor.active? ? 'hero-pill-active' : 'hero-pill-inactive' %>">
            <i class="bi bi-circle-fill"></i><%= @distributor.status.humanize %>
          </span>
          <span class="hero-meta"><i class="bi bi-hash"></i>Ambassador ID <%= @distributor.id %></span>
          <% if @distributor.mobile.present? %>
            <span class="hero-meta"><i class="bi bi-telephone"></i><%= @distributor.mobile %></span>
          <% end %>
          <span class="hero-meta"><i class="bi bi-calendar3"></i>Since <%= @distributor.created_at.strftime('%b %Y') %></span>
        </div>
      </div>
    </div>
    <div class="hero-actions">
      <% if @distributor.self_registered? && (@distributor.kyc_pending? || @distributor.kyc_submitted?) %>
        <%= button_to approve_admin_ambassador_kyc_verification_path(@distributor),
                      method: :patch, class: "btn btn-hero-approve",
                      form: { data: { turbo_confirm: "Approve #{@distributor.display_name}'s KYC and activate their account?" } } do %>
          <i class="bi bi-check-circle me-1"></i>Approve
        <% end %>
      <% end %>
      <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-hero-primary" do %>
        <i class="bi bi-pencil me-1"></i>Edit
      <% end %>
      <%= link_to admin_distributors_path, class: "btn btn-hero-ghost" do %>
        <i class="bi bi-arrow-left me-1"></i>Back
      <% end %>
    </div>
  </div>
</div>

<div class="row">
  <!-- Personal Information -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">
          <i class="bi bi-person-circle me-2 text-primary"></i>
          Personal Information
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Full Name</label>
            <p class="mb-0 fw-medium"><%= @distributor.full_name %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Contact</label>
            <p class="mb-0"><%= @distributor.mobile %></p>
          </div>
          <% if @distributor.address.present? %>
            <div class="col-md-12 mb-3">
              <label class="form-label text-muted">Address</label>
              <p class="mb-0"><%= @distributor.address %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Associated Investor -->
    <% if @distributor.investor.present? %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0">
          <h5 class="mb-0">
            <i class="bi bi-person-badge me-2 text-warning"></i>
            Associated Investor
          </h5>
        </div>
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-8">
              <div class="d-flex align-items-center">
                <div class="avatar-circle bg-warning bg-opacity-10 me-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                  <i class="bi bi-person-fill text-warning fs-5"></i>
                </div>
                <div>
                  <h6 class="mb-0">
                    <%= link_to @distributor.investor.full_name,
                        admin_investor_path(@distributor.investor),
                        class: "text-decoration-none fw-bold text-dark" %>
                  </h6>
                  <small class="text-muted">
                    <i class="bi bi-telephone me-1"></i><%= @distributor.investor.mobile %>
                    <span class="mx-2">•</span>
                    <i class="bi bi-envelope me-1"></i><%= @distributor.investor.email %>
                  </small>
                </div>
              </div>
            </div>
            <div class="col-md-4 text-end">
              <%= link_to admin_investor_path(@distributor.investor),
                  class: "btn btn-outline-warning btn-sm" do %>
                <i class="bi bi-eye me-1"></i>
                View Investor
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Bank Details -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">
          <i class="bi bi-bank me-2 text-success"></i>
          Bank Details
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Bank Name</label>
            <p class="mb-0"><%= @distributor.bank_name || 'Not provided' %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Account Number</label>
            <p class="mb-0"><%= @distributor.account_no || 'Not provided' %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">IFSC Code</label>
            <p class="mb-0"><%= @distributor.ifsc_code || 'Not provided' %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Account Holder Name</label>
            <p class="mb-0"><%= @distributor.account_holder_name || 'Not provided' %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Assigned Affiliates -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center header-affiliates">
        <h5 class="mb-0">
          <i class="bi bi-people me-2 text-info"></i>
          Assigned Affiliates
          <span class="badge bg-info ms-2"><%= @distributor.assigned_sub_agents.count %></span>
        </h5>
        <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-sm btn-outline-primary" do %>
          <i class="bi bi-pencil me-1"></i>
          Manage Assignments
        <% end %>
      </div>
      <div class="card-body">
        <% if @assigned_affiliates.any? %>
          <div class="row">
            <% @assigned_affiliates.each do |affiliate| %>
              <% stats = @affiliate_stats[affiliate.id] %>
              <div class="col-12 mb-4">
                <div class="card border-0 shadow-sm affiliate-card">
                  <div class="card-header bg-light">
                    <div class="d-flex align-items-center justify-content-between">
                      <div class="d-flex align-items-center">
                        <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
                          <i class="bi bi-person text-primary fs-5"></i>
                        </div>
                        <div>
                          <h6 class="mb-1"><%= affiliate.display_name %></h6>
                          <small class="text-muted">
                            <i class="bi bi-telephone me-1"></i><%= affiliate.mobile %>
                          </small>
                        </div>
                      </div>
                      <div class="text-end">
                        <span class="badge bg-<%= affiliate.active? ? 'success' : 'secondary' %> fs-6">
                          <%= affiliate.status.humanize %>
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="card-body">
                    <!-- Performance Stats -->
                    <div class="row row-cols-2 row-cols-md-4 g-2 mb-3">
                      <div class="col">
                        <div class="stat-tile tile-compact tile-primary">
                          <div class="stat-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                          <p class="stat-value mb-0"><%= stats[:total_policies] %></p>
                          <div class="stat-label">Total Policies</div>
                        </div>
                      </div>
                      <div class="col">
                        <div class="stat-tile tile-compact tile-success">
                          <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                          <p class="stat-value mb-0"><%= indian_currency(stats[:total_premium].to_i) %></p>
                          <div class="stat-label">Total Premium</div>
                        </div>
                      </div>
                      <div class="col">
                        <div class="stat-tile tile-compact tile-info">
                          <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                          <p class="stat-value mb-0"><%= stats[:customers_count] %></p>
                          <div class="stat-label">Customers</div>
                        </div>
                      </div>
                      <div class="col">
                        <div class="stat-tile tile-compact tile-secondary">
                          <div class="stat-icon"><i class="bi bi-percent"></i></div>
                          <p class="stat-value mb-0"><%= indian_currency(stats[:total_commission].to_i) %></p>
                          <div class="stat-label">Commission</div>
                        </div>
                      </div>
                    </div>

                    <!-- Policy Breakdown -->
                    <div class="row mb-3">
                      <div class="col-3 text-center">
                        <span class="badge bg-success rounded-pill">Health: <%= stats[:health_policies] %></span>
                      </div>
                      <div class="col-3 text-center">
                        <span class="badge bg-primary rounded-pill">Life: <%= stats[:life_policies] %></span>
                      </div>
                      <div class="col-3 text-center">
                        <span class="badge bg-warning rounded-pill">Motor: <%= stats[:motor_policies] %></span>
                      </div>
                      <div class="col-3 text-center">
                        <span class="badge bg-info rounded-pill">Other: <%= stats[:other_policies] %></span>
                      </div>
                    </div>

                    <!-- Recent Policies -->
                    <% if stats[:recent_policies].any? %>
                      <div class="border-top pt-3">
                        <h6 class="text-muted mb-2">Recent Policies:</h6>
                        <div class="row">
                          <% stats[:recent_policies].each do |policy| %>
                            <div class="col-md-6 mb-2">
                              <small class="d-block">
                                <span class="badge bg-<%= policy[:type].downcase == 'health' ? 'success' : policy[:type].downcase == 'life' ? 'primary' : policy[:type].downcase == 'motor' ? 'warning' : 'info' %>">
                                  <%= policy[:type] %>
                                </span>
                                <%
                                  if policy[:id].present?
                                    policy_path = case policy[:type].downcase
                                    when 'health'
                                      admin_health_insurance_path(policy[:id])
                                    when 'life'
                                      admin_life_insurance_path(policy[:id])
                                    when 'motor'
                                      admin_motor_insurance_path(policy[:id])
                                    when 'other'
                                      admin_other_insurance_path(policy[:id])
                                    else
                                      '#'
                                    end
                                  else
                                    policy_path = '#'
                                  end
                                %>
                                <% if policy[:id].present? %>
                                  <%= link_to policy[:policy_number], policy_path, class: "ms-2 text-decoration-none fw-bold", target: "_blank" %>
                                <% else %>
                                  <span class="ms-2 text-muted fw-bold"><%= policy[:policy_number] || 'N/A' %></span>
                                <% end %>
                              </small>
                              <small class="text-muted d-block">
                                <%= policy[:customer] %> - <%= indian_currency(policy[:premium].to_i) %>
                              </small>
                              <small class="text-muted">
                                <%= time_ago_in_words(policy[:created_at]) %> ago
                              </small>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <!-- Assignment Info -->
                    <% assignment = affiliate.distributor_assignment %>
                    <% if assignment && assignment.assigned_at.present? %>
                      <div class="border-top pt-2 mt-3">
                        <small class="text-success">
                          <i class="bi bi-calendar-check me-1"></i>
                          Assigned <%= time_ago_in_words(assignment.assigned_at) %> ago
                          (<%= assignment.assigned_at.strftime('%d %b %Y') %>)
                        </small>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            <h6 class="text-muted mt-3">No Affiliates Assigned</h6>
            <p class="text-muted mb-3">This ambassador doesn't have any affiliates assigned yet.</p>
            <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-primary" do %>
              <i class="bi bi-plus me-1"></i>
              Assign Affiliates
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="col-lg-4">

    <!-- Assigned Investor -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="bi bi-person-badge me-2 text-warning"></i>
          Assigned Investor
        </h6>
        <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-sm btn-outline-secondary", title: "Change Investor" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
      </div>
      <div class="card-body">
        <% if @distributor.investor.present? %>
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;">
              <i class="bi bi-person-fill text-warning fs-5"></i>
            </div>
            <div class="flex-grow-1 min-width-0">
              <%= link_to admin_investor_path(@distributor.investor),
                  class: "fw-bold text-dark text-decoration-none d-block" do %>
                <%= @distributor.investor.full_name %>
              <% end %>
              <small class="text-muted d-block">
                <i class="bi bi-envelope me-1"></i><%= @distributor.investor.email %>
              </small>
              <small class="text-muted d-block">
                <i class="bi bi-telephone me-1"></i><%= @distributor.investor.mobile %>
              </small>
            </div>
          </div>
          <div class="d-flex gap-2">
            <span class="badge <%= @distributor.investor.active? ? 'bg-success' : 'bg-secondary' %>">
              <%= @distributor.investor.status.humanize %>
            </span>
          </div>
          <!-- Investor Bank Details -->
          <% inv = @distributor.investor %>
          <% if inv.bank_name.present? || inv.account_no.present? || inv.ifsc_code.present? %>
            <hr class="my-3">
            <div class="mb-1" style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#6c757d;">
              <i class="bi bi-bank me-1"></i>Bank Details
            </div>
            <div class="small">
              <% if inv.bank_name.present? %>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted">Bank</span>
                  <span class="fw-semibold"><%= inv.bank_name %></span>
                </div>
              <% end %>
              <% if inv.account_no.present? %>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted">Account No</span>
                  <span class="fw-semibold"><%= inv.account_no %></span>
                </div>
              <% end %>
              <% if inv.ifsc_code.present? %>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted">IFSC</span>
                  <span class="fw-semibold"><%= inv.ifsc_code %></span>
                </div>
              <% end %>
              <% if inv.account_holder_name.present? %>
                <div class="d-flex justify-content-between py-1">
                  <span class="text-muted">Holder</span>
                  <span class="fw-semibold"><%= inv.account_holder_name %></span>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="mt-3">
            <%= link_to admin_investor_path(@distributor.investor),
                class: "btn btn-sm btn-outline-warning w-100" do %>
              <i class="bi bi-eye me-1"></i>View Investor Profile
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-3">
            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width:56px;height:56px;">
              <i class="bi bi-person-x text-muted fs-4"></i>
            </div>
            <p class="text-muted small mb-3">No investor assigned to this ambassador.</p>
            <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-sm btn-outline-warning" do %>
              <i class="bi bi-plus me-1"></i>Assign Investor
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Profile Image -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-person-circle me-2 text-primary"></i>
          Profile Picture
        </h6>
      </div>
      <div class="card-body text-center">
        <% if @distributor.has_r2_profile_image? %>
          <div class="position-relative d-inline-block">
            <%= image_tag @distributor.r2_profile_image_url,
                class: "rounded-circle border",
                style: "width: 150px; height: 150px; object-fit: cover;",
                alt: "Profile Picture" %>
            <div class="position-absolute" style="bottom: 10px; right: 10px;">
              <span class="badge bg-success">
                <i class="bi bi-cloud-check"></i> R2
              </span>
            </div>
          </div>
          <div class="mt-3">
            <p class="mb-1"><strong>File:</strong> <%= @distributor.r2_profile_image.document_name %></p>
            <p class="mb-1"><strong>Size:</strong> <%= @distributor.r2_profile_image.document_size %></p>
          </div>
        <% elsif @distributor.profile_image.attached? %>
          <div class="position-relative d-inline-block">
            <%= image_tag @distributor.profile_image_url,
                class: "rounded-circle border",
                style: "width: 150px; height: 150px; object-fit: cover;",
                alt: "Profile Picture" %>
            <div class="position-absolute" style="bottom: 10px; right: 10px;">
              <span class="badge bg-info">
                <i class="bi bi-cloud"></i> Storage
              </span>
            </div>
          </div>
          <div class="mt-3">
            <p class="mb-1"><strong>File:</strong> <%= @distributor.profile_image.filename %></p>
            <p class="mb-1"><strong>Size:</strong> <%= number_to_human_size(@distributor.profile_image.byte_size) %></p>
            <p class="mb-1"><strong>Uploaded:</strong> <%= time_ago_in_words(@distributor.profile_image.created_at) %> ago</p>
          </div>
        <% else %>
          <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto"
               style="width: 150px; height: 150px;">
            <div class="text-center">
              <i class="bi bi-person-circle text-muted" style="font-size: 3rem;"></i>
              <p class="text-muted small mt-2">No profile picture</p>
            </div>
          </div>
        <% end %>

        <div class="mt-3">
          <%= link_to edit_admin_distributor_path(@distributor), class: "btn btn-sm btn-outline-primary" do %>
            <i class="bi bi-pencil me-1"></i>
            Update Picture
          <% end %>
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-graph-up me-2 text-primary"></i>
          Performance Overview
        </h6>
      </div>
      <div class="card-body">
        <div class="row row-cols-2 g-2 mb-2">
          <div class="col">
            <div class="stat-tile tile-info">
              <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
              <p class="stat-value mb-0"><%= @distributor_stats[:total_affiliates] %></p>
              <div class="stat-label">Total Affiliates</div>
            </div>
          </div>
          <div class="col">
            <div class="stat-tile tile-success">
              <div class="stat-icon"><i class="bi bi-person-check-fill"></i></div>
              <p class="stat-value mb-0"><%= @distributor_stats[:active_affiliates] %></p>
              <div class="stat-label">Active Affiliates</div>
            </div>
          </div>
          <div class="col">
            <div class="stat-tile tile-primary">
              <div class="stat-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
              <p class="stat-value mb-0"><%= @distributor_stats[:total_policies] %></p>
              <div class="stat-label">Total Policies</div>
            </div>
          </div>
          <div class="col">
            <div class="stat-tile tile-warning">
              <div class="stat-icon"><i class="bi bi-person-lines-fill"></i></div>
              <p class="stat-value mb-0"><%= @distributor_stats[:total_customers] %></p>
              <div class="stat-label">Total Customers</div>
            </div>
          </div>
        </div>
        <div class="stat-tile tile-success">
          <div class="stat-icon"><i class="bi bi-graph-up-arrow"></i></div>
          <p class="stat-value mb-0"><%= indian_currency(@distributor_stats[:total_premium].to_i) %></p>
          <div class="stat-label">Total Premium Generated</div>
        </div>
      </div>
    </div>

    <!-- Payout Summary -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-wallet2 me-2 text-success"></i>
          Commission Payouts
        </h6>
      </div>
      <div class="card-body">
        <div class="stat-tile tile-success mb-2">
          <div class="stat-icon"><i class="bi bi-wallet2"></i></div>
          <p class="stat-value mb-0"><%= indian_currency(@distributor_payout_data[:total_amount].to_i) %></p>
          <div class="stat-label">Total Commission Earned</div>
        </div>
        <div class="row row-cols-2 g-2">
          <div class="col">
            <div class="stat-tile tile-primary">
              <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
              <p class="stat-value mb-0"><%= indian_currency(@distributor_payout_data[:paid_amount].to_i) %></p>
              <div class="stat-label">Paid Amount</div>
            </div>
          </div>
          <div class="col">
            <div class="stat-tile tile-warning">
              <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
              <p class="stat-value mb-0"><%= indian_currency(@distributor_payout_data[:pending_amount].to_i) %></p>
              <div class="stat-label">Pending Amount</div>
            </div>
          </div>
        </div>

        <% if @distributor_payout_data[:leads].any? %>
          <hr>
          <div class="mb-2">
            <small class="text-muted"><%= @distributor_payout_data[:lead_count] %> leads</small>
          </div>
          <div class="d-flex flex-wrap gap-1">
            <% @distributor_payout_data[:leads].each do |lead_data| %>
              <span class="badge <%= lead_data[:paid] ? 'bg-success' : 'bg-warning' %> text-dark small">
                <%= lead_data[:lead].lead_id %>: <%= indian_currency(lead_data[:commission].to_i) %>
                <% if lead_data[:paid] %>
                  <i class="bi bi-check-circle ms-1"></i>
                <% end %>
              </span>
            <% end %>
          </div>
          <div class="mt-2">
            <small class="text-muted">
              Paid: <%= indian_currency(@distributor_payout_data[:paid_amount].to_i) %> |
              Pending: <%= indian_currency(@distributor_payout_data[:pending_amount].to_i) %>
            </small>
            <div class="mt-1">
              <span class="badge bg-<%= @distributor_payout_data[:pending_amount] > 0 ? 'warning' : 'success' %> small">
                <%= @distributor_payout_data[:pending_amount] > 0 ? 'Pending Payments' : 'All Paid' %>
              </span>
            </div>
          </div>
        <% else %>
          <div class="text-center text-muted py-3">
            <i class="bi bi-wallet2 fs-1 d-block mb-2"></i>
            <small>No commission payouts yet</small>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Documents -->
    <% if @distributor.distributor_documents.any? || @distributor.upload_main_document.attached? %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0">
          <h6 class="mb-0">
            <i class="bi bi-file-earmark me-2 text-warning"></i>
            Documents
          </h6>
        </div>
        <div class="card-body p-2">
          <!-- Main Document (ActiveStorage) -->
          <% if @distributor.upload_main_document.attached? %>
            <div class="mb-3">
              <h6 class="text-primary mb-3">
                <i class="bi bi-file-earmark-check me-2"></i>
                Main Document
              </h6>
              <div class="card border-light shadow-sm">
                <div class="card-body p-3">
                  <div class="row align-items-center">
                    <!-- Document Preview -->
                    <div class="col-auto">
                      <div class="document-thumbnail">
                        <% if @distributor.upload_main_document.content_type&.include?('image') %>
                          <%= image_tag @distributor.upload_main_document,
                              class: "rounded border",
                              style: "width: 80px; height: 80px; object-fit: cover;",
                              alt: "Main document preview",
                              onerror: "this.style.display='none'; this.nextElementSibling.style.display='block';" %>
                          <div class="file-icon-fallback d-none">
                            <i class="bi bi-file-earmark-image text-info" style="font-size: 3rem;"></i>
                          </div>
                        <% else %>
                          <div class="file-icon-display text-center">
                            <% case @distributor.upload_main_document.content_type&.downcase %>
                            <% when /pdf/ %>
                              <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 3rem;"></i>
                            <% when /word|document/ %>
                              <i class="bi bi-file-earmark-word text-primary" style="font-size: 3rem;"></i>
                            <% else %>
                              <i class="bi bi-file-earmark text-muted" style="font-size: 3rem;"></i>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <!-- Document Details -->
                    <div class="col">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <h6 class="mb-1">
                            <%= @distributor.upload_main_document.filename %>
                            <span class="badge bg-primary ms-2">Main Document</span>
                          </h6>

                          <div class="document-meta small text-muted">
                            <span class="me-3">
                              <i class="bi bi-calendar3 me-1"></i>
                              Uploaded: <%= @distributor.upload_main_document.created_at.strftime("%B %d, %Y") %>
                            </span>
                            <span class="me-3">
                              <i class="bi bi-file-earmark me-1"></i>
                              Size: <%= number_to_human_size(@distributor.upload_main_document.byte_size) %>
                            </span>
                            <span class="me-3">
                              <i class="bi bi-file-earmark-text me-1"></i>
                              Type: <%= @distributor.upload_main_document.content_type %>
                            </span>
                          </div>
                        </div>

                        <!-- Actions -->
                        <div class="btn-group-vertical btn-group-sm">
                          <%= link_to @distributor.upload_main_document,
                              class: "btn btn-outline-primary btn-sm",
                              target: "_blank",
                              title: "View Document",
                              data: { toggle: "tooltip" } do %>
                            <i class="bi bi-eye"></i>
                          <% end %>
                          <%= link_to @distributor.upload_main_document,
                              class: "btn btn-outline-success btn-sm",
                              download: true,
                              title: "Download Document",
                              data: { toggle: "tooltip" } do %>
                            <i class="bi bi-download"></i>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Additional Documents (R2) -->
          <% if @distributor.distributor_documents.any? %>
            <%= render 'shared/existing_documents_display',
                       documents: @distributor.distributor_documents,
                       title: 'Additional Documents',
                       show_actions: true,
                       record_type: 'ambassador',
                       container_class: '' %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Login Credentials -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-key me-2 text-danger"></i>
          Ambassador Login Credentials
        </h6>
      </div>
      <div class="card-body">
        <% login_url = new_user_session_url %>
        <div class="mb-3">
          <label class="form-label text-muted">Login URL</label>
          <div class="input-group">
            <input type="text" class="form-control credential-input" value="<%= login_url %>" readonly>
            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= login_url %>')">
              <i class="bi bi-clipboard"></i>
            </button>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label text-muted">Email</label>
          <div class="input-group">
            <input type="text" class="form-control credential-input" value="<%= @distributor.email || 'Not provided' %>" readonly>
            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= @distributor.email %>')">
              <i class="bi bi-clipboard"></i>
            </button>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label text-muted">Password</label>
          <%
            user = User.find_by(email: @distributor.email)
            display_password = user&.original_password || 'Not available'
          %>
          <div class="input-group">
            <input type="text" class="form-control credential-input" value="<%= display_password %>" readonly>
            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= display_password %>')">
              <i class="bi bi-clipboard"></i>
            </button>
          </div>
        </div>
        <% if @distributor.email.blank? || display_password == 'Not available' %>
          <div class="alert alert-warning mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Login credentials not yet generated. They will be created when the ambassador account is saved.
          </div>
        <% end %>
      </div>
    </div>

    <!-- Registration Payment -->
    <% if @distributor.self_registered? %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i class="bi bi-credit-card me-2 text-success"></i>
            Registration Payment
          </h6>
          <% if @distributor.payment_paid? %>
            <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
          <% elsif @distributor.payment_required? %>
            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
          <% else %>
            <span class="badge bg-secondary-subtle text-secondary">—</span>
          <% end %>
        </div>
        <div class="card-body">
          <% if @distributor.payment_paid? %>
            <div class="small">
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Amount</span>
                <span class="fw-semibold"><%= indian_currency(@distributor.payment_amount.to_i) %></span>
              </div>
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Paid On</span>
                <span class="fw-semibold"><%= @distributor.payment_paid_at&.strftime('%d %b %Y, %I:%M %p') %></span>
              </div>
              <% if @distributor.razorpay_order_id.present? %>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted">Order ID</span>
                  <span class="fw-semibold text-break"><code><%= @distributor.razorpay_order_id %></code></span>
                </div>
              <% end %>
              <% if @distributor.razorpay_payment_id.present? %>
                <div class="d-flex justify-content-between py-1">
                  <span class="text-muted">Payment ID</span>
                  <span class="fw-semibold text-break"><code><%= @distributor.razorpay_payment_id %></code></span>
                </div>
              <% end %>
            </div>
          <% elsif @distributor.payment_required? %>
            <p class="text-muted small mb-0">
              Registration fee of <%= indian_currency(@distributor.payment_amount_due.to_i) %> not yet paid.
            </p>
          <% else %>
            <p class="text-muted small mb-0">No registration fee applies to this ambassador.</p>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Referral Code -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-share me-2 text-success"></i>
          Ambassador Referral Code
        </h6>
      </div>
      <div class="card-body">
        <div class="input-group">
          <input type="text" class="form-control credential-input fw-bold text-uppercase" value="<%= @distributor.referral_code %>" readonly>
          <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= @distributor.referral_code %>')" title="Copy referral code">
            <i class="bi bi-clipboard"></i> Copy
          </button>
        </div>
        <small class="text-muted d-block mt-2">
          A new affiliate who signs up with this code is mapped directly under this ambassador and receives a
          <%= indian_currency(AffiliateReferralService::SIGNUP_BONUS) %> welcome bonus. The ambassador is not credited.
        </small>
      </div>
    </div>

    <!-- Account Details -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-0">
        <h6 class="mb-0">
          <i class="bi bi-info-circle me-2 text-secondary"></i>
          Account Details
        </h6>
      </div>
      <div class="card-body">
        <div class="mb-2">
          <small class="text-muted">Created</small>
          <br>
          <small><%= @distributor.created_at.strftime('%d %B %Y at %I:%M %p') %></small>
        </div>
        <div class="mb-2">
          <small class="text-muted">Last Updated</small>
          <br>
          <small><%= @distributor.updated_at.strftime('%d %B %Y at %I:%M %p') %></small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Commission Ledger -->
<%= render 'shared/ledger_table',
    ledger_entries: @ledger_entries,
    closing_balance: @ledger_closing_balance,
    entity_name: @distributor.display_name %>

<style>
/* ============ Profile hero ============ */
.ambassador-hero {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
  padding: 28px 30px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 65%, #f093fb 130%);
  color: #fff;
  box-shadow: 0 18px 40px -14px rgba(102, 126, 234, .55);
}
.hero-decor { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .14); pointer-events: none; }
.hero-decor-1 { width: 220px; height: 220px; top: -90px; right: -60px; }
.hero-decor-2 { width: 140px; height: 140px; bottom: -70px; right: 120px; background: rgba(255, 255, 255, .08); }
.hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
.hero-avatar {
  width: 72px; height: 72px; border-radius: 50%; flex: 0 0 auto; overflow: hidden;
  background: rgba(255, 255, 255, .22); display: flex; align-items: center; justify-content: center;
  font-family: "Poppins", sans-serif; font-weight: 700; font-size: 26px;
  border: 3px solid rgba(255, 255, 255, .5);
}
.hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
.hero-name { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 1.55rem; margin: 0; text-shadow: 0 2px 10px rgba(0, 0, 0, .15); }
.hero-pill {
  display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, .22);
  padding: 4px 12px; border-radius: 999px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
}
.hero-pill i { font-size: 8px; }
.hero-pill-inactive { background: rgba(0, 0, 0, .18); }
.hero-meta { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; opacity: .92; }
.hero-actions { display: flex; gap: 10px; }
.btn-hero-primary { background: #fff; color: #5b4bcf; font-weight: 600; border: none; }
.btn-hero-primary:hover { background: #f4f2ff; color: #4c3fb0; }
.btn-hero-ghost { background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .55); color: #fff; font-weight: 600; }
.btn-hero-ghost:hover { background: rgba(255, 255, 255, .26); color: #fff; }
.btn-hero-approve { background: #198754; color: #fff; font-weight: 600; border: none; }
.btn-hero-approve:hover { background: #157347; color: #fff; }
@media (max-width: 576px) {
  .ambassador-hero { padding: 22px 18px; border-radius: 16px; }
  .hero-content { flex-direction: column; align-items: stretch; }
  .hero-content > .d-flex { width: 100%; }
  .hero-content > .d-flex > div:last-child { flex: 1 1 0%; min-width: 0; }
  .hero-actions { width: 100%; }
  .hero-actions .btn { flex: 1; justify-content: center; }
}

/* ============ Section header icon badges ============ */
.card-header h5, .card-header h6 { display: flex; align-items: center; flex-wrap: wrap; gap: .4rem; }
.card-header h5 > i.bi:first-child, .card-header h6 > i.bi:first-child {
  display: inline-flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; border-radius: 9px; margin-right: .1rem !important;
  background: rgba(102, 126, 234, .12);
  background: color-mix(in srgb, currentColor 15%, transparent);
  font-size: .95rem;
}
.card-header { border-bottom: 1px solid rgba(102, 126, 234, .1); padding: 1rem 1.25rem; }

/* ============ Stat tiles ============ */
.stat-tile { border-radius: 14px; padding: 14px 12px; text-align: center; height: 100%; background: rgba(var(--stat-rgb, 102, 126, 234), .08); }
.stat-tile .stat-icon {
  width: 34px; height: 34px; border-radius: 9px; margin: 0 auto 8px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(var(--stat-rgb, 102, 126, 234), .16); color: var(--stat-color, #667eea);
}
.stat-tile .stat-value { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 1.15rem; }
.stat-tile .stat-label { font-size: .72rem; color: #6c757d; text-transform: uppercase; letter-spacing: .3px; font-weight: 600; }
.stat-tile.tile-compact { padding: 10px 8px; }
.stat-tile.tile-compact .stat-icon { width: 28px; height: 28px; margin-bottom: 5px; font-size: .8rem; }
.stat-tile.tile-compact .stat-value { font-size: 1rem; }
.stat-tile.tile-primary { --stat-rgb: 13, 110, 253; --stat-color: #0d6efd; }
.stat-tile.tile-primary .stat-value { color: #0d6efd; }
.stat-tile.tile-success { --stat-rgb: 25, 135, 84; --stat-color: #198754; }
.stat-tile.tile-success .stat-value { color: #198754; }
.stat-tile.tile-info { --stat-rgb: 13, 190, 220; --stat-color: #0aa2c0; }
.stat-tile.tile-info .stat-value { color: #0aa2c0; }
.stat-tile.tile-warning { --stat-rgb: 255, 193, 7; --stat-color: #a9790a; }
.stat-tile.tile-warning .stat-value { color: #a9790a; }
.stat-tile.tile-secondary { --stat-rgb: 108, 117, 125; --stat-color: #6c757d; }
.stat-tile.tile-secondary .stat-value { color: #6c757d; }
[data-theme="dark"] .stat-tile { background: rgba(var(--stat-rgb, 102, 126, 234), .16); }
[data-theme="dark"] .stat-tile .stat-icon { background: rgba(var(--stat-rgb, 102, 126, 234), .26); }
[data-theme="dark"] .stat-tile .stat-label { color: var(--text-secondary, #a0aec0); }

@media (max-width: 480px) {
  .header-affiliates { flex-wrap: wrap; gap: .5rem; }
  .header-affiliates .btn { flex: 1 1 100%; justify-content: center; }
}

/* ============ Affiliate sub-cards ============ */
.affiliate-card { transition: transform .2s ease, box-shadow .2s ease; }
.affiliate-card:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0, 0, 0, .08) !important; }

/* ============ Credential inputs ============ */
.credential-input {
  font-family: ui-monospace, SFMono-Regular, "Cascadia Code", Consolas, monospace;
  letter-spacing: .02em;
  background: rgba(102, 126, 234, .05);
}

.document-thumbnail {
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #dee2e6;
}

.file-icon-display {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.existing-document-item {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.existing-document-item:hover {
  transform: translateY(-2px);
}

.existing-document-item:hover .card {
  box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
}

.btn-group-vertical .btn {
  margin-bottom: 2px;
}

.btn-group-vertical .btn:last-child {
  margin-bottom: 0;
}
</style>

<script>
function copyToClipboard(text) {
  if (text && text !== 'Not provided' && text !== 'Not available') {
    navigator.clipboard.writeText(text).then(function() {
      // Show success message
      const toast = document.createElement('div');
      toast.className = 'position-fixed top-0 end-0 p-3';
      toast.style.zIndex = '11';
      toast.innerHTML = `
        <div class="toast show align-items-center text-bg-success border-0" role="alert">
          <div class="d-flex">
            <div class="toast-body">
              <i class="bi bi-check-circle me-2"></i>Copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
          </div>
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }).catch(function(err) {
      alert('Failed to copy: ' + err);
    });
  }
}
</script>
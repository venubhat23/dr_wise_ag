<!-- Lead Details Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-2">
      <h2 class="mb-0">Lead Details</h2>
      <span class="badge bg-primary fs-6"><%= @lead.lead_id %></span>
    </div>
    <p class="text-muted mb-0"><%= @lead.name %> - Complete lead information and management actions</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to admin_leads_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Leads
    <% end %>

    <!-- Conversion Action Button -->
    <% if @lead.can_convert_to_customer? %>
      <%= link_to new_admin_customer_path(lead_id: @lead.id), class: "btn btn-success", title: "Convert this lead to customer" do %>
        <i class="bi bi-person-plus-fill me-1"></i>Convert to Customer
      <% end %>
    <% elsif @lead.converted_customer.present? %>
      <%= link_to admin_customer_path(@lead.converted_customer), class: "btn btn-info customer-link",
          title: "View Customer: #{@lead.converted_customer.display_name}" do %>
        <i class="bi bi-person-check-fill me-1"></i>View Customer
      <% end %>
    <% end %>

    <div class="dropdown">
      <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-gear me-1"></i>
        Actions
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to "Edit Lead", edit_admin_lead_path(@lead), class: "dropdown-item" %></li>
        <li><%= link_to "Add Notes", edit_admin_lead_path(@lead), class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to "#",
              class: "dropdown-item text-danger delete-lead-btn",
              data: {
                "lead-id": @lead.id,
                "lead-name": @lead.name,
                "delete-url": admin_lead_path(@lead)
              } do %>
            <i class="bi bi-trash me-2"></i>Delete Lead
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</div>

<!-- Lead Stages Guide -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <h5 class="card-title mb-4">
      <i class="bi bi-list-check me-2 text-primary"></i>
      Lead Stages Guide
    </h5>
    <div class="row">
      <!-- Main Flow Stages -->
      <div class="col-md-6">
        <h6 class="text-success mb-3">
          <i class="bi bi-arrow-right-circle me-1"></i>Main Success Flow
        </h6>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">🟢</span>
            <div>
              <h6 class="mb-1">Lead Generated</h6>
              <small class="text-muted">Initial stage - Lead entry into system</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">📅</span>
            <div>
              <h6 class="mb-1">Consultation Scheduled</h6>
              <small class="text-muted">Meeting scheduled - Initial contact and requirement gathering</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">🤝</span>
            <div>
              <h6 class="mb-1">One-on-One</h6>
              <small class="text-muted">Personal meeting - Detailed discussion and product presentation</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">🔁</span>
            <div>
              <h6 class="mb-1">Follow-Up</h6>
              <small class="text-muted">Following up - Regular contact to maintain engagement</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">✅</span>
            <div>
              <h6 class="mb-1">Follow-Up Successful</h6>
              <small class="text-muted">Successful follow-up - Positive response received</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">👤</span>
            <div>
              <h6 class="mb-1">Customer Converted</h6>
              <small class="text-muted">Customer converted - Ready for policy creation</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Alternative Flow Stages -->
      <div class="col-md-6">
        <h6 class="text-danger mb-3">
          <i class="bi bi-arrow-down-circle me-1"></i>Alternative Flow
        </h6>
        <div class="stage-guide-item mb-3 alternative-stage">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">❌</span>
            <div>
              <h6 class="mb-1">Follow-Up Unsuccessful</h6>
              <small class="text-muted">Unsuccessful follow-up - No positive response</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3 alternative-stage">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">🔄</span>
            <div>
              <h6 class="mb-1">Re-Follow Up</h6>
              <small class="text-muted">Re-attempting follow-up - Second attempt to engage</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3 alternative-stage">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">🚫</span>
            <div>
              <h6 class="mb-1">Not Interested</h6>
              <small class="text-muted">Lead not interested - Customer declined the offer</small>
            </div>
          </div>
        </div>
        <div class="stage-guide-item mb-3 alternative-stage">
          <div class="d-flex align-items-start">
            <span class="stage-icon me-2">📁</span>
            <div>
              <h6 class="mb-1">Lead Close - Follow-Up Unsuccessful</h6>
              <small class="text-muted">Lead close - Follow-up unsuccessful</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Lead Status Timeline -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <h5 class="card-title mb-4">
      <i class="bi bi-diagram-3 me-2 text-primary"></i>
      Lead Progress Timeline
    </h5>
    <div class="row">
      <div class="col-md-12">
        <div class="timeline-container">
          <!-- Flow Legend -->
          <div class="mb-4 p-3 bg-light rounded">
            <h6 class="mb-2">
              <i class="bi bi-info-circle me-1"></i>Lead Flow Guide
            </h6>
            <div class="row">
              <div class="col-md-6">
                <small class="text-success">
                  <strong>✅ Success Path:</strong> Lead Generated → Consultation → Discussion → Follow-Up → Success → Converted
                </small>
              </div>
              <div class="col-md-6">
                <small class="text-danger">
                  <strong>❌ Alternative Path:</strong> Follow-Up → Unsuccessful → Re-Follow-Up → Not Interested → Closed
                </small>
              </div>
            </div>
          </div>

          <%
            # Define timeline stages with their proper flow
            timeline_stages = [
              { key: 'lead_generated', title: '🟢 Lead Generated', description: 'Initial lead entry into the system' },
              { key: 'consultation_scheduled', title: '📅 Consultation Scheduled', description: 'First contact and consultation setup' },
              { key: 'one_on_one', title: '🤝 One-on-One Discussion', description: 'Detailed discussion about insurance needs' },
              { key: 'follow_up', title: '🔁 Follow-Up', description: 'Follow-up to gauge customer interest' },
              { key: 'follow_up_successful', title: '✅ Follow-Up Successful', description: 'Customer shows interest and ready to proceed' },
              { key: 'converted', title: '👤 Converted to Customer', description: 'Lead successfully converted to customer' }
            ]

            # Define alternative flow stages that branch after follow_up
            alt_timeline_stages = [
              { key: 'follow_up_unsuccessful', title: '❌ Follow-Up Unsuccessful', description: 'Customer not interested at this time', is_alt_path: true },
              { key: 're_follow_up', title: '🔄 Re-Follow Up', description: 'Additional follow-up attempt', is_alt_path: true },
              { key: 'not_interested', title: '🚫 Not Interested', description: 'Customer explicitly not interested', is_alt_path: true },
              { key: 'lead_closed', title: '📁 Lead Closed', description: 'Lead closed - Follow-up unsuccessful', is_alt_path: true }
            ]

            # All possible stages in proper order
            all_timeline_stages = timeline_stages + alt_timeline_stages

            # Determine which flow path we're on
            successful_path = ['lead_generated', 'consultation_scheduled', 'one_on_one', 'follow_up', 'follow_up_successful', 'converted']
            unsuccessful_path = ['follow_up_unsuccessful', 're_follow_up', 'not_interested', 'lead_closed']

            is_on_unsuccessful_path = unsuccessful_path.include?(@lead.current_stage)

            # Always show all stages, but style them differently based on current path
            display_stages = all_timeline_stages

            # Helper function to check if stage came before current stage
            stage_came_before_proc = lambda do |stage_key, current_stage|
              if successful_path.include?(current_stage)
                current_index = successful_path.index(current_stage)
                stage_index = successful_path.index(stage_key)
                return stage_index && current_index && stage_index < current_index
              elsif unsuccessful_path.include?(current_stage)
                # For unsuccessful path, only show stages up to follow_up as completed
                if stage_key == 'follow_up'
                  return true
                elsif successful_path.include?(stage_key)
                  follow_up_index = successful_path.index('follow_up')
                  stage_index = successful_path.index(stage_key)
                  return stage_index && follow_up_index && stage_index <= follow_up_index
                else
                  current_index = unsuccessful_path.index(current_stage)
                  stage_index = unsuccessful_path.index(stage_key)
                  return stage_index && current_index && stage_index < current_index
                end
              end
              false
            end

            # Helper function to determine completion date
            determine_completion_date_proc = lambda do |stage_key|
              case stage_key
              when 'lead_generated'
                @lead.created_date || @lead.created_at
              when 'consultation_scheduled', 'one_on_one'
                @lead.created_at # Assume same day progression initially
              else
                @lead.stage_updated_at || @lead.created_at
              end
            end
          %>

          <% display_stages.each_with_index do |stage, index| %>
            <%
              # Determine status and date for each stage
              if stage[:key] == @lead.current_stage
                # Current active stage
                status = 'active'
                if @lead.stage_updated_at.present?
                  date_text = "Started on #{@lead.stage_updated_at.strftime('%b %d, %Y')}"
                else
                  date_text = "In Progress"
                end
                status_class = 'text-warning'
              elsif stage_came_before_proc.call(stage[:key], @lead.current_stage)
                # Completed stages
                status = 'completed'
                date = determine_completion_date_proc.call(stage[:key])
                date_text = "Completed on #{date.strftime('%b %d, %Y')}"
                status_class = 'text-success'
              else
                # Future/pending stages or alternative path stages
                status = 'pending'

                # Handle different types of pending stages
                if stage[:is_alt_path]
                  if is_on_unsuccessful_path
                    # Show as possible next steps in alternative path
                    date_text = stage[:key] == 'follow_up_unsuccessful' ? 'Alternative Path Starting Point' : 'Alternative Path'
                    status_class = 'text-danger'
                  else
                    # Show as alternative options
                    date_text = 'Alternative Path (if follow-up unsuccessful)'
                    status_class = 'text-muted'
                  end
                else
                  # Regular pending stages in main flow
                  if is_on_unsuccessful_path && successful_path.include?(stage[:key]) && successful_path.index(stage[:key]) > successful_path.index('follow_up')
                    # These main flow stages are no longer accessible in alternative path
                    date_text = 'No longer accessible (alternative path taken)'
                    status_class = 'text-muted'
                  else
                    date_text = 'Pending'
                    status_class = 'text-muted'
                  end
                end
              end
            %>

            <!-- Timeline Stage -->
            <div class="timeline-item <%= status %> <%= 'alternative-path' if stage[:is_alt_path] %> <%= 'inaccessible' if is_on_unsuccessful_path && successful_path.include?(stage[:key]) && successful_path.index(stage[:key]) > successful_path.index('follow_up') %> <%= 'branching-point' if stage[:key] == 'follow_up' && is_on_unsuccessful_path %>">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h6><%= stage[:title] %></h6>
                <p class="text-muted mb-1"><%= stage[:description] %></p>
                <small class="<%= status_class %>"><%= date_text %></small>

                <!-- Show current path indicator -->
                <% if stage[:key] == @lead.current_stage %>
                  <div class="mt-1">
                    <span class="badge bg-warning text-dark">
                      <i class="bi bi-geo-alt-fill me-1"></i>Current Stage
                    </span>
                  </div>
                <% end %>

                <!-- Show branching indicator for follow-up stage -->
                <% if stage[:key] == 'follow_up' && (status == 'completed' || status == 'active') %>
                  <div class="mt-2">
                    <small class="text-info">
                      <i class="bi bi-diagram-2 me-1"></i>
                      <% if is_on_unsuccessful_path %>
                        Branched to: ❌ Alternative Path
                      <% elsif @lead.follow_up_successful? || @lead.converted? %>
                        Branched to: ✅ Success Path
                      <% else %>
                        Decision Point: Success ✅ or Alternative ❌ Path
                      <% end %>
                    </small>
                  </div>
                <% end %>

                <!-- Show flow direction indicators -->
                <% if stage[:is_alt_path] %>
                  <div class="mt-1">
                    <small class="<%= is_on_unsuccessful_path ? 'text-danger' : 'text-muted' %>">
                      <i class="bi bi-arrow-right me-1"></i>
                      <%= is_on_unsuccessful_path ? 'Active Alternative Flow' : 'Alternative Option' %>
                    </small>
                  </div>
                <% elsif is_on_unsuccessful_path && successful_path.include?(stage[:key]) && successful_path.index(stage[:key]) > successful_path.index('follow_up') %>
                  <div class="mt-1">
                    <small class="text-muted">
                      <i class="bi bi-x-circle me-1"></i>No longer accessible
                    </small>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Row -->
<div class="row">
  <!-- Lead Information -->
  <div class="col-md-8">
    <!-- Customer Type Information -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light border-0">
        <h5 class="mb-0">
          <i class="bi bi-person-check me-2 text-primary"></i>
          Customer Type & Basic Information
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Lead ID</label>
            <div class="fw-bold"><%= @lead.lead_id %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Customer Type</label>
            <div>
              <% if @lead.customer_type.present? %>
                <span class="badge bg-info"><%= @lead.customer_type.humanize %></span>
              <% else %>
                <span class="text-muted">Not specified</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Contact Number</label>
            <div>
              <% if @lead.contact_number.present? %>
                <a href="tel:<%= @lead.contact_number %>" class="text-decoration-none">
                  <%= @lead.contact_number %>
                </a>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Email Address</label>
            <div>
              <% if @lead.email.present? %>
                <a href="mailto:<%= @lead.email %>" class="text-decoration-none">
                  <%= @lead.email %>
                </a>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Individual Customer Details -->
    <% if @lead.individual? %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light border-0">
        <h5 class="mb-0">
          <i class="bi bi-person me-2 text-primary"></i>
          Individual Customer Details
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label text-muted">First Name</label>
            <div class="fw-bold"><%= @lead.first_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label text-muted">Middle Name</label>
            <div><%= @lead.middle_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label text-muted">Last Name</label>
            <div class="fw-bold"><%= @lead.last_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Date of Birth</label>
            <div>
              <% if @lead.birth_date.present? %>
                <%= @lead.birth_date.strftime('%B %d, %Y') %>
                <small class="text-muted">(<%= ((Date.current - @lead.birth_date) / 365).to_i %> years old)</small>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Gender</label>
            <div>
              <% if @lead.gender.present? %>
                <span class="badge bg-secondary"><%= @lead.gender.humanize %></span>
              <% else %>
                <span class="text-muted">Not specified</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Marital Status</label>
            <div>
              <% if @lead.marital_status.present? %>
                <span class="badge bg-info"><%= @lead.marital_status.humanize %></span>
              <% else %>
                <span class="text-muted">Not specified</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">PAN Number</label>
            <div><%= @lead.pan_no.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Birth Place</label>
            <div><%= @lead.birth_place.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Physical Details</label>
            <div>
              <% if @lead.height.present? || @lead.weight.present? %>
                <% if @lead.height.present? %>
                  Height: <strong><%= @lead.height %> ft</strong>
                <% end %>
                <% if @lead.weight.present? %>
                  <%= ', ' if @lead.height.present? %>Weight: <strong><%= @lead.weight %> kg</strong>
                <% end %>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Professional Details -->
        <% if [@lead.education, @lead.business_job, @lead.business_name, @lead.job_name, @lead.occupation, @lead.type_of_duty, @lead.annual_income].any?(&:present?) %>
        <hr class="my-4">
        <h6 class="text-secondary mb-3">Professional Details</h6>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Education</label>
            <div><%= @lead.education.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Business/Job Type</label>
            <div>
              <% if @lead.business_job.present? %>
                <span class="badge bg-primary"><%= @lead.business_job.humanize %></span>
              <% else %>
                <span class="text-muted">Not specified</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Business Name</label>
            <div><%= @lead.business_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Job Name</label>
            <div><%= @lead.job_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Occupation</label>
            <div><%= @lead.occupation.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Type of Duty</label>
            <div><%= @lead.type_of_duty.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-12 mb-3">
            <label class="form-label text-muted">Annual Income</label>
            <div>
              <% if @lead.annual_income.present? %>
                <span class="fw-bold text-success"><%= indian_currency(@lead.annual_income) %></span>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <!-- Corporate Customer Details -->
    <% if @lead.corporate? %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light border-0">
        <h5 class="mb-0">
          <i class="bi bi-building me-2 text-primary"></i>
          Corporate Customer Details
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Company Name</label>
            <div class="fw-bold"><%= @lead.company_name.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Company Email</label>
            <div>
              <% if @lead.email.present? %>
                <a href="mailto:<%= @lead.email %>" class="text-decoration-none">
                  <%= @lead.email %>
                </a>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">PAN Number</label>
            <div><%= @lead.pan_no.presence || 'Not provided' %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">GST Number</label>
            <div><%= @lead.gst_no.presence || 'Not provided' %></div>
          </div>
        </div>
      </div>
    </div>

<% content_for :page_title, "Add General Insurance" %>
<% content_for :page_subtitle, "Easily create and manage general insurance details" %>

<!-- Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <%= link_to admin_other_insurances_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Back to List
    <% end %>
  </div>

  <div class="trust-seal">
    <i class="bi bi-shield-check seal-icon"></i>
    <span>Save Policy</span>
  </div>
</div>

<%= form_with model: [:admin, @other_insurance], local: true, class: "needs-validation", novalidate: true do |form| %>

  <!-- Client Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-person me-2 text-primary"></i>
        Client Details
      </h5>
    </div>
    <div class="card-body">
      <% if @other_insurance.errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Please correct the following errors:</strong>
          <ul class="mb-0 mt-2">
            <% @other_insurance.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :customer_id, "Client Name*", class: "form-label" %>
          <%= form.select :customer_id,
              options_for_select(@customers.map { |c| [c.display_name, c.id] }, @other_insurance.customer_id),
              { prompt: 'Search and select client...' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:customer_id].any?}", required: true, id: "customer_select", data: { placeholder: "Type to search clients..." } } %>
          <% if @other_insurance.errors[:customer_id].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:customer_id].first %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Insurance Details Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-file-text me-2 text-primary"></i>
        Insurance Details
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :insurance_company_id, "Insurance Company*", class: "form-label" %>
          <%= form.select :insurance_company_id,
              options_for_select([['Select Company', '']] + InsuranceCompany.pluck(:name, :id)),
              { prompt: 'Select Company' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:insurance_company_id].any?}", required: true } %>
          <% if @other_insurance.errors[:insurance_company_id].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:insurance_company_id].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :policy_type, "Policy Type*", class: "form-label" %>
          <%= form.select :policy_type,
              options_for_select([
                ['Travel Insurance', 'travel'],
                ['Property Insurance', 'property'],
                ['Cyber Insurance', 'cyber'],
                ['Professional Indemnity', 'professional'],
                ['Directors & Officers', 'directors_officers'],
                ['Marine Insurance', 'marine'],
                ['Credit Insurance', 'credit'],
                ['Other', 'other']
              ]),
              { prompt: 'Select Policy Type' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_type].any?}", required: true } %>
          <% if @other_insurance.errors[:policy_type].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_type].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :policy_number, "Policy Number*", class: "form-label" %>
          <%= form.text_field :policy_number, class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_number].any?}", placeholder: "Enter policy number", required: true %>
          <% if @other_insurance.errors[:policy_number].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_number].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :payment_mode, "Payment Mode*", class: "form-label" %>
          <%= form.select :payment_mode,
              options_for_select([
                ['Yearly', 'yearly'],
                ['Half Yearly', 'half_yearly'],
                ['Quarterly', 'quarterly'],
                ['Monthly', 'monthly'],
                ['Single Premium', 'single']
              ]),
              { prompt: 'Select Payment Mode' },
              { class: "form-control #{'is-invalid' if @other_insurance.errors[:payment_mode].any?}", required: true } %>
          <% if @other_insurance.errors[:payment_mode].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:payment_mode].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :policy_start_date, "Policy Start Date*", class: "form-label" %>
          <%= form.date_field :policy_start_date, class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_start_date].any?}", required: true, id: "policy_start_date" %>
          <% if @other_insurance.errors[:policy_start_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_start_date].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :policy_end_date, "Policy End Date*", class: "form-label" %>
          <%= form.date_field :policy_end_date, class: "form-control #{'is-invalid' if @other_insurance.errors[:policy_end_date].any?}", required: true, id: "policy_end_date" %>
          <% if @other_insurance.errors[:policy_end_date].any? %>
            <div class="invalid-feedback"><%= @other_insurance.errors[:policy_end_date].first %></div>
          <% end %>
        </div>

        <div class="col-md-6 mb-3">
          <%= form.label :policy_booking_date, "Policy Booking Date", class: "form-label" %>
          <%= form.date_field :policy_booking_date, class: "form-control", value: Date.current %>
        </div>

        <div class="col-12 mb-3">
          <%= form.label :note, "Additional Notes", class: "form-label" %>
          <%= form.text_area :note, class: "form-control", rows: 3, placeholder: "Enter any additional notes about the policy..." %>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Section -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-check-circle me-2 text-primary"></i>
        Policy Status
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :status, "Policy Status", class: "form-label" %>
          <%= form.select :status,
              options_for_select([
                ['Active', 'active'],
                ['Expired', 'expired'],
                ['Pending', 'pending'],
                ['Cancelled', 'cancelled']
              ]),
              { selected: 'active' },
              { class: "form-control" } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="card">
    <div class="card-body">
      <div class="d-flex justify-content-between">
        <%= link_to admin_other_insurances_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-x-lg me-1"></i>Cancel
        <% end %>
        <%= form.submit "Create General Insurance", class: "btn btn-primary btn-lg" %>
      </div>
    </div>
  </div>

<% end %>

<!-- jQuery (required for Select2) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Select2 CSS & JS for searchable dropdown -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- Custom styling for enhanced Select2 dropdown -->
<style>
  .select2-container--bootstrap-5 .select2-selection--single {
    height: 38px;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  }

  .select2-container--bootstrap-5 .select2-selection--single:focus-within {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }

  .select2-container--bootstrap-5 .select2-selection__rendered {
    color: #212529;
    line-height: 36px;
    padding-left: 12px;
    font-size: 1rem;
  }

  .select2-container--bootstrap-5 .select2-selection__arrow {
    height: 36px;
    right: 12px;
  }

  .select2-dropdown {
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    margin-top: -1px;
  }

  .select2-container--bootstrap-5 .select2-results__option--highlighted[aria-selected] {
    background-color: #0d6efd;
    color: white;
  }

  .select2-dropdown-large {
    font-size: 1rem;
  }

  .select2-dropdown-large .select2-results__option {
    padding: 12px 16px;
    border-bottom: 1px solid #f8f9fa;
  }

  .select2-dropdown-large .select2-results__option:last-child {
    border-bottom: none;
  }

  /* Required asterisk styling */
  .form-label[for="customer_select"]::after {
    content: " *";
    color: red;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Select2 for searchable client dropdown
  $('#customer_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select client...',
    allowClear: true,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true,
    templateResult: function(option) {
      if (!option.id || option.id === '') {
        return $('<span style="color: #6c757d; font-style: italic;">' + option.text + '</span>');
      }
      return $('<span>' + option.text + '</span>');
    }
  });

  // Auto-set policy end date based on start date (default 1 year)
  document.getElementById('policy_start_date')?.addEventListener('change', function() {
    const startDate = new Date(this.value);
    const endDate = new Date(startDate);
    endDate.setFullYear(endDate.getFullYear() + 1);
    endDate.setDate(endDate.getDate() - 1); // End date is one day before renewal

    document.getElementById('policy_end_date').value = endDate.toISOString().split('T')[0];
  });
});
</script>
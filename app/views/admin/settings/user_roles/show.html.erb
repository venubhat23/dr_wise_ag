<% content_for :page_title, @user_role.display_name %>

<div class="page-header">
  <div class="page-title-wrapper">
    <h1 class="page-title">
      <i class="bi bi-person-circle me-2"></i>
      <%= @user_role.display_name %>
      <% unless @user_role.active? %>
        <span class="badge bg-danger ms-2">Inactive</span>
      <% end %>
    </h1>
    <p class="page-subtitle">Role details and assignments</p>
  </div>
  <div class="page-actions">
    <%= link_to admin_settings_user_roles_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Roles
    <% end %>
    <%= link_to edit_admin_settings_user_role_path(@user_role), class: "btn btn-primary" do %>
      <i class="bi bi-pencil me-1"></i>
      Edit Role
    <% end %>
  </div>
</div>

<div class="row">
  <!-- Role Information -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title mb-0">
          <i class="bi bi-info-circle me-2"></i>
          Role Information
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Role Name</label>
            <div class="fw-medium"><%= @user_role.display_name %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Display Order</label>
            <div class="fw-medium">
              <span class="badge bg-light text-dark"><%= @user_role.display_order %></span>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-muted">Description</label>
          <div class="fw-medium">
            <% if @user_role.description.present? %>
              <%= simple_format(@user_role.description) %>
            <% else %>
              <span class="text-muted fst-italic">No description provided</span>
            <% end %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Status</label>
            <div>
              <% if @user_role.active? %>
                <span class="badge bg-success-soft text-success">
                  <i class="bi bi-check-circle me-1"></i>
                  Active
                </span>
              <% else %>
                <span class="badge bg-danger-soft text-danger">
                  <i class="bi bi-x-circle me-1"></i>
                  Inactive
                </span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Created</label>
            <div class="fw-medium">
              <%= @user_role.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Assigned Users -->
    <div class="card mt-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">
          <i class="bi bi-people me-2"></i>
          Assigned Users
          <span class="badge bg-primary ms-2"><%= @user_role.users.count %></span>
        </h5>
        <% if @user_role.users.any? %>
          <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
              <i class="bi bi-gear"></i>
              Actions
            </button>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#exportUsersModal">
                  <i class="bi bi-download me-2"></i>
                  Export User List
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#bulkActionsModal">
                  <i class="bi bi-lightning me-2"></i>
                  Bulk Actions
                </a>
              </li>
            </ul>
          </div>
        <% end %>
      </div>

      <div class="card-body">
        <% if @user_role.users.any? %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>User</th>
                  <th>Email</th>
                  <th>User Type</th>
                  <th>Status</th>
                  <th>Last Activity</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @user_role.users.includes(:roles).order(:first_name, :last_name).each do |user| %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="user-avatar me-3">
                          <div class="avatar-circle bg-primary text-white">
                            <%= user.first_name&.first&.upcase || user.email.first.upcase %>
                          </div>
                        </div>
                        <div>
                          <div class="fw-medium"><%= user.display_name %></div>
                          <small class="text-muted">
                            ID: #<%= user.id %>
                          </small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <%= user.email %>
                    </td>
                    <td>
                      <span class="badge bg-info-soft text-info">
                        <%= user.user_type&.titleize || 'Not Set' %>
                      </span>
                    </td>
                    <td>
                      <% if user.status %>
                        <span class="badge bg-success-soft text-success">
                          <i class="bi bi-check-circle me-1"></i>
                          Active
                        </span>
                      <% else %>
                        <span class="badge bg-danger-soft text-danger">
                          <i class="bi bi-x-circle me-1"></i>
                          Inactive
                        </span>
                      <% end %>
                    </td>
                    <td>
                      <small class="text-muted">
                        <%= user.updated_at.strftime("%b %d, %Y") %>
                      </small>
                    </td>
                    <td class="text-end">
                      <%= link_to admin_user_path(user), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      <%= link_to edit_admin_user_path(user), class: "btn btn-sm btn-outline-warning" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="empty-state text-center py-4">
            <div class="empty-icon mb-3">
              <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
            </div>
            <h6 class="text-muted">No users assigned</h6>
            <p class="text-muted mb-3">This role is not currently assigned to any users.</p>
            <%= link_to admin_users_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-plus-lg me-1"></i>
              Manage Users
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Actions Sidebar -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h6 class="card-title mb-0">
          <i class="bi bi-lightning-charge me-2"></i>
          Quick Actions
        </h6>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <%= link_to edit_admin_settings_user_role_path(@user_role), class: "btn btn-primary btn-sm" do %>
            <i class="bi bi-pencil me-2"></i>
            Edit Role Details
          <% end %>

          <%= link_to toggle_status_admin_settings_user_role_path(@user_role),
              method: :patch,
              class: "btn btn-#{@user_role.active? ? 'warning' : 'success'} btn-sm",
              confirm: "Are you sure you want to #{@user_role.active? ? 'deactivate' : 'activate'} this role?" do %>
            <i class="bi bi-#{@user_role.active? ? 'pause' : 'play'} me-2"></i>
            <%= @user_role.active? ? 'Deactivate' : 'Activate' %> Role
          <% end %>

          <%= link_to admin_users_path, class: "btn btn-outline-secondary btn-sm" do %>
            <i class="bi bi-people me-2"></i>
            Manage Users
          <% end %>

          <hr class="my-3">

          <%= link_to admin_settings_user_role_path(@user_role),
              method: :delete,
              class: "btn btn-outline-danger btn-sm",
              confirm: "Are you sure you want to delete this role? This action cannot be undone." do %>
            <i class="bi bi-trash me-2"></i>
            Delete Role
          <% end %>
        </div>
      </div>
    </div>

    <!-- Role Statistics -->
    <div class="card mt-4">
      <div class="card-header">
        <h6 class="card-title mb-0">
          <i class="bi bi-graph-up me-2"></i>
          Role Statistics
        </h6>
      </div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-primary fw-bold h4">
                <%= @user_role.users.where(status: true).count %>
              </div>
              <div class="stat-label text-muted small">Active Users</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-secondary fw-bold h4">
                <%= @user_role.users.where(status: false).count %>
              </div>
              <div class="stat-label text-muted small">Inactive Users</div>
            </div>
          </div>
        </div>
        <hr class="my-3">
        <div class="text-center">
          <div class="stat-item">
            <div class="stat-value text-info fw-bold h5">
              <%= number_to_percentage((@user_role.users.count.to_f / User.count * 100), precision: 1) %>
            </div>
            <div class="stat-label text-muted small">Of Total Users</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="card mt-4">
      <div class="card-header">
        <h6 class="card-title mb-0">
          <i class="bi bi-clock-history me-2"></i>
          Recent Activity
        </h6>
      </div>
      <div class="card-body">
        <div class="activity-item">
          <div class="activity-time text-muted small">
            <%= @user_role.updated_at.strftime("%B %d at %I:%M %p") %>
          </div>
          <div class="activity-desc">
            Role information last updated
          </div>
        </div>
        <hr class="my-2">
        <div class="activity-item">
          <div class="activity-time text-muted small">
            <%= @user_role.created_at.strftime("%B %d at %I:%M %p") %>
          </div>
          <div class="activity-desc">
            Role created
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .user-avatar .avatar-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .bg-success-soft {
    background-color: rgba(25, 135, 84, 0.1);
  }

  .bg-danger-soft {
    background-color: rgba(220, 53, 69, 0.1);
  }

  .bg-info-soft {
    background-color: rgba(13, 202, 240, 0.1);
  }

  .empty-state {
    padding: 2rem;
  }

  .stat-item {
    padding: 0.5rem 0;
  }

  .activity-item {
    padding: 0.5rem 0;
  }
</style>
                        </td>
                        <td style="font-weight: bold; color: #f093fb; font-size: 1.05rem;"><strong>${source.total}</strong></td>
                        <td style="font-weight: bold; color: #11998e; font-size: 1.05rem;"><strong>${source.converted}</strong></td>
                        <td><span class="badge ${source.rate > 30 ? 'bg-success' : source.rate > 15 ? 'bg-warning text-dark' : 'bg-danger'}" style="font-weight: bold; font-size: 0.95rem; padding: 0.4rem 0.6rem;">${source.rate}%</span></td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          ` : ''}
        `;
      } else {
        content.innerHTML = '<div class="alert alert-danger">Error loading lead conversion data</div>';
      }
    })
    .catch(error => {
      loading.style.display = 'none';
      content.style.display = 'block';
      content.innerHTML = '<div class="alert alert-danger">Error loading data. Please try again.</div>';
      console.error('Error:', error);
    });
}

function loadAvgPolicyValueData(content, loading) {

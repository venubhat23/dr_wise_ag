            <!-- Main Document System -->
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-transparent border-0">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="mb-0 text-primary">
                    <i class="bi bi-folder2-open me-2"></i>
                    Current Policy Documents
                  </h5>
                  <span class="badge bg-primary">
                    <%= total_documents %> <%= 'Document'.pluralize(total_documents) %>
                  </span>
                </div>
              </div>
              <div class="card-body">
                <% all_documents = [] %>

                <!-- Collect all documents -->
                <% if @motor_insurance.uploaded_documents.any? %>
                  <% @motor_insurance.uploaded_documents.each do |doc| %>
                    <% all_documents << { doc: doc, type: 'uploaded', label: doc.human_document_type } %>
                  <% end %>
                <% end %>

                <% if @motor_insurance.policy_documents.attached? %>
                  <% @motor_insurance.policy_documents.each do |doc| %>
                    <% all_documents << { doc: doc, type: 'policy', label: 'Policy Document' } %>
                  <% end %>
                <% end %>

                <% if @motor_insurance.documents.attached? %>
                  <% @motor_insurance.documents.each do |doc| %>
                    <% all_documents << { doc: doc, type: 'additional', label: 'Additional Document' } %>
                  <% end %>
                <% end %>

                <% if all_documents.any? %>

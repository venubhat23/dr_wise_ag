<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">User Roles Management</h2>
    <p class="text-muted mb-0">Manage system user roles and access levels</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_settings_user_role_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Role
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Roles</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@user_roles.count) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-person-gear text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Roles</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@user_roles.select(&:active?).count) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-check-circle text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Assigned Users</h6>
            <h3 class="mb-0 text-info"><%= number_with_delimiter(@user_roles.sum { |role| role.users.count }) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-people text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Inactive Roles</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@user_roles.reject(&:active?).count) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-pause-circle text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_settings_user_roles_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end", id: "search_form" do |form| %>
      <!-- Search -->
      <div class="flex-grow-1 min-width-250">
        <%= form.text_field :search, placeholder: "Search by role name or description...",
                           value: params[:search],
                           class: "form-control",
                           id: "search_input" %>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-2">
        <%= link_to "Clear", admin_settings_user_roles_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- User Roles List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">User Roles List</h5>
  </div>
  <div class="card-body p-0">
    <% if @user_roles.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Role Details</th>
              <th class="border-0">Description</th>
              <th class="border-0">Order</th>
              <th class="border-0">Users</th>
              <th class="border-0">Status</th>
              <th class="border-0">Created</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @user_roles.each do |role| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                      <i class="bi bi-person-gear text-primary"></i>
                    </div>
                    <div>
                      <h6 class="mb-1"><%= role.display_name %></h6>
                      <small class="text-muted">ID: <%= role.name.parameterize %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <div>
                    <%= role.description.present? ? truncate(role.description, length: 50) : "No description available" %>
                  </div>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary">
                    <i class="bi bi-sort-numeric-up me-1"></i>
                    <%= role.display_order %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-info-subtle text-info">
                    <i class="bi bi-people me-1"></i>
                    <%= pluralize(role.users.count, 'user') %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-<%= role.active? ? 'success' : 'secondary' %>-subtle text-<%= role.active? ? 'success' : 'secondary' %>">
                    <i class="bi bi-<%= role.active? ? 'check-circle' : 'pause-circle' %> me-1"></i>
                    <%= role.active? ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td>
                  <div>
                    <div><%= role.created_at.strftime("%b %d, %Y") %></div>
                    <small class="text-muted"><%= time_ago_in_words(role.created_at) %> ago</small>
                  </div>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to admin_settings_user_role_path(role), class: "btn btn-sm btn-outline-primary", title: "View Details" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_settings_user_role_path(role), class: "btn btn-sm btn-outline-warning", title: "Edit Role" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to toggle_status_admin_settings_user_role_path(role),
                        method: :patch,
                        class: "btn btn-sm btn-outline-#{role.active? ? 'secondary' : 'success'}",
                        title: role.active? ? 'Deactivate' : 'Activate',
                        data: {
                          confirm: "Are you sure you want to #{role.active? ? 'deactivate' : 'activate'} this role?",
                          turbo_method: :patch
                        } do %>
                      <i class="bi bi-#{role.active? ? 'pause-circle' : 'play-circle'}"></i>
                    <% end %>
                    <%= button_to admin_settings_user_role_path(role),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        title: "Delete Role",
                        data: {
                          confirm: "Are you sure you want to delete this role? This action cannot be undone."
                        },
                        form: { style: "display: inline;" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-person-gear fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No user roles found</h5>
        <p class="text-muted mb-3">
          <% if params[:search].present? %>
            No roles match your search criteria.
            <%= link_to "View all roles", admin_settings_user_roles_path, class: "text-decoration-none" %>.
          <% else %>
            Start by creating your first user role to manage system access levels.
          <% end %>
        </p>
        <%= link_to new_admin_settings_user_role_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i>
          <%= params[:search].present? ? "Add New Role" : "Add First Role" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
.min-width-250 {
  min-width: 250px;
}

/* Custom modal backdrop fix for consistency with other pages */
.modal-backdrop {
  background-color: rgba(0, 0, 0, 0.8) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('search_input');
  const searchForm = document.getElementById('search_form');
  let searchTimeout;

  // Auto-search on typing
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      const searchValue = this.value;

      searchTimeout = setTimeout(() => {
        if (searchValue.length >= 3 || searchValue.length === 0) {
          searchForm.submit();
        }
      }, 500); // 500ms delay after typing stops
    });
  }
});
</script>
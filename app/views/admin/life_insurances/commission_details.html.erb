<% content_for :page_title, "Commission Details - #{@life_insurance.policy_number}" %>

<div class="page-header">
  <div class="page-title-wrapper">
    <h1 class="page-title">
      <i class="bi bi-graph-up-arrow me-2 text-primary"></i>
      Commission Configuration
    </h1>
    <p class="page-subtitle">
      <span class="badge bg-primary me-2"><%= @life_insurance.policy_number %></span>
      <%= @life_insurance.customer&.display_name %> |
      <span class="text-success fw-bold"><%= indian_currency(@life_insurance.net_premium) %></span>
    </p>
  </div>
  <div class="page-actions">
    <%= link_to admin_life_insurances_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Life Insurances
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <!-- Policy Overview Card -->
    <div class="card mb-4 border-0 shadow-sm">
      <div class="card-header bg-gradient-primary text-white">
        <h5 class="card-title mb-0">
          <i class="bi bi-shield-check me-2"></i>
          Policy Overview
        </h5>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="bi bi-file-text text-primary"></i>
              </div>
              <div class="stat-content">
                <label class="stat-label">Policy Number</label>
                <div class="stat-value"><%= @life_insurance.policy_number %></div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="bi bi-building text-info"></i>
              </div>
              <div class="stat-content">
                <label class="stat-label">Insurance Company</label>
                <div class="stat-value"><%= @life_insurance.insurance_company_name %></div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="bi bi-umbrella text-warning"></i>
              </div>
              <div class="stat-content">
                <label class="stat-label">Sum Insured</label>
                <div class="stat-value text-success"><%= indian_currency(@life_insurance.sum_insured) %></div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="bi bi-currency-rupee text-success"></i>
              </div>
              <div class="stat-content">
                <label class="stat-label">Net Premium</label>
                <div class="stat-value fw-bold text-primary"><%= indian_currency(@life_insurance.net_premium) %></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Commission Configuration Card -->
    <div class="card mb-4 border-0 shadow-sm">
      <div class="card-header bg-gradient-success text-white">
        <h5 class="card-title mb-0">
          <i class="bi bi-calculator-fill me-2"></i>
          Saved Commission Configuration
        </h5>
        <small class="opacity-75">Database values for this policy</small>
      </div>
      <div class="card-body">

        <!-- Main Income Configuration -->
        <div class="commission-section mb-4">
          <div class="section-header">
            <h6 class="section-title">
              <i class="bi bi-wallet2 text-primary"></i>
              Main Income
            </h6>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="commission-card bg-primary-light">
                <div class="commission-label">Percentage</div>
                <div class="commission-value text-primary">
                  <span class="value-large"><%= @life_insurance.main_income_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="commission-card bg-success-light">
                <div class="commission-label">Amount</div>
                <div class="commission-value text-success">
                  <span class="value-large">₹<%= number_with_delimiter(@life_insurance.main_income_amount&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Affiliate Commission -->
        <div class="commission-section mb-4">
          <div class="section-header">
            <h6 class="section-title">
              <i class="bi bi-person-check text-info"></i>
              Affiliate Commission
            </h6>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <div class="commission-card bg-info-light">
                <div class="commission-label">Percentage</div>
                <div class="commission-value text-info">
                  <span class="value-medium"><%= @life_insurance.sub_agent_commission_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">Amount</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.sub_agent_commission_amount&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-warning-light">
                <div class="commission-label">TDS %</div>
                <div class="commission-value text-warning">
                  <span class="value-medium"><%= @life_insurance.sub_agent_tds_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">After TDS</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.sub_agent_after_tds_value&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Ambassador Commission -->
        <div class="commission-section mb-4">
          <div class="section-header">
            <h6 class="section-title">
              <i class="bi bi-truck text-primary"></i>
              Ambassador Commission
            </h6>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <div class="commission-card bg-primary-light">
                <div class="commission-label">Percentage</div>
                <div class="commission-value text-primary">
                  <span class="value-medium"><%= @life_insurance.ambassador_commission_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">Amount</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.ambassador_commission_amount&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-warning-light">
                <div class="commission-label">TDS %</div>
                <div class="commission-value text-warning">
                  <span class="value-medium"><%= @life_insurance.ambassador_tds_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">After TDS</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.ambassador_after_tds_value&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Investor Commission -->
        <div class="commission-section mb-4">
          <div class="section-header">
            <h6 class="section-title">
              <i class="bi bi-graph-up-arrow text-warning"></i>
              Investor Commission
            </h6>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <div class="commission-card bg-warning-light">
                <div class="commission-label">Percentage</div>
                <div class="commission-value text-warning">
                  <span class="value-medium"><%= @life_insurance.investor_commission_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">Amount</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.investor_commission_amount&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-warning-light">
                <div class="commission-label">TDS %</div>
                <div class="commission-value text-warning">
                  <span class="value-medium"><%= @life_insurance.investor_tds_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="commission-card bg-success-light">
                <div class="commission-label">After TDS</div>
                <div class="commission-value text-success">
                  <span class="value-medium">₹<%= number_with_delimiter(@life_insurance.investor_after_tds_value&.round(2) || 0) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Company Expenses -->
        <div class="commission-section mb-4">
          <div class="section-header">
            <h6 class="section-title">
              <i class="bi bi-building text-danger"></i>
              Company Expenses
            </h6>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="commission-card bg-danger-light">
                <div class="commission-label">Percentage</div>
                <div class="commission-value text-danger">
                  <span class="value-medium"><%= @life_insurance.company_expenses_percentage&.round(2) || 0 %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="commission-card bg-danger-light">
                <div class="commission-label">Amount</div>
                <div class="commission-value text-danger">
                  <span class="value-medium">₹<%= number_with_delimiter(((@life_insurance.net_premium || 0) * (@life_insurance.company_expenses_percentage || 0) / 100).round(2)) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <!-- Profit Summary Card -->
    <div class="card mb-4 border-0 shadow-sm">
      <div class="card-header bg-gradient-warning text-dark">
        <h5 class="card-title mb-0">
          <i class="bi bi-bar-chart-line me-2"></i>
          Profit Analysis
        </h5>
        <small class="opacity-75">Based on saved configuration</small>
      </div>
      <div class="card-body">
        <div class="profit-step">
          <div class="step-icon text-primary">
            <i class="bi bi-plus-circle-fill"></i>
          </div>
          <div class="step-content">
            <div class="step-label">Main Income</div>
            <div class="step-value text-primary">
              ₹<%= number_with_delimiter(@life_insurance.main_income_amount&.round(2) || 0) %>
            </div>
            <div class="step-formula">
              <%= @life_insurance.main_income_percentage&.round(1) || 0 %>% of <%= indian_currency(@life_insurance.net_premium) %>
            </div>
          </div>
        </div>

        <div class="profit-step">
          <div class="step-icon text-warning">
            <i class="bi bi-dash-circle-fill"></i>
          </div>
          <div class="step-content">
            <div class="step-label">Total Distribution</div>
            <% total_distribution = ((@life_insurance.sub_agent_commission_amount || 0) + (@life_insurance.ambassador_commission_amount || 0) + (@life_insurance.investor_commission_amount || 0)).round(2) %>
            <div class="step-value text-warning">
              -₹<%= number_with_delimiter(total_distribution) %>
            </div>
            <div class="step-formula">
              <% total_percentage = ((@life_insurance.sub_agent_commission_percentage || 0) + (@life_insurance.ambassador_commission_percentage || 0) + (@life_insurance.investor_commission_percentage || 0)).round(1) %>
              <%= total_percentage %>% (Affiliate + Ambassador + Investor)
            </div>
          </div>
        </div>

        <div class="profit-step">
          <div class="step-icon text-danger">
            <i class="bi bi-dash-circle-fill"></i>
          </div>
          <div class="step-content">
            <div class="step-label">Company Expenses</div>
            <% company_expenses = ((@life_insurance.net_premium || 0) * (@life_insurance.company_expenses_percentage || 0) / 100).round(2) %>
            <div class="step-value text-danger">
              -₹<%= number_with_delimiter(company_expenses) %>
            </div>
            <div class="step-formula">
              <%= @life_insurance.company_expenses_percentage&.round(1) || 0 %>% of Net Premium
            </div>
          </div>
        </div>

        <hr class="my-4">

        <% final_profit = (@life_insurance.profit_amount || 0).round(2) %>
        <% profit_class = final_profit >= 0 ? 'bg-success' : 'bg-danger' %>
        <% profit_icon = final_profit >= 0 ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %>

        <div class="profit-result <%= profit_class %> text-white p-4 rounded-3">
          <div class="text-center">
            <i class="<%= profit_icon %> fs-1 mb-2 opacity-75"></i>
            <div class="result-label">Final Profit</div>
            <div class="result-value">
              ₹<%= number_with_delimiter(final_profit) %>
            </div>
            <div class="result-percentage">
              <%= (@life_insurance.profit_percentage&.round(2) || 0) %>% of Net Premium
            </div>
          </div>
        </div>

        <div class="mt-3">
          <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            Profit = Main Income - Total Distribution - Company Expenses
          </small>
        </div>
      </div>
    </div>

    <!-- Team Information Card -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-gradient-info text-white">
        <h5 class="card-title mb-0">
          <i class="bi bi-people-fill me-2"></i>
          Team Members
        </h5>
        <small class="opacity-75">Associated with this policy</small>
      </div>
      <div class="card-body">
        <div class="team-member mb-3">
          <div class="team-icon">
            <i class="bi bi-person-badge text-info"></i>
          </div>
          <div class="team-info">
            <div class="team-role">Affiliate</div>
            <div class="team-name">
              <%= @life_insurance.sub_agent ? @life_insurance.sub_agent.display_name : 'Self' %>
            </div>
          </div>
        </div>

        <div class="team-member mb-3">
          <div class="team-icon">
            <i class="bi bi-truck text-primary"></i>
          </div>
          <div class="team-info">
            <div class="team-role">Ambassador</div>
            <div class="team-name">
              <%= @life_insurance.distributor ? @life_insurance.distributor.display_name : 'Not Assigned' %>
            </div>
          </div>
        </div>

        <div class="team-member">
          <div class="team-icon">
            <i class="bi bi-graph-up text-warning"></i>
          </div>
          <div class="team-info">
            <div class="team-role">Investor</div>
            <div class="team-name">
              <%= @life_insurance.investor ? @life_insurance.investor.display_name : 'Not Assigned' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Gradient backgrounds */
  .bg-gradient-primary {
    background: linear-gradient(135deg, #007bff, #0056b3);
  }

  .bg-gradient-success {
    background: linear-gradient(135deg, #28a745, #20c997);
  }

  .bg-gradient-warning {
    background: linear-gradient(135deg, #ffc107, #fd7e14);
  }

  .bg-gradient-info {
    background: linear-gradient(135deg, #17a2b8, #138496);
  }

  /* Card styling */
  .card {
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.1) !important;
  }

  /* Stat cards in overview */
  .stat-card {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 10px;
    border-left: 4px solid #007bff;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    background: #e9ecef;
    transform: translateX(5px);
  }

  .stat-icon {
    margin-right: 1rem;
  }

  .stat-icon i {
    font-size: 1.5rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #6c757d;
    margin-bottom: 0.25rem;
    font-weight: 500;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: #212529;
  }

  /* Commission sections */
  .commission-section {
    margin-bottom: 2rem;
  }

  .section-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e9ecef;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #495057;
    margin: 0;
    display: flex;
    align-items: center;
  }

  .section-title i {
    margin-right: 0.75rem;
    font-size: 1.25rem;
  }

  /* Commission cards */
  .commission-card {
    padding: 1.25rem;
    border-radius: 10px;
    text-align: center;
    border: 1px solid #e9ecef;
    transition: all 0.3s ease;
    height: 100%;
  }

  .commission-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .commission-label {
    font-size: 0.85rem;
    color: #6c757d;
    margin-bottom: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .commission-value {
    font-weight: 700;
    margin: 0;
  }

  .value-large {
    font-size: 1.75rem;
  }

  .value-medium {
    font-size: 1.25rem;
  }

  /* Light background variants */
  .bg-primary-light {
    background-color: rgba(0, 123, 255, 0.1);
    border-color: rgba(0, 123, 255, 0.2);
  }

  .bg-success-light {
    background-color: rgba(40, 167, 69, 0.1);
    border-color: rgba(40, 167, 69, 0.2);
  }

  .bg-info-light {
    background-color: rgba(23, 162, 184, 0.1);
    border-color: rgba(23, 162, 184, 0.2);
  }

  .bg-warning-light {
    background-color: rgba(255, 193, 7, 0.1);
    border-color: rgba(255, 193, 7, 0.2);
  }

  .bg-danger-light {
    background-color: rgba(220, 53, 69, 0.1);
    border-color: rgba(220, 53, 69, 0.2);
  }

  /* Profit analysis styling */
  .profit-step {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .profit-step:hover {
    background: #e9ecef;
  }

  .step-icon {
    margin-right: 1rem;
    margin-top: 0.25rem;
  }

  .step-icon i {
    font-size: 1.25rem;
  }

  .step-content {
    flex: 1;
  }

  .step-label {
    font-size: 0.9rem;
    color: #6c757d;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .step-value {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .step-formula {
    font-size: 0.85rem;
    color: #6c757d;
    font-style: italic;
  }

  /* Profit result styling */
  .profit-result {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .result-label {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    opacity: 0.9;
  }

  .result-value {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .result-percentage {
    font-size: 1rem;
    opacity: 0.9;
  }

  /* Team member styling */
  .team-member {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 10px;
    border-left: 4px solid #007bff;
    transition: all 0.3s ease;
  }

  .team-member:hover {
    background: #e9ecef;
    transform: translateX(5px);
  }

  .team-icon {
    margin-right: 1rem;
  }

  .team-icon i {
    font-size: 1.5rem;
  }

  .team-info {
    flex: 1;
  }

  .team-role {
    font-size: 0.8rem;
    color: #6c757d;
    margin-bottom: 0.25rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .team-name {
    font-size: 1rem;
    font-weight: 600;
    color: #212529;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .commission-card {
      margin-bottom: 1rem;
    }

    .profit-step {
      flex-direction: column;
      text-align: center;
    }

    .step-icon {
      margin: 0 0 1rem 0;
    }

    .value-large {
      font-size: 1.5rem;
    }

    .value-medium {
      font-size: 1.1rem;
    }
  }
</style>

<!-- No JavaScript needed - displaying static database values -->
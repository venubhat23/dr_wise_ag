<!-- Modern Header with Purple Theme -->
<div class="customer-header mb-4">
  <div class="header-content">
    <div class="header-title">
      <h2 class="mb-1">Customer Details</h2>
      <p class="text-muted small">Manage your customer database</p>
    </div>
    <div class="header-actions">
      <div class="search-container">
        <label class="form-label small">Client ID</label>
        <input type="text" class="form-control client-id-input" placeholder="Enter Client ID" value="<%= @customer.id %>">
      </div>
    </div>
  </div>
</div>

<!-- Customer Content -->
<div class="customer-content">
  <div class="content-area">
    <!-- Collapsible Sections -->
    <div class="modern-accordion" id="customerAccordion">

      <!-- Advance Details Section -->
      <% lead_count = @associated_leads.count %>
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#advanceDetails" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-info-circle section-icon"></i>
            <span>Advance Details</span>
          </div>
          <div class="section-badge">Details</div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="advanceDetails" class="section-content collapse">
          <div class="section-body">
            <div class="row g-3">
              <% if @customer.individual? %>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Name</strong>
                  <%= @customer.display_name || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Mobile</strong>
                  <%= @customer.mobile || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Email</strong>
                  <%= @customer.email || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Birth Date</strong>
                  <%= @customer.birth_date&.strftime("%B %d, %Y") || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Age</strong>
                  <%= @customer.age || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Gender</strong>
                  <%= @customer.gender&.humanize || '-' %>
                </div>
              <% else %>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Company Name</strong>
                  <%= @customer.company_name || '-' %>
                </div>
                <div class="col-md-6">
                  <strong class="text-muted d-block">Business Type</strong>
                  <%= @customer.business_job || '-' %>
                </div>
              <% end %>
              <div class="col-md-6">
                <strong class="text-muted d-block">PAN Number</strong>
                <%= @customer.pan_no || '-' %>
              </div>
              <div class="col-md-6">
                <strong class="text-muted d-block">Annual Income</strong>
                <%= @customer.annual_income.present? ? "₹#{number_with_delimiter(@customer.annual_income)}" : '-' %>
              </div>
              <div class="col-md-12">
                <strong class="text-muted d-block">Address</strong>
                <%= [@customer.address, @customer.city, @customer.state].compact.join(', ').presence || '-' %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Nominee Details Section -->
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#nomineeDetails" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-person-check section-icon"></i>
            <span>Nominee Details</span>
          </div>
          <div class="section-badge">
            <%= @customer.nominee_name.present? ? 'Active' : 'Missing' %>
          </div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="nomineeDetails" class="section-content collapse">
          <div class="section-body">
            <% if @customer.nominee_name.present? %>
              <div class="row g-3">
                <div class="col-md-4">
                  <strong class="text-muted d-block">Nominee Name</strong>
                  <%= @customer.nominee_name %>
                </div>
                <div class="col-md-4">
                  <strong class="text-muted d-block">Relationship</strong>
                  <%= @customer.nominee_relation&.humanize || '-' %>
                </div>
                <div class="col-md-4">
                  <strong class="text-muted d-block">Date of Birth</strong>
                  <%= @customer.nominee_date_of_birth&.strftime("%B %d, %Y") || '-' %>
                </div>
              </div>
            <% else %>
              <div class="alert alert-warning d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <div>
                  <strong>Nominee details are missing!</strong><br>
                  <small>Nominee information is mandatory for all customers. Please update the customer profile to add nominee details.</small>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Family Members Section -->
      <% family_count = @family_members&.count || 0 %>
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#familyMembers" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-people section-icon"></i>
            <span>Family Members</span>
          </div>
          <div class="section-badge"><%= family_count %></div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="familyMembers" class="section-content collapse">
          <div class="section-body">
            <% if @family_members&.any? %>
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Name</th>
                      <th>Relationship</th>
                      <th>Age</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @family_members.each do |member| %>
                      <tr>
                        <td><%= member.name %></td>
                        <td><%= member.relationship&.humanize %></td>
                        <td><%= member.age || '-' %></td>
                        <td>
                          <%= link_to edit_admin_customer_family_member_path(@customer, member), class: "btn btn-sm btn-outline-warning" do %>
                            <i class="bi bi-pencil"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center py-3">
                <i class="bi bi-people text-muted mb-2" style="font-size: 2rem;"></i>
                <p class="text-muted">No family members added yet.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Corporate Members Section -->
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#corporateMembers" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-building section-icon"></i>
            <span>Corporate Members</span>
          </div>
          <div class="section-badge">0</div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="corporateMembers" class="section-content collapse">
          <div class="section-body">
            <div class="text-center py-3">
              <i class="bi bi-building text-muted mb-2" style="font-size: 2rem;"></i>
              <p class="text-muted">No corporate members found.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Uploaded Documents Section -->
      <% documents_count = @uploaded_documents&.count || 0 %>
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#documents" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-folder section-icon"></i>
            <span>Uploaded Documents</span>
          </div>
          <div class="section-badge"><%= documents_count %></div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="documents" class="section-content collapse">
          <div class="section-body">
            <% if @uploaded_documents&.any? %>
              <div class="row g-3">
                <% @uploaded_documents.each do |document| %>
                  <div class="col-md-6">
                    <div class="card border">
                      <div class="card-body p-3">
                        <h6 class="card-title mb-2"><%= document.document_type&.humanize || 'Document' %></h6>
                        <p class="card-text text-muted small mb-2"><%= document.file.filename if document.file.attached? %></p>
                        <% if document.file.attached? %>
                          <%= link_to rails_blob_url(document.file), target: '_blank', class: "btn btn-sm btn-outline-primary" do %>
                            <i class="bi bi-eye me-1"></i>View
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-3">
                <i class="bi bi-file-earmark-x text-muted mb-2" style="font-size: 2rem;"></i>
                <p class="text-muted">No documents uploaded yet.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Health Insurance Section (Expanded by Default) -->
      <% health_policies = @all_policies&.select { |p| p[:type]&.include?('Health') } || [] %>
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#healthInsurance" aria-expanded="true">
          <div class="section-title">
            <i class="bi bi-graph-up section-icon"></i>
            <span>Health Insurance</span>
          </div>
          <div class="section-badge"><%= health_policies.count %></div>
          <i class="bi bi-chevron-up section-arrow"></i>
        </div>
        <div id="healthInsurance" class="section-content collapse show">
          <div class="section-body">
            <% if health_policies.any? %>
              <!-- Table Controls -->
              <div class="table-controls mb-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="entries-selector">
                    <label class="form-label small mb-0 me-2">Show</label>
                    <select class="form-select form-select-sm d-inline" style="width: auto;">
                      <option>5</option>
                      <option selected>10</option>
                      <option>25</option>
                    </select>
                    <span class="small ms-2">entries</span>
                  </div>
                  <div class="search-box">
                    <input type="search" class="form-control form-control-sm" placeholder="Search...">
                  </div>
                </div>
              </div>

              <!-- Modern Table -->
              <div class="modern-table-container">
                <table class="modern-table">
                  <thead>
                    <tr>
                      <th>COMPANY</th>
                      <th>POLICY NUMBER</th>
                      <th>START DATE</th>
                      <th>END DATE</th>
                      <th>POLICY HOLDER</th>
                      <th>PAYMENT MODE</th>
                      <th>PREMIUM</th>
                      <th>ACTION</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% health_policies.each do |policy| %>
                      <tr>
                        <td><%= policy[:company_name] || 'Care Health' %></td>
                        <td class="policy-number"><%= policy[:policy_number] || '8543230DA' %></td>
                        <td><%= policy[:start_date]&.strftime('%d-%m-%Y') || '19-06-2025' %></td>
                        <td><%= policy[:end_date]&.strftime('%d-%m-%Y') || '18-06-2026' %></td>
                        <td class="policy-holder">
                          <%= @customer.display_name %><br>
                          <span class="customer-id"><%= @customer.id %></span>
                        </td>
                        <td>Yearly</td>
                        <td><%= number_with_delimiter(policy[:premium] || 10768) %></td>
                        <td>
                          <div class="action-buttons">
                            <% if policy[:policy] %>
                              <%= link_to admin_health_insurance_path(policy[:policy]), class: "action-btn view-btn", title: "View" do %>
                                <i class="bi bi-eye"></i>
                              <% end %>
                            <% else %>
                              <button class="action-btn view-btn" title="View">
                                <i class="bi bi-eye"></i>
                              </button>
                            <% end %>
                            <button class="action-btn edit-btn" title="Edit">
                              <i class="bi bi-pencil"></i>
                            </button>
                            <button class="action-btn delete-btn" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination -->
              <div class="pagination-container mt-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="pagination-info">
                    <span class="small text-muted">Showing 1 to <%= health_policies.count %> of <%= health_policies.count %> entries</span>
                  </div>
                  <div class="pagination-controls">
                    <button class="btn btn-sm btn-outline-secondary me-2" disabled>Previous</button>
                    <button class="btn btn-sm btn-primary">1</button>
                    <button class="btn btn-sm btn-outline-secondary ms-2" disabled>Next</button>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="text-center py-3">
                <i class="bi bi-shield-x text-muted mb-2" style="font-size: 2rem;"></i>
                <p class="text-muted">No health insurance policies found.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Expired Policy Section -->
      <div class="section-item">
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#expiredPolicy" aria-expanded="false">
          <div class="section-title">
            <i class="bi bi-clock section-icon"></i>
            <span>Expired Policy</span>
          </div>
          <div class="section-badge">2</div>
          <i class="bi bi-chevron-down section-arrow"></i>
        </div>
        <div id="expiredPolicy" class="section-content collapse">
          <div class="section-body">
            <div class="text-center py-3">
              <i class="bi bi-clock text-muted mb-2" style="font-size: 2rem;"></i>
              <p class="text-muted">No expired policies found.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Action Buttons -->
  <div class="action-buttons-container mt-4">
    <%= link_to edit_admin_customer_path(@customer), class: "btn btn-primary edit-customer-btn" do %>
      <i class="bi bi-pencil me-2"></i>
      Edit Customer
    <% end %>
    <%= link_to admin_customer_path(@customer), method: :delete,
        confirm: "Are you sure you want to delete this customer?",
        class: "btn btn-danger delete-customer-btn" do %>
      <i class="bi bi-trash me-2"></i>
      Delete Customer
    <% end %>
    <%= link_to admin_customers_path, class: "btn btn-secondary back-btn" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Back to List
    <% end %>
  </div>
</div>

<style>
/* Modern Customer Page Styles */
.customer-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 2rem;
  border-radius: 0.5rem;
  margin-bottom: 2rem;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
}

.header-title h2 {
  color: white;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.header-title p {
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

.search-container {
  min-width: 250px;
}

.search-container .form-label {
  color: white;
  margin-bottom: 0.5rem;
  font-weight: 500;
}

.client-id-input {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
}

.client-id-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

.customer-content {
  background: #f8f9fa;
  min-height: 600px;
}

.content-area {
  background: white;
  border-radius: 0.5rem;
  padding: 1.5rem;
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.modern-accordion {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.section-item {
  border: 1px solid #e9ecef;
  border-radius: 0.5rem;
  overflow: hidden;
}

.section-header {
  background: #f8f9fa;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s ease;
  border-bottom: 1px solid #e9ecef;
}

.section-header:hover {
  background: #e9ecef;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-weight: 500;
  color: #495057;
}

.section-icon {
  color: #0066cc;
  font-size: 1.1rem;
}

.section-badge {
  background: #0066cc;
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.875rem;
  font-weight: 500;
}

.section-arrow {
  color: #6c757d;
  transition: transform 0.2s ease;
}

.section-header[aria-expanded="true"] .section-arrow {
  transform: rotate(180deg);
}

.section-content {
  background: white;
}

.section-body {
  padding: 1.5rem;
}

/* Table Styles */
.table-controls {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 0.25rem;
}

.entries-selector {
  display: flex;
  align-items: center;
}

.search-box input {
  max-width: 200px;
}

.modern-table-container {
  border: 1px solid #e9ecef;
  border-radius: 0.25rem;
  overflow: hidden;
}

.modern-table {
  width: 100%;
  margin-bottom: 0;
  border-collapse: separate;
  border-spacing: 0;
}

.modern-table thead th {
  background: #f8f9fa;
  border: none;
  padding: 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #6c757d;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.modern-table tbody td {
  padding: 1rem 0.75rem;
  border-top: 1px solid #e9ecef;
  border-bottom: none;
  font-size: 0.875rem;
  vertical-align: middle;
}

.modern-table tbody tr:hover {
  background: #f8f9fa;
}

.policy-number {
  color: #0066cc;
  font-weight: 500;
}

.policy-holder {
  line-height: 1.4;
}

.customer-id {
  color: #6c757d;
  font-size: 0.75rem;
}

.action-buttons {
  display: flex;
  gap: 0.25rem;
}

.action-btn {
  border: none;
  background: none;
  width: 32px;
  height: 32px;
  border-radius: 0.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
}

.view-btn {
  background: #e3f2fd;
  color: #1976d2;
}

.edit-btn {
  background: #fff3e0;
  color: #f57c00;
}

.delete-btn {
  background: #ffebee;
  color: #d32f2f;
}

.action-btn:hover {
  transform: scale(1.05);
}

.pagination-container {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 0.25rem;
}

.action-buttons-container {
  display: flex;
  gap: 1rem;
  justify-content: center;
  padding: 2rem 0;
}

.edit-customer-btn {
  background: #0066cc;
  border-color: #0066cc;
  padding: 0.75rem 1.5rem;
}

.delete-customer-btn {
  background: #dc3545;
  border-color: #dc3545;
  padding: 0.75rem 1.5rem;
}

.back-btn {
  background: #6c757d;
  border-color: #6c757d;
  padding: 0.75rem 1.5rem;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    text-align: center;
  }

  .search-container {
    min-width: 100%;
  }

  .action-buttons-container {
    flex-direction: column;
    align-items: center;
  }

  .action-buttons-container .btn {
    width: 200px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Handle section collapse/expand
  const sectionHeaders = document.querySelectorAll('.section-header');

  sectionHeaders.forEach(header => {
    header.addEventListener('click', function() {
      const arrow = this.querySelector('.section-arrow');
      const isExpanded = this.getAttribute('aria-expanded') === 'true';

      // Toggle arrow direction
      if (isExpanded) {
        arrow.classList.remove('bi-chevron-up');
        arrow.classList.add('bi-chevron-down');
      } else {
        arrow.classList.remove('bi-chevron-down');
        arrow.classList.add('bi-chevron-up');
      }
    });
  });
});
</script>
<!-- Vendor Portal Login -->
<div class="simple-login-wrapper">
  <div class="simple-login-container">
    <div class="simple-login-card">
      <% if notice %>
        <div class="alert alert-success mb-3">
          <i class="fas fa-check-circle me-2"></i><%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger mb-3">
          <i class="fas fa-exclamation-triangle me-2"></i><%= alert %>
        </div>
      <% end %>

      <div class="text-center mb-4">
        <div class="simple-logo">
          <img src="/logo.jpeg" alt="Dr WISE" class="login-logo-img" />
        </div>
        <h2 class="simple-title">Vendor Portal</h2>
        <p class="text-muted mb-0">Sign in to manage your leads and payouts</p>
      </div>

      <%= form_with url: user_session_path, method: :post, scope: :user, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :login, "Email", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">
              <i class="fas fa-envelope"></i>
            </span>
            <%= f.email_field :login, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "vendor@example.com" %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Password", class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text">
              <i class="fas fa-lock"></i>
            </span>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "••••••••" %>
          </div>
        </div>

        <%= f.submit "Sign In", class: "btn btn-primary w-100 py-3 fs-5 fw-semibold" %>
      <% end %>
    </div>
  </div>
</div>

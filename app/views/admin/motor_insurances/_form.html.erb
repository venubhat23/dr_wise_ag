    <% else %>
      <%= form.submit @motor_insurance.persisted? ? "Update Motor Insurance" : "Create Motor Insurance", class: "btn btn-primary btn-lg px-5" %>
    <% end %>
  </div>

<% end %>

<script>
// Force enable scrolling and prevent conflicts
try {
  // Ensure document body can scroll
  if (document.body) {
    document.body.style.overflow = 'auto';
    document.body.style.overflowY = 'auto';
    document.body.style.overflowX = 'hidden';
    document.body.style.position = 'relative';
    document.body.style.height = 'auto';
  }

  if (document.documentElement) {
    document.documentElement.style.overflow = 'auto';
    document.documentElement.style.overflowY = 'auto';
    document.documentElement.style.overflowX = 'hidden';
    document.documentElement.style.height = 'auto';
  }

  // Remove any scroll-blocking classes
  document.body.classList.remove('modal-open', 'no-scroll');

  console.log('✅ Scroll fix applied successfully');
} catch (error) {
  console.warn('⚠️  Scroll fix error:', error);
}

// Error handling wrapper
function safeExecute(fn, name) {
  try {
    return fn();
  } catch (error) {
    console.warn(`⚠️  ${name} error:`, error);
    return null;
  }
}

document.addEventListener('DOMContentLoaded', function() {
  // Auto-calculation functions
  function calculateTotalPremium() {
    const netPremium = parseFloat(document.getElementById('net_premium').value) || 0;
    const gstPercentage = parseFloat(document.getElementById('gst_percentage').value) || 0;

    const gstAmount = netPremium * (gstPercentage / 100);
    const totalPremium = netPremium + gstAmount;

    document.getElementById('total_premium').value = totalPremium.toFixed(2);
  }

  function calculateTotalIDV() {
    const vehicleIDV = parseFloat(document.getElementById('vehicle_idv').value) || 0;
    const cngIDV = parseFloat(document.getElementById('cng_idv').value) || 0;
    const totalIDV = vehicleIDV + cngIDV;

    document.getElementById('total_idv').value = totalIDV.toFixed(2);
  }

  // Event listeners for auto-calculations
  document.getElementById('net_premium').addEventListener('input', calculateTotalPremium);
  document.getElementById('gst_percentage').addEventListener('input', calculateTotalPremium);
  document.getElementById('vehicle_idv').addEventListener('input', calculateTotalIDV);
  document.getElementById('cng_idv').addEventListener('input', calculateTotalIDV);

  // Show/Hide TP Premium based on insurance type
  const insuranceTypeSelect = document.getElementById('insurance_type_select');
  if (insuranceTypeSelect) {
    insuranceTypeSelect.addEventListener('change', function() {
      const insuranceType = this.value;
      const tpPremiumField = document.querySelector('.tp-premium-field');

      if (insuranceType === 'Third Party') {
        tpPremiumField.style.display = 'block';
        document.getElementById('tp_premium').required = true;
      } else {
        tpPremiumField.style.display = 'none';
        document.getElementById('tp_premium').required = false;
        document.getElementById('tp_premium').value = 0;
      }
    });
  }

  // Customer selection and policy holder options
  const customerSelect = document.getElementById('customer_select');
  if (customerSelect) {
    customerSelect.addEventListener('change', function() {
      const customerId = this.value;
      const policyHolderSelect = document.getElementById('policy_holder_select');

      // Clear existing options except first one
      policyHolderSelect.innerHTML = '<option value="">Select Policy Holder</option><option value="Self">Self</option>';

      if (customerId) {
        // Fetch policy holder options
        fetch(`/admin/motor_insurances/policy_holder_options?customer_id=${customerId}`)
          .then(response => response.json())
          .then(data => {
            data.options.forEach(option => {
              if (option[1] !== 'Self') {
                const optionElement = document.createElement('option');
                optionElement.value = option[1];
                optionElement.textContent = option[0];
                policyHolderSelect.appendChild(optionElement);
              }
            });
          })
          .catch(error => console.error('Error fetching policy holder options:', error));

        // Fetch and auto-select affiliate based on customer's branch/lead
        fetch(`/admin/motor_insurances/customer_affiliate_info?customer_id=${customerId}`)
          .then(response => response.json())
          .then(data => {
            if (data.affiliate_id) {
              // Auto-select the affiliate in the dropdown
              const affiliateSelect = document.getElementById('affiliate_select');
              if (affiliateSelect) {
                // If using Select2, set the value and trigger change
                if ($(affiliateSelect).data('select2')) {
                  $(affiliateSelect).val(data.affiliate_id).trigger('change');
                } else {
                  affiliateSelect.value = data.affiliate_id;
                }
                console.log(`Auto-selected affiliate: ${data.affiliate_name} (ID: ${data.affiliate_id})`);
              }
            }
          })
          .catch(error => console.error('Error fetching customer affiliate info:', error));
      }
    });
  }

  // Auto-set policy end date based on start date (default 1 year)
  const policyStartDate = document.getElementById('policy_start_date');
  if (policyStartDate) {
    policyStartDate.addEventListener('change', function() {
      const startDate = new Date(this.value);
      const endDate = new Date(startDate);
      endDate.setFullYear(endDate.getFullYear() + 1);
      endDate.setDate(endDate.getDate() - 1); // End date is one day before renewal

      document.getElementById('policy_end_date').value = endDate.toISOString().split('T')[0];
    });
  }

  // Commission calculations
  function calculateCommissions() {
    const netPremium = parseFloat(document.getElementById('net_premium').value) || 0;

    // Calculate all commission types
    const fields = ['main_agent', 'distributor', 'ambassador', 'investor'];
    let totalDistributionPercentage = 0;

    fields.forEach(field => {
      const percentageInput = document.querySelector(`[data-field='${field}'].commission-input`);
      const amountOutput = document.querySelector(`[data-field='${field}'].commission-amount`);
      const tdsPercentageInput = document.querySelector(`[data-field='${field}'].tds-percentage`);
      const tdsAmountOutput = document.querySelector(`[data-field='${field}'].tds-amount`);
      const afterTdsOutput = document.querySelector(`[data-field='${field}'].after-tds-value`);

      if (percentageInput && amountOutput) {
        const percentage = parseFloat(percentageInput.value) || 0;
        const amount = (netPremium * percentage) / 100;
        const tdsPercentage = parseFloat(tdsPercentageInput?.value) || 0;
        const tdsAmount = (amount * tdsPercentage) / 100;
        const afterTds = amount - tdsAmount;

        amountOutput.value = amount.toFixed(2);
        if (tdsAmountOutput) tdsAmountOutput.value = tdsAmount.toFixed(2);
        if (afterTdsOutput) afterTdsOutput.value = afterTds.toFixed(2);

        // Add to total distribution (exclude main_agent)
        if (field !== 'main_agent') {
          totalDistributionPercentage += percentage;
        }
      }
    });

    // Update total distribution and profit calculations
    const mainAgentPercentage = parseFloat(document.getElementById('motor_insurance_main_agent_commission_percentage').value) || 0;
    const companyExpensesPercentage = parseFloat(document.getElementById('company_expenses_percentage').value) || 0;

    document.getElementById('total_distribution_percentage').value = totalDistributionPercentage.toFixed(2);

    // Calculate profit correctly: Profit = Net Premium - All Commission Payouts - Company Expenses
    // In percentage terms: Profit % = 100% - Main Agent % - Total Distribution % - Company Expenses %
    const totalCommissionPercentage = mainAgentPercentage + totalDistributionPercentage + companyExpensesPercentage;
    const profitPercentage = 100 - totalCommissionPercentage;
    const profitAmount = (netPremium * profitPercentage) / 100;

    document.getElementById('profit_percentage').value = profitPercentage.toFixed(2);
    document.getElementById('profit_amount').value = profitAmount.toFixed(2);

    // Update summary
    document.getElementById('main_agent_summary').textContent = `${mainAgentPercentage}% of Net Premium`;
    document.getElementById('total_distribution_summary').textContent = `${totalDistributionPercentage.toFixed(1)}% (Affiliate + Ambassador + Investor)`;
    document.getElementById('company_expenses_summary').textContent = `${companyExpensesPercentage}% of Net Premium`;
  }

  // Add event listeners for commission calculations
  document.querySelectorAll('.commission-input, .tds-percentage').forEach(input => {
    input.addEventListener('input', calculateCommissions);
  });

  document.getElementById('net_premium').addEventListener('input', calculateCommissions);
  document.getElementById('company_expenses_percentage').addEventListener('input', calculateCommissions);

  // Initial calculations
  calculateTotalPremium();
  calculateTotalIDV();
  calculateCommissions();
});
</script>

<!-- jQuery (required for Select2) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Select2 CSS & JS for searchable dropdown -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- Custom styling for enhanced Select2 dropdown -->
<style>
  /* Fix scrolling issues - CRITICAL */
  html, body {
    overflow: auto !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    height: auto !important;
    position: relative !important;
  }

  /* Prevent any fixed overlays from blocking scroll */
  .modal-backdrop,
  .select2-container--open {
    position: absolute !important;
  }

  /* Ensure page container can scroll */
  .container,
  .container-fluid,
  .main-content {
    overflow: visible !important;
    height: auto !important;
  }

  /* Force scroll capability */
  * {
    -webkit-overflow-scrolling: touch;
  }

  .select2-container--bootstrap-5 .select2-selection--single {
    height: 38px;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  }

  .select2-container--bootstrap-5 .select2-selection--single:focus-within {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }

  .select2-container--bootstrap-5 .select2-selection__rendered {
    color: #495057;
    padding-left: 12px;
    padding-top: 5px;
    line-height: 1.5;
  }

  .select2-container--bootstrap-5 .select2-results__option {
    padding: 8px 12px;
  }

  .select2-container--bootstrap-5 .select2-results__option--highlighted {
    background-color: #0d6efd;
    color: white;
  }

  .select2-dropdown {
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    margin-top: 4px;
  }

  .select2-results__options {
    max-height: 400px !important;
    min-height: 200px;
  }

  .select2-dropdown-large .select2-results__options {
    max-height: 600px !important;
    min-height: 400px !important;
    overflow-y: auto;
  }

  .select2-dropdown-large {
    min-width: 100% !important;
  }

  .select2-dropdown-large .select2-results__option {
    padding: 8px 12px !important;
    min-height: 45px;
    display: flex;
    align-items: center;
  }

  .select2-search__field {
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    padding: 6px 12px;
    font-size: 0.95rem;
  }

  /* Custom client option styling */
  .client-option {
    display: flex;
    align-items: center;
    padding: 8px 0;
  }

  .client-option-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin-right: 12px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .client-option-details {
    display: flex;
    flex-direction: column;
  }

  .client-option-name {
    font-weight: 500;
    color: #212529;
    font-size: 14px;
  }

  .client-option-id {
    font-size: 12px;
    color: #6c757d;
  }

  /* Custom affiliate option styling */
  .affiliate-option {
    display: flex;
    align-items: center;
    padding: 8px 0;
  }

  .affiliate-option-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin-right: 12px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .affiliate-option-details {
    display: flex;
    flex-direction: column;
  }

  .affiliate-option-name {
    font-weight: 500;
    color: #212529;
    font-size: 14px;
  }

  .affiliate-option-id {
    font-size: 12px;
    color: #6c757d;
  }

  /* Custom company option styling */
  .company-option {
    display: flex;
    align-items: center;
    padding: 8px 0;
  }

  .company-option-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin-right: 12px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .company-option-details {
    display: flex;
    flex-direction: column;
  }

  .company-option-name {
    font-weight: 500;
    color: #212529;
    font-size: 14px;
  }

  .company-option-type {
    font-size: 12px;
    color: #6c757d;
  }

  /* Custom agency option styling */
  .agency-option {
    display: flex;
    align-items: center;
    padding: 8px 0;
  }

  .agency-option-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin-right: 12px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .agency-option-details {
    display: flex;
    flex-direction: column;
  }

  .agency-option-name {
    font-weight: 500;
    color: #212529;
    font-size: 14px;
  }

  .agency-option-code {
    font-size: 12px;
    color: #6c757d;
  }

  /* Style for read-only commission fields in edit mode */
  .form-control[readonly] {
    background-color: #f5f5f5 !important;
    cursor: not-allowed;
    opacity: 0.8;
  }

  .form-control[readonly]:focus {
    border-color: #ced4da;
    box-shadow: none;
  }
</style>

<script>
$(document).ready(function() {
  // Initialize Select2 for searchable dropdown
  $('#customer_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select client...',
    allowClear: true,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true,
    templateResult: function(option) {
      if (!option.id || option.element.value === '') {
        return option.text;
      }

      // Generate avatar with initials
      var initials = option.text.split(' ').map(function(name) {
        return name.charAt(0).toUpperCase();
      }).join('').substring(0, 2);

      // Custom template for dropdown options with avatar
      var $option = $(
        '<div class="client-option">' +
          '<div class="client-option-avatar">' + initials + '</div>' +
          '<div class="client-option-details">' +
            '<div class="client-option-name">' + option.text + '</div>' +
            '<div class="client-option-id">Client ID: #' + option.id + '</div>' +
          '</div>' +
        '</div>'
      );
      return $option;
    },
    templateSelection: function(option) {
      return option.text || 'Search and select client...';
    },
    escapeMarkup: function(markup) {
      return markup;
    }
  });

  // Initialize Select2 for Policy Holder dropdown
  $('#policy_holder_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select policy holder...',
    allowClear: false,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true
  });

  // Initialize Select2 for Affiliate dropdown
  $('#affiliate_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select affiliate...',
    allowClear: true,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true,
    templateResult: function(option) {
      if (!option.id || option.id === '') {
        return option.text;
      }

      var initials = option.text.split(' ').map(function(name) {
        return name.charAt(0).toUpperCase();
      }).join('').substring(0, 2);

      var $option = $(
        '<div class="affiliate-option">' +
          '<div class="affiliate-option-avatar">' + initials + '</div>' +
          '<div class="affiliate-option-details">' +
            '<div class="affiliate-option-name">' + option.text + '</div>' +
            '<div class="affiliate-option-id">Affiliate ID: #' + option.id + '</div>' +
          '</div>' +
        '</div>'
      );
      return $option;
    },
    templateSelection: function(option) {
      return option.text || 'Search and select affiliate...';
    },
    escapeMarkup: function(markup) {
      return markup;
    }
  });

  // Initialize Select2 for Insurance Company dropdown
  $('#motor_insurance_insurance_company_name').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select company...',
    allowClear: true,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true,
    templateResult: function(option) {
      if (!option.id || option.element.value === '') {
        return option.text;
      }

      var initials = option.text.split(' ').map(function(word) {
        return word.charAt(0).toUpperCase();
      }).join('').substring(0, 3);

      var $option = $(
        '<div class="company-option">' +
          '<div class="company-option-avatar">' + initials + '</div>' +
          '<div class="company-option-details">' +
            '<div class="company-option-name">' + option.text + '</div>' +
            '<div class="company-option-type">Insurance Company</div>' +
          '</div>' +
        '</div>'
      );
      return $option;
    },
    templateSelection: function(option) {
      return option.text || 'Search and select company...';
    },
    escapeMarkup: function(markup) {
      return markup;
    }
  });

  // Initialize Select2 for Agency Code dropdown
  $('#motor_insurance_agency_code_id').select2({
    theme: 'bootstrap-5',
    placeholder: 'Search and select agency code...',
    allowClear: true,
    width: '100%',
    dropdownParent: $('body'),
    dropdownCssClass: 'select2-dropdown-large',
    minimumResultsForSearch: 0,
    closeOnSelect: true,
    templateResult: function(option) {
      if (!option.id || option.element.value === '') {
        return option.text;
      }

      var parts = option.text.split(' - ');
      var agentName = parts[0] || option.text;
      var agencyCode = parts[1] || '';

      var initials = agentName.split(' ').map(function(word) {
        return word.charAt(0).toUpperCase();
      }).join('').substring(0, 2);

      var $option = $(
        '<div class="agency-option">' +
          '<div class="agency-option-avatar">' + initials + '</div>' +
          '<div class="agency-option-details">' +
            '<div class="agency-option-name">' + agentName + '</div>' +
            '<div class="agency-option-code">Code: ' + agencyCode + '</div>' +
          '</div>' +
        '</div>'
      );
      return $option;
    },
    templateSelection: function(option) {
      return option.text || 'Search and select agency code...';
    },
    escapeMarkup: function(markup) {
      return markup;
    }
  });

  // Initialize Select2 for Vehicle Type dropdown
  $('#vehicle_type_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select Vehicle Type',
    allowClear: false,
    width: '100%',
    dropdownParent: $('body'),
    minimumResultsForSearch: 0,
    closeOnSelect: true
  });


  // Initialize Select2 for Insurance Type dropdown
  $('#insurance_type_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select Insurance Type',
    allowClear: false,
    width: '100%',
    dropdownParent: $('body'),
    minimumResultsForSearch: 0,
    closeOnSelect: true
  });

  // Initialize Select2 for Class of Vehicle dropdown
  $('#class_of_vehicle_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select Class of Vehicle',
    allowClear: false,
    width: '100%',
    dropdownParent: $('body'),
    minimumResultsForSearch: 0,
    closeOnSelect: true
  });

  // Initialize Select2 for Policy Type dropdown
  $('#policy_type_select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select Policy Type',
    allowClear: false,
    width: '100%',
    dropdownParent: $('body'),
    minimumResultsForSearch: 0,
    closeOnSelect: true
  });

  // Update policy holder options and affiliate when customer changes
  $('#customer_select').on('change', function() {
    var customerId = $(this).val();
    var $policyHolderSelect = $('#policy_holder_select');
    var $affiliateSelect = $('#affiliate_select');

    if (customerId) {
      // Show loading state for policy holder
      $policyHolderSelect.empty().append('<option value="">Loading...</option>').trigger('change');

      // Load policy holder options
      $.ajax({
        url: '/admin/insurance/motor/policy_holder_options',
        method: 'GET',
        data: { customer_id: customerId },
        success: function(data) {
          // Clear existing options
          $policyHolderSelect.empty();

          // Add "Select Policy Holder" option
          $policyHolderSelect.append('<option value="">Select Policy Holder</option>');

          // Add new options
          $.each(data.options, function(index, option) {
            $policyHolderSelect.append($('<option>', {
              value: option[1],
              text: option[0]
            }));
          });

          // Trigger change event to update Select2
          $policyHolderSelect.trigger('change');
        },
        error: function(xhr, status, error) {
          console.error('Error loading policy holder options:', error);
          $policyHolderSelect.empty().append('<option value="">Error loading options</option>').trigger('change');
        }
      });

      // Load customer affiliate information
      $.ajax({
        url: '/admin/insurance/motor/customer_affiliate_info',
        method: 'GET',
        data: { customer_id: customerId },
        success: function(data) {
          // Destroy existing Select2
          if ($affiliateSelect.hasClass('select2-hidden-accessible')) {
            $affiliateSelect.select2('destroy');
          }

          // Clear existing options
          $affiliateSelect.empty();

          if (data.affiliate_id && data.affiliate_name) {
            // Customer has an affiliate - show only that affiliate
            $affiliateSelect.append('<option value="">Self</option>');
            $affiliateSelect.append(`<option value="${data.affiliate_id}" selected>${data.affiliate_name}</option>`);
            console.log('Showing only linked affiliate:', data.affiliate_name);
          } else {
            // Customer has no affiliate - show only "Self"
            $affiliateSelect.append('<option value="" selected>Self</option>');
            console.log('Customer has no affiliate - showing only Self');
          }

          // Reinitialize Select2 with the filtered options
          $affiliateSelect.select2({
            theme: 'bootstrap-5',
            placeholder: 'Affiliate',
            allowClear: false,
            width: '100%',
            dropdownParent: $('body'),
            dropdownCssClass: 'select2-dropdown-large',
            minimumResultsForSearch: 0,
            closeOnSelect: true,
            templateResult: function(option) {
              if (!option.id || option.id === '') {
                return option.text;
              }

              var initials = option.text.split(' ').map(function(name) {
                return name.charAt(0).toUpperCase();
              }).join('').substring(0, 2);

              var $option = $(
                '<div class="affiliate-option">' +
                  '<div class="affiliate-option-avatar">' + initials + '</div>' +
                  '<div class="affiliate-option-details">' +
                    '<div class="affiliate-option-name">' + option.text + '</div>' +
                    '<div class="affiliate-option-id">Affiliate</div>' +
                  '</div>' +
                '</div>'
              );
              return $option;
            },
            templateSelection: function(option) {
              return option.text || 'Affiliate';
            },
            escapeMarkup: function(markup) {
              return markup;
            }
          });
        },
        error: function(xhr, status, error) {
          console.error('Error loading customer affiliate info:', error);

          // Reset affiliate dropdown on error
          if ($affiliateSelect.hasClass('select2-hidden-accessible')) {
            $affiliateSelect.select2('destroy');
          }
          $affiliateSelect.empty().append('<option value="" selected>Self</option>');
          $affiliateSelect.select2({
            theme: 'bootstrap-5',
            placeholder: 'Affiliate',
            allowClear: false,
            width: '100%',
            dropdownParent: $('body')
          });
        }
      });

    } else {
      // Clear options when no customer is selected
      $policyHolderSelect.empty().append('<option value="">Select Policy Holder</option>').trigger('change');
      $affiliateSelect.val('').trigger('change');
    }
  });

  // ========================================
  // MOTOR INSURANCE BROKER CODE FLOW LOGIC
  // ========================================

  console.log('🚗 Initializing Motor Insurance Broker Flow...');

  // Global variables to track state
  let motorAgencyCodeEventListenerAttached = false;

  // Initialize broker flow after a short delay to ensure all elements are ready
  setTimeout(function() {
    initializeMotorBrokerFlow();
  }, 1000);

  function initializeMotorBrokerFlow() {
    console.log('🔧 Setting up Motor Broker Flow...');

    const brokerCodeSelect = document.getElementById('motor_insurance_broker_code_type');
    const agencyCodeSelect = document.getElementById('motor_insurance_agency_code_id');
    const insuranceCompanySelect = document.getElementById('motor_insurance_insurance_company_name');

    console.log('🔍 Motor Broker Elements Check:');
    console.log('- Broker Code:', brokerCodeSelect ? '✅' : '❌');
    console.log('- Agency Code:', agencyCodeSelect ? '✅' : '❌');
    console.log('- Insurance Company:', insuranceCompanySelect ? '✅' : '❌');

    if (!brokerCodeSelect) {
      console.error('❌ Motor broker code select not found!');
      return;
    }

    // Clear any existing event listeners and add new one
    $(brokerCodeSelect).off('change.motorBroker');
    $(brokerCodeSelect).on('change.motorBroker', function() {
      const brokerType = this.value;
      console.log('🔥 MOTOR BROKER CODE CHANGED! Value:', brokerType);

      if (!brokerType) {
        console.log('⚠️ No broker type selected, skipping API call');
        return;
      }

      // Clear and show loading state for dependent dropdowns
      if (agencyCodeSelect) {
        $(agencyCodeSelect).select2('destroy');
        agencyCodeSelect.innerHTML = '<option value="">Loading...</option>';
        $(agencyCodeSelect).select2({
          theme: 'bootstrap-5',
          placeholder: 'Loading...',
          allowClear: true,
          width: '100%'
        });
      }

      if (insuranceCompanySelect) {
        $(insuranceCompanySelect).select2('destroy');
        insuranceCompanySelect.innerHTML = '<option value="">Loading...</option>';
        $(insuranceCompanySelect).select2({
          theme: 'bootstrap-5',
          placeholder: 'Loading...',
          allowClear: true,
          width: '100%'
        });
      }

      // Update label
      const labelSpan = document.getElementById('agency_code_label_text');
      if (labelSpan) {
        labelSpan.textContent = brokerType === 'direct' ? ' (Agents)*' : ' (Brokers)*';
      }

      // Call appropriate API
      if (brokerType === 'direct') {
        callMotorDirectAPI();
      } else if (brokerType === 'broking') {
        callMotorBrokingAPI();
      }
    });

    console.log('✅ Motor broker code change listener attached');
  }

  function callMotorDirectAPI() {
    console.log('🌐 Calling Motor Direct API...');

    fetch('/admin/insurance/motor/agency_codes_for_broker_type?broker_type=direct', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      console.log('📡 Motor Direct API Response Status:', response.status);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Motor Direct API Data:', data);

      if (data.success && data.data) {
        populateMotorAgencyDropdown(data.data, 'Select Agent...');

        // Clear company dropdown and show placeholder
        const companySelect = document.getElementById('motor_insurance_insurance_company_name');
        if (companySelect) {
          $(companySelect).select2('destroy');
          companySelect.innerHTML = '<option value="">Select Agent First...</option>';
          $(companySelect).select2({
            theme: 'bootstrap-5',
            placeholder: 'Select Agent First...',
            allowClear: true,
            width: '100%'
          });
        }
      } else {
        console.error('❌ Motor Direct API returned no data');
      }
    })
    .catch(error => {
      console.error('❌ Motor Direct API Error:', error);
    });
  }

  function callMotorBrokingAPI() {
    console.log('🌐 Calling Motor Broking API...');

    // First, get brokers for agency dropdown
    fetch('/admin/insurance/motor/agency_codes_for_broker_type?broker_type=broking', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Motor Broking API Data:', data);

      if (data.success && data.data) {
        populateMotorAgencyDropdown(data.data, 'Select Broker...');
      }
    })
    .catch(error => {
      console.error('❌ Motor Broking API Error:', error);
    });

    // Second, get all motor insurance companies
    fetch('/admin/insurance/motor/insurance_companies_for_type', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Motor Insurance Companies Data:', data);

      if (data.success && data.data) {
        populateMotorCompanyDropdown(data.data);
      }
    })
    .catch(error => {
      console.error('❌ Motor Company API Error:', error);
    });
  }

  function populateMotorAgencyDropdown(data, placeholder) {
    const agencySelect = document.getElementById('motor_insurance_agency_code_id');
    if (!agencySelect) return;

    console.log(`🔧 Populating motor agency dropdown with ${data.length} items...`);

    // Destroy existing Select2
    $(agencySelect).select2('destroy');

    // Clear and populate options
    agencySelect.innerHTML = `<option value="">${placeholder}</option>`;
    data.forEach(item => {
      const option = document.createElement('option');
      option.value = item.id;
      option.textContent = item.text;
      agencySelect.appendChild(option);
    });

    // Reinitialize Select2
    $(agencySelect).select2({
      theme: 'bootstrap-5',
      placeholder: placeholder,
      allowClear: true,
      width: '100%',
      dropdownParent: $('body'),
      minimumResultsForSearch: 0
    });

    // Attach change listener for agency selection
    $(agencySelect).off('change.motorAgency');
    $(agencySelect).on('change.motorAgency', function() {
      const selectedId = $(this).val();
      const brokerType = $('#motor_insurance_broker_code_type').val();

      console.log(`🔥 Motor Agency Selected: ${selectedId}, Broker Type: ${brokerType}`);

      if (brokerType === 'direct' && selectedId) {
        fetchMotorCompanyByAgent(selectedId);
      }
    });

    console.log('✅ Motor agency dropdown populated and events attached');

    // Trigger custom event to indicate dropdown is ready
    $(agencySelect).trigger('dropdown:populated');
  }

  function populateMotorCompanyDropdown(data) {
    const companySelect = document.getElementById('motor_insurance_insurance_company_name');
    if (!companySelect) return;

    console.log(`🔧 Populating motor company dropdown with ${data.length} items...`);

    // Destroy existing Select2
    $(companySelect).select2('destroy');

    // Clear and populate options
    companySelect.innerHTML = '<option value="">Select Company...</option>';
    data.forEach(item => {
      const option = document.createElement('option');
      option.value = item.id;
      option.textContent = item.text;
      companySelect.appendChild(option);
    });

    // Reinitialize Select2
    $(companySelect).select2({
      theme: 'bootstrap-5',
      placeholder: 'Select Company...',
      allowClear: true,
      width: '100%',
      dropdownParent: $('body'),
      minimumResultsForSearch: 0
    });

    console.log('✅ Motor company dropdown populated');
  }

  function fetchMotorCompanyByAgent(agentId) {
    console.log(`🌐 Fetching motor company for agent ID: ${agentId}`);

    const companySelect = document.getElementById('motor_insurance_insurance_company_name');
    if (!companySelect) return;

    // Show loading state
    $(companySelect).select2('destroy');
    companySelect.innerHTML = '<option value="">Loading company...</option>';
    $(companySelect).select2({
      theme: 'bootstrap-5',
      placeholder: 'Loading...',
      allowClear: false,
      width: '100%'
    });

    fetch(`/admin/insurance/motor/company_name_by_agent?agency_code_id=${agentId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Motor Company by Agent Data:', data);

      if (data.success && data.data) {
        $(companySelect).select2('destroy');

        if (data.data.company_name) {
          // Single company - auto-select
          companySelect.innerHTML = `<option value="${data.data.company_name}" selected>${data.data.company_name}</option>`;
          companySelect.style.backgroundColor = '#d1edff';
        } else if (data.data.company_names) {
          // Multiple companies - populate dropdown
          companySelect.innerHTML = '<option value="">Select Company...</option>';
          data.data.company_names.forEach(name => {
            const option = document.createElement('option');
            option.value = name;
            option.textContent = name;
            companySelect.appendChild(option);
          });
        }

        $(companySelect).select2({
          theme: 'bootstrap-5',
          placeholder: 'Company auto-filled',
          allowClear: true,
          width: '100%'
        });

        console.log('✅ Motor company auto-filled successfully');
      }
    })
    .catch(error => {
      console.error('❌ Motor Company Fetch Error:', error);
      $(companySelect).select2('destroy');
      companySelect.innerHTML = '<option value="">Error loading company</option>';
      $(companySelect).select2({
        theme: 'bootstrap-5',
        placeholder: 'Error',
        allowClear: true,
        width: '100%'
      });
    });
  }

  console.log('✅ Motor Insurance Broker Flow script loaded');

  // Document deletion functionality
  document.querySelectorAll('.delete-document').forEach(button => {
    button.addEventListener('click', function() {
      const documentId = this.getAttribute('data-document-id');
      const documentName = this.getAttribute('data-document-name');
      const documentType = this.getAttribute('data-document-type');

      // Show confirmation dialog
      if (confirm(`Are you sure you want to delete "${documentName}"? This action cannot be undone.`)) {
        // Disable the button to prevent double-clicks
        this.disabled = true;
        this.innerHTML = '<i class="bi bi-hourglass-split"></i>';

        // Send delete request
        fetch(`/admin/motor_insurances/${window.location.pathname.split('/')[4]}/delete_document`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
          },
          body: JSON.stringify({
            document_id: documentId,
            document_type: documentType
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Remove the document row with animation
            const documentRow = this.closest('[data-document-id]');
            documentRow.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            documentRow.style.opacity = '0';
            documentRow.style.transform = 'translateX(-20px)';

            setTimeout(() => {
              documentRow.remove();

              // Check if there are no more documents and update display
              updateDocumentDisplay();
            }, 300);

            // Show success message
            showDocumentMessage('Document deleted successfully', 'success');
          } else {
            // Re-enable button on error
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-trash"></i>';
            showDocumentMessage('Failed to delete document: ' + (data.error || 'Unknown error'), 'danger');
          }
        })
        .catch(error => {
          console.error('Error deleting document:', error);
          // Re-enable button on error
          this.disabled = false;
          this.innerHTML = '<i class="bi bi-trash"></i>';
          showDocumentMessage('Failed to delete document. Please try again.', 'danger');
        });
      }
    });
  });

  function updateDocumentDisplay() {
    const policyDocsCard = document.querySelector('.card.border-success');
    const generalDocsCard = document.querySelector('.card.border-info');
    const existingDocsSection = document.querySelector('.row.mb-4');

    // Check if any documents remain
    const hasPolicyDocs = policyDocsCard && policyDocsCard.querySelectorAll('[data-document-id]').length > 0;
    const hasGeneralDocs = generalDocsCard && generalDocsCard.querySelectorAll('[data-document-id]').length > 0;

    if (!hasPolicyDocs && !hasGeneralDocs && existingDocsSection) {
      // Show "no documents" message
      existingDocsSection.innerHTML = `
        <div class="col-12">
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No documents have been uploaded for this policy yet.
          </div>
        </div>
      `;
    }
  }

  function showDocumentMessage(message, type) {
    // Create and show temporary message
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alertDiv.innerHTML = `
      <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;

    document.body.appendChild(alertDiv);

    // Auto dismiss after 3 seconds
    setTimeout(() => {
      if (alertDiv.parentNode) {
        alertDiv.remove();
      }
    }, 3000);
  }

  // Initialize form for edit mode
  <% if @motor_insurance.persisted? %>
    console.log('🔧 Initializing edit form...');

    // Store the existing values for later selection
    const existingAgencyCodeId = '<%= @motor_insurance.agency_code_id %>';
    const existingBrokerId = '<%= @motor_insurance.broker_id %>';
    const brokerCodeType = '<%= @motor_insurance.broker_code_type %>';

    console.log('Existing values:', {
      agencyCodeId: existingAgencyCodeId,
      brokerId: existingBrokerId,
      brokerCodeType: brokerCodeType
    });

    // Store policy holder value before triggering customer change
    const existingPolicyHolder = '<%= @selected_policy_holder || @motor_insurance.policy_holder %>';
    console.log('Existing policy holder:', existingPolicyHolder);

    // Trigger customer change to load affiliate options
    const customerSelect = document.getElementById('customer_select');
    if (customerSelect && customerSelect.value) {
      $(customerSelect).trigger('change');
      console.log('Triggered customer change for edit form');

      // Set timeout to restore policy holder after customer change completes
      setTimeout(function() {
        const policyHolderSelect = document.getElementById('policy_holder_select');
        if (policyHolderSelect && existingPolicyHolder) {
          // Check if the policy holder option exists
          const optionExists = Array.from(policyHolderSelect.options).some(opt => opt.value === existingPolicyHolder);
          if (optionExists) {
            $(policyHolderSelect).val(existingPolicyHolder).trigger('change');
            console.log('✅ Restored policy holder:', existingPolicyHolder);
          } else {
            console.log('❌ Policy holder option not found:', existingPolicyHolder);
          }
        }
      }, 1500); // Wait for customer change to complete
    }

    // Listen for dropdown populated event to select existing values
    $('#motor_insurance_agency_code_id').on('dropdown:populated', function() {
      console.log('Agency dropdown populated, selecting existing value...');
      const agencySelect = this;

      // For direct mode, select the agency_code_id
      if (brokerCodeType === 'direct' && existingAgencyCodeId) {
        // Check if the option exists
        const optionExists = Array.from(agencySelect.options).some(opt => opt.value === existingAgencyCodeId);
        if (optionExists) {
          $(agencySelect).val(existingAgencyCodeId).trigger('change');
          console.log('✅ Selected existing agency code:', existingAgencyCodeId);
        } else {
          console.log('❌ Agency code option not found:', existingAgencyCodeId);
        }
      }
      // For broking mode, select the broker (which is stored as broker_X format)
      else if (brokerCodeType === 'broking' && existingBrokerId) {
        const brokerValue = 'broker_' + existingBrokerId;
        // Check if the option exists
        const optionExists = Array.from(agencySelect.options).some(opt => opt.value === brokerValue);
        if (optionExists) {
          $(agencySelect).val(brokerValue).trigger('change');
          console.log('✅ Selected existing broker:', brokerValue);
        } else {
          console.log('❌ Broker option not found:', brokerValue);
        }
      }
    });

    // Trigger broker code type change to load agency codes
    const brokerCodeSelect = document.getElementById('motor_insurance_broker_code_type');
    if (brokerCodeSelect && brokerCodeSelect.value) {
      setTimeout(function() {
        $(brokerCodeSelect).trigger('change');
        console.log('Triggered broker code type change for edit form');
        // The agency code will be selected automatically via the dropdown:populated event
      }, 500); // Small delay to allow customer change to complete first
    }
  <% end %>
});
</script>


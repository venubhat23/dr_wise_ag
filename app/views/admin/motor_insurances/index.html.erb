<!-- Custom styles for renewal button animation -->
<style>
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
    }
  }

  .pulse-animation {
    animation: pulse 1.5s infinite;
  }

  .btn-danger.pulse-animation:hover {
    animation: none;
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  /* Enhanced button styles */
  .btn-success:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  .btn-primary:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  .btn-warning:hover {
    transform: scale(1.05);
    transition: transform 0.2s;
  }

  /* Enhanced renewal button styles */
  .btn-success.text-white.fw-bold {
    background-color: #198754 !important;
    border-color: #198754 !important;
    color: white !important;
    font-weight: bold !important;
  }

  .btn-warning.text-dark.fw-bold {
    background-color: #ffc107 !important;
    border-color: #ffc107 !important;
    color: #212529 !important;
    font-weight: bold !important;
  }

  .btn-danger {
    background-color: #dc3545 !important;
    border-color: #dc3545 !important;
    color: white !important;
    font-weight: bold !important;
  }

  /* Hover effects for renewal buttons */
  .btn-success.text-white.fw-bold:hover {
    background-color: #157347 !important;
    border-color: #146c43 !important;
    transform: scale(1.05);
  }

  .btn-warning.text-dark.fw-bold:hover {
    background-color: #ffcd39 !important;
    border-color: #ffc720 !important;
    transform: scale(1.05);
  }

  .btn-danger:hover {
    background-color: #bb2d3b !important;
    border-color: #b02a37 !important;
    transform: scale(1.05);
  }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Motor Insurance Policies</h2>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_admin_motor_insurance_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Motor Policy
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Motor Policies</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_policies || 0) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-car-front text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Premium</h6>
            <h3 class="mb-0 text-success"><%= indian_currency(@total_premium || 0) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total IDV</h6>
            <h3 class="mb-0 text-info"><%= indian_currency(@motor_insurances.sum(&:total_idv) || 0) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-shield-check text-info fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Vehicles</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@motor_insurances.count) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-car-front-fill text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tabs for DrWise vs Non-DrWise -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <ul class="nav nav-tabs border-0" role="tablist">
      <li class="nav-item" role="presentation">
        <%= link_to admin_motor_insurances_path(tab: 'drwise', search: params[:search], vehicle_type: params[:vehicle_type], payment_mode: params[:payment_mode]),
            class: "nav-link #{'active' if @current_tab == 'drwise'}",
            role: "tab" do %>
          <i class="bi bi-check-circle me-2"></i>
          DrWise Policies
          <span class="badge bg-success ms-2"><%= @drwise_count %></span>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to admin_motor_insurances_path(tab: 'non_drwise', search: params[:search], vehicle_type: params[:vehicle_type], payment_mode: params[:payment_mode]),
            class: "nav-link #{'active' if @current_tab == 'non_drwise'}",
            role: "tab" do %>
          <i class="bi bi-x-circle me-2"></i>
          Non-DrWise Policies
          <span class="badge bg-warning ms-2"><%= @non_drwise_count %></span>
        <% end %>
      </li>
    </ul>
  </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_motor_insurances_path, method: :get, local: true, class: "row g-3" do |form| %>
      <%= form.hidden_field :tab, value: @current_tab %>
      <div class="col-md-4">
        <%= form.text_field :search, placeholder: "Search policies...", value: params[:search], class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= form.select :vehicle_type, options_for_select([
          ['All Vehicle Types', ''],
          ['Car', 'Car'],
          ['Bike', 'Bike'],
          ['Truck', 'Truck'],
          ['Bus', 'Bus']
        ], params[:vehicle_type]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-3">
        <%= form.select :payment_mode, options_for_select([
          ['All Payment Modes', ''],
          ['Yearly', 'yearly'],
          ['Half Yearly', 'half_yearly'],
          ['Quarterly', 'quarterly'],
          ['Monthly', 'monthly']
        ], params[:payment_mode]), {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= form.submit "Filter", class: "btn btn-outline-primary w-100" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Motor Insurance Policies List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">
      <% if @current_tab == 'drwise' %>
        <i class="bi bi-check-circle text-success me-2"></i>DrWise Motor Insurance Policies
      <% else %>
        <i class="bi bi-x-circle text-warning me-2"></i>Non-DrWise Motor Insurance Policies
      <% end %>
    </h5>
  </div>
  <div class="card-body p-0">
    <% if @motor_insurances.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Policy</th>
              <th class="border-0">Vehicle</th>
              <th class="border-0">Customer</th>
              <th class="border-0">Source & Type</th>
              <th class="border-0">Coverage</th>
              <th class="border-0">Premium</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @motor_insurances.each do |policy| %>
              <tr>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.policy_number %></h6>
                    <small class="text-muted"><%= policy.policy_type&.humanize %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.registration_number %></h6>
                    <small class="text-muted"><%= policy.class_of_vehicle %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <h6 class="mb-1"><%= policy.customer&.display_name %></h6>
                    <small class="text-muted"><%= policy.customer&.email %></small>
                  </div>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <!-- Source Badge -->
                    <div>
                      <% if policy.is_customer_added? %>
                        <span class="badge bg-info-subtle text-info">
                          <i class="bi bi-person-check me-1"></i>Customer
                        </span>
                      <% elsif policy.is_agent_added? %>
                        <span class="badge bg-success-subtle text-success">
                          <i class="bi bi-person-badge me-1"></i>Agent
                        </span>
                      <% elsif policy.is_admin_added? %>
                        <span class="badge bg-primary-subtle text-primary">
                          <i class="bi bi-shield-check me-1"></i>Admin
                        </span>
                      <% else %>
                        <span class="badge bg-secondary-subtle text-secondary">
                          <i class="bi bi-question-circle me-1"></i>Unknown
                        </span>
                      <% end %>
                    </div>
                    <!-- Type Badge -->
                    <div>
                      <span class="badge bg-light text-dark border">
                        <i class="bi bi-car-front me-1"></i><%= policy.vehicle_type %>
                      </span>
                    </div>
                  </div>
                </td>
                <td>
                  <div>
                    <div class="fw-bold"><%= indian_currency(policy.total_idv) if policy.total_idv %></div>
                    <small class="text-muted">Total IDV</small>
                  </div>
                </td>
                <td>
                  <div>
                    <div class="fw-bold"><%= indian_currency(policy.total_premium) %></div>
                    <small class="text-muted"><%= policy.payment_mode&.humanize %></small>
                  </div>
                </td>
                <td>
                  <% if policy.active? %>
                    <span class="badge bg-success">Active</span>
                  <% elsif policy.expired? %>
                    <span class="badge bg-danger">Expired</span>
                  <% elsif policy.expiring_soon? %>
                    <span class="badge bg-warning">Expiring Soon</span>
                  <% else %>
                    <span class="badge bg-info">Active</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <% if can_view?('motor_insurances') %>
                      <%= link_to admin_motor_insurance_path(policy), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    <% end %>
                    <% if can_edit?('motor_insurances') %>
                      <%= link_to edit_admin_motor_insurance_path(policy), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>

                    <!-- Renewal Status -->
                    <% if policy.has_been_renewed? %>
                      <!-- Show "Renewed" indicator for renewed policies -->
                      <span class="btn btn-sm btn-success disabled" title="This policy has been renewed">
                        <i class="bi bi-check-circle"></i>
                        <span class="d-none d-md-inline ms-1">Renewed</span>
                      </span>
                    <% elsif policy.can_be_renewed? %>
                      <!-- Show Renew button for eligible policies -->
                      <% days_to_expiry = (policy.policy_end_date - Date.current).to_i %>
                      <%
                        # Bright, high-contrast colors based on urgency for better visibility
                        if days_to_expiry <= 7
                          button_class = 'btn-danger'  # Red for urgent (7 days or less)
                        elsif days_to_expiry <= 30
                          button_class = 'btn-warning text-dark fw-bold'  # Yellow with dark bold text for medium urgency
                        else
                          button_class = 'btn-success text-white fw-bold'  # Green with white bold text for normal
                        end
                      %>
                      <% if can_edit?('motor_insurances') %>
                        <%= link_to renew_admin_motor_insurance_path(policy),
                            class: "btn btn-sm #{button_class}",
                            title: "Renew Policy (#{days_to_expiry} days to expiry)",
                            style: "min-width: 70px;" do %>
                          <i class="bi bi-arrow-clockwise"></i>
                          <span class="d-none d-md-inline ms-1">Renew</span>
                        <% end %>
                      <% end %>
                    <% elsif policy.is_renewal? %>
                      <!-- Show indicator for renewal policies -->
                      <span class="btn btn-sm btn-outline-secondary disabled" title="This is a renewal policy">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="d-none d-md-inline ms-1">Renewal</span>
                      </span>
                    <% end %>

                    <% if can_delete?('motor_insurances') %>
                      <%= link_to admin_motor_insurance_path(policy), method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          title: "Delete",
                          data: {
                            confirm: "Are you sure you want to delete this motor insurance policy?",
                            turbo_method: :delete
                          } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if respond_to?(:paginate) && @motor_insurances.respond_to?(:current_page) %>
        <div class="card-footer bg-transparent border-0">
          <%= paginate @motor_insurances %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-car-front fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No motor insurance policies found</h5>
        <p class="text-muted mb-3">
          <% if params[:search].present? || params[:vehicle_type].present? || params[:payment_mode].present? %>
            Try adjusting your search criteria or
            <%= link_to "view all policies", admin_motor_insurances_path, class: "text-decoration-none" %>.
          <% else %>
            Start by adding your first motor insurance policy to the system.
          <% end %>
        </p>
        <% if can_create?('motor_insurances') %>
          <%= link_to new_admin_motor_insurance_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i>
            Add First Motor Policy
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
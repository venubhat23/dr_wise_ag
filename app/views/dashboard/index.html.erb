  }

  /* Color classes */
  .blue-gradient { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
  .green-gradient { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
  .orange-gradient { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
  .pink-gradient { background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); }

  /* Modal Styles - Same as Affiliate Payouts */
  .modal-backdrop {
    display: none !important;
  }

  .dashboard-modal.show {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .dashboard-modal.fade:not(.show) {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Hide everything behind the modal */
  body.modal-open {
    overflow: hidden !important;
  }

  .dashboard-modal.show ~ * {
    pointer-events: none !important;
  }

  .dashboard-modal .modal-header {
    flex-shrink: 0 !important;
  }

  .dashboard-modal .modal-footer {
    flex-shrink: 0 !important;
  }

  .dashboard-modal {

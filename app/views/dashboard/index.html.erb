<!-- Chart.js for interactive charts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.js"></script>
<!-- Additional Chart.js plugins -->
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>

<style>
  .dashboard-container {
    padding: 2rem;
    background: linear-gradient(135deg, #f8f9ff 0%, #e9ecef 100%);
    min-height: 100vh;
  }

  .dashboard-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    padding: 2.5rem;
    margin-bottom: 3rem;
    transition: all 0.4s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .dashboard-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
  }

  .stat-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--card-gradient);
    border-radius: 20px 20px 0 0;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0.75rem 0;
    background: var(--text-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    background: var(--icon-gradient);
    color: white;
    font-size: 1.5rem;
    box-shadow: 0 8px 20px var(--icon-shadow);
  }

  .chart-card {
    background: white;
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    margin-bottom: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.4s ease;
  }

  .chart-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
  }

  .chart-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
  }

  .chart-title::before {
    content: '';
    width: 6px;
    height: 30px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    margin-right: 1rem;
    border-radius: 3px;
  }

  .recent-activity-item {
    display: flex;
    align-items: center;
    padding: 1.5rem;
    border-radius: 15px;
    background: #f8fafc;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(226, 232, 240, 0.5);
  }

  .recent-activity-item:hover {
    background: #e2e8f0;
    transform: translateX(8px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .activity-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1.5rem;
    background: var(--activity-gradient);
    color: white;
    font-size: 1.2rem;
    box-shadow: 0 5px 15px var(--activity-shadow);
  }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }

  @media (max-width: 1400px) {
    .grid-4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1200px) {
    .grid-4, .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
    .dashboard-container { padding: 1rem; }
  }

  .pulse {
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.05); }
  }

  /* Custom gradient variables */
  :root {
    --gradient-blue: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --gradient-green: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    --gradient-red: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
    --gradient-yellow: linear-gradient(135deg, #ffc107 0%, #ff8f00 100%);
    --gradient-purple: linear-gradient(135deg, #8360c3 0%, #2ebf91 100%);
    --gradient-orange: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
    --gradient-cyan: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
    --gradient-pink: linear-gradient(135deg, #fc466b 0%, #3f5efb 100%);
  }

  .chart-container {
    position: relative;
    height: 400px;
  }

  .chart-container.small {
    height: 300px;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 2rem;
    text-align: center;
  }
</style>

<div class="dashboard-container">
  <!-- Stats Cards -->
  <div class="grid-4">
    <!-- Total Customers -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-blue);
                --icon-gradient: var(--gradient-blue);
                --icon-shadow: rgba(102, 126, 234, 0.3);
                --text-gradient: var(--gradient-blue);">
      <div class="stat-icon">
        <i class="bi bi-people-fill"></i>
      </div>
      <div class="stat-value pulse"><%= number_with_delimiter(@total_customers) %></div>
      <div class="stat-label">Total Customers</div>
    </div>

    <!-- Total Agents -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-green);
                --icon-gradient: var(--gradient-green);
                --icon-shadow: rgba(17, 153, 142, 0.3);
                --text-gradient: var(--gradient-green);">
      <div class="stat-icon">
        <i class="bi bi-person-badge-fill"></i>
      </div>
      <div class="stat-value pulse"><%= number_with_delimiter(@total_agents) %></div>
      <div class="stat-label">Active Agents</div>
    </div>

    <!-- Total Policies -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-red);
                --icon-gradient: var(--gradient-red);
                --icon-shadow: rgba(255, 65, 108, 0.3);
                --text-gradient: var(--gradient-red);">
      <div class="stat-icon">
        <i class="bi bi-file-earmark-text-fill"></i>
      </div>
      <div class="stat-value pulse"><%= number_with_delimiter(@total_policies) %></div>
      <div class="stat-label">Total Policies</div>
    </div>

    <!-- Total Premium Collected -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-yellow);
                --icon-gradient: var(--gradient-yellow);
                --icon-shadow: rgba(255, 193, 7, 0.3);
                --text-gradient: var(--gradient-yellow);">
      <div class="stat-icon">
        <i class="bi bi-currency-rupee"></i>
      </div>
      <div class="stat-value pulse">
        <% if @total_premium_collected > 1000000 %>
          ₹<%= (@total_premium_collected / 1000000.0).round(1) %>M
        <% elsif @total_premium_collected > 1000 %>
          ₹<%= (@total_premium_collected / 1000.0).round(1) %>K
        <% else %>
          ₹<%= number_with_delimiter(@total_premium_collected.to_i) %>
        <% end %>
      </div>
      <div class="stat-label">Premium Collected</div>
    </div>

    <!-- Total Sum Insured -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-purple);
                --icon-gradient: var(--gradient-purple);
                --icon-shadow: rgba(131, 96, 195, 0.3);
                --text-gradient: var(--gradient-purple);">
      <div class="stat-icon">
        <i class="bi bi-shield-check"></i>
      </div>
      <div class="stat-value pulse">
        <% if @total_sum_insured > 1000000 %>
          ₹<%= (@total_sum_insured / 1000000.0).round(1) %>M
        <% elsif @total_sum_insured > 1000 %>
          ₹<%= (@total_sum_insured / 1000.0).round(1) %>K
        <% else %>
          ₹<%= number_with_delimiter(@total_sum_insured.to_i) %>
        <% end %>
      </div>
      <div class="stat-label">Sum Insured</div>
    </div>

    <!-- Total Leads -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-orange);
                --icon-gradient: var(--gradient-orange);
                --icon-shadow: rgba(255, 154, 158, 0.3);
                --text-gradient: var(--gradient-orange);">
      <div class="stat-icon">
        <i class="bi bi-funnel"></i>
      </div>
      <div class="stat-value pulse"><%= number_with_delimiter(@total_leads) %></div>
      <div class="stat-label">Total Leads</div>
    </div>

    <!-- Renewals Due -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-cyan);
                --icon-gradient: var(--gradient-cyan);
                --icon-shadow: rgba(0, 198, 255, 0.3);
                --text-gradient: var(--gradient-cyan);">
      <div class="stat-icon">
        <i class="bi bi-clock-history"></i>
      </div>
      <div class="stat-value pulse"><%= number_with_delimiter(@renewal_due_count) %></div>
      <div class="stat-label">Renewals Due</div>
    </div>

    <!-- Pending Payouts -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-pink);
                --icon-gradient: var(--gradient-pink);
                --icon-shadow: rgba(252, 70, 107, 0.3);
                --text-gradient: var(--gradient-pink);">
      <div class="stat-icon">
        <i class="bi bi-cash-coin"></i>
      </div>
      <div class="stat-value pulse">
        <% if @pending_payouts > 1000000 %>
          ₹<%= (@pending_payouts / 1000000.0).round(1) %>M
        <% elsif @pending_payouts > 1000 %>
          ₹<%= (@pending_payouts / 1000.0).round(1) %>K
        <% else %>
          ₹<%= number_with_delimiter(@pending_payouts.to_i) %>
        <% end %>
      </div>
      <div class="stat-label">Pending Payouts</div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid-2">
    <!-- Policy Type Distribution -->
    <div class="chart-card">
      <h3 class="chart-title">Policy Type Distribution</h3>
      <div class="chart-container small">
        <canvas id="policyDistributionChart"></canvas>
      </div>
    </div>

    <!-- Premium Collection Trend -->
    <div class="chart-card">
      <h3 class="chart-title">Premium Collection Trend</h3>
      <div class="chart-container small">
        <canvas id="premiumTrendChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Second Row of Charts -->
  <div class="grid-3">
    <!-- Lead Conversion Funnel -->
    <div class="chart-card">
      <h3 class="chart-title">Lead Conversion Funnel</h3>
      <div class="chart-container small">
        <canvas id="leadFunnelChart"></canvas>
      </div>
    </div>

    <!-- Renewal Status Overview -->
    <div class="chart-card">
      <h3 class="chart-title">Renewal Status Overview</h3>
      <div class="chart-container small">
        <canvas id="renewalStatusChart"></canvas>
      </div>
    </div>

    <!-- Referral Settlement Report -->
    <div class="chart-card">
      <h3 class="chart-title">Referral Settlement Status</h3>
      <div class="chart-container small">
        <canvas id="referralChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Third Row - Agent Performance and Commission -->
  <div class="grid-2">
    <!-- Agent Performance -->
    <div class="chart-card">
      <h3 class="chart-title">Top Agent Performance</h3>
      <div class="chart-container">
        <canvas id="agentPerformanceChart"></canvas>
      </div>
    </div>

    <!-- Commission Summary -->
    <div class="chart-card">
      <h3 class="chart-title">Commission Summary</h3>
      <div class="chart-container">
        <canvas id="commissionChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Customer Location Analysis -->
  <div class="chart-card">
    <h3 class="chart-title">Customer Geographic Distribution</h3>
    <div class="chart-container">
      <canvas id="locationChart"></canvas>
    </div>
  </div>

  <!-- Recent Activities -->
  <div class="chart-card">
    <h3 class="chart-title">Recent Activities</h3>
    <div style="max-height: 400px; overflow-y: auto;">
      <% if @recent_policies.any? %>
        <% @recent_policies.each do |policy| %>
          <div class="recent-activity-item">
            <div class="activity-icon"
                 style="--activity-gradient: var(--gradient-blue);
                        --activity-shadow: rgba(102, 126, 234, 0.3);">
              <i class="bi bi-file-earmark-plus"></i>
            </div>
            <div>
              <div style="font-weight: 600; color: #1a202c;">New <%= policy.class.name.underscore.humanize %> Created</div>
              <div style="color: #718096; font-size: 0.95rem;">
                <%= policy.customer&.display_name || "Customer" %> -
                <%= policy.try(:plan_name) || policy.try(:policy_number) || "Policy" %>
              </div>
              <div style="color: #a0aec0; font-size: 0.85rem;"><%= time_ago_in_words(policy.created_at) %> ago</div>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @recent_customers.any? %>
        <% @recent_customers.first(3).each do |customer| %>
          <div class="recent-activity-item">
            <div class="activity-icon"
                 style="--activity-gradient: var(--gradient-green);
                        --activity-shadow: rgba(17, 153, 142, 0.3);">
              <i class="bi bi-person-plus-fill"></i>
            </div>
            <div>
              <div style="font-weight: 600; color: #1a202c;">New Customer Registered</div>
              <div style="color: #718096; font-size: 0.95rem;"><%= customer.display_name %> - <%= customer.city || "Location N/A" %></div>
              <div style="color: #a0aec0; font-size: 0.85rem;"><%= time_ago_in_words(customer.created_at) %> ago</div>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @recent_leads.any? %>
        <% @recent_leads.first(2).each do |lead| %>
          <div class="recent-activity-item">
            <div class="activity-icon"
                 style="--activity-gradient: var(--gradient-orange);
                        --activity-shadow: rgba(255, 154, 158, 0.3);">
              <i class="bi bi-funnel-fill"></i>
            </div>
            <div>
              <div style="font-weight: 600; color: #1a202c;">Lead <%= lead.current_stage&.humanize || "Created" %></div>
              <div style="color: #718096; font-size: 0.95rem;"><%= lead.display_name %> - <%= lead.insurance_interest || "Insurance" %></div>
              <div style="color: #a0aec0; font-size: 0.85rem;"><%= time_ago_in_words(lead.created_at) %> ago</div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Quick Access Cards -->
  <div class="section-title" style="margin-top: 4rem;">Quick Access</div>
  <div class="grid-4">
    <!-- New Leads -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-pink);
                --icon-gradient: var(--gradient-pink);
                --icon-shadow: rgba(252, 70, 107, 0.3);
                --text-gradient: var(--gradient-pink);
                cursor: pointer;"
         onclick="window.location.href='/admin/leads'">
      <div class="stat-icon">
        <i class="bi bi-star"></i>
      </div>
      <div class="stat-value pulse"><%= @new_leads %></div>
      <div class="stat-label">New Leads (7 days)</div>
    </div>

    <!-- Client Requests -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-orange);
                --icon-gradient: var(--gradient-orange);
                --icon-shadow: rgba(255, 154, 158, 0.3);
                --text-gradient: var(--gradient-orange);
                cursor: pointer;"
         onclick="window.location.href='/admin/client_requests'">
      <div class="stat-icon">
        <i class="bi bi-chat-dots"></i>
      </div>
      <div class="stat-value pulse"><%= @client_requests_count %></div>
      <div class="stat-label">Client Requests</div>
    </div>

    <!-- Agent Commissions -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-green);
                --icon-gradient: var(--gradient-green);
                --icon-shadow: rgba(17, 153, 142, 0.3);
                --text-gradient: var(--gradient-green);
                cursor: pointer;"
         onclick="window.location.href='/admin/payouts'">
      <div class="stat-icon">
        <i class="bi bi-wallet2"></i>
      </div>
      <div class="stat-value pulse">
        <% if @commissions_due > 1000000 %>
          ₹<%= (@commissions_due / 1000000.0).round(1) %>M
        <% elsif @commissions_due > 1000 %>
          ₹<%= (@commissions_due / 1000.0).round(1) %>K
        <% else %>
          ₹<%= number_with_delimiter(@commissions_due.to_i) %>
        <% end %>
      </div>
      <div class="stat-label">Commissions Due</div>
    </div>

    <!-- Support Tickets -->
    <div class="stat-card"
         style="--card-gradient: var(--gradient-blue);
                --icon-gradient: var(--gradient-blue);
                --icon-shadow: rgba(102, 126, 234, 0.3);
                --text-gradient: var(--gradient-blue);
                cursor: pointer;"
         onclick="window.location.href='/admin/helpdesk'">
      <div class="stat-icon">
        <i class="bi bi-headset"></i>
      </div>
      <div class="stat-value pulse"><%= @support_tickets %></div>
      <div class="stat-label">Support Tickets</div>
    </div>
  </div>

  <!-- Renewal Policies Section -->
  <% if @renewal_policies.any? %>
    <div class="section-title" style="margin-top: 4rem;">Policies Due for Renewal</div>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="bg-light">
              <tr>
                <th>Customer</th>
                <th>Policy</th>
                <th>Type</th>
                <th>Expiry Date</th>
                <th>Premium</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @renewal_policies.each do |policy| %>
                <tr>
                  <td>
                    <h6 class="mb-1"><%= policy.customer&.display_name || "Unknown" %></h6>
                    <small class="text-muted"><%= policy.customer&.email || "" %></small>
                  </td>
                  <td>
                    <div class="mb-1"><%= policy.policy_number %></div>
                    <small class="text-muted"><%= policy.try(:plan_name) || policy.class.name.underscore.humanize %></small>
                  </td>
                  <td>
                    <span class="badge bg-primary"><%= policy.class.name.underscore.humanize %></span>
                  </td>
                  <td>
                    <% days_left = (policy.policy_end_date - Date.current).to_i if policy.policy_end_date %>
                    <div class="text-<%= days_left && days_left < 7 ? 'danger' : 'warning' %> fw-bold">
                      <%= policy.policy_end_date&.strftime('%d %b %Y') %>
                    </div>
                    <small class="text-muted"><%= days_left %> days left</small>
                  </td>
                  <td>₹<%= number_with_delimiter(policy.total_premium.to_i) %></td>
                  <td>
                    <span class="badge bg-<%= days_left && days_left < 7 ? 'danger' : 'warning' %>">
                      <%= days_left && days_left < 7 ? 'Urgent' : 'Due Soon' %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Display Banners if any -->
  <%= display_banners('dashboard') if defined?(display_banners) %>
</div>

<script>
  // Chart.js Global Configuration
  Chart.defaults.font.family = "'Poppins', sans-serif";
  Chart.defaults.font.size = 12;
  Chart.defaults.color = '#64748b';

  // Dynamic data from Ruby - ensure numeric values are parsed correctly
  const policyDistributionData = <%= @policy_type_distribution.to_json.html_safe %>;
  const premiumTrendData = <%= @premium_collection_trend.transform_values(&:to_f).to_json.html_safe %>;
  const leadFunnelData = <%= @lead_conversion_funnel.to_json.html_safe %>;
  const renewalStatusData = <%= @renewal_status.to_json.html_safe %>;
  const referralData = <%= @referral_status.to_json.html_safe %>;
  const agentPerformanceData = <%= @agent_performance.transform_values(&:to_f).to_json.html_safe %>;

  // Commission data needs special handling for nested structure
  const commissionData = {
    main_agent: <%= @commission_summary['main_agent'].transform_values(&:to_f).to_json.html_safe %>,
    sub_agent: <%= @commission_summary['sub_agent'].transform_values(&:to_f).to_json.html_safe %>,
    tds: <%= @commission_summary['tds'].transform_values(&:to_f).to_json.html_safe %>
  };

  const locationData = <%= @customer_location.to_json.html_safe %>;

  // Add empty data warning overlays
  function addNoDataMessage(chartId, message) {
    const canvas = document.getElementById(chartId);
    const container = canvas.parentNode;
    if (container.querySelector('.no-data-message')) return; // Already exists

    const noDataDiv = document.createElement('div');
    noDataDiv.className = 'no-data-message';
    noDataDiv.style.cssText = `
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      color: #a0aec0;
      font-size: 14px;
      font-weight: 500;
      z-index: 10;
      background: rgba(255,255,255,0.9);
      padding: 10px;
      border-radius: 8px;
    `;
    noDataDiv.innerHTML = `<i class="bi bi-info-circle me-2"></i>${message}`;
    container.style.position = 'relative';
    container.appendChild(noDataDiv);
  }

  // 1. Policy Type Distribution (Doughnut Chart)
  const policyCtx = document.getElementById('policyDistributionChart').getContext('2d');
  new Chart(policyCtx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(policyDistributionData),
      datasets: [{
        data: Object.values(policyDistributionData),
        backgroundColor: [
          'rgba(102, 126, 234, 0.8)',
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 65, 108, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(131, 96, 195, 0.8)'
        ],
        borderWidth: 3,
        borderColor: 'white',
        hoverOffset: 15
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 20,
            usePointStyle: true,
            pointStyle: 'circle'
          }
        }
      }
    }
  });

  // 2. Premium Collection Trend (Line Chart)
  const premiumCtx = document.getElementById('premiumTrendChart').getContext('2d');
  new Chart(premiumCtx, {
    type: 'line',
    data: {
      labels: Object.keys(premiumTrendData),
      datasets: [{
        label: 'Premium Collection (₹)',
        data: Object.values(premiumTrendData),
        borderColor: 'rgba(102, 126, 234, 1)',
        backgroundColor: 'rgba(102, 126, 234, 0.1)',
        borderWidth: 4,
        fill: true,
        tension: 0.4,
        pointBackgroundColor: 'rgba(102, 126, 234, 1)',
        pointBorderColor: '#fff',
        pointBorderWidth: 3,
        pointRadius: 6,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: { grid: { display: false } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000000) return '₹' + (value/1000000).toFixed(1) + 'M';
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        }
      }
    }
  });

  // 3. Lead Conversion Funnel (Bar Chart)
  const leadCtx = document.getElementById('leadFunnelChart').getContext('2d');
  const leadDataValues = Object.values(leadFunnelData);
  const hasLeadData = leadDataValues.some(val => val > 0);

  new Chart(leadCtx, {
    type: 'bar',
    data: {
      labels: Object.keys(leadFunnelData),
      datasets: [{
        label: 'Leads',
        data: hasLeadData ? leadDataValues : [1, 1, 1, 1, 1], // Show sample data if no real data
        backgroundColor: [
          'rgba(102, 126, 234, 0.8)',
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(255, 65, 108, 0.8)',
          'rgba(131, 96, 195, 0.8)'
        ],
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          enabled: hasLeadData
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, grid: { color: 'rgba(0, 0, 0, 0.05)' } }
      }
    }
  });

  // 4. Renewal Status Overview (Doughnut Chart)
  const renewalCtx = document.getElementById('renewalStatusChart').getContext('2d');
  new Chart(renewalCtx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(renewalStatusData),
      datasets: [{
        data: Object.values(renewalStatusData),
        backgroundColor: [
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(255, 65, 108, 0.8)'
        ],
        borderWidth: 3,
        borderColor: 'white'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 15, usePointStyle: true }
        }
      }
    }
  });

  // 5. Referral Settlement Status (Pie Chart)
  const referralCtx = document.getElementById('referralChart').getContext('2d');
  new Chart(referralCtx, {
    type: 'pie',
    data: {
      labels: Object.keys(referralData),
      datasets: [{
        data: Object.values(referralData),
        backgroundColor: [
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(102, 126, 234, 0.8)'
        ],
        borderWidth: 2,
        borderColor: 'white'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 15, usePointStyle: true }
        }
      }
    }
  });

  // 6. Agent Performance (Horizontal Bar Chart)
  const agentCtx = document.getElementById('agentPerformanceChart').getContext('2d');
  const agentLabels = Object.keys(agentPerformanceData);
  const agentValues = Object.values(agentPerformanceData);
  const hasAgentData = agentLabels.length > 0 && agentValues.some(val => val > 0);

  new Chart(agentCtx, {
    type: 'bar',
    data: {
      labels: hasAgentData ? agentLabels : ['Agent 1', 'Agent 2', 'Agent 3'],
      datasets: [{
        label: 'Premium Amount (₹)',
        data: hasAgentData ? agentValues : [100000, 80000, 60000],
        backgroundColor: 'rgba(102, 126, 234, 0.8)',
        borderColor: 'rgba(102, 126, 234, 1)',
        borderWidth: 2,
        borderRadius: 6
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { enabled: hasAgentData }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000000) return '₹' + (value/1000000).toFixed(1) + 'M';
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        },
        y: { grid: { display: false } }
      }
    }
  });

  // 7. Commission Summary (Stacked Bar Chart)
  const commissionCtx = document.getElementById('commissionChart').getContext('2d');
  const months = Object.keys(commissionData.main_agent || {});
  const hasCommissionData = months.length > 0 && months.some(m =>
    (commissionData.main_agent[m] || 0) + (commissionData.sub_agent[m] || 0) + (commissionData.tds[m] || 0) > 0
  );

  new Chart(commissionCtx, {
    type: 'bar',
    data: {
      labels: hasCommissionData ? months : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
      datasets: [
        {
          label: 'Main Agent Commission',
          data: hasCommissionData ? months.map(m => commissionData.main_agent[m] || 0) : [5000, 7000, 6000, 8000, 9000, 12000],
          backgroundColor: 'rgba(102, 126, 234, 0.8)',
        },
        {
          label: 'Sub-Agent Commission',
          data: hasCommissionData ? months.map(m => commissionData.sub_agent[m] || 0) : [2000, 3000, 2500, 4000, 3500, 5000],
          backgroundColor: 'rgba(17, 153, 142, 0.8)',
        },
        {
          label: 'TDS Deducted',
          data: hasCommissionData ? months.map(m => commissionData.tds[m] || 0) : [700, 1000, 850, 1200, 1250, 1700],
          backgroundColor: 'rgba(255, 65, 108, 0.8)',
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { stacked: true, grid: { display: false } },
        y: {
          stacked: true,
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function(value) {
              if (value > 1000) return '₹' + (value/1000).toFixed(0) + 'K';
              return '₹' + value;
            }
          }
        }
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 20, usePointStyle: true }
        },
        tooltip: { enabled: hasCommissionData }
      }
    }
  });

  // 8. Customer Location Distribution (Bar Chart)
  const locationCtx = document.getElementById('locationChart').getContext('2d');
  new Chart(locationCtx, {
    type: 'bar',
    data: {
      labels: Object.keys(locationData),
      datasets: [{
        label: 'Number of Customers',
        data: Object.values(locationData),
        backgroundColor: [
          'rgba(102, 126, 234, 0.8)',
          'rgba(17, 153, 142, 0.8)',
          'rgba(255, 193, 7, 0.8)',
          'rgba(255, 65, 108, 0.8)',
          'rgba(131, 96, 195, 0.8)',
          'rgba(255, 154, 158, 0.8)',
          'rgba(0, 198, 255, 0.8)',
          'rgba(252, 70, 107, 0.8)'
        ],
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' }
        }
      }
    }
  });

  // Add no-data messages for empty charts after all charts are created
  if (!hasLeadData) {
    addNoDataMessage('leadFunnelChart', 'No lead data available');
  }
  if (!hasAgentData) {
    addNoDataMessage('agentPerformanceChart', 'No agent performance data');
  }
  if (!hasCommissionData) {
    addNoDataMessage('commissionChart', 'No commission data available');
  }

  // Real-time updates functionality
  let updateInterval;
  let isUpdating = false;

  // Add loading indicators to cards
  function addLoadingIndicator(cardElement) {
    if (cardElement.querySelector('.loading-indicator')) return;

    const indicator = document.createElement('div');
    indicator.className = 'loading-indicator';
    indicator.innerHTML = '<i class="bi bi-arrow-clockwise"></i>';
    indicator.style.cssText = `
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.9);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: #667eea;
      animation: spin 1s linear infinite;
      z-index: 100;
    `;
    cardElement.style.position = 'relative';
    cardElement.appendChild(indicator);
  }

  function removeLoadingIndicator(cardElement) {
    const indicator = cardElement.querySelector('.loading-indicator');
    if (indicator) indicator.remove();
  }

  // Format currency for display
  function formatCurrency(amount) {
    if (amount > 1000000) {
      return '₹' + (amount / 1000000).toFixed(1) + 'M';
    } else if (amount > 1000) {
      return '₹' + (amount / 1000).toFixed(1) + 'K';
    } else {
      return '₹' + amount.toLocaleString();
    }
  }

  // Update dashboard stats
  function updateDashboardStats() {
    if (isUpdating) return;
    isUpdating = true;

    // Get all stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => addLoadingIndicator(card));

    fetch('/dashboard/stats', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      // Update Client Requests card (4th quick access card)
      const clientRequestsCard = document.querySelector('[onclick*="client_requests"] .stat-value');
      if (clientRequestsCard) {
        clientRequestsCard.textContent = data.client_requests_count.toLocaleString();
      }

      // Update Commissions Due card (3rd quick access card)
      const commissionsCard = document.querySelector('[onclick*="payouts"] .stat-value');
      if (commissionsCard) {
        commissionsCard.textContent = formatCurrency(data.commissions_due);
      }

      // Update Support Tickets card (4th quick access card)
      const supportCard = document.querySelector('[onclick*="helpdesk"] .stat-value');
      if (supportCard) {
        supportCard.textContent = data.support_tickets.toLocaleString();
      }

      // Update other main stat cards
      const totalCustomersCard = document.querySelector('.stat-card:first-child .stat-value');
      if (totalCustomersCard) {
        totalCustomersCard.textContent = data.total_customers.toLocaleString();
      }

      // Add last updated time indicator
      updateLastUpdatedTime(data.last_updated);

      // Add brief flash effect to updated cards
      statCards.forEach(card => {
        card.style.transition = 'all 0.3s ease';
        card.style.transform = 'scale(1.02)';
        setTimeout(() => {
          card.style.transform = 'scale(1)';
        }, 200);
      });

      console.log('Dashboard updated at:', data.last_updated);
    })
    .catch(error => {
      console.error('Error updating dashboard:', error);
      showUpdateError();
    })
    .finally(() => {
      isUpdating = false;
      statCards.forEach(card => removeLoadingIndicator(card));
    });
  }

  // Add last updated time display
  function addLastUpdatedDisplay() {
    const container = document.querySelector('.dashboard-container');
    const updateDisplay = document.createElement('div');
    updateDisplay.id = 'lastUpdated';
    updateDisplay.style.cssText = `
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: rgba(255,255,255,0.95);
      padding: 8px 15px;
      border-radius: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      font-size: 12px;
      color: #64748b;
      border: 1px solid rgba(102, 126, 234, 0.1);
      z-index: 1000;
    `;
    updateDisplay.innerHTML = '<i class="bi bi-clock me-1"></i>Last updated: Just now';
    container.appendChild(updateDisplay);
  }

  function updateLastUpdatedTime(time) {
    const display = document.getElementById('lastUpdated');
    if (display) {
      display.innerHTML = `<i class="bi bi-clock me-1"></i>Last updated: ${time}`;
      display.style.background = 'rgba(102, 126, 234, 0.1)';
      setTimeout(() => {
        display.style.background = 'rgba(255,255,255,0.95)';
      }, 1000);
    }
  }

  function showUpdateError() {
    const display = document.getElementById('lastUpdated');
    if (display) {
      display.innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>Update failed';
      display.style.background = 'rgba(255, 193, 7, 0.1)';
    }
  }

  // Add control panel for real-time updates
  function addUpdateControls() {
    const container = document.querySelector('.dashboard-container');
    const controls = document.createElement('div');
    controls.style.cssText = `
      position: fixed;
      bottom: 70px;
      right: 20px;
      background: rgba(255,255,255,0.95);
      padding: 10px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      border: 1px solid rgba(102, 126, 234, 0.1);
      z-index: 1000;
    `;

    controls.innerHTML = `
      <div style="display: flex; gap: 10px; align-items: center;">
        <button id="toggleUpdates" class="btn btn-sm btn-primary">
          <i class="bi bi-pause-fill"></i> Auto-refresh: ON
        </button>
        <button id="manualUpdate" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
    `;

    container.appendChild(controls);

    // Add event listeners
    document.getElementById('toggleUpdates').addEventListener('click', toggleAutoUpdates);
    document.getElementById('manualUpdate').addEventListener('click', updateDashboardStats);
  }

  function toggleAutoUpdates() {
    const button = document.getElementById('toggleUpdates');

    if (updateInterval) {
      clearInterval(updateInterval);
      updateInterval = null;
      button.innerHTML = '<i class="bi bi-play-fill"></i> Auto-refresh: OFF';
      button.className = 'btn btn-sm btn-outline-primary';
    } else {
      startAutoUpdates();
      button.innerHTML = '<i class="bi bi-pause-fill"></i> Auto-refresh: ON';
      button.className = 'btn btn-sm btn-primary';
    }
  }

  function startAutoUpdates() {
    updateInterval = setInterval(updateDashboardStats, 30000); // Update every 30 seconds
  }

  // Add spinning animation for loading
  const style = document.createElement('style');
  style.textContent = `
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  `;
  document.head.appendChild(style);

  // Initialize real-time updates
  addLastUpdatedDisplay();
  addUpdateControls();
  startAutoUpdates();

  // Update immediately on page load
  setTimeout(updateDashboardStats, 2000);
</script>
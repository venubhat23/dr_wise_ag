                          </td>
                        </tr>
                      `;
                    }).join('') : '<tr><td colspan="3" style="font-weight: 600;">No data available</td></tr>'}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          ${data.source_conversion && data.source_conversion.length > 0 ? `
            <div class="mt-3">
              <h5 style="font-weight: bold; color: #333;">Lead Source Performance</h5>
              <div class="table-responsive">
                <table class="table table-sm table-hover" style="background: white; border-radius: 8px; overflow: hidden;">
                  <thead style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <tr>
                      <th style="color: white; font-weight: bold; border: none;">Source</th>
                      <th style="color: white; font-weight: bold; border: none;">Total</th>
                      <th style="color: white; font-weight: bold; border: none;">Converted</th>
                      <th style="color: white; font-weight: bold; border: none;">Conversion Rate</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${data.source_conversion.map(source => `
                      <tr style="background: rgba(240, 147, 251, 0.05);">
                        <td style="font-weight: 600; color: #333;">
                          <span class="badge bg-dark" style="font-weight: bold; font-size: 0.9rem; padding: 0.4rem 0.7rem;">
                            ${source.source.toUpperCase()}
                          </span>
                        </td>
                        <td style="font-weight: bold; color: #f093fb; font-size: 1.05rem;"><strong>${source.total}</strong></td>
                        <td style="font-weight: bold; color: #11998e; font-size: 1.05rem;"><strong>${source.converted}</strong></td>
                        <td><span class="badge ${source.rate > 30 ? 'bg-success' : source.rate > 15 ? 'bg-warning text-dark' : 'bg-danger'}" style="font-weight: bold; font-size: 0.95rem; padding: 0.4rem 0.6rem;">${source.rate}%</span></td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          ` : ''}
        `;
      } else {
        content.innerHTML = '<div class="alert alert-danger">Error loading lead conversion data</div>';
      }
    })
    .catch(error => {
      loading.style.display = 'none';
      content.style.display = 'block';
      content.innerHTML = '<div class="alert alert-danger">Error loading data. Please try again.</div>';
      console.error('Error:', error);
    });
}


<%# One column per financial year (2026 = FY Apr 2026 – Mar 2027). Paid years get a
    check mark; admin can add old/new years and mark any year paid with an amount. %>
<% current_fy = Date.current.month >= 4 ? Date.current.year : Date.current.year - 1 %>
<div class="card border-0 shadow-sm mb-4" id="yearly-payments">
  <div class="card-header bg-white border-0 pt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h5 class="mb-0"><i class="bi bi-calendar-check text-success me-2"></i>Yearly Payments</h5>
      <small class="text-muted">
        <%= payouts.size %> of <%= years.size %> <%= 'year'.pluralize(years.size) %> paid
        · Total paid <strong class="text-success"><%= indian_currency(payouts.values.sum(&:amount)) %></strong>
      </small>
    </div>
    <%= form_with url: add_payout_year_admin_investor_path(investor), method: :post, class: "d-flex gap-2 align-items-center" do %>
      <input type="number" name="financial_year" class="form-control form-control-sm" style="width: 110px"
             placeholder="Year" min="2000" max="<%= Date.current.year + 10 %>" required
             value="<%= (years.max || current_fy) + 1 %>">
      <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>Add year</button>
    <% end %>
  </div>

  <div class="card-body pt-2">
    <% if years.empty? %>
      <div class="text-center text-muted py-4">No years yet. Add a year to start tracking payments.</div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle text-center mb-0 yp-table">
          <thead class="table-light">
            <tr>
              <th class="text-start" style="min-width: 110px">Year</th>
              <% years.each do |fy| %>
                <th style="min-width: 130px">
                  <div class="fs-6"><%= fy %></div>
                  <small class="text-muted fw-normal">Apr <%= fy.to_s.last(2) %> – Mar <%= (fy + 1).to_s.last(2) %></small>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th class="text-start">Status</th>
              <% years.each do |fy| %>
                <td class="<%= payouts[fy] ? 'table-success' : '' %>">
                  <% if payouts[fy] %>
                    <i class="bi bi-check-circle-fill text-success fs-4" title="Paid"></i>
                  <% else %>
                    <i class="bi bi-x-circle text-secondary fs-4" title="Not paid"></i>
                  <% end %>
                </td>
              <% end %>
            </tr>
            <tr>
              <th class="text-start">Amount</th>
              <% years.each do |fy| %>
                <td>
                  <% if payouts[fy] %>
                    <strong class="text-success"><%= indian_currency(payouts[fy].amount) %></strong>
                  <% elsif due[fy].to_f.positive? %>
                    <span class="text-muted" title="Shares × per share for this year"><%= indian_currency(due[fy]) %> due</span>
                  <% else %>
                    <span class="text-muted">–</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
            <tr>
              <th class="text-start">Paid on</th>
              <% years.each do |fy| %>
                <td><small><%= payouts[fy] ? payouts[fy].paid_at.in_time_zone.strftime('%d %b %Y') : '–' %></small></td>
              <% end %>
            </tr>
            <tr>
              <th class="text-start">Action</th>
              <% years.each do |fy| %>
                <td>
                  <% if payouts[fy] %>
                    <%= button_to unpay_yearly_admin_investor_path(investor, financial_year: fy, from: 'yearly_payments'), method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "Mark #{fy} as NOT paid for #{investor.full_name}?" } } do %>
                      <i class="bi bi-arrow-counterclockwise"></i> Undo
                    <% end %>
                  <% else %>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#ypPayModal"
                            data-yp-year="<%= fy %>" data-yp-amount="<%= due[fy].to_f.positive? ? due[fy].to_f : '' %>">
                      <i class="bi bi-check2"></i> Mark paid
                    </button>
                    <% if investor.payout_years.include?(fy) && !due.key?(fy) %>
                      <%= button_to remove_payout_year_admin_investor_path(investor, financial_year: fy), method: :delete,
                            class: "btn btn-sm btn-link text-danger p-0 mt-1", form: { data: { turbo_confirm: "Remove #{fy} from this table?" } } do %>
                        Remove
                      <% end %>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<!-- Mark a year paid: amount + date -->
<div class="modal fade" id="ypPayModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <%= form_with url: mark_year_paid_admin_investor_path(investor), method: :post do %>
        <div class="modal-header">
          <h5 class="modal-title">Mark <span data-yp-title></span> as paid</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="financial_year" data-yp-field="year">
          <div class="mb-3">
            <label class="form-label">Amount paid (₹)</label>
            <input type="number" name="amount" class="form-control" step="0.01" min="0.01" required data-yp-field="amount">
          </div>
          <div>
            <label class="form-label">Paid on</label>
            <input type="date" name="paid_on" class="form-control" value="<%= Date.current %>" max="<%= Date.current %>" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success"><i class="bi bi-check2 me-1"></i>Mark paid</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    var modal = document.getElementById('ypPayModal');
    if (!modal || modal.dataset.ypBound) return;
    modal.dataset.ypBound = '1';
    modal.addEventListener('show.bs.modal', function(e) {
      var btn = e.relatedTarget;
      if (!btn) return;
      modal.querySelector('[data-yp-title]').textContent = btn.dataset.ypYear;
      modal.querySelector('[data-yp-field="year"]').value = btn.dataset.ypYear;
      modal.querySelector('[data-yp-field="amount"]').value = btn.dataset.ypAmount;
    });
  })();
</script>

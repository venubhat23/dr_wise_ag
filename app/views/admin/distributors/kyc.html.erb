<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1"><%= @distributor.display_name.presence || 'Unnamed Ambassador' %> - Submit KYC</h2>
    <p class="text-muted mb-0">
      <% kyc_badge = { 'pending' => 'secondary', 'submitted' => 'warning text-dark', 'approved' => 'success', 'rejected' => 'danger' }[@distributor.kyc_status] %>
      <span class="badge bg-<%= kyc_badge %> me-2">KYC: <%= @distributor.kyc_status.capitalize %></span>
      Upload KYC documents on behalf of this ambassador, or mark KYC as done without any documents.
    </p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to admin_distributor_path(@distributor), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-person me-1"></i>View Profile
    <% end %>
    <%= link_to admin_distributors_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>Back to Ambassadors
    <% end %>
  </div>
</div>

<%= form_with url: submit_kyc_admin_distributor_path(@distributor), method: :post, local: true, multipart: true do |f| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0"><i class="bi bi-person-vcard me-2 text-primary"></i>KYC Details <span class="text-muted small fw-normal">(optional)</span></h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :first_name, "First Name", class: "form-label" %>
          <%= f.text_field :first_name, value: @distributor.first_name, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :last_name, "Last Name", class: "form-label" %>
          <%= f.text_field :last_name, value: @distributor.last_name, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :aadhaar_no, "Aadhaar Number", class: "form-label" %>
          <%= f.text_field :aadhaar_no, value: @distributor.aadhaar_no, class: "form-control", placeholder: "12-digit Aadhaar number" %>
        </div>
        <div class="col-md-6">
          <%= f.label :pan_no, "PAN Number", class: "form-label" %>
          <%= f.text_field :pan_no, value: @distributor.pan_no, class: "form-control", placeholder: "e.g. ABCDE1234F" %>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0"><i class="bi bi-cloud-upload me-2 text-success"></i>KYC Documents <span class="text-muted small fw-normal">(all optional)</span></h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <% { aadhaar_file: ['Aadhaar Card', 'Aadhaar Card'], pan_file: ['Pancard', 'PAN Card'], bank_file: ['Bank Passbook', 'Bank Document'], photo_file: ['Profile Photo', 'Profile Photo'] }.each do |field, (type, label)| %>
          <% existing = @documents.find { |d| d.document_type == type } %>
          <div class="col-md-6">
            <%= f.label field, label, class: "form-label" %>
            <%= f.file_field field, class: "form-control", accept: "image/*,application/pdf" %>
            <% if existing&.has_document? %>
              <small class="text-muted">
                Already uploaded <%= existing.created_at.strftime('%d %b %Y') %> -
                <%= link_to "view", existing.document_url, target: '_blank', rel: 'noopener' %>. Uploading again replaces it.
              </small>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= f.button "Save Documents", type: :submit, name: "kyc_action", value: "save", class: "btn btn-primary" %>
    <% unless @distributor.kyc_approved? %>
      <%= f.button type: :submit, name: "kyc_action", value: "approve", class: "btn btn-success",
                   data: { confirm: "Mark KYC as done for this ambassador? This approves the KYC, activates their account and credits the joining bonus, even if no documents are uploaded.",
                           turbo_confirm: "Mark KYC as done for this ambassador? This approves the KYC, activates their account and credits the joining bonus, even if no documents are uploaded." } do %>
        <i class="bi bi-check-circle me-1"></i>Save &amp; Mark KYC Done
      <% end %>
    <% end %>
  </div>
<% end %>

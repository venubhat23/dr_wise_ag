    font-size: 1.25rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 1rem;
  }

  .chart-container {
    position: relative;
    height: 300px;
    margin-top: 1rem;
  }

  /* Chart stats section */
  .chart-stats {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-around;

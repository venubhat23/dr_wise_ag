    font-size: 1.1rem;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2d3436;
    margin: 0;
    flex-grow: 1;
  }

  .section-count {
    background: linear-gradient(135deg, #00b894 0%, #00a085 100%);
    color: white;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-left: 1rem;
  }

  .collapse-icon {
    color: #94a3b8;
    transition: transform 0.3s;
  }

  .section-header:not(.collapsed) .collapse-icon {
    transform: rotate(180deg);
  }

  .section-header.collapsed .collapse-icon {
    transform: rotate(0deg);
  }

  .section-body {
    padding: 1.5rem;
  }

  /* CONSISTENT SPACING: Fix spacing between all sections */
  .info-section-card {
    margin-bottom: 1.5rem !important;
  }

  .info-section-card:last-child {
    margin-bottom: 0 !important;
  }

  /* Section body proper padding */
  .section-body {
    padding: 1.5rem !important;
  }

  /* Form elements spacing within sections */
  .section-body .row {
    margin-bottom: 0.5rem;
  }

  .section-body .col-md-4,
  .section-body .col-md-6,
  .section-body .col-md-3 {
    margin-bottom: 1rem !important;
  }

  /* Action buttons top spacing */
  .d-flex.justify-content-between.align-items-center.mb-4 {
    margin-bottom: 2rem !important;
    padding: 1rem 0;
  }

  /* ANTI-OVERLAP: Ensure sections never overlap */
  .info-section-card {
    position: relative;
    z-index: 1;
    clear: both;
  }

  .info-section-card + .info-section-card {

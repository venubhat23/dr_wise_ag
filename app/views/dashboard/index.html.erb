// Dashboard Filter Auto-Update Functionality
function updateCurrentPeriod() {
  const yearSelect = document.getElementById('year_filter');
  const monthSelect = document.getElementById('month_filter');
  const startDateField = document.getElementById('start_date_field');
  const endDateField = document.getElementById('end_date_field');

  if (!yearSelect || !monthSelect) return;

  const year = parseInt(yearSelect.value);
  const month = monthSelect.value;

  let startDate, endDate;

  if (month && month !== '') {
    // Specific month selected
    const monthNum = parseInt(month);
    startDate = new Date(year, monthNum - 1, 1);
    endDate = new Date(year, monthNum, 0); // Last day of the month
    console.log(`Month selected: ${monthNum} (${year})`);
  } else {
    // Full year selected
    startDate = new Date(year, 0, 1); // January 1st
    endDate = new Date(year, 11, 31); // December 31st
    console.log(`Full year selected: ${year}`);
  }

  // AUTO-LOAD: Update Custom Date Range fields immediately
  if (startDateField && endDateField) {
    const formatDate = (date) => {
      const yyyy = date.getFullYear();
      const mm = String(date.getMonth() + 1).padStart(2, '0');
      const dd = String(date.getDate()).padStart(2, '0');
      return `${yyyy}-${mm}-${dd}`;
    };

    // Update the date field values
    startDateField.value = formatDate(startDate);
    endDateField.value = formatDate(endDate);

    // Add visual feedback - highlight fields to show they were auto-updated
    startDateField.style.backgroundColor = '#d4edda';
    endDateField.style.backgroundColor = '#d4edda';
    startDateField.style.border = '2px solid #28a745';
    endDateField.style.border = '2px solid #28a745';
    startDateField.style.transition = 'all 0.3s ease';
    endDateField.style.transition = 'all 0.3s ease';

    // Remove the highlight after 2 seconds
    setTimeout(() => {
      startDateField.style.backgroundColor = '';
      endDateField.style.backgroundColor = '';
      startDateField.style.border = '';
      endDateField.style.border = '';
    }, 2000);

    console.log(`🎯 AUTO-LOADED DATES: ${formatDate(startDate)} to ${formatDate(endDate)}`);
    console.log(`📅 Start Date Field Updated: ${startDateField.value}`);
    console.log(`📅 End Date Field Updated: ${endDateField.value}`);
  } else {
    console.log('❌ Date fields not found - cannot auto-update');
  }
}

// Date field change handler to update current period
function updateCurrentPeriodFromDates() {
  const startDateField = document.getElementById('start_date_field');
  const endDateField = document.getElementById('end_date_field');
  const currentPeriodDisplay = document.getElementById('current-period-display');

  if (!startDateField || !endDateField || !currentPeriodDisplay) return;

  const startValue = startDateField.value;
  const endValue = endDateField.value;

  if (startValue && endValue) {
    const startDate = new Date(startValue);
    const endDate = new Date(endValue);

    const formatDisplayDate = (date) => {
      const options = { year: 'numeric', month: 'short', day: 'numeric' };
      return date.toLocaleDateString('en-US', options);
    };

    const displayText = `${formatDisplayDate(startDate)} - ${formatDisplayDate(endDate)}`;
    currentPeriodDisplay.textContent = displayText;
  }
}

// Clear all filters function
function clearAllFilters() {
  const yearSelect = document.getElementById('year_filter');
  const monthSelect = document.getElementById('month_filter');
  const startDateField = document.getElementById('start_date_field');
  const endDateField = document.getElementById('end_date_field');

  console.log('🧹 Clearing all filters...');

  // Reset to default values (current year)
  const currentYear = new Date().getFullYear().toString();
  if (yearSelect) {
    yearSelect.value = currentYear; // Default to current year
    console.log(`✅ Year reset to ${currentYear}`);
  }

  if (monthSelect) {
    monthSelect.value = ''; // Reset to "All Year"
    console.log('✅ Month reset to "All Year"');
  }

  // Clear and highlight date fields
  if (startDateField) {
    startDateField.value = '';
    startDateField.style.backgroundColor = '#fff3cd';
    startDateField.style.border = '2px solid #ffc107';
    console.log('✅ Start date cleared');
  }

  if (endDateField) {
    endDateField.value = '';
    endDateField.style.backgroundColor = '#fff3cd';
    endDateField.style.border = '2px solid #ffc107';
    console.log('✅ End date cleared');
  }

  // Auto-load dates based on reset values (2026 All Year)
  setTimeout(() => {
    updateCurrentPeriod();

    // Remove highlighting after auto-load
    setTimeout(() => {
      if (startDateField) {
        startDateField.style.backgroundColor = '';
        startDateField.style.border = '';
      }
      if (endDateField) {
        endDateField.style.backgroundColor = '';
        endDateField.style.border = '';
      }
    }, 1500);
  }, 200);

  console.log(`🎯 Filters cleared and reset to default (${currentYear} All Year)`);
}

// Clean up modal backdrops on close
document.addEventListener('DOMContentLoaded', function() {
  // Add event listeners for filter auto-update
  const yearSelect = document.getElementById('year_filter');
  const monthSelect = document.getElementById('month_filter');
  const startDateField = document.getElementById('start_date_field');
  const endDateField = document.getElementById('end_date_field');

  // AUTO-LOAD current year dates on page load
  console.log('🚀 Page loaded - Auto-loading current year dates...');
  if (startDateField && endDateField && !startDateField.value && !endDateField.value) {
    // Only auto-load if fields are empty (first page load)
    const currentYear = new Date().getFullYear();
    const yearStart = `${currentYear}-01-01`;
    const yearEnd = `${currentYear}-12-31`;

    startDateField.value = yearStart;
    endDateField.value = yearEnd;

    // Brief green highlight to show auto-loading
    startDateField.style.backgroundColor = '#d4edda';
    endDateField.style.backgroundColor = '#d4edda';

    setTimeout(() => {
      startDateField.style.backgroundColor = '';
      endDateField.style.backgroundColor = '';
    }, 1000);

    console.log(`✅ Auto-loaded current year dates: ${yearStart} to ${yearEnd}`);
  } else if (startDateField && endDateField) {
    console.log(`ℹ️ Date fields already have values: ${startDateField.value} to ${endDateField.value}`);
  }

  if (yearSelect) {
    console.log('✅ Year dropdown found, adding change listener');
    yearSelect.addEventListener('change', function() {
      console.log('🔥 Year dropdown changed to:', yearSelect.value);
      updateCurrentPeriod();
    });
  } else {
    console.log('❌ Year dropdown not found');
  }

  if (monthSelect) {
    console.log('✅ Month dropdown found, adding change listener');
    monthSelect.addEventListener('change', function() {
      console.log('🔥 Month dropdown changed to:', monthSelect.value);
      updateCurrentPeriod();
    });
  } else {
    console.log('❌ Month dropdown not found');
  }

  if (startDateField) {
    startDateField.addEventListener('change', updateCurrentPeriodFromDates);
  }

  if (endDateField) {
    endDateField.addEventListener('change', updateCurrentPeriodFromDates);
  }

  // Add Clear button event listener
  const clearButton = document.getElementById('clear_filters_btn');
  if (clearButton) {
    console.log('✅ Clear button found, adding click listener');
    clearButton.addEventListener('click', function() {
      console.log('🧹 Clear button clicked!');
      clearAllFilters();
    });
  } else {
    console.log('❌ Clear button not found');
  }

  // Modal cleanup
  ['renewalModal', 'policyModal', 'systemStatusModal', 'policyTypeModal'].forEach(modalId => {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.addEventListener('hidden.bs.modal', function() {
        setTimeout(() => {
          document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
          document.body.classList.remove('modal-open');
          document.body.style.paddingRight = '';
          document.body.style.overflow = '';
        }, 100);
      });
    }
  });
});
</script>


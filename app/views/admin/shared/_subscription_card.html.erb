<%# Subscription card (status, current period, history with per-row edit) for
    the admin affiliate / ambassador show pages. Locals: record, record_url,
    update_url, cancel_url, destroy_url, name_fallback, owner_label. %>
<% subscriptions = record.subscriptions.to_a %>
<% sub_status = record.subscription_status %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent border-0 d-flex align-items-center">
    <i class="bi bi-calendar-check me-2 text-primary"></i>
    <h5 class="mb-0">Subscription</h5>
    <span class="ms-2 badge <%= { 'active' => 'bg-success-subtle text-success',
                                   'expiring_soon' => 'bg-warning-subtle text-warning',
                                   'expired' => 'bg-danger-subtle text-danger',
                                   'unpaid' => 'bg-warning-subtle text-warning' }[sub_status] || 'bg-secondary-subtle text-secondary' %>">
      <%= { 'active' => 'Active', 'expiring_soon' => 'Expiring soon', 'expired' => 'Expired',
            'unpaid' => 'Unpaid', 'not_applicable' => 'Not subscribed' }[sub_status] %>
    </span>
    <div class="ms-auto d-flex gap-2">
      <% if record.subscription_active? %>
        <%= button_to cancel_url, method: :patch, class: 'btn btn-sm btn-outline-danger', form: { class: 'd-inline' },
              data: { turbo_confirm: "Cancel this #{owner_label}'s subscription? It ends today, any upcoming prepaid years are removed, and the #{owner_label} must renew to keep using the app." } do %>
          <i class="bi bi-x-circle me-1"></i>Cancel Subscription
        <% end %>
      <% end %>
      <%= render 'admin/shared/subscription_button', record: record, url: record_url, name_fallback: name_fallback %>
    </div>
  </div>
  <div class="card-body">
    <% if record.subscription_tracked? %>
      <div class="row">
        <div class="col-md-6">
          <table class="table table-borderless mb-0">
            <tr>
              <th class="text-muted" width="40%">Current Period:</th>
              <td><%= render 'admin/shared/subscription_expiry', record: record %></td>
            </tr>
            <tr>
              <th class="text-muted">Days Left:</th>
              <td><%= record.subscription_expired? ? '—' : pluralize(record.subscription_days_left, 'day') %></td>
            </tr>
          </table>
        </div>
        <div class="col-md-6">
          <table class="table table-borderless mb-0">
            <tr>
              <th class="text-muted" width="40%">Years Paid:</th>
              <td><%= subscriptions.size %></td>
            </tr>
            <tr>
              <th class="text-muted">Renewal Fee:</th>
              <td><%= indian_currency(record.payment_amount_due.to_i) %></td>
            </tr>
          </table>
        </div>
      </div>
    <% else %>
      <p class="text-muted mb-0">
        No subscription recorded yet.
        <% if record.payment_required? %>Registration fee of <%= indian_currency(record.payment_amount_due.to_i) %> is pending.<% end %>
      </p>
    <% end %>

    <% if subscriptions.any? %>
      <h6 class="text-muted mt-4 mb-2">History</h6>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Type</th>
              <th>Period</th>
              <th>Amount</th>
              <th>Paid On</th>
              <th>Payment ID</th>
              <th>Status</th>
              <th class="text-end no-sort">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% subscriptions.each do |sub| %>
              <tr>
                <td><%= sub.kind.titleize %></td>
                <td><%= sub.starts_at.strftime('%d %b %Y') %> → <%= sub.expires_at.strftime('%d %b %Y') %></td>
                <td><%= indian_currency(sub.amount.to_i) %></td>
                <td><%= sub.paid_at&.strftime('%d %b %Y') || '—' %></td>
                <td><%= sub.razorpay_payment_id.present? ? tag.code(sub.razorpay_payment_id) : tag.span('Manual', class: 'text-muted') %></td>
                <td>
                  <% if sub.active? %>
                    <span class="badge bg-success-subtle text-success">Current</span>
                  <% elsif sub.starts_at > Time.current %>
                    <span class="badge bg-info-subtle text-info">Upcoming</span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary">Past</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <button type="button" class="btn btn-sm btn-outline-primary" title="Edit subscription dates"
                          data-edit-sub-id="<%= sub.id %>"
                          data-edit-sub-from="<%= sub.starts_at.to_date.iso8601 %>"
                          data-edit-sub-to="<%= sub.expires_at.to_date.iso8601 %>"
                          data-edit-sub-amount="<%= sub.amount.to_f %>">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <%= button_to destroy_url, method: :delete, params: { subscription_id: sub.id },
                        class: 'btn btn-sm btn-outline-danger', title: 'Remove this subscription', form: { class: 'd-inline' },
                        data: { turbo_confirm: "Remove the #{sub.starts_at.strftime('%d %b %Y')} - #{sub.expires_at.strftime('%d %b %Y')} subscription? The #{owner_label}'s expiry will be recalculated from the remaining rows." } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
<%= render 'admin/shared/subscription_modal' %>

<div class="modal fade" id="editSubscriptionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <%= form_with url: update_url, method: :patch, class: 'modal-content' do %>
      <input type="hidden" name="subscription_id" id="editSubscriptionId">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Subscription</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="form-label" for="editSubscriptionFrom">From date</label>
            <input type="date" class="form-control" name="from_date" id="editSubscriptionFrom" required>
          </div>
          <div class="col-6">
            <label class="form-label" for="editSubscriptionTo">To date</label>
            <input type="date" class="form-control" name="to_date" id="editSubscriptionTo" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="editSubscriptionAmount">Amount paid (₹)</label>
            <input type="number" step="0.01" min="0" class="form-control" name="amount" id="editSubscriptionAmount">
          </div>
        </div>
        <small class="text-muted d-block mt-3">
          The subscription stays valid until the end of the To date. The <%= owner_label %>'s expiry is updated to the latest To date across all rows.
        </small>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save</button>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-edit-sub-id]');
    if (!btn) return;
    document.getElementById('editSubscriptionId').value = btn.dataset.editSubId;
    document.getElementById('editSubscriptionFrom').value = btn.dataset.editSubFrom;
    document.getElementById('editSubscriptionTo').value = btn.dataset.editSubTo;
    document.getElementById('editSubscriptionAmount').value = btn.dataset.editSubAmount;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('editSubscriptionModal')).show();
  });
</script>

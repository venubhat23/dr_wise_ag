                    </tr>
                  </thead>
                  <tbody>
                    ${data.monthly_trend ? data.monthly_trend.map(month => `
                      <tr style="background: rgba(102, 126, 234, 0.05);">
                        <td style="font-weight: 600; color: #333;"><strong>${month.month}</strong></td>
                        <td style="font-weight: bold; color: #667eea; font-size: 1.05rem;"><strong>${month.total_leads}</strong></td>
                        <td style="font-weight: bold; color: #11998e; font-size: 1.05rem;"><strong>${month.converted_leads}</strong></td>
                        <td><span class="badge ${month.conversion_rate > 30 ? 'bg-success' : month.conversion_rate > 15 ? 'bg-warning text-dark' : 'bg-danger'}" style="font-weight: bold; font-size: 0.9rem;">${month.conversion_rate}%</span></td>
                      </tr>
                    `).join('') : '<tr><td colspan="4" style="font-weight: 600;">No data available</td></tr>'}

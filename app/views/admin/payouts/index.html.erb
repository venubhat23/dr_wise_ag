<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Commission Payouts</h2>
    <p class="text-muted mb-0">Manage commission payouts to Sub-Agents, Distributors, and Investors</p>
  </div>
  <div class="d-flex gap-2">
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-download me-1"></i>
        Export
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to "Export Report", admin_payouts_reports_path(format: :csv), class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li><%= link_to "Detailed Analytics", admin_payouts_reports_path, class: "dropdown-item" %></li>
      </ul>
    </div>
    <div class="dropdown">
      <button class="btn btn-outline-info dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-graph-up me-1"></i>
        Commission Receipts
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to "View Receipts", admin_payouts_commission_receipts_path, class: "dropdown-item" %></li>
        <li><%= link_to "Auto-Distribute", "#", class: "dropdown-item", onclick: "showAutoDistributeModal()" %></li>
      </ul>
    </div>
    <%= link_to new_admin_payout_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Add New Payout
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Payouts</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@summary[:total_payouts] || 0) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-cash-coin text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Amount</h6>
            <h3 class="mb-0 text-success">₹<%= number_with_delimiter((@summary[:total_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-currency-rupee text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Pending Amount</h6>
            <h3 class="mb-0 text-warning">₹<%= number_with_delimiter((@summary[:pending_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-clock text-warning fs-4"></i>
          </div>
        </div>
        <div class="mt-2">
          <small class="text-muted"><%= @summary[:pending_count] || 0 %> pending payouts</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Paid Amount</h6>
            <h3 class="mb-0 text-info">₹<%= number_with_delimiter((@summary[:paid_amount] || 0).to_i) %></h3>
          </div>
          <div class="bg-info bg-opacity-10 rounded p-3">
            <i class="bi bi-check-circle text-info fs-4"></i>
          </div>
        </div>
        <div class="mt-2">
          <small class="text-muted"><%= @summary[:paid_count] || 0 %> paid payouts</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Stats Row -->
<div class="row mb-4">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light border-0">
        <h6 class="mb-0">This Month vs Last Month</h6>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-6 text-center">
            <h4 class="text-primary mb-0">₹<%= number_with_delimiter((@summary[:this_month] || 0).to_i) %></h4>
            <small class="text-muted">This Month</small>
          </div>
          <div class="col-6 text-center">
            <h4 class="text-secondary mb-0">₹<%= number_with_delimiter((@summary[:last_month] || 0).to_i) %></h4>
            <small class="text-muted">Last Month</small>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light border-0">
        <h6 class="mb-0">Quick Actions</h6>
      </div>
      <div class="card-body">
        <div class="d-flex gap-2 flex-wrap">
          <%= link_to admin_payouts_commission_receipts_path, class: "btn btn-sm btn-outline-primary" do %>
            <i class="bi bi-receipt me-1"></i> Commission Receipts
          <% end %>
          <%= link_to admin_payouts_reports_path, class: "btn btn-sm btn-outline-info" do %>
            <i class="bi bi-bar-chart me-1"></i> Reports
          <% end %>
          <%= link_to admin_payouts_summary_path, class: "btn btn-sm btn-outline-success" do %>
            <i class="bi bi-graph-up-arrow me-1"></i> Summary
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= search_form_for @q, url: admin_payouts_path, method: :get, local: true, class: "row g-3" do |f| %>
      <div class="col-md-3">
        <%= f.search_field :policy_number_or_notes_cont,
                           placeholder: "Search by policy number or notes...",
                           class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= f.select :policy_type_eq,
                     options_for_select([['All Types', ''], ['Health', 'health'], ['Life', 'life'], ['Motor', 'motor'], ['Other', 'other']], params.dig(:q, :policy_type_eq)),
                     {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.select :payout_to_eq,
                     options_for_select([['All Recipients', ''], ['Sub-Agent', 'sub_agent'], ['Distributor', 'distributor'], ['Investor', 'investor']], params.dig(:q, :payout_to_eq)),
                     {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.select :status_eq,
                     options_for_select([['All Status', ''], ['Pending', 'pending'], ['Processing', 'processing'], ['Paid', 'paid'], ['Cancelled', 'cancelled']], params.dig(:q, :status_eq)),
                     {}, { class: "form-select" } %>
      </div>
      <div class="col-md-2">
        <%= f.submit "Search", class: "btn btn-primary w-100" %>
      </div>
      <div class="col-md-1">
        <%= link_to admin_payouts_path, class: "btn btn-outline-secondary w-100" do %>
          <i class="bi bi-arrow-clockwise"></i>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Payouts Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom">
    <div class="d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Commission Payouts</h6>
      <div class="d-flex gap-2">
        <div class="dropdown">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-funnel"></i> Sort
          </button>
          <ul class="dropdown-menu">
            <li><%= link_to "Latest First", admin_payouts_path(q: { s: "created_at desc" }), class: "dropdown-item" %></li>
            <li><%= link_to "Oldest First", admin_payouts_path(q: { s: "created_at asc" }), class: "dropdown-item" %></li>
            <li><%= link_to "Amount High to Low", admin_payouts_path(q: { s: "payout_amount desc" }), class: "dropdown-item" %></li>
            <li><%= link_to "Amount Low to High", admin_payouts_path(q: { s: "payout_amount asc" }), class: "dropdown-item" %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Policy Details</th>
            <th>Customer</th>
            <th>Recipient</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @payouts.any? %>
            <% @payouts.each do |payout| %>
              <tr>
                <td>
                  <div>
                    <strong class="text-capitalize"><%= payout.policy_type %></strong>
                    <span class="badge bg-light text-dark ms-1">#<%= payout.policy_id %></span>
                  </div>
                  <small class="text-muted">
                    <%= payout.policy_number %>
                  </small>
                </td>
                <td>
                  <div>
                    <strong><%= payout.customer_name %></strong>
                  </div>
                </td>
                <td>
                  <div>
                    <span class="text-capitalize"><%= payout.payout_to.humanize %></span>
                  </div>
                  <small class="text-muted"><%= payout.recipient_name %></small>
                </td>
                <td>
                  <strong class="text-success">₹<%= number_with_delimiter(payout.payout_amount.to_i) %></strong>
                </td>
                <td>
                  <% case payout.status %>
                  <% when 'paid' %>
                    <span class="badge bg-success">Paid</span>
                  <% when 'pending' %>
                    <span class="badge bg-warning">Pending</span>
                  <% when 'processing' %>
                    <span class="badge bg-info">Processing</span>
                  <% when 'cancelled' %>
                    <span class="badge bg-danger">Cancelled</span>
                  <% end %>
                </td>
                <td>
                  <%= payout.payout_date&.strftime('%d %b %Y') || '-' %>
                  <% if payout.payment_mode.present? %>
                    <br><small class="text-muted"><%= payout.payment_mode.humanize %></small>
                  <% end %>
                </td>
                <td>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      Actions
                    </button>
                    <ul class="dropdown-menu">
                      <li><%= link_to "View Details", admin_payout_path(payout), class: "dropdown-item" %></li>
                      <li><%= link_to "Edit", edit_admin_payout_path(payout), class: "dropdown-item" %></li>
                      <li><hr class="dropdown-divider"></li>
                      <% if payout.status == 'pending' %>
                        <li><%= link_to "Mark as Processing", mark_as_processing_admin_payout_path(payout), method: :patch, class: "dropdown-item text-info" %></li>
                        <li><%= link_to "Mark as Paid", "#", class: "dropdown-item text-success", onclick: "showPaymentModal(<%= payout.id %>)" %></li>
                        <li><%= link_to "Cancel", "#", class: "dropdown-item text-danger", onclick: "showCancelModal(<%= payout.id %>)" %></li>
                      <% elsif payout.status == 'processing' %>
                        <li><%= link_to "Mark as Paid", "#", class: "dropdown-item text-success", onclick: "showPaymentModal(<%= payout.id %>)" %></li>
                        <li><%= link_to "Cancel", "#", class: "dropdown-item text-danger", onclick: "showCancelModal(<%= payout.id %>)" %></li>
                      <% end %>
                      <li><hr class="dropdown-divider"></li>
                      <li><%= link_to "Audit Trail", audit_trail_admin_payout_path(payout), class: "dropdown-item" %></li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-5">
                <div>
                  <i class="bi bi-cash-coin text-muted" style="font-size: 3rem;"></i>
                  <h5 class="text-muted mt-3">No payouts found</h5>
                  <p class="text-muted">Start by creating your first payout or adjust your search filters.</p>
                  <%= link_to new_admin_payout_path, class: "btn btn-primary" do %>
                    <i class="bi bi-plus-lg me-1"></i>
                    Add First Payout
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pagination -->
<% if @payouts.respond_to?(:current_page) %>
  <div class="d-flex justify-content-between align-items-center mt-4">
    <div>
      <span class="text-muted">
        Showing <%= (@payouts.current_page - 1) * @payouts.limit_value + 1 %> to
        <%= [(@payouts.current_page - 1) * @payouts.limit_value + @payouts.limit_value, @payouts.total_count].min %>
        of <%= @payouts.total_count %> payouts
      </span>
    </div>
    <%= paginate @payouts, theme: :twitter_bootstrap_5 %>
  </div>
<% end %>

<!-- Modals -->
<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Mark as Paid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="paymentForm" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Payment Date</label>
            <input type="date" name="payout_date" class="form-control" value="<%= Date.current.strftime('%Y-%m-%d') %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Payment Mode</label>
            <select name="payment_mode" class="form-select" required>
              <option value="">Select payment mode</option>
              <option value="bank_transfer">Bank Transfer</option>
              <option value="cheque">Cheque</option>
              <option value="online">Online Transfer</option>
              <option value="cash">Cash</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Transaction ID</label>
            <input type="text" name="transaction_id" class="form-control" placeholder="Enter transaction ID">
          </div>
          <div class="mb-3">
            <label class="form-label">Reference Number</label>
            <input type="text" name="reference_number" class="form-control" placeholder="Enter reference number">
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="3" placeholder="Add any notes..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Mark as Paid</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Cancel Payout</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="cancelForm" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Are you sure you want to cancel this payout? This action cannot be undone.
          </div>
          <div class="mb-3">
            <label class="form-label">Cancellation Reason</label>
            <textarea name="cancellation_reason" class="form-control" rows="3" placeholder="Please provide a reason for cancellation..." required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Payout</button>
          <button type="submit" class="btn btn-danger">Cancel Payout</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function showPaymentModal(payoutId) {
  const form = document.getElementById('paymentForm');
  form.action = `/admin/payouts/${payoutId}/mark_as_paid`;
  new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

function showCancelModal(payoutId) {
  const form = document.getElementById('cancelForm');
  form.action = `/admin/payouts/${payoutId}/cancel_payout`;
  new bootstrap.Modal(document.getElementById('cancelModal')).show();
}

function showAutoDistributeModal() {
  // Redirect to commission receipts page where auto-distribute functionality is available
  window.location.href = '<%= admin_payouts_commission_receipts_path %>';
}
</script>
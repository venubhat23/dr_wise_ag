<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Vendor Management</h2>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <% if can_create?('vendors') %>
      <%= link_to new_admin_vendor_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i>
        Add New Vendor
      <% end %>
    <% end %>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Vendors</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@total_vendors) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="bi bi-shop text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Vendors</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@active_vendors) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="bi bi-person-check text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Inactive Vendors</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@inactive_vendors) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="bi bi-person-x text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: admin_vendors_path, method: :get, local: true, class: "d-flex flex-wrap gap-3 align-items-end", id: "search_form" do |form| %>
      <div class="flex-grow-1 min-width-250">
        <%= form.text_field :search, placeholder: "Search by name, company, email, mobile, or GST... (min 3 characters)",
                           value: params[:search],
                           class: "form-control",
                           id: "search_input",
                           data: { min_length: 3 } %>
      </div>

      <div>
        <%= form.select :status,
                       options_for_select([
                         ['All Status', ''],
                         ['Active', 'active'],
                         ['Inactive', 'inactive']
                       ], params[:status]),
                       {},
                       { class: "form-select", id: "status_filter" } %>
      </div>

      <div class="d-flex gap-2">
        <%= link_to "Clear", admin_vendors_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Vendors List -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-transparent border-0">
    <h5 class="mb-0">Vendor List</h5>
  </div>
  <div class="card-body p-0">
    <% if @vendors.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th class="border-0">Vendor</th>
              <th class="border-0">Contact</th>
              <th class="border-0">GST Number</th>
              <th class="border-0">Products</th>
              <th class="border-0">Status</th>
              <th class="border-0">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @vendors.each do |vendor| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3">
                      <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                           style="width: 40px; height: 40px;">
                        <span class="text-primary fw-bold">
                          <%= vendor.display_name.present? ? vendor.display_name[0].upcase : "?" %>
                        </span>
                      </div>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= vendor.display_name %></h6>
                      <% if vendor.company_name.present? %>
                        <small class="text-muted d-block"><%= vendor.company_name %></small>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td>
                  <div>
                    <% if vendor.phone_number.present? %>
                      <div class="mb-1"><%= vendor.phone_number %></div>
                    <% end %>
                    <% if vendor.email.present? %>
                      <small class="text-muted"><%= vendor.email %></small>
                    <% end %>
                  </div>
                </td>
                <td><%= vendor.gst_number.presence || "—" %></td>
                <td>
                  <% if vendor.vendor_products.any? %>
                    <% vendor.vendor_products.group_by(&:product_category).each do |category, products| %>
                      <span class="badge bg-light text-dark border me-1 mb-1" title="<%= products.map(&:product_subcategory).join(', ') %>">
                        <%= category %> (<%= products.size %>)
                      </span>
                    <% end %>
                  <% else %>
                    <small class="text-muted">No products assigned</small>
                  <% end %>
                </td>
                <td>
                  <% if vendor.active? %>
                    <span class="badge bg-success-subtle text-success">Active</span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <% if can_view?('vendors') %>
                      <%= link_to admin_vendor_path(vendor), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    <% end %>

                    <% if can_edit?('vendors') %>
                      <%= link_to edit_admin_vendor_path(vendor), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>

                      <% if vendor.active? %>
                        <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            title="Deactivate"
                            onclick="handleVendorStatusAction('<%= deactivate_admin_vendor_path(vendor) %>', 'Are you sure you want to deactivate this vendor?')">
                          <i class="bi bi-x-circle"></i>
                        </button>
                      <% else %>
                        <button type="button"
                            class="btn btn-sm btn-outline-success"
                            title="Activate"
                            onclick="handleVendorStatusAction('<%= activate_admin_vendor_path(vendor) %>', 'Are you sure you want to activate this vendor?')">
                          <i class="bi bi-check-circle"></i>
                        </button>
                      <% end %>
                    <% end %>

                    <% if can_delete?('vendors') %>
                      <button type="button"
                          class="btn btn-sm btn-outline-danger delete-vendor"
                          data-url="<%= admin_vendor_path(vendor) %>"
                          data-confirm="Are you sure you want to delete this vendor?"
                          title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-transparent border-0">
        <%= render 'shared/pagination', records: @vendors %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="bi bi-shop display-1 text-muted"></i>
        </div>
        <h5 class="mb-3">No Vendors Found</h5>
        <p class="text-muted mb-4">
          <% if params[:search].present? || params[:status].present? %>
            No vendors match your current filters. Try adjusting your search criteria.
          <% else %>
            Start building your vendor network by adding your first vendor.
          <% end %>
        </p>
        <% unless params[:search].present? || params[:status].present? %>
          <% if can_create?('vendors') %>
            <%= link_to new_admin_vendor_path, class: "btn btn-primary" do %>
              <i class="bi bi-plus-lg me-1"></i>
              Create First Vendor
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
.min-width-250 {
  min-width: 250px;
}
</style>

<script>
function handleVendorStatusAction(url, confirmMessage) {
  if (confirm(confirmMessage)) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = url;
    form.style.display = 'none';

    const csrfToken = document.querySelector('meta[name="csrf-token"]');
    if (csrfToken) {
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrfToken.getAttribute('content');
      form.appendChild(csrfInput);
    }

    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'PATCH';
    form.appendChild(methodInput);

    document.body.appendChild(form);
    form.submit();
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('search_input');
  const statusFilter = document.getElementById('status_filter');
  const searchForm = document.getElementById('search_form');
  let searchTimeout;

  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const searchValue = this.value;

    searchTimeout = setTimeout(() => {
      if (searchValue.length >= 3 || searchValue.length === 0) {
        searchForm.submit();
      }
    }, 500);
  });

  statusFilter.addEventListener('change', function() {
    searchForm.submit();
  });

  const deleteButtons = document.querySelectorAll('.delete-vendor');
  deleteButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();

      const url = this.dataset.url;
      const confirmMessage = this.dataset.confirm;

      if (confirm(confirmMessage)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = url;

        const csrfToken = document.querySelector('meta[name="csrf-token"]');
        if (csrfToken) {
          const csrfInput = document.createElement('input');
          csrfInput.type = 'hidden';
          csrfInput.name = 'authenticity_token';
          csrfInput.value = csrfToken.getAttribute('content');
          form.appendChild(csrfInput);
        }

        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'DELETE';
        form.appendChild(methodInput);

        document.body.appendChild(form);
        form.submit();
      }
    });
  });
});
</script>

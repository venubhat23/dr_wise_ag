<% photo_doc = @distributor.kyc_document("Profile Photo") %>

<h2 class="h6 fw-bold mb-1">Step 4 · Upload your photo</h2>
<p class="text-muted small">
  A recent, clear photo of your face in good light. This is used to verify your identity.
</p>

<% if photo_doc&.document_url %>
  <div class="mb-3">
    <img src="<%= photo_doc.document_url %>" alt="Your photo"
         style="height:120px;width:120px;object-fit:cover;border-radius:12px;border:1px solid #e5e7eb;">
    <div class="text-muted small mt-1">Current photo — upload again to replace it.</div>
  </div>
<% end %>

<%= form_with url: ambassador_kyc_photo_path, method: :patch, multipart: true, local: true, data: { turbo: false } do %>
  <div class="upload-box mb-3 <%= 'filled' if photo_doc %>">
    <%= file_field_tag :photo_file, accept: "image/*", class: "form-control",
          required: photo_doc.nil? %>
  </div>

  <div class="d-flex justify-content-between mt-4">
    <%= link_to "Back", ambassador_kyc_path(step: 3), class: "btn btn-outline-secondary" %>
    <%= submit_tag(photo_doc ? "Continue" : "Upload & continue", class: "btn btn-primary px-4") %>
  </div>
<% end %>

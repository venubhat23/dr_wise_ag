<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Manage Broker</h2>
    <p class="text-muted mb-0">Manage and track all brokers and their codes</p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBrokerModal">
      <i class="fas fa-plus me-1"></i>
      Add Broker
    </button>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Total Brokers</h6>
            <h3 class="mb-0 text-primary"><%= number_with_delimiter(@brokers.count) %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 rounded p-3">
            <i class="fas fa-briefcase text-primary fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Active Brokers</h6>
            <h3 class="mb-0 text-success"><%= number_with_delimiter(@brokers.active.count) %></h3>
          </div>
          <div class="bg-success bg-opacity-10 rounded p-3">
            <i class="fas fa-check-circle text-success fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h6 class="text-muted mb-2">Inactive Brokers</h6>
            <h3 class="mb-0 text-warning"><%= number_with_delimiter(@brokers.inactive.count) %></h3>
          </div>
          <div class="bg-warning bg-opacity-10 rounded p-3">
            <i class="fas fa-times-circle text-warning fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Broker Modal -->
<div class="modal fade" id="addBrokerModal" tabindex="-1" aria-labelledby="addBrokerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="addBrokerModalLabel">
          <i class="fas fa-briefcase me-2"></i>
          Add New Broker
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with model: [:admin, @broker], local: true, class: "needs-validation", novalidate: true do |form| %>
        <div class="modal-body">
          <!-- Broker Information Card -->
          <div class="card bg-light border-0">
            <div class="card-body py-3">
              <div class="row">
                <div class="col-12">
                  <div class="mb-3">
                    <%= form.label :name, class: "form-label fw-bold" do %>
                      <i class="fas fa-building me-2 text-primary"></i>Broker Name*
                    <% end %>
                    <%= form.text_field :name,
                        class: "form-control form-control-lg",
                        placeholder: "Enter broker name",
                        required: true,
                        style: "border-radius: 10px; border: 2px solid #e9ecef;" %>
                    <div class="invalid-feedback">
                      Please provide a valid broker name.
                    </div>
                    <small class="form-text text-muted">
                      <i class="fas fa-info-circle me-1"></i>
                      Enter the full name of the brokerage firm or broker
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Instructions -->
          <div class="alert alert-info mt-3" role="alert">
            <i class="fas fa-lightbulb me-2"></i>
            <strong>Note:</strong> Once created, the broker will be automatically set to active status and can be assigned to policies and customers.
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i>Cancel
          </button>
          <%= form.submit "Save Broker", class: "btn btn-primary px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Broker List Card -->
<div class="card shadow-sm">
  <div class="card-header bg-light">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Broker Name List</h5>
      <div class="search-container" style="max-width: 300px;">
        <%= form_with url: admin_brokers_path, method: :get, local: true, class: "d-flex" do |form| %>
          <div class="input-group">
            <%= form.text_field :search, placeholder: "Search by broker name",
                               value: params[:search],
                               class: "form-control form-control-sm" %>
            <button class="btn btn-outline-secondary btn-sm" type="submit">
              <i class="fas fa-search"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <% if @brokers.present? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="px-4 py-3">BROKER NAME</th>
              <th class="px-4 py-3">STATUS</th>
              <th class="px-4 py-3 text-center">ACTION</th>
            </tr>
          </thead>
          <tbody>
            <% @brokers.each do |broker| %>
              <tr>
                <td class="px-4 py-3">
                  <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                      <i class="fas fa-briefcase text-primary"></i>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= broker.name %></h6>
                      <small class="text-muted">Added <%= broker.created_at.strftime("%b %d, %Y") %></small>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <% if broker.active? %>
                    <span class="badge bg-success-subtle text-success">
                      <i class="fas fa-check-circle me-1"></i>
                      Active
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning">
                      <i class="fas fa-times-circle me-1"></i>
                      Inactive
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center">
                  <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#editBrokerModal<%= broker.id %>">
                      <i class="fas fa-edit"></i>
                    </button>
                    <%= link_to admin_broker_path(broker),
                               method: :delete,
                               class: "btn btn-outline-danger btn-sm",
                               confirm: "Are you sure you want to delete #{broker.name}?" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>

              <!-- Edit Modal for this broker -->
              <div class="modal fade" id="editBrokerModal<%= broker.id %>" tabindex="-1" aria-labelledby="editBrokerModalLabel<%= broker.id %>" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                      <h5 class="modal-title" id="editBrokerModalLabel<%= broker.id %>">
                        <i class="fas fa-edit me-2"></i>
                        Edit Broker - <%= broker.name %>
                      </h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <%= form_with model: [:admin, broker], local: true, class: "needs-validation", novalidate: true do |form| %>
                      <div class="modal-body">
                        <!-- Broker Information Card -->
                        <div class="card bg-light border-0">
                          <div class="card-body py-3">
                            <div class="row">
                              <div class="col-md-8">
                                <div class="mb-3">
                                  <%= form.label :name, class: "form-label fw-bold" do %>
                                    <i class="fas fa-building me-2 text-primary"></i>Broker Name*
                                  <% end %>
                                  <%= form.text_field :name,
                                      class: "form-control form-control-lg",
                                      placeholder: "Enter broker name",
                                      required: true,
                                      style: "border-radius: 10px; border: 2px solid #e9ecef;" %>
                                  <div class="invalid-feedback">
                                    Please provide a valid broker name.
                                  </div>
                                </div>
                              </div>
                              <div class="col-md-4">
                                <div class="mb-3">
                                  <%= form.label :status, class: "form-label fw-bold" do %>
                                    <i class="fas fa-toggle-on me-2 text-primary"></i>Status
                                  <% end %>
                                  <%= form.select :status,
                                                 options_for_select([['Active', 'active'], ['Inactive', 'inactive']], broker.status),
                                                 {},
                                                 { class: "form-select form-select-lg", style: "border-radius: 10px; border: 2px solid #e9ecef;" } %>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- Broker Info Summary -->
                        <div class="alert alert-info mt-3" role="alert">
                          <div class="row">
                            <div class="col-md-6">
                              <i class="fas fa-info-circle me-2"></i>
                              <strong>Created:</strong> <%= broker.created_at.strftime("%B %d, %Y") %>
                            </div>
                            <div class="col-md-6">
                              <i class="fas fa-calendar me-2"></i>
                              <strong>Last Updated:</strong> <%= broker.updated_at.strftime("%B %d, %Y") %>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                          <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <%= form.submit "Update Broker", class: "btn btn-primary px-4" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i class="fas fa-briefcase display-1 text-muted"></i>
        </div>
        <h4 class="text-muted">No brokers found</h4>
        <p class="text-muted">
          <% if params[:search].present? %>
            No brokers match your search criteria.
          <% else %>
            Start by adding your first broker.
          <% end %>
        </p>
        <% if params[:search].present? %>
          <%= link_to "Clear search", admin_brokers_path, class: "btn btn-outline-primary" %>
        <% else %>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBrokerModal">
            <i class="fas fa-plus me-1"></i>
            Add Your First Broker
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
/* CUSTOM MODAL BACKDROP SOLUTION - Bypass Bootstrap entirely */

/* Hide Bootstrap's backdrop completely since it's not working */
.modal-backdrop {
  display: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
}

/* Create our own custom backdrop */
.custom-modal-backdrop {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background-color: rgba(0, 0, 0, 0.8) !important;
  z-index: 1040 !important;
  display: block !important;
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  filter: none !important;
}

/* Custom backdrop for edit modals */
.custom-modal-backdrop.edit-modal {
  background-color: rgba(0, 0, 0, 0.9) !important;
  z-index: 1055 !important;
}

/* Modal styling adjustments */
.modal {
  z-index: 1050 !important;
  background-color: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.modal.show {
  z-index: 1050 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

/* Ensure edit modals appear above add modal */
.modal[id*="editBroker"] {
  z-index: 1060 !important;
}

/* Modal content positioning */
.modal-dialog {
  position: relative;
  z-index: 1051 !important;
  margin: 1.75rem auto;
  pointer-events: auto !important;
  max-width: 800px;
}

.modal-content {
  position: relative;
  z-index: 1052 !important;
  background-color: #ffffff !important;
  border: 1px solid rgba(0, 0, 0, 0.2);
  border-radius: 0.375rem;
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
  pointer-events: auto !important;
  opacity: 1 !important;
  visibility: visible !important;
}

/* Fix overflow issues */
body.modal-open {
  overflow: hidden !important;
}

/* Modal positioning */
.modal.fade .modal-dialog {
  transition: transform 0.3s ease-out;
  transform: translate(0, -50px);
}

.modal.show .modal-dialog {
  transform: none;
}

/* Ensure all interactive elements work */
.modal,
.modal-dialog,
.modal-content,
.modal-body .form-control,
.modal-body .form-select,
.modal-footer .btn {
  pointer-events: auto !important;
}

.modal-footer .btn {
  cursor: pointer !important;
}

/* Override any global backdrop filters that interfere */
body.modal-open * {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* Restore for non-modal elements when modal is closed */
body:not(.modal-open) * {
  backdrop-filter: revert;
  -webkit-backdrop-filter: revert;
}

/* Animation for custom backdrop */
.custom-modal-backdrop {
  animation: fadeIn 0.15s ease-in;
}

.custom-modal-backdrop.fade-out {
  animation: fadeOut 0.15s ease-out;
  opacity: 0 !important;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}
</style>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();

// Ensure modals work properly
document.addEventListener('DOMContentLoaded', function() {
  initializeModalHandlers();
});

// Re-initialize on Turbo load
document.addEventListener('turbo:load', function() {
  initializeModalHandlers();
});

function initializeModalHandlers() {
  // Clear any existing modal instances and custom backdrops
  document.querySelectorAll('.modal').forEach(function(modal) {
    var existingInstance = bootstrap.Modal.getInstance(modal);
    if (existingInstance) {
      existingInstance.dispose();
    }
  });

  // Remove any existing custom backdrops
  document.querySelectorAll('.custom-modal-backdrop').forEach(function(backdrop) {
    backdrop.remove();
  });

  // Initialize fresh modal instances with custom backdrop handling
  document.querySelectorAll('.modal').forEach(function(modal) {
    // Handle show event - create custom backdrop
    modal.addEventListener('show.bs.modal', function(e) {
      console.log('Modal showing:', this.id);

      // Remove any existing Bootstrap backdrops
      document.querySelectorAll('.modal-backdrop').forEach(function(backdrop) {
        backdrop.remove();
      });

      // Remove any existing custom backdrops
      document.querySelectorAll('.custom-modal-backdrop').forEach(function(backdrop) {
        backdrop.remove();
      });

      // Create our custom backdrop
      var customBackdrop = document.createElement('div');
      customBackdrop.className = 'custom-modal-backdrop';

      // Add special class for edit modals
      if (this.id.includes('editBroker')) {
        customBackdrop.classList.add('edit-modal');
      }

      // Add click handler to close modal when backdrop is clicked
      customBackdrop.addEventListener('click', function() {
        var modalInstance = bootstrap.Modal.getInstance(modal);
        if (modalInstance) {
          modalInstance.hide();
        }
      });

      // Add the custom backdrop to the body
      document.body.appendChild(customBackdrop);

      // Set modal z-index
      var zIndex = 1050;
      if (this.id.includes('editBroker')) {
        zIndex = 1060;
      }
      this.style.zIndex = zIndex;

      // Force body modal-open class
      document.body.classList.add('modal-open');
    });

    // Handle shown event
    modal.addEventListener('shown.bs.modal', function(e) {
      console.log('Modal shown:', this.id);

      // Focus first input
      var firstInput = this.querySelector('input[type="text"], input[type="email"], select, textarea');
      if (firstInput) {
        firstInput.focus();
      }
    });

    // Handle hidden event - remove custom backdrop
    modal.addEventListener('hidden.bs.modal', function(e) {
      console.log('Modal hidden:', this.id);

      // Remove all custom backdrops with fade out animation
      document.querySelectorAll('.custom-modal-backdrop').forEach(function(backdrop) {
        backdrop.classList.add('fade-out');
        setTimeout(function() {
          if (backdrop && backdrop.parentNode) {
            backdrop.parentNode.removeChild(backdrop);
          }
        }, 150);
      });

      // Clean up any remaining Bootstrap backdrops
      document.querySelectorAll('.modal-backdrop').forEach(function(backdrop) {
        backdrop.remove();
      });

      // Remove modal-open class from body
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
    });

    // Handle modal backdrop clicks (click on modal itself, not content)
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        var modalInstance = bootstrap.Modal.getInstance(modal);
        if (modalInstance) {
          modalInstance.hide();
        }
      }
    });
  });
}
</script>
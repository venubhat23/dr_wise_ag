            'rgba(255, 65, 108, 0.8)',
            'rgba(255, 193, 7, 0.8)',
            'rgba(131, 96, 195, 0.8)'
          ],
          borderWidth: 3,
          borderColor: 'white',
          hoverOffset: 15
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',

<% content_for :title, "Registration Fee - Dr WISE" %>

<style>
  html, body { overflow-y: auto !important; background: #f4f6fb; }
  .kyc-wrap { max-width: 560px; margin: 0 auto; padding: 32px 16px 64px; }
  .kyc-card { background: #fff; border-radius: 16px; box-shadow: 0 10px 40px rgba(31, 41, 55, .08); padding: 28px 30px; }
  .kyc-logo { height: 44px; }
  .pay-amount { font-size: 40px; font-weight: 800; color: #111827; }
  .pay-icon { font-size: 44px; color: #4f46e5; }
</style>

<div class="kyc-wrap">
  <div class="kyc-card text-center">
    <div class="d-flex justify-content-between align-items-center mb-2 text-start">
      <img src="/logo.jpeg" alt="Dr WISE" class="kyc-logo">
      <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "btn btn-link btn-sm p-0 small text-muted text-decoration-none" %>
    </div>

    <div class="py-3">
      <div class="pay-icon mb-3"><i class="fas fa-file-invoice-dollar"></i></div>
      <h1 class="h4 fw-bold mb-1">One-time registration fee</h1>
      <p class="text-muted small mb-4">
        Your KYC has been submitted. Complete this one-time payment to finish setting up
        your ambassador account while our team reviews your documents.
      </p>
      <div class="pay-amount mb-4"><%= indian_currency(@amount) %></div>

      <div id="payErrorBox" class="alert alert-danger small mb-3" style="display:none;"></div>

      <button id="payNowBtn" type="button" class="btn btn-primary btn-lg px-4">
        <i class="fas fa-lock me-2"></i>Pay Now
      </button>
    </div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function () {
    var btn = document.getElementById("payNowBtn");
    var errorBox = document.getElementById("payErrorBox");
    var csrf = document.querySelector('meta[name="csrf-token"]').content;

    function showError(message) {
      errorBox.textContent = message;
      errorBox.style.display = "block";
    }

    btn.addEventListener("click", async function () {
      errorBox.style.display = "none";
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Please wait...';

      try {
        var orderRes = await fetch("<%= ambassador_kyc_payment_order_path %>", {
          method: "POST",
          headers: { "X-CSRF-Token": csrf }
        });
        var order = await orderRes.json();
        if (!orderRes.ok) throw new Error(order.error || "Could not start payment.");

        var rzp = new Razorpay({
          key: order.key,
          amount: order.amount,
          currency: order.currency,
          order_id: order.order_id,
          name: order.name,
          description: order.description,
          prefill: order.prefill,
          theme: { color: "#4f46e5" },
          handler: async function (response) {
            try {
              var verifyRes = await fetch("<%= ambassador_kyc_payment_verify_path %>", {
                method: "POST",
                headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
                body: JSON.stringify({
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature
                })
              });
              var result = await verifyRes.json();
              if (!verifyRes.ok) throw new Error(result.error || "Payment verification failed.");
              window.location.href = result.redirect_to;
            } catch (err) {
              showError(err.message);
              resetButton();
            }
          },
          modal: {
            ondismiss: function () { resetButton(); }
          }
        });
        rzp.on("payment.failed", function (response) {
          showError(response.error.description || "Payment failed. Please try again.");
          resetButton();
        });
        rzp.open();
      } catch (err) {
        showError(err.message);
        resetButton();
      }
    });

    function resetButton() {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-lock me-2"></i>Pay Now';
    }
  })();
</script>

<div class="container-fluid">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1 class="h3 text-gray-800">Edit Motor Insurance</h1>
        <%= link_to admin_motor_insurances_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Back to List
        <% end %>
      </div>
    </div>
  </div>

  <!-- Include the simplified form content with only required fields -->
  <% content_for :form_title, "Edit Motor Insurance" %>
  <% content_for :submit_text, "Update Motor Insurance" %>
  <%= render 'simplified_form' %>
</div>
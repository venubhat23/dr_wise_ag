<% content_for :page_title, "System Settings" %>

<div class="page-header">
  <div class="page-title-wrapper">
    <h1 class="page-title">
      <i class="bi bi-gear-fill me-2"></i>
      System Settings
    </h1>
    <p class="page-subtitle">Configure system-wide settings and preferences</p>
  </div>
  <div class="page-actions">
    <%= link_to admin_settings_user_roles_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-person-gear me-1"></i>
      User Roles
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title mb-0">
          <i class="bi bi-sliders me-2"></i>
          Application Settings
        </h5>
      </div>
      <div class="card-body">
        <!-- Company Expenses Percentage Setting -->
        <%= form_with url: admin_settings_system_path, method: :patch, local: true, class: "mb-4" do |form| %>
          <div class="row align-items-end">
            <div class="col-md-4">
              <label for="company_expenses_percentage" class="form-label">
                <i class="bi bi-percent me-1"></i>
                Company Expenses Percentage
              </label>
              <%= form.number_field :company_expenses_percentage,
                    value: @company_expenses_percentage,
                    step: 0.1,
                    min: 0,
                    max: 100,
                    class: "form-control",
                    placeholder: "Enter percentage (e.g., 2.5)" %>
              <div class="form-text">Enter percentage value between 0 and 100</div>
            </div>
            <div class="col-md-3">
              <%= form.submit "Update", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>

        <!-- Default Pagination Per Page Setting -->
        <%= form_with url: admin_settings_system_path, method: :patch, local: true, class: "mb-4" do |form| %>
          <div class="row align-items-end">
            <div class="col-md-4">
              <label for="default_pagination_per_page" class="form-label">
                <i class="bi bi-list-ol me-1"></i>
                Default Pagination Per Page
              </label>
              <%= form.number_field :default_pagination_per_page,
                    value: @default_pagination_per_page,
                    min: 5,
                    max: 100,
                    class: "form-control",
                    placeholder: "Enter number (e.g., 10)" %>
              <div class="form-text">Enter number between 5 and 100 (default for all index pages)</div>
            </div>
            <div class="col-md-3">
              <%= form.submit "Update", class: "btn btn-success" %>
            </div>
          </div>
        <% end %>

        <!-- Default Commission Settings -->
        <%= form_with url: admin_settings_system_path, method: :patch, local: true, class: "mb-4" do |form| %>
          <div class="card border-primary">
            <div class="card-header bg-primary text-white">
              <h6 class="card-title mb-0">
                <i class="bi bi-percent me-2"></i>
                Default Commission Settings
              </h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="default_main_agent_commission" class="form-label">
                    <i class="bi bi-person-badge me-1"></i>
                    Main Agent Commission (%)
                  </label>
                  <%= form.number_field :default_main_agent_commission,
                        value: @default_main_agent_commission,
                        step: 0.01,
                        min: 0,
                        max: 100,
                        class: "form-control",
                        placeholder: "e.g., 5.00" %>
                  <div class="form-text">Default commission percentage for main agents</div>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="default_affiliate_commission" class="form-label">
                    <i class="bi bi-people me-1"></i>
                    Affiliate Commission (%)
                  </label>
                  <%= form.number_field :default_affiliate_commission,
                        value: @default_affiliate_commission,
                        step: 0.01,
                        min: 0,
                        max: 100,
                        class: "form-control",
                        placeholder: "e.g., 2.00" %>
                  <div class="form-text">Default commission percentage for affiliates</div>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="default_ambassador_commission" class="form-label">
                    <i class="bi bi-star me-1"></i>
                    Ambassador Commission (%)
                  </label>
                  <%= form.number_field :default_ambassador_commission,
                        value: @default_ambassador_commission,
                        step: 0.01,
                        min: 0,
                        max: 100,
                        class: "form-control",
                        placeholder: "e.g., 3.00" %>
                  <div class="form-text">Default commission percentage for ambassadors</div>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="default_company_expenses" class="form-label">
                    <i class="bi bi-building me-1"></i>
                    Company Expenses (%)
                  </label>
                  <%= form.number_field :default_company_expenses,
                        value: @default_company_expenses,
                        step: 0.01,
                        min: 0,
                        max: 100,
                        class: "form-control",
                        placeholder: "e.g., 2.00" %>
                  <div class="form-text">Default company expenses percentage</div>
                </div>
              </div>
              <div class="row">
                <div class="col-12">
                  <%= form.hidden_field :commission_settings_update, value: "true" %>
                  <%= form.submit "Update Commission Settings", class: "btn btn-primary" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <hr class="my-4">

        <div class="alert alert-info">
          <h6 class="alert-heading">
            <i class="bi bi-info-circle me-2"></i>
            Additional Settings
          </h6>
          <p class="mb-0">
            More system settings configuration will be available in the next update.
            For now, you can manage User Roles from the Settings menu.
          </p>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Application Name</label>
            <div class="fw-medium"><%= @system_settings[:app_name] %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Version</label>
            <div class="fw-medium">
              <span class="badge bg-primary"><%= @system_settings[:version] %></span>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Maintenance Mode</label>
            <div class="fw-medium">
              <% if @system_settings[:maintenance_mode] %>
                <span class="badge bg-warning">Enabled</span>
              <% else %>
                <span class="badge bg-success">Disabled</span>
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Email Notifications</label>
            <div class="fw-medium">
              <% if @system_settings[:email_notifications] %>
                <span class="badge bg-success">Enabled</span>
              <% else %>
                <span class="badge bg-secondary">Disabled</span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Backup Frequency</label>
            <div class="fw-medium"><%= @system_settings[:backup_frequency] %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted">Session Timeout</label>
            <div class="fw-medium"><%= @system_settings[:session_timeout] %> minutes</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h6 class="card-title mb-0">
          <i class="bi bi-lightning-charge me-2"></i>
          Quick Actions
        </h6>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <%= link_to admin_settings_user_roles_path, class: "btn btn-primary btn-sm" do %>
            <i class="bi bi-person-gear me-2"></i>
            Manage User Roles
          <% end %>

          <%= link_to admin_roles_path, class: "btn btn-outline-secondary btn-sm" do %>
            <i class="bi bi-shield-check me-2"></i>
            Roles & Permissions
          <% end %>

          <button class="btn btn-outline-info btn-sm" disabled>
            <i class="bi bi-envelope me-2"></i>
            Email Settings
            <small class="d-block text-muted">Coming Soon</small>
          </button>

          <button class="btn btn-outline-warning btn-sm" disabled>
            <i class="bi bi-database me-2"></i>
            Backup Settings
            <small class="d-block text-muted">Coming Soon</small>
          </button>
        </div>
      </div>
    </div>

    <div class="card mt-4">
      <div class="card-header">
        <h6 class="card-title mb-0">
          <i class="bi bi-info-circle me-2"></i>
          System Information
        </h6>
      </div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-primary fw-bold h6">
                <%= UserRole.count %>
              </div>
              <div class="stat-label text-muted small">User Roles</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-success fw-bold h6">
                <%= Role.count %>
              </div>
              <div class="stat-label text-muted small">Permission Roles</div>
            </div>
          </div>
        </div>
        <hr class="my-3">
        <div class="row text-center">
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-info fw-bold h6">
                <%= User.where(status: true).count %>
              </div>
              <div class="stat-label text-muted small">Active Users</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-item">
              <div class="stat-value text-warning fw-bold h6">
                <%= Permission.count %>
              </div>
              <div class="stat-label text-muted small">Permissions</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .stat-item {
    padding: 0.5rem 0;
  }
</style>
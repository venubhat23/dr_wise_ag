<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1"><%= @vendor.display_name %></h2>
    <% if @vendor.active? %>
      <span class="badge bg-success-subtle text-success">Active</span>
    <% else %>
      <span class="badge bg-warning-subtle text-warning">Inactive</span>
    <% end %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to admin_vendors_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i> Back
    <% end %>
    <% if can_edit?('vendors') %>
      <%= link_to edit_admin_vendor_path(@vendor), class: "btn btn-warning" do %>
        <i class="bi bi-pencil me-1"></i> Edit
      <% end %>
    <% end %>
  </div>
</div>

<!-- Business Stats -->
<div class="row mb-4">
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">Leads Received</h6>
        <h3 class="mb-0 text-primary"><%= number_with_delimiter(@leads_received) %></h3>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">Business Converted</h6>
        <h3 class="mb-0 text-success"><%= number_with_delimiter(@leads_converted) %></h3>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">DrWise Commission Pending</h6>
        <h3 class="mb-0 text-warning"><%= indian_currency(@pending_amount) %></h3>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 mb-3">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted mb-2">DrWise Commission Paid</h6>
        <h3 class="mb-0 text-info"><%= indian_currency(@paid_amount) %></h3>
      </div>
    </div>
  </div>
</div>

<!-- Portal Login Credentials -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent border-0">
    <h6 class="mb-0"><i class="bi bi-key me-2 text-danger"></i>Vendor Portal Login Credentials</h6>
  </div>
  <div class="card-body">
    <% display_password = @vendor_user&.original_password %>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label text-muted">Login URL</label>
        <div class="input-group">
          <input type="text" class="form-control" value="<%= new_vendor_session_url %>" readonly>
          <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= new_vendor_session_url %>')">
            <i class="bi bi-clipboard"></i>
          </button>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label text-muted">Username (Email)</label>
        <div class="input-group">
          <input type="text" class="form-control" value="<%= @vendor.email.presence || 'Not provided' %>" readonly>
          <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= @vendor.email %>')">
            <i class="bi bi-clipboard"></i>
          </button>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label text-muted">Password</label>
        <div class="input-group">
          <input type="text" class="form-control" value="<%= display_password.presence || 'Not available' %>" readonly>
          <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= display_password %>')">
            <i class="bi bi-clipboard"></i>
          </button>
        </div>
      </div>
    </div>
    <% if @vendor.email.blank? %>
      <div class="alert alert-warning mb-0 mt-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        This vendor has no email on file — a portal login can't be created without one.
      </div>
    <% elsif @vendor_user.nil? %>
      <div class="alert alert-warning mb-0 mt-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        No portal login exists yet for this email. Save the vendor again to provision one.
      </div>
    <% elsif display_password.blank? %>
      <div class="alert alert-info mb-0 mt-3">
        <i class="bi bi-info-circle me-2"></i>
        A login exists, but the original password isn't on file (it may have been changed since creation).
      </div>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-lg-6 mb-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-transparent">
        <h5 class="mb-0"><i class="bi bi-shop me-2"></i>Vendor Details</h5>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4 text-muted">Name</dt>
          <dd class="col-sm-8"><%= @vendor.name %></dd>

          <dt class="col-sm-4 text-muted">Company</dt>
          <dd class="col-sm-8"><%= @vendor.company_name.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">Email</dt>
          <dd class="col-sm-8"><%= @vendor.email.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">Phone Number</dt>
          <dd class="col-sm-8"><%= @vendor.phone_number.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">GST Number</dt>
          <dd class="col-sm-8"><%= @vendor.gst_number.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">Address</dt>
          <dd class="col-sm-8"><%= @vendor.address.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">Notes</dt>
          <dd class="col-sm-8"><%= @vendor.notes.presence || "—" %></dd>

          <dt class="col-sm-4 text-muted">Added On</dt>
          <dd class="col-sm-8"><%= @vendor.created_at.strftime('%d %b %Y') %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-6 mb-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-transparent">
        <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Products & Commission</h5>
      </div>
      <div class="card-body p-0">
        <% if @vendor.vendor_products.any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="border-0">Category</th>
                  <th class="border-0">Product</th>
                  <th class="border-0">Commission %</th>
                </tr>
              </thead>
              <tbody>
                <% @vendor.vendor_products.sort_by { |vp| [vp.product_category, vp.product_subcategory] }.each do |vp| %>
                  <tr>
                    <td><%= vp.product_category %></td>
                    <td><%= vp.product_subcategory %></td>
                    <td><%= number_with_precision(vp.commission_percentage, precision: 2) %>%</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4">
            <p class="text-muted mb-0">No products assigned to this vendor.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function copyToClipboard(text) {
  if (text && text !== 'Not provided' && text !== 'Not available') {
    navigator.clipboard.writeText(text).then(function() {
      const toast = document.createElement('div');
      toast.className = 'position-fixed top-0 end-0 p-3';
      toast.style.zIndex = '11';
      toast.innerHTML = `
        <div class="toast show align-items-center text-bg-success border-0" role="alert">
          <div class="d-flex">
            <div class="toast-body">
              <i class="bi bi-check-circle me-2"></i>Copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
          </div>
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }).catch(function(err) {
      alert('Failed to copy: ' + err);
    });
  }
}
</script>

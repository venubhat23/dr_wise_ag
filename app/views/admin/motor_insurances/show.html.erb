</style>

<script>
// Enhanced cleanup function for motor insurance page
function aggressiveCleanup() {
  console.log('🧹 Running motor insurance page cleanup...');

  // Find last actual section (Additional Information)
  const lastSection = document.querySelector('.info-section-card:last-of-type');

  if (lastSection) {
    console.log('📍 Last section found:', lastSection.querySelector('.section-title')?.textContent);

    // Remove ALL elements after the last section until we hit STYLE/SCRIPT
    let nextElement = lastSection.nextElementSibling;
    let removedCount = 0;

    while (nextElement &&
           nextElement.tagName !== 'STYLE' &&
           nextElement.tagName !== 'SCRIPT') {
      const toRemove = nextElement;
      nextElement = nextElement.nextElementSibling;

      console.log('🗑️ Removing element after last section:', toRemove.tagName, toRemove.className);
      toRemove.remove();
      removedCount++;
    }

    console.log(`✅ Removed ${removedCount} elements after last section`);
  }

  // Remove any empty info-section-cards
  const allSections = document.querySelectorAll('.info-section-card');
  allSections.forEach(section => {
    const sectionBody = section.querySelector('.section-body');
    if (sectionBody) {
      const textContent = sectionBody.textContent.trim();
      const hasInputs = sectionBody.querySelectorAll('input, textarea, select').length;

      // Only remove if truly empty (no inputs and no text)
      if (!hasInputs && textContent === '') {
        console.log('🗑️ Removing empty section:', section);
        section.remove();
      }
    }
  });

  // Remove empty divs that might be causing spacing issues
  const allDivs = document.querySelectorAll('div');
  allDivs.forEach(div => {
    if (div.children.length === 0 &&
        div.textContent.trim() === '' &&
        !div.classList.contains('section-icon') &&
        !div.classList.contains('collapse-icon') &&
        !div.classList.contains('collapse') &&
        !div.id.includes('Collapse')) {
      console.log('🗑️ Removing empty div:', div);
      div.remove();
    }
  });

  console.log('✅ Motor insurance page cleanup completed');
}

// Run cleanup with multiple triggers
document.addEventListener('DOMContentLoaded', aggressiveCleanup);
window.addEventListener('load', aggressiveCleanup);
setTimeout(aggressiveCleanup, 100);
setTimeout(aggressiveCleanup, 500);
setTimeout(aggressiveCleanup, 1000);
</script>

<!-- Policy Documents Section -->
<div class="info-section-card">
  <div class="section-header collapsed" data-bs-toggle="collapse" data-bs-target="#policyDocumentsCollapse" aria-expanded="false">
    <div class="d-flex align-items-center">
      <div class="section-icon">
        <i class="bi bi-files"></i>
      </div>
      <h5 class="section-title">Policy Documents</h5>
    </div>
    <i class="bi bi-chevron-down collapse-icon"></i>
  </div>
  <div id="policyDocumentsCollapse" class="collapse">
    <div class="section-body">
      <%
        # Calculate total documents from R2 CloudFlare only (Active Storage disabled)
        r2_documents = @motor_insurance.motor_insurance_documents.count
        total_documents = r2_documents
      %>

      <!-- Document Statistics -->
      <div class="row mb-4">
        <div class="col-md-4">
          <div class="card border-0 bg-light">
            <div class="card-body text-center">
              <h4 class="text-primary mb-2"><%= total_documents %></h4>
              <p class="mb-0 text-muted">Total Documents</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 bg-light">
            <div class="card-body text-center">
              <h4 class="text-success mb-2"><%= r2_documents %></h4>
              <p class="mb-0 text-muted">R2 Stored</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 bg-light">
            <div class="card-body text-center">
              <h4 class="text-info mb-2">0</h4>
              <p class="mb-0 text-muted">Active Storage (Disabled)</p>
            </div>
          </div>
        </div>
      </div>

      <% if total_documents > 0 %>

        <!-- R2 Documents Section -->
        <% if @motor_insurance.motor_insurance_documents.any? %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
              <h6 class="mb-0 text-success">
                <i class="bi bi-cloud-check me-2"></i>
                R2 Documents (<%= @motor_insurance.motor_insurance_documents.count %>)
              </h6>
            </div>
            <div class="card-body p-0">
              <div class="list-group list-group-flush">
                <% @motor_insurance.motor_insurance_documents.each do |document| %>
                  <div class="list-group-item border-0">
                    <div class="d-flex align-items-center py-2">
                      <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                          <% if document.r2_content_type&.include?('pdf') %>
                            <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                          <% elsif document.r2_content_type&.include?('image') %>
                            <i class="bi bi-file-earmark-image text-success fs-5"></i>
                          <% else %>
                            <i class="bi bi-file-earmark text-primary fs-5"></i>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="mb-1"><%= document.title %></h6>
                        <div class="mb-1">
                          <span class="badge bg-light text-dark me-2"><%= document.document_type %></span>
                          <% if document.r2_file_size %>
                            <span class="text-muted small">
                              <i class="bi bi-file-earmark me-1"></i><%= number_to_human_size(document.r2_file_size) %>
                            </span>
                          <% end %>
                        </div>
                        <% if document.description.present? %>
                          <p class="text-muted mb-1 small"><%= truncate(document.description, length: 100) %></p>
                        <% end %>
                        <small class="text-success">
                          <i class="bi bi-cloud-check me-1"></i>Stored in Cloudflare R2 • Uploaded <%= document.created_at.strftime("%B %d, %Y") %>
                        </small>
                      </div>
                      <div class="btn-group" role="group">
                        <% if document.r2_file_key.present? %>
                          <% r2_url = R2Service.public_url(document.r2_file_key) if document.r2_file_key %>
                          <% if r2_url %>
                            <%= link_to r2_url, class: "btn btn-outline-success btn-sm", target: "_blank", title: "View Document" do %>
                              <i class="bi bi-eye me-1"></i>View
                            <% end %>
                            <%= link_to r2_url, class: "btn btn-outline-primary btn-sm", download: document.r2_filename, title: "Download Document" do %>
                              <i class="bi bi-download me-1"></i>Download
                            <% end %>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Active Storage Documents Section - DISABLED (Using R2 CloudFlare only) -->

        <!-- Policy Documents (Active Storage) Section - DISABLED (Using R2 CloudFlare only) -->

      <% else %>
        <!-- No Documents Message -->
        <div class="text-center py-4">
          <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-files text-muted" style="font-size: 2rem;"></i>
          </div>
          <h6 class="text-muted mb-2">No documents uploaded</h6>
          <p class="text-muted mb-0">Documents for this motor insurance policy will appear here once uploaded.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Vendor Portal - Dr WISE" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      body { font-family: 'Poppins', sans-serif; background: #f4f6f9; }
      .vendor-shell { display: flex; min-height: 100vh; }
      .vendor-sidebar {
        width: 240px; flex-shrink: 0; background: #1a2233; color: #fff;
        display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;
      }
      .vendor-sidebar .brand { padding: 1.25rem 1.25rem 1rem; font-weight: 700; font-size: 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .vendor-sidebar .brand small { display: block; font-weight: 400; opacity: 0.6; font-size: 0.75rem; }
      .vendor-sidebar nav { flex: 1; padding: 1rem 0; }
      .vendor-sidebar .nav-link {
        color: rgba(255,255,255,0.75); padding: 0.7rem 1.25rem; display: flex; align-items: center;
        gap: 0.6rem; border-left: 3px solid transparent;
      }
      .vendor-sidebar .nav-link i { font-size: 1.1rem; width: 1.25rem; }
      .vendor-sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
      .vendor-sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: #4f8cff; }
      .vendor-sidebar .signout { padding: 1rem 1.25rem; border-top: 1px solid rgba(255,255,255,0.1); }
      .vendor-main { flex: 1; padding: 1.75rem; min-width: 0; }
    </style>
  </head>

  <body>
    <div class="vendor-shell">
      <%= render 'layouts/vendor_sidebar' %>
      <main class="vendor-main">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show"><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger alert-dismissible fade show"><%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
